# --------------------------------------------------------------------------
# Configuration constants
# --------------------------------------------------------------------------

ALLOWED_CLUSTERS = {"man07", "gar07"}
ALLOWED_ENVS = {"nonprod"}

# Prometheus label keys used to scope every query. Change these if your
# metrics use different label names -- nothing else in this file needs to
# change.
LABEL_APP_ID = "app_id"
LABEL_COMPONENT = "component"
LABEL_CLUSTER = "cluster"
LABEL_ENV = "env"

DEFAULT_MAX_DATAPOINTS_PER_SERIES = 1000
DEFAULT_MIN_STEP_SECONDS = 15
DEFAULT_CONCURRENCY = 8
DEFAULT_CONNECT_TIMEOUT = 10.0
DEFAULT_READ_TIMEOUT = 60.0
DEFAULT_MAX_RETRIES = 4
DEFAULT_BACKOFF_BASE = 0.5
DEFAULT_BACKOFF_MAX = 20.0

# Overall wall-clock budget for one fetch_all_metrics() call. Once exceeded,
# in-flight and not-yet-started requests fail fast with DEADLINE_EXCEEDED
# instead of continuing to retry/queue -- already-completed metrics keep
# their results.
DEFAULT_OVERALL_TIMEOUT_SECONDS = 300.0

# A server can tell us to back off for an arbitrarily long time via
# Retry-After; we honor it but never wait longer than this for a single
# retry, so one slow metric can't quietly eat the whole deadline budget.
DEFAULT_MAX_RETRY_AFTER_SECONDS = 60.0

# Many enterprise Grafana/Prometheus proxies cap response size or duration
# per single query_range call regardless of `step`. Windows longer than this
# are split into sequential, non-overlapping sub-ranges fetched concurrently
# and merged back together per series.
DEFAULT_MAX_CHUNK_SECONDS = 6 * 60 * 60  # 6 hours

# Circuit breaker: after this many consecutive request failures (across all
# metrics, shared per fetch_all_metrics call), stop attempting new requests
# for `reset_after_seconds` so a downed backend doesn't get hammered by
# every remaining metric retrying independently.
DEFAULT_CIRCUIT_BREAKER_THRESHOLD = 10
DEFAULT_CIRCUIT_BREAKER_RESET_SECONDS = 30.0


# --------------------------------------------------------------------------
# Error taxonomy
# --------------------------------------------------------------------------

class ErrorCode(str, Enum):
    VALIDATION_ERROR = "VALIDATION_ERROR"
    AUTH_ERROR = "AUTH_ERROR"
    FORBIDDEN = "FORBIDDEN"
    NOT_FOUND = "NOT_FOUND"
    RATE_LIMITED = "RATE_LIMITED"
    SERVER_ERROR = "SERVER_ERROR"
    TIMEOUT = "TIMEOUT"
    CONNECTION_ERROR = "CONNECTION_ERROR"
    INVALID_RESPONSE = "INVALID_RESPONSE"
    PROMQL_ERROR = "PROMQL_ERROR"
    NO_METRICS_FOUND = "NO_METRICS_FOUND"
    DEADLINE_EXCEEDED = "DEADLINE_EXCEEDED"
    CIRCUIT_OPEN = "CIRCUIT_OPEN"
    UNKNOWN_ERROR = "UNKNOWN_ERROR"


class GrafanaMetricsError(Exception):
    """Base exception. Carries a stable error_code + retryability + details
    so every failure can be serialized identically, whether it surfaces via
    CLI, MCP tool, or LangGraph tool."""

    def __init__(
        self,
        message: str,
        error_code: ErrorCode = ErrorCode.UNKNOWN_ERROR,
        status_code: Optional[int] = None,
        retryable: bool = False,
        details: Optional[dict] = None,
    ):
        super().__init__(message)
        self.message = message
        self.error_code = error_code
        self.status_code = status_code
        self.retryable = retryable
        self.details = details or {}

    def to_dict(self) -> dict:
        return {
            "error_code": self.error_code.value,
            "message": self.message,
            "status_code": self.status_code,
            "retryable": self.retryable,
            "details": self.details,
        }


class ValidationError(GrafanaMetricsError):
    def __init__(self, message, details=None):
        super().__init__(message, ErrorCode.VALIDATION_ERROR, retryable=False, details=details)


class AuthError(GrafanaMetricsError):
    def __init__(self, message, status_code=None, details=None):
        super().__init__(message, ErrorCode.AUTH_ERROR, status_code=status_code, retryable=False, details=details)


class ForbiddenError(GrafanaMetricsError):
    def __init__(self, message, status_code=None, details=None):
        super().__init__(message, ErrorCode.FORBIDDEN, status_code=status_code, retryable=False, details=details)


class NotFoundErrorX(GrafanaMetricsError):
    def __init__(self, message, status_code=None, details=None):
        super().__init__(message, ErrorCode.NOT_FOUND, status_code=status_code, retryable=False, details=details)


class RateLimitErrorX(GrafanaMetricsError):
    def __init__(self, message, status_code=None, details=None):
        super().__init__(message, ErrorCode.RATE_LIMITED, status_code=status_code, retryable=True, details=details)


class ServerErrorX(GrafanaMetricsError):
    def __init__(self, message, status_code=None, details=None):
        super().__init__(message, ErrorCode.SERVER_ERROR, status_code=status_code, retryable=True, details=details)


class TimeoutErrorX(GrafanaMetricsError):
    def __init__(self, message, details=None):
        super().__init__(message, ErrorCode.TIMEOUT, retryable=True, details=details)


class ConnectionErrorX(GrafanaMetricsError):
    def __init__(self, message, details=None):
        super().__init__(message, ErrorCode.CONNECTION_ERROR, retryable=True, details=details)


class InvalidResponseError(GrafanaMetricsError):
    def __init__(self, message, details=None):
        super().__init__(message, ErrorCode.INVALID_RESPONSE, retryable=False, details=details)


class PromQLError(GrafanaMetricsError):
    def __init__(self, message, details=None):
        super().__init__(message, ErrorCode.PROMQL_ERROR, retryable=False, details=details)


class DeadlineExceededError(GrafanaMetricsError):
    """The overall per-call time budget ran out. Not retried -- if we're
    out of budget, retrying just burns more of a budget that's already gone."""
    def __init__(self, message, details=None):
        super().__init__(message, ErrorCode.DEADLINE_EXCEEDED, retryable=False, details=details)


class CircuitOpenError(GrafanaMetricsError):
    """Too many consecutive failures against this backend recently; failing
    fast without a network call until the reset window elapses."""
    def __init__(self, message, details=None):
        super().__init__(message, ErrorCode.CIRCUIT_OPEN, retryable=False, details=details)



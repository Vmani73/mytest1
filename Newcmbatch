@dataclass
class Task:
    repo_url: str
    branch: str = "main"
    playbooks: list[str] = field(default_factory=list)
    goal: str = ""
    cd_repo_url: str = ""
    cd_branch: str = ""
    repo_path: str = ""
    user_id: str = ""
    mirror_mode: Optional[bool] = None

    @property
    def key(self) -> str:
        raw = "|".join([
            self.repo_url.strip().rstrip("/").lower(),
            self.branch.strip(),
            ",".join(self.playbooks),
            self.goal.strip(),
            self.cd_repo_url.strip(),
            self.cd_branch.strip(),
        ])
        return hashlib.sha256(raw.encode()).hexdigest()[:20]

    @property
    def short(self) -> str:
        return self.repo_url.rstrip("/").rsplit("/", 1)[-1] or self.repo_url

    def payload(self) -> dict[str, Any]:
        """Only repo_url + playbook_names + branch are sent unconditionally.
        Optional fields are omitted when empty so the API keeps its defaults."""
        body: dict[str, Any] = {
            "repo_url": self.repo_url,
            "branch": self.branch or "main",
            "playbook_names": self.playbooks,
        }
        if self.goal:
            body["goal"] = self.goal
        if self.cd_repo_url:
            body["cd_repo_url"] = self.cd_repo_url
        if self.cd_branch:
            body["cd_branch"] = self.cd_branch
        if self.repo_path:
            body["repo_path"] = self.repo_path
        if self.user_id:
            body["user_id"] = self.user_id
        if self.mirror_mode is not None:
            body["mirror_mode"] = self.mirror_mode
        return body



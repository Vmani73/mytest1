# process-level guards: single instance + keep awake
# ==========================================================================


class InstanceLock:
    """Prevents two runners sharing one state dir (which would double-submit)."""

    def __init__(self, state_dir: Path):
        self.path = state_dir / ".runner.lock"
        self.fd: Optional[int] = None

    def acquire(self) -> None:
        self.path.parent.mkdir(parents=True, exist_ok=True)
        try:
            self.fd = os.open(str(self.path), os.O_CREAT | os.O_EXCL | os.O_RDWR)
        except FileExistsError:
            stale = self._stale()
            if not stale:
                owner = self.path.read_text(errors="ignore").strip()
                raise SystemExit(
                    f"Another runner owns {self.path.parent} ({owner}).\n"
                    f"If that process is gone, delete {self.path} and retry.")
            self.path.unlink(missing_ok=True)
            self.fd = os.open(str(self.path), os.O_CREAT | os.O_EXCL | os.O_RDWR)
        os.write(self.fd, f"pid={os.getpid()} host={platform.node()} at={utcnow()}"
                          .encode())

    def _stale(self) -> bool:
        try:
            txt = self.path.read_text()
            pid = int(txt.split("pid=")[1].split()[0])
        except Exception:
            return True
        if platform.node() not in txt:
            return False          # another host: never assume stale
        try:
            os.kill(pid, 0)
            return False
        except OSError:
            return True

    def release(self) -> None:
        with contextlib.suppress(Exception):
            if self.fd is not None:
                os.close(self.fd)
            self.path.unlink(missing_ok=True)


class KeepAwake:
    """Blocks system sleep. Screen lock never stops a process; sleep does."""

    def __init__(self, enabled: bool = True):
        self.enabled = enabled
        self._stop = threading.Event()
        self._thread: Optional[threading.Thread] = None
        self._proc = None
        self.mode = "off"

    def start(self) -> None:
        if not self.enabled:
            return
        sysname = platform.system()
        if sysname == "Windows":
            self.mode = "windows/SetThreadExecutionState"
            self._thread = threading.Thread(target=self._win_loop, daemon=True)
            self._thread.start()
        elif sysname == "Darwin":
            import subprocess
            with contextlib.suppress(Exception):
                self._proc = subprocess.Popen(
                    ["caffeinate", "-i", "-w", str(os.getpid())],
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                self.mode = "macos/caffeinate"
        else:
            self.mode = "n/a (linux: use systemd-run or a server)"

    def _win_loop(self) -> None:
        import ctypes
        ES_CONTINUOUS = 0x80000000
        ES_SYSTEM_REQUIRED = 0x00000001
        ES_AWAYMODE_REQUIRED = 0x00000040
        k32 = ctypes.windll.kernel32  # type: ignore[attr-defined]
        while not self._stop.is_set():
            k32.SetThreadExecutionState(
                ES_CONTINUOUS | ES_SYSTEM_REQUIRED | ES_AWAYMODE_REQUIRED)
            self._stop.wait(30)
        k32.SetThreadExecutionState(ES_CONTINUOUS)

    def stop(self) -> None:
        self._stop.set()
        if self._proc:
            with contextlib.suppress(Exception):
                self._proc.terminate()


# ==========================================================================
# HTTP layer: retry, backoff, circuit breaker
# ==========================================================================


class CircuitBreaker:
    def __init__(self, threshold: int, cooldown: float):
        self.threshold, self.cooldown = threshold, cooldown
        self.failures = 0
        self.open_until = 0.0
        self.trips = 0
        self._lock = asyncio.Lock()

    async def gate(self, stop: asyncio.Event) -> None:
        while now_ts() < self.open_until and not stop.is_set():
            await interruptible_sleep(min(2.0, self.open_until - now_ts()), stop)

    async def record(self, ok: bool) -> None:
        async with self._lock:
            if ok:
                self.failures = 0
                return
            self.failures += 1
            if self.failures >= self.threshold:
                self.open_until = now_ts() + self.cooldown
                self.failures = 0
                self.trips += 1

    @property
    def is_open(self) -> bool:
        return now_ts() < self.open_until


class TransientError(Exception):
    pass


class PermanentError(Exception):
    pass


async def interruptible_sleep(seconds: float, stop: asyncio.Event) -> None:
    """Sleep that reacts to shutdown within ~0.25s."""
    end = now_ts() + max(0.0, seconds)
    while now_ts() < end:
        if stop.is_set():
            return
        await asyncio.sleep(min(0.25, end - now_ts()))


@dataclass
class Resp:
    status: int
    body: str
    headers: dict[str, str] = field(default_factory=dict)


def http_call(url: str, method: str, headers: dict[str, str],
              body: Optional[dict], timeout: float, verify: bool) -> Resp:
    """One blocking HTTP call on the stdlib. Runs in a worker thread."""
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(url, data=data, method=method)
    for k, v in headers.items():
        req.add_header(k, v)
    ctx = None
    if url.lower().startswith("https"):
        ctx = ssl.create_default_context()
        if not verify:
            ctx.check_hostname = False
            ctx.verify_mode = ssl.CERT_NONE
    try:
        with urllib.request.urlopen(req, timeout=timeout, context=ctx) as r:
            return Resp(r.status, r.read().decode("utf-8", "replace"),
                        {k.lower(): v for k, v in r.headers.items()})
    except urllib.error.HTTPError as e:              # server answered 4xx/5xx
        payload = ""
        with contextlib.suppress(Exception):
            payload = e.read().decode("utf-8", "replace")
        return Resp(e.code, payload,
                    {k.lower(): v for k, v in (e.headers or {}).items()})


class ApiClient:
    def __init__(self, cfg: Config, breaker: CircuitBreaker, stop: asyncio.Event,
                 log):
        self.cfg = cfg
        self.breaker = breaker
        self.stop = stop
        self.log = log
        self.headers = {"accept": "application/json",
                        "content-type": "application/json",
                        "user-agent": f"{APP}/{VERSION}"}
        self.headers.update(cfg.headers)
        if cfg.token:
            self.headers["Authorization"] = f"Bearer {cfg.token}"
        self._submit_lock = asyncio.Lock()
        self._last_submit = 0.0
        self.requests = 0
        self.retries = 0

    async def aclose(self) -> None:
        return None

    async def _request(self, method: str, path: str,
                       json_body: Optional[dict] = None) -> Resp:
        url = self.cfg.base_url.rstrip("/") + path
        attempt = 0
        while True:
            attempt += 1
            await self.breaker.gate(self.stop)
            if self.stop.is_set():
                raise TransientError("shutdown requested")
            try:
                self.requests += 1
                resp = await asyncio.to_thread(
                    http_call, url, method, self.headers, json_body,
                    self.cfg.http_timeout, self.cfg.verify)
            except (urllib.error.URLError, socket.timeout, OSError,
                    ssl.SSLError) as exc:
                await self.breaker.record(False)
                reason = getattr(exc, "reason", exc)
                if attempt >= self.cfg.max_http_attempts:
                    raise TransientError(f"cannot reach server: {reason}") from exc
                self.retries += 1
                await self._backoff(attempt, None)
                continue

            if resp.status < 400:
                await self.breaker.record(True)
                return resp

            if resp.status in RETRYABLE_HTTP:
                await self.breaker.record(False)
                if attempt >= self.cfg.max_http_attempts:
                    raise TransientError(
                        f"HTTP {resp.status} after {attempt} attempts: "
                        f"{resp.body[:200]}")
                self.retries += 1
                await self._backoff(attempt, resp.headers.get("retry-after"))
                continue

            await self.breaker.record(True)    # 400/401/403/404/422: never retry
            raise PermanentError(f"HTTP {resp.status}: {resp.body[:300]}")

    async def _backoff(self, attempt: int, retry_after: Optional[str]) -> None:
        if retry_after:
            with contextlib.suppress(ValueError):
                await interruptible_sleep(
                    min(float(retry_after), self.cfg.backoff_cap), self.stop)
                return
        delay = min(self.cfg.backoff_base ** attempt, self.cfg.backoff_cap)
        await interruptible_sleep(delay * (0.5 + random.random()), self.stop)

    async def submit(self, task: Task) -> tuple[str, dict]:
        async with self._submit_lock:          # global pacing
            gap = self.cfg.submit_gap - (now_ts() - self._last_submit)
            if gap > 0:
                await interruptible_sleep(gap, self.stop)
            self._last_submit = now_ts()
        resp = await self._request("POST", SUBMIT_PATH, task.payload())
        data = _safe_json(resp)
        run_id = deep_find(data, RUN_ID_KEYS)
        if not run_id:
            raise PermanentError(
                f"the server did not return a run id: {json.dumps(data)[:300]}")
        return str(run_id), data

    async def get_run(self, run_id: str) -> dict:
        return _safe_json(await self._request("GET", POLL_PATH.format(run_id=run_id)))


def _safe_json(resp: Resp) -> dict:
    try:
        data = json.loads(resp.body)
    except Exception:
        return {"_raw": resp.body[:4000]}
    return data if isinstance(data, dict) else {"_data": data}


def classify(payload: dict, cfg_success: set[str], cfg_failure: set[str]
             ) -> tuple[str, str]:
    """-> (bucket, raw_status) where bucket in {SUCCEEDED, FAILED, RUNNING, ?}"""
    raw = deep_find(payload, STATUS_KEYS) or ""
    norm = raw.strip().lower().replace(" ", "_")
    if norm in cfg_success:
        return SUCCEEDED, raw
    if norm in cfg_failure:
        return FAILED, raw
    if norm in RUNNING_STATES:
        return RUNNING, raw
    return "?", raw



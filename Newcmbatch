CONFIG_NAME = "codemind.json"

DEFAULT_CONFIG: dict[str, Any] = {
    "base_url": "",
    "playbooks": [],
    "goal": "generate report",
    "branch": "main",
    "cd_repo_url": "",
    "cd_branch": "",
    "user_id": "",
    "token": "",
    "insecure": True,
    "concurrency": 2,
    "max_wall_minutes": 30,
    "poll_interval": 30,
    "first_poll_delay": 60,
    "state": "./cm_state",
    "shard": "1/1",
}


def config_path() -> Path:
    return Path.cwd() / CONFIG_NAME


def build_config(r: dict[str, Any]) -> Config:
    """Turn the saved settings dict into the engine's Config."""
    shard, shards = 0, 1
    with contextlib.suppress(Exception):
        i, n = str(r.get("shard", "1/1")).split("/")
        shard, shards = int(i) - 1, int(n)
    if not (0 <= shard < shards):
        shard, shards = 0, 1
    return Config(
        base_url=str(r.get("base_url", "")).strip().rstrip("/"),
        state_dir=Path(r.get("state") or "./cm_state"),
        playbooks=[str(x).strip() for x in (r.get("playbooks") or [])
                   if str(x).strip()],
        goal=r.get("goal", ""), branch=r.get("branch") or "main",
        cd_repo_url=r.get("cd_repo_url", ""), cd_branch=r.get("cd_branch", ""),
        user_id=r.get("user_id", ""), token=r.get("token", ""),
        verify=not bool(r.get("insecure", True)),
        concurrency=max(1, min(16, int(r.get("concurrency", 2) or 2))),
        max_wall=float(r.get("max_wall_minutes", 30)) * 60,
        poll_interval=float(r.get("poll_interval", 30)),
        first_poll_delay=float(r.get("first_poll_delay", 60)),
        shard=shard, shards=shards, no_ui=True,
    )


class Controller:
    def __init__(self):
        self.raw: dict[str, Any] = dict(DEFAULT_CONFIG)
        if config_path().exists():
            with contextlib.suppress(Exception):
                loaded = json.loads(config_path().read_text(encoding="utf-8-sig"))
                self.raw.update({k: v for k, v in loaded.items()
                                 if not k.startswith("_")})
        self.cfg = self._build()
        self.store = Store(self.cfg.db_path)
        self.runner: Optional[Runner] = None
        self.loop: Optional[asyncio.AbstractEventLoop] = None
        self.thread: Optional[threading.Thread] = None
        self.phase = "idle"                 # idle | running | stopping
        self.message = ""
        self.awake = KeepAwake(True)
        self.lock = InstanceLock(self.cfg.state_dir)
        self.log = None

    # -- config ----------------------------------------------------------
    def _build(self) -> Config:
        return build_config(self.raw)

    def save_config(self, patch: dict[str, Any]) -> None:
        if self.phase != "idle":
            raise ValueError("Pause the batch before changing settings.")
        clean = {k: v for k, v in patch.items() if k in DEFAULT_CONFIG}
        if "playbooks" in clean:
            pb = [str(x).strip() for x in clean["playbooks"] if str(x).strip()]
            if len(pb) > 2:
                raise ValueError("At most 2 playbooks per run.")
            clean["playbooks"] = pb
        if not str(clean.get("base_url", self.raw.get("base_url", ""))).strip():
            raise ValueError("The server address cannot be empty.")
        self.raw.update(clean)
        old_state = self.cfg.state_dir
        self.cfg = self._build()
        config_path().write_text(json.dumps(self.raw, indent=2) + "\n")
        if self.cfg.state_dir != old_state:
            self.store.close()
            self.store = Store(self.cfg.db_path)
            self.lock = InstanceLock(self.cfg.state_dir)

    @property
    def configured(self) -> bool:
        return bool(self.cfg.base_url and self.cfg.playbooks)

    # -- work ------------------------------------------------------------
    def add_repos(self, text: str, as_csv: bool) -> dict[str, int]:
        rows = parse_rows(text, as_csv)
        if not rows:
            raise ValueError("No repository URLs found in that list.")
        tasks = rows_to_tasks(rows, self.cfg)
        if not tasks:
            raise ValueError("Nothing to add — every row belongs to another shard.")
        new, dup = self.store.enqueue(tasks)
        return {"added": new, "already_known": dup, "parsed": len(rows)}

    def test_connection(self) -> dict[str, Any]:
        return probe_server(self.cfg)

    def start(self) -> None:
        if self.phase != "idle":
            raise ValueError("Already running.")
        if not self.configured:
            raise ValueError("Finish setup first.")
        rows = self.store.actionable()
        if not rows:
            raise ValueError("No repositories waiting. Add some below.")
        self.lock.acquire()
        self.awake.start()
        self.log = make_logger(self.cfg)
        self.message = ""
        self.phase = "running"
        self.thread = threading.Thread(target=self._thread, args=(rows,),
                                       daemon=True)
        self.thread.start()

    def _thread(self, rows: list[sqlite3.Row]) -> None:
        try:
            asyncio.run(self._arun(rows))
        except Exception as exc:                       # never lose the reason
            self.message = f"Stopped: {type(exc).__name__}: {exc}"
            if self.log:
                self.log(f"fatal: {type(exc).__name__}: {exc}")
        finally:
            self.phase = "idle"
            self.awake.stop()
            self.lock.release()
            with contextlib.suppress(Exception):
                write_html(self.cfg, self.store, live=False)

    async def _arun(self, rows: list[sqlite3.Row]) -> None:
        self.loop = asyncio.get_running_loop()
        counts = self.store.counts()
        already = sum(v for k, v in counts.items() if k in TERMINAL)
        self.runner = Runner(self.cfg, self.store, self.log or (lambda m: None))
        await self.runner.run(rows, already)

    def stop(self) -> None:
        if self.phase != "running" or not (self.runner and self.loop):
            return
        self.phase = "stopping"
        self.message = "Finishing the runs in flight — they resume where they left off."
        self.loop.call_soon_threadsafe(self.runner.stop.set)

    # -- read models -----------------------------------------------------
    def snapshot(self) -> dict[str, Any]:
        counts = self.store.counts()
        total = sum(counts.values())
        done = sum(counts.get(k, 0) for k in TERMINAL)
        st = self.runner.stats if (self.runner and self.phase != "idle") else None
        active = []
        if st:
            for lr in list(st.active.values()):
                active.append({"repo": lr.repo, "run_id": lr.run_id,
                               "status": lr.status, "polls": lr.polls,
                               "elapsed": round(now_ts() - lr.started)})
        durations = self.store.durations()
        avg = sum(durations) / len(durations) if durations else 0
        rate = st.rate_per_hour if st else 0
        remaining = total - done
        eta = (remaining / rate * 3600) if rate else (
            remaining * avg / self.cfg.concurrency if avg else 0)
        api = self.runner.api if self.runner else None
        return {
            "phase": self.phase,
            "message": self.message,
            "configured": self.configured,
            "config": {**self.raw, "token": "***" if self.raw.get("token") else ""},
            "endpoints": {"submit": SUBMIT_PATH, "poll": POLL_PATH},
            "counts": counts, "total": total, "done": done,
            "succeeded": counts.get(SUCCEEDED, 0),
            "failed": counts.get(FAILED, 0) + counts.get(DEAD, 0),
            "timeout": counts.get(TIMEOUT, 0),
            "in_flight": counts.get(RUNNING, 0),
            "waiting": counts.get(PENDING, 0),
            "rate_per_hour": round(rate),
            "eta_seconds": round(eta),
            "elapsed": round(st.elapsed) if st else 0,
            "avg_seconds": round(avg),
            "active": active,
            "events": [{"ts": e["ts"][11:19], "level": e["level"],
                        "msg": e["msg"]} for e in self.store.recent_events(14)],
            "http": {"requests": api.requests if api else 0,
                     "retries": api.retries if api else 0,
                     "breaker": bool(self.runner.breaker.is_open)
                     if self.runner else False},
            "state_dir": str(self.cfg.state_dir.resolve()),
        }

    def runs(self, q: str = "", state: str = "", limit: int = 300) -> list[dict]:
        out = []
        for r in self.store.all_rows():
            if state and r["state"] != state:
                continue
            blob = f"{r['repo_url']} {r['state']} {r['api_status']} {r['error']}"
            if q and q.lower() not in blob.lower():
                continue
            rp = ""
            if r["report_path"]:
                with contextlib.suppress(Exception):
                    rp = os.path.relpath(
                        r["report_path"],
                        self.cfg.state_dir.resolve()).replace(os.sep, "/")
            out.append({
                "repo": r["repo_url"].rstrip("/").rsplit("/", 1)[-1],
                "repo_url": r["repo_url"], "branch": r["branch"],
                "state": r["state"], "api_status": r["api_status"] or "",
                "run_id": r["run_id"] or "",
                "duration": round(r["duration_s"] or 0),
                "polls": r["polls"] or 0, "error": (r["error"] or "")[:240],
                "report": rp,
            })
        out.sort(key=lambda x: (x["state"] != "RUNNING", x["state"]))
        return out[:limit]


def probe_server(cfg: Config) -> dict[str, Any]:
    """Friendly reachability check used by the Test connection button."""
    url = cfg.base_url
    if not url:
        return {"ok": False, "message": "Enter the server address first."}
    headers = {"accept": "application/json",
               "user-agent": f"{APP}/{VERSION}"}
    if cfg.token:
        headers["Authorization"] = f"Bearer {cfg.token}"
    for path in ("/openapi.json", "/docs", "/"):
        try:
            r = http_call(url + path, "GET", headers, None, 15,
                          cfg.verify)
        except Exception as exc:
            reason = getattr(exc, "reason", exc)
            return {"ok": False,
                    "message": f"Cannot reach {url} — {reason}"}
        if r.status < 400:
            found = SUBMIT_PATH in r.body if path == "/openapi.json" else None
            msg = f"Connected to {url}"
            if found is False:
                msg += f" — warning: {SUBMIT_PATH} was not in its API list"
            return {"ok": True, "message": msg}
        if r.status in (401, 403):
            return {"ok": False,
                    "message": "The server answered but refused the "
                               "credentials. Check the token in Advanced."}
    return {"ok": False,
            "message": f"{url} answered, but not with an API. "
                       f"Check the address."}



      <div class="spacer" style="flex:1"></div>
      <input type="text" id="q" placeholder="Search repository, status or error" oninput="loadRuns()"
             style="max-width:260px">
      <button onclick="requeue()" class="danger">Try failed again</button>
      <span id="chips"></span>
    </div>
    <div style="overflow:auto;max-height:560px;margin-top:14px">
      <table><thead><tr><th>Repository</th><th>Outcome</th><th>Server status</th>
        <th>Run id</th><th>Time</th><th>Report</th></tr></thead>
        <tbody id="rows"></tbody></table>
    </div>
  </div>

  <details class="card"><summary style="cursor:pointer;color:var(--dim)">Activity log</summary>
    <div id="events" style="margin-top:12px"></div></details>
</section>

def make_logger(cfg: Config):
    cfg.state_dir.mkdir(parents=True, exist_ok=True)
    fh = cfg.log_path.open("a", encoding="utf-8")

    def log(msg: str) -> None:
        fh.write(f"{utcnow()} {msg}\n")
        fh.flush()
    return log


def cmd_export(cfg: Config, out: Path, quiet: bool = False) -> int:
    store = Store(cfg.db_path)
    rows = store.all_rows()
    cols = ["repo_url", "branch", "playbooks", "state", "api_status", "run_id",
            "duration_s", "polls", "attempt", "error", "report_path",
            "enqueued_at", "updated_at"]
    out.parent.mkdir(parents=True, exist_ok=True)
    with out.open("w", newline="", encoding="utf-8") as fh:
        w = csv.writer(fh)
        w.writerow(cols)
        for r in rows:
            w.writerow([r[c] for c in cols])
    store.close()
    if not quiet:
        print(f"{len(rows)} rows -> {out.resolve()}")
    return 0



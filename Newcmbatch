<script>
let S={}, RUNS=[], filterState="", addMode="list", fileText="", fileIsCsv=false, setupOpen=false;
const $=id=>document.getElementById(id);
const COL={SUCCEEDED:"var(--ok)",FAILED:"var(--bad)",DEAD:"var(--bad)",
  TIMEOUT:"var(--warn)",RUNNING:"var(--cy)",PENDING:"#22303d"};
const ORDER=["SUCCEEDED","FAILED","DEAD","TIMEOUT","RUNNING","PENDING"];
const NICE={SUCCEEDED:"done",FAILED:"failed",DEAD:"rejected",TIMEOUT:"timed out",
  RUNNING:"in progress",PENDING:"waiting"};

function toast(msg,bad){const t=$("toast");t.textContent=msg;
  t.className="toast"+(bad?" bad":"");clearTimeout(t._t);
  t._t=setTimeout(()=>t.className="toast hidden",bad?7000:3500);}
async function api(path,body){
  const r=await fetch(path,body?{method:"POST",headers:{"content-type":"application/json"},
    body:JSON.stringify(body)}:{});
  const d=await r.json().catch(()=>({}));
  if(!r.ok) throw new Error(d.error||("Request failed ("+r.status+")"));
  return d;}
function dur(s){if(!s)return "—";if(s<60)return Math.round(s)+"s";
  const m=Math.floor(s/60);if(m<60)return m+"m "+Math.round(s%60)+"s";
  const h=Math.floor(m/60);if(h<48)return h+"h "+(m%60)+"m";return Math.floor(h/24)+" days";}

/* ---------- setup ---------- */
function fillSetup(){const c=S.config||{};
  $("base").value=c.base_url||""; $("pb1").value=(c.playbooks||[])[0]||"";
  $("pb2").value=(c.playbooks||[])[1]||""; $("goal").value=c.goal||"";
  $("branch").value=c.branch||"main"; $("conc").value=c.concurrency||2;
  $("wall").value=c.max_wall_minutes||30; $("shard").value=c.shard||"1/1";
  $("token").value=""; $("cdrepo").value=c.cd_repo_url||"";
  $("cdbranch").value=c.cd_branch||""; $("insecure").checked=c.insecure!==false;}
function toggleSetup(){setupOpen=!setupOpen;paint();}
function setupPayload(){
  const p={base_url:$("base").value.trim(),
    playbooks:[$("pb1").value.trim(),$("pb2").value.trim()].filter(Boolean),
    goal:$("goal").value.trim(),branch:$("branch").value.trim()||"main",
    concurrency:+$("conc").value||2,max_wall_minutes:+$("wall").value||30,
    shard:$("shard").value.trim()||"1/1",cd_repo_url:$("cdrepo").value.trim(),
    cd_branch:$("cdbranch").value.trim(),insecure:$("insecure").checked};
  if($("token").value.trim())p.token=$("token").value.trim();
  return p;}
async function testConn(){
  $("testout").textContent="Checking…";$("testout").style.color="var(--dim)";
  try{const d=await api("/api/test",setupPayload());
    $("testout").textContent=d.message;
    $("testout").style.color=d.ok?"var(--ok)":"var(--bad)";}
  catch(e){$("testout").textContent=e.message;$("testout").style.color="var(--bad)";}}
async function saveSetup(){
  const p=setupPayload();
  if(!p.base_url){toast("Enter the server address first.",1);return;}
  if(!p.playbooks.length){toast("Enter at least one playbook.",1);return;}
  try{await api("/api/config",p);setupOpen=false;await refresh();
    toast("Settings saved.");}catch(e){toast(e.message,1);}}

/* ---------- repositories ---------- */
function mode(m){addMode=m;
  document.querySelectorAll(".pill[data-m]").forEach(b=>
    b.setAttribute("aria-pressed",b.dataset.m===m));
  ["one","list","file"].forEach(x=>$("m-"+x).classList.toggle("hidden",x!==m));}
function pickFile(){const f=$("csvfile").files[0];if(!f)return;
  const rd=new FileReader();
  rd.onload=()=>{fileText=rd.result;fileIsCsv=/\.(csv|tsv)$/i.test(f.name);
    const n=fileText.split(/\r?\n/).filter(l=>l.trim()).length;
    $("fileinfo").textContent=f.name+" — "+n+" lines read";};
  rd.readAsText(f);}
async function addRepos(){
  let text="",as_csv=false;
  if(addMode==="one")text=$("onerepo").value.trim();
  else if(addMode==="list")text=$("listrepos").value;
  else{text=fileText;as_csv=fileIsCsv;}
  if(!text.trim()){toast("Nothing to add yet.",1);return;}
  try{const d=await api("/api/repos",{text,as_csv});
    toast(d.added+" added"+(d.already_known?", "+d.already_known+" already in the list":"")+".");
    $("onerepo").value="";$("listrepos").value="";fileText="";$("fileinfo").textContent="";
    await refresh();loadRuns();}catch(e){toast(e.message,1);}}

/* ---------- run control ---------- */
async function toggleRun(){
  try{if(S.phase==="running"){await api("/api/stop",{});toast("Pausing…");}
      else{await api("/api/start",{});toast("Started.");}
      await refresh();}catch(e){toast(e.message,1);}}
async function requeue(){
  try{const d=await api("/api/retry",{});
    toast(d.requeued?d.requeued+" put back in the queue — press Start.":"Nothing to retry.");
    await refresh();loadRuns();}catch(e){toast(e.message,1);}}
async function openReport(){try{const d=await api("/api/report");
  window.open(d.url,"_blank");}catch(e){toast(e.message,1);}}

/* ---------- render ---------- */
function paint(){
  const needSetup=!S.configured;
  $("setup").classList.toggle("hidden",!(needSetup||setupOpen));
  $("dash").classList.toggle("hidden",needSetup);
  $("setupcancel").classList.toggle("hidden",needSetup);
  if(needSetup||setupOpen)fillSetup();

  const running=S.phase==="running",stopping=S.phase==="stopping";
  $("dot").className="dot "+(running||stopping?"busy":(S.configured?"on":""));
  $("phase").textContent=running?"running":stopping?"pausing":
    (S.configured?"ready":"needs setup");
  $("hdone").textContent=(S.done||0).toLocaleString();
  $("htotal").textContent=(S.total||0).toLocaleString();
  const b=$("mainbtn");
  b.textContent=running?"Pause":stopping?"Pausing…":(S.done&&S.done===S.total?"All done":"Start");
  b.disabled=stopping||!S.total||(S.done===S.total&&!running);
  b.className=running?"big":"primary big";

  let sub="";
  if(S.message)sub=S.message;
  else if(running)sub=(S.rate_per_hour?S.rate_per_hour+" per hour · ":"")+
    (S.eta_seconds?"about "+dur(S.eta_seconds)+" remaining":"estimating…");
  else if(!S.total)sub="No repositories yet. Add some below to begin.";
  else if(S.done===S.total)sub="Every repository has finished. Open the full report to review.";
  else sub=(S.total-S.done).toLocaleString()+" waiting. Press Start when ready.";
  $("hsub").textContent=sub;

  const c=S.counts||{},tot=S.total||1;
  $("rail").innerHTML=ORDER.map(k=>c[k]?
    `<i style="width:${c[k]/tot*100}%;background:${COL[k]}" title="${NICE[k]}: ${c[k]}"></i>`:"").join("");
  $("legend").innerHTML=ORDER.filter(k=>c[k]).map(k=>
    `<span><span class="dot" style="background:${COL[k]}"></span> <b>${c[k].toLocaleString()}</b> ${NICE[k]}</span>`).join("");
  const sr=S.done?Math.round((S.succeeded||0)/S.done*100):0;
  $("kpis").innerHTML=[["Succeeded",(S.succeeded||0).toLocaleString(),"var(--ok)"],
    ["Failed",(S.failed||0).toLocaleString(),"var(--bad)"],
    ["Timed out",(S.timeout||0).toLocaleString(),"var(--warn)"],
    ["Success rate",S.done?sr+"%":"—"],["Average run",dur(S.avg_seconds)],
    ["Running for",dur(S.elapsed)]].map(([l,v,col])=>
    `<div class="kpi"><b style="color:${col||"var(--ink)"}">${v}</b><span>${l}</span></div>`).join("");
  $("slots").innerHTML=(S.active||[]).map(a=>
    `<div class="slot"><span class="dot busy"></span><b>${a.repo}</b>
     <span class="mono" style="color:var(--faint);font-size:12px">${(a.run_id||"").slice(0,8)}</span>
     <span class="st">${a.status} · ${dur(a.elapsed)}</span></div>`).join("");
  $("events").innerHTML=(S.events||[]).map(e=>
    `<div class="evt"><span>${e.ts}</span><span>${e.msg}</span></div>`).join("")
    ||`<div class="empty">Nothing yet.</div>`;
  $("chips").innerHTML=ORDER.filter(k=>c[k]).map(k=>
    `<button class="pill" onclick="setFilter('${k}')" aria-pressed="${filterState===k}">${NICE[k]} ${c[k]}</button>`).join(" ");
  $("foot").textContent="Results are saved in "+(S.state_dir||"")+
    " — safe to close this window, nothing is lost.";
}
function setFilter(k){filterState=filterState===k?"":k;loadRuns();paint();}
async function loadRuns(){
  const q=encodeURIComponent($("q").value||"");
  RUNS=await api(`/api/runs?q=${q}&state=${filterState}`);
  $("rows").innerHTML=RUNS.map(r=>`<tr>
    <td><b>${r.repo}</b>${r.branch?` <span style="color:var(--faint)">${r.branch}</span>`:""}
      ${r.error?`<span class="err">${esc(r.error)}</span>`:""}</td>
    <td class="${r.state}">${NICE[r.state]||r.state}</td>
    <td style="color:var(--dim)">${esc(r.api_status)}</td>
    <td class="mono" style="font-size:11.5px;color:var(--faint)">${r.run_id.slice(0,8)}</td>
    <td>${dur(r.duration)}</td>
    <td>${r.report?`<a href="/file/${r.report}" target="_blank">open</a>`:"—"}</td></tr>`).join("")
    ||`<div></div>`;
  if(!RUNS.length)$("rows").innerHTML=
    `<tr><td colspan="6" class="empty">No repositories match. Clear the search or the filter.</td></tr>`;
}
const esc=s=>String(s||"").replace(/[<>&]/g,c=>({"<":"&lt;",">":"&gt;","&":"&amp;"}[c]));
async function refresh(){try{S=await api("/api/state");paint();}catch(e){
  $("phase").textContent="lost connection to the app";}}
mode("list");refresh().then(loadRuns);
setInterval(refresh,2000);setInterval(loadRuns,6000);
</script></body></html>
"""


class Handler(http.server.BaseHTTPRequestHandler):
    ctl: Controller = None            # type: ignore[assignment]
    protocol_version = "HTTP/1.1"

    def log_message(self, *a: Any) -> None:
        return

    # -- helpers ---------------------------------------------------------
    def _send(self, code: int, body: bytes, ctype: str,
              extra: Optional[dict] = None) -> None:
        self.send_response(code)
        self.send_header("content-type", ctype)
        self.send_header("content-length", str(len(body)))
        self.send_header("cache-control", "no-store")
        for k, v in (extra or {}).items():
            self.send_header(k, v)
        self.end_headers()
        with contextlib.suppress(BrokenPipeError, ConnectionResetError):
            self.wfile.write(body)

    def _json(self, obj: Any, code: int = 200) -> None:
        self._send(code, json.dumps(obj, default=str).encode(),
                   "application/json")

    def _body(self) -> dict:
        n = int(self.headers.get("content-length") or 0)
        if not n:
            return {}
        try:
            return json.loads(self.rfile.read(n) or b"{}")
        except json.JSONDecodeError:
            return {}

    def _file(self, rel: str) -> None:
        root = self.ctl.cfg.state_dir.resolve()
        target = (root / unquote(rel)).resolve()
        if root not in target.parents and target != root:
            return self._json({"error": "not allowed"}, 403)
        if not target.is_file():
            return self._json({"error": "file not found"}, 404)
        ctype = ("text/html" if target.suffix == ".html"
                 else "application/json" if target.suffix == ".json"
                 else "text/plain")
        self._send(200, target.read_bytes(), ctype + "; charset=utf-8")

    # -- routes ----------------------------------------------------------
    def do_GET(self) -> None:
        u = urlparse(self.path)
        path = u.path
        try:
            if path in ("/", "/index.html"):
                return self._send(200, PAGE.encode(), "text/html; charset=utf-8")
            if path == "/api/state":
                return self._json(self.ctl.snapshot())
            if path == "/api/runs":
                qs = dict(x.split("=", 1) for x in u.query.split("&") if "=" in x)
                return self._json(self.ctl.runs(
                    unquote(qs.get("q", "")).replace("+", " "),
                    qs.get("state", "")))
            if path == "/api/report":
                p = write_html(self.ctl.cfg, self.ctl.store, live=False)
                rel = os.path.relpath(p, self.ctl.cfg.state_dir.resolve())
                return self._json({"url": "/file/" + rel.replace(os.sep, "/")})
            if path == "/export.csv":
                out = self.ctl.cfg.state_dir / "runs.csv"
                cmd_export(self.ctl.cfg, out, quiet=True)
                return self._send(200, out.read_bytes(), "text/csv",
                                  {"content-disposition":
                                   'attachment; filename="codemind_runs.csv"'})
            if path.startswith("/file/"):
                return self._file(path[len("/file/"):])
            if path == "/favicon.ico":
                return self._send(204, b"", "image/x-icon")
            return self._json({"error": "unknown page"}, 404)
        except Exception as exc:
            return self._json({"error": f"{type(exc).__name__}: {exc}"}, 500)

    def do_POST(self) -> None:
        path = urlparse(self.path).path
        body = self._body()
        try:
            if path == "/api/config":
                self.ctl.save_config(body)
                return self._json({"ok": True})
            if path == "/api/test":
                return self._json(probe_server(
                    build_config({**self.ctl.raw, **body})))
            if path == "/api/repos":
                return self._json(self.ctl.add_repos(
                    body.get("text", ""), bool(body.get("as_csv"))))
            if path == "/api/start":
                self.ctl.start()
                return self._json({"ok": True})
            if path == "/api/stop":
                self.ctl.stop()
                return self._json({"ok": True})
            if path == "/api/retry":
                if self.ctl.phase != "idle":
                    return self._json(
                        {"error": "Pause the batch before requeuing."}, 400)
                n = self.ctl.store.reset_states({FAILED, TIMEOUT, DEAD})
                return self._json({"requeued": n})
            return self._json({"error": "unknown action"}, 404)
        except (ValueError, SystemExit) as exc:
            return self._json({"error": str(exc)}, 400)
        except Exception as exc:
            return self._json({"error": f"{type(exc).__name__}: {exc}"}, 500)


class Server(socketserver.ThreadingTCPServer):
    daemon_threads = True
    allow_reuse_address = True


def free_port(preferred: int = 0) -> int:
    for cand in ([preferred] if preferred else []) + [8765, 8766, 8767, 0]:
        with contextlib.suppress(OSError):
            s = socket.socket()
            s.bind(("127.0.0.1", cand))
            port = s.getsockname()[1]
            s.close()
            return port
    return 8765


def write_launchers() -> None:
    """Create a double-clickable shortcut next to this file, once."""
    me = Path(sys.argv[0]).resolve()
    here = me.parent
    with contextlib.suppress(Exception):
        if platform.system() == "Windows":
            bat = here / "Start Batch Runner.bat"
            if not bat.exists():
                bat.write_text(
                    "@echo off\r\ntitle CodeMind Batch Runner\r\n"
                    'cd /d "%~dp0"\r\n'
                    f'python "{me.name}"\r\n'
                    "if errorlevel 1 pause\r\n")
        else:
            sh = here / "Start Batch Runner.command"
            if not sh.exists():
                sh.write_text('#!/bin/bash\ncd "$(dirname "$0")"\n'
                              f'python3 "{me.name}"\n')
                os.chmod(sh, 0o755)


def serve(port: int, open_browser: bool) -> int:
    ctl = Controller()
    Handler.ctl = ctl
    write_launchers()
    port = free_port(port)
    httpd = Server(("127.0.0.1", port), Handler)
    url = f"http://127.0.0.1:{port}/"

    print("\n  " + "─" * 52)
    print(f"  {APP} {VERSION}")
    print(f"  Dashboard:  {url}")
    print(f"  Results:    {ctl.cfg.state_dir.resolve()}")
    print("  Close this window to quit. Runs already started can be")
    print("  picked up again next time you open it.")
    print("  " + "─" * 52 + "\n")

    def launch() -> None:
        with contextlib.suppress(Exception):
            webbrowser.open(url)

    if open_browser:
        threading.Timer(0.8, launch).start()
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        print("\n  Shutting down…")
        ctl.stop()
        for _ in range(40):
            if ctl.phase == "idle":
                break
            time.sleep(0.25)
    finally:
        httpd.server_close()
        ctl.store.close()
    return 0


# ==========================================================================
# headless mode (servers, OCP jobs) and the demo self test
# ==========================================================================


def run_headless() -> int:
    ctl = Controller()
    if not ctl.configured:
        raise SystemExit(f"{config_path()} is missing base_url or playbooks.")
    if ctl.cfg.input_path is None and ctl.raw.get("input"):
        ctl.cfg.input_path = Path(ctl.raw["input"])
    if ctl.cfg.input_path and ctl.cfg.input_path.exists():
        ctl.store.enqueue(load_tasks(ctl.cfg))
    rows = ctl.store.actionable()
    print(f"{len(rows)} repositories to process")
    if not rows:
        return 0
    ctl.start()
    try:
        while ctl.phase != "idle":
            time.sleep(2)
    except KeyboardInterrupt:
        ctl.stop()
        while ctl.phase != "idle":
            time.sleep(0.5)
    counts = ctl.store.counts()
    print(" ".join(f"{k.lower()}={v}" for k, v in sorted(counts.items())))
    print(f"report: {write_html(ctl.cfg, ctl.store)}")
    return 0


def start_mock_server() -> str:
    runs: dict[str, dict] = {}

    class M(http.server.BaseHTTPRequestHandler):
        protocol_version = "HTTP/1.1"

        def log_message(self, *a): pass

        def _s(self, code: int, body: dict) -> None:
            raw = json.dumps(body).encode()
            self.send_response(code)
            self.send_header("content-type", "application/json")
            self.send_header("content-length", str(len(raw)))
            self.end_headers()
            self.wfile.write(raw)

        def do_POST(self):
            n = int(self.headers.get("content-length", 0))
            body = json.loads(self.rfile.read(n) or b"{}")
            if random.random() < 0.15:
                return self._s(503, {"detail": "busy"})
            rid = str(uuid.uuid4())
            runs[rid] = {"n": 0, "repo": body.get("repo_url", "")}
            self._s(200, {"run_id": rid, "status": "queued"})

        def do_GET(self):
            if self.path.startswith("/openapi.json"):
                return self._s(200, {"paths": {SUBMIT_PATH: {}}})
            rid = self.path.rstrip("/").rsplit("/", 1)[-1]
            r = runs.get(rid)
            if not r:
                return self._s(404, {"detail": "not found"})
            r["n"] += 1
            if r["n"] < 2:
                return self._s(200, {"run_id": rid, "status": "running"})
            bad = random.random() < 0.2
            self._s(200, {"run_id": rid,
                          "status": "failed" if bad else "completed",
                          "error": "playbook assertion failed" if bad else None,
                          "report": {"findings": random.randint(0, 9),
                                     "repo": r["repo"]}})

    srv = Server(("127.0.0.1", 0), M)
    threading.Thread(target=srv.serve_forever, daemon=True).start()
    return f"http://127.0.0.1:{srv.server_address[1]}"


def run_demo(headless: bool, port: int, browser: bool = True) -> int:
    import tempfile
    base = start_mock_server()
    work = Path(tempfile.mkdtemp(prefix="codemind_demo_"))
    os.chdir(work)
    config_path().write_text(json.dumps({
        "base_url": base, "playbooks": ["demo_playbook"],
        "goal": "generate report", "branch": "main", "insecure": True,
        "concurrency": 2, "max_wall_minutes": 2, "poll_interval": 0.5,
        "first_poll_delay": 0.5, "state": "./cm_state",
        "input": "repos.csv"}, indent=2))
    Path("repos.csv").write_text(
        "repo_url,branch\n" + "\n".join(
            f"https://github.com/example/service-{i:02d},main"
            for i in range(1, 13)))
    print(f"Demo workspace: {work}\nMock server: {base}")
    return run_headless() if headless else serve(port, browser)


def main(argv: Optional[list[str]] = None) -> int:
    ap = argparse.ArgumentParser(
        prog="codemind_batch",
        description="CodeMind Batch Runner — opens a dashboard in your browser.")
    ap.add_argument("--headless", action="store_true",
                    help="no browser; run straight from codemind.json")
    ap.add_argument("--port", type=int, default=0, help="dashboard port")
    ap.add_argument("--no-browser", action="store_true")
    ap.add_argument("--demo", action="store_true",
                    help="self test against a built-in mock server")
    ap.add_argument("--version", action="version", version=f"{APP} {VERSION}")
    a = ap.parse_args(argv)

    if a.demo:
        return run_demo(a.headless, a.port, not a.no_browser)
    if a.headless:
        return run_headless()
    return serve(a.port, not a.no_browser)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)

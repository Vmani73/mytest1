CSV_ALIASES = {
    "repo_url": {"repo_url", "repo", "url", "repository", "repo_link", "git_url"},
    "branch": {"branch", "repo_branch", "ref"},
    "cd_repo_url": {"cd_repo_url", "cd_repo", "ci_repo_url", "ci_repo", "cd_url"},
    "cd_branch": {"cd_branch", "ci_branch"},
    "playbooks": {"playbooks", "playbook_names", "playbook", "skills"},
    "goal": {"goal", "objective"},
    "repo_path": {"repo_path", "path", "module_path"},
    "user_id": {"user_id", "user", "sso", "requester"},
    "mirror_mode": {"mirror_mode", "mirror"},
}


def _canon(header: str) -> Optional[str]:
    h = header.strip().lower().replace(" ", "_").lstrip("\ufeff")
    for canon, names in CSV_ALIASES.items():
        if h in names:
            return canon
    return None


def _split_list(v: str) -> list[str]:
    return [p.strip() for p in v.replace("|", ";").replace(",", ";").split(";")
            if p.strip()]


def parse_rows(text: str, as_csv: bool) -> list[dict[str, str]]:
    """Accept a pasted list, a CSV with headers, or a headerless CSV."""
    rows: list[dict[str, str]] = []
    text = text.lstrip("\ufeff")
    if as_csv:
        delim = "\t" if text.count("\t") > text.count(",") else ","
        lines = list(csv.reader(io.StringIO(text), delimiter=delim))
        if not lines:
            return rows
        canon = [_canon(h) for h in lines[0]]
        if "repo_url" in canon:
            for parts in lines[1:]:
                if not parts or not any(x.strip() for x in parts):
                    continue
                row = {c: v.strip() for c, v in zip(canon, parts) if c}
                if row.get("repo_url"):
                    rows.append(row)
            return rows
    for line in text.splitlines():
        line = line.strip().strip(",")
        if not line or line.startswith("#"):
            continue
        parts = [x.strip() for x in line.replace("\t", ",").split(",")]
        if not parts[0] or _canon(parts[0]) == "repo_url":
            continue
        rows.append({"repo_url": parts[0],
                     "branch": parts[1] if len(parts) > 1 else "",
                     "cd_repo_url": parts[2] if len(parts) > 2 else "",
                     "cd_branch": parts[3] if len(parts) > 3 else ""})
    return rows


def rows_to_tasks(rows: list[dict[str, str]], cfg: Config) -> list[Task]:
    tasks: list[Task] = []
    for r in rows:
        url = r.get("repo_url", "").strip()
        if not url:
            continue
        pb = _split_list(r.get("playbooks", "")) or list(cfg.playbooks)
        if not pb:
            raise ValueError("No playbook chosen. Add one in Setup.")
        if len(pb) > 2:
            raise ValueError(f"At most 2 playbooks per run — {url} has {len(pb)}.")
        mm = r.get("mirror_mode", "")
        tasks.append(Task(
            repo_url=url,
            branch=r.get("branch") or cfg.branch,
            playbooks=pb,
            goal=r.get("goal") or cfg.goal,
            cd_repo_url=r.get("cd_repo_url") or cfg.cd_repo_url,
            cd_branch=r.get("cd_branch") or cfg.cd_branch,
            repo_path=r.get("repo_path") or cfg.repo_path,
            user_id=r.get("user_id") or cfg.user_id,
            mirror_mode=(mm.lower() in {"1", "true", "yes"}) if mm
            else cfg.mirror_mode,
        ))

    seen: set[str] = set()
    out: list[Task] = []
    for t in tasks:
        if t.key in seen:
            continue
        seen.add(t.key)
        if cfg.shards > 1:
            bucket = int(hashlib.md5(t.key.encode()).hexdigest(), 16) % cfg.shards
            if bucket != cfg.shard:
                continue
        out.append(t)
    return out


def load_tasks(cfg: Config) -> list[Task]:
    path = cfg.input_path
    assert path is not None
    if not path.exists():
        raise ValueError(f"Repository list not found: {path}")
    text = path.read_text(encoding="utf-8-sig")
    return rows_to_tasks(
        parse_rows(text, path.suffix.lower() in {".csv", ".tsv"}), cfg)



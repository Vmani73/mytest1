# the worker
# ==========================================================================


class Runner:
    def __init__(self, cfg: Config, store: Store, log):
        self.cfg = cfg
        self.store = store
        self.log = log
        self.stop = asyncio.Event()
        self.breaker = CircuitBreaker(cfg.breaker_threshold, cfg.breaker_cooldown)
        self.api = ApiClient(cfg, self.breaker, self.stop, log)
        self.success_states = SUCCESS_STATES | cfg.include_states  # placeholder
        self.stats: Optional[Stats] = None

    # -- lifecycle -------------------------------------------------------
    async def run(self, rows: list[sqlite3.Row], already_done: int) -> None:
        self.stats = Stats(len(rows), already_done)
        self._queued = {r["key"] for r in rows}
        self._refill_lock = asyncio.Lock()
        queue: asyncio.Queue = asyncio.Queue()
        for r in rows:
            queue.put_nowait(r)

        workers = [asyncio.create_task(self._worker(i + 1, queue))
                   for i in range(self.cfg.concurrency)]
        snap = asyncio.create_task(self._snapshotter())
        try:
            await asyncio.gather(*workers)
        finally:
            self.stop.set()
            snap.cancel()
            with contextlib.suppress(asyncio.CancelledError):
                await snap
            await self.api.aclose()

    async def _snapshotter(self) -> None:
        while not self.stop.is_set():
            await interruptible_sleep(self.cfg.snapshot_every, self.stop)
            with contextlib.suppress(Exception):
                write_html(self.cfg, self.store, live=True)

    async def _worker(self, wid: int, queue: asyncio.Queue) -> None:
        while not self.stop.is_set():
            try:
                row = queue.get_nowait()
            except asyncio.QueueEmpty:
                if await self._refill(queue):     # repos added while running
                    continue
                return
            try:
                await self._process(row)
            except Exception as exc:                      # never kill a worker
                self.log(f"worker{wid} unexpected: {type(exc).__name__}: {exc}")
                self.store.update(row["key"], state=FAILED,
                                  error=f"runner:{type(exc).__name__}: {exc}"[:900])
                self._finish(row, FAILED)
            finally:
                queue.task_done()

    async def _refill(self, queue: asyncio.Queue) -> int:
        async with self._refill_lock:
            added = 0
            for r in self.store.actionable():
                if r["key"] in self._queued:
                    continue
                self._queued.add(r["key"])
                queue.put_nowait(r)
                added += 1
            if added and self.stats:
                self.stats.total += added
            return added

    # -- one task --------------------------------------------------------
    async def _process(self, row: sqlite3.Row) -> None:
        cfg, st = self.cfg, self.stats
        assert st is not None
        key = row["key"]
        task = row_to_task(row)
        live = Live_Run(key, task.short, row["run_id"] or "", now_ts())
        st.active[key] = live

        try:
            run_id = row["run_id"]
            submitted_at = row["submitted_at"]
            attempt = row["attempt"] or 0

            # ---- resume path: a run_id already exists, re-attach ----
            if row["state"] == RUNNING and run_id:
                st.resumed += 1
                live.run_id, live.status = run_id, "re-attached"
                st.note("info", task.short, f"re-attached to {run_id[:8]}")
                self.store.event(key, "INFO", f"resume poll run_id={run_id}")
            else:
                # ---- submit with whole-task retry ----
                while True:
                    attempt += 1
                    live.status = f"submit#{attempt}"
                    self.store.update(key, state=RUNNING, attempt=attempt)
                    try:
                        run_id, raw = await self.api.submit(task)
                        submitted_at = now_ts()
                        self.store.update(key, run_id=run_id,
                                          submitted_at=submitted_at,
                                          error=None)
                        self.store.event(key, "INFO", f"submitted run_id={run_id}")
                        live.run_id = run_id
                        break
                    except PermanentError as exc:
                        self.store.update(key, state=DEAD, error=str(exc)[:900],
                                          finished_at=now_ts())
                        self.store.event(key, "ERROR", f"submit rejected: {exc}")
                        st.note("dead", task.short, str(exc)[:80])
                        self._finish(row, DEAD)
                        return
                    except TransientError as exc:
                        if self.stop.is_set():
                            self.store.update(key, state=PENDING)
                            return
                        if attempt > cfg.max_submit_retries:
                            self.store.update(key, state=FAILED,
                                              error=f"submit: {exc}"[:900],
                                              finished_at=now_ts())
                            self.store.event(key, "ERROR", f"submit gave up: {exc}")
                            st.note("fail", task.short, "submit exhausted")
                            self._finish(row, FAILED)
                            return
                        await interruptible_sleep(
                            min(cfg.backoff_cap, cfg.backoff_base ** attempt) *
                            (0.5 + random.random()), self.stop)

            # ---- poll ----
            deadline = (submitted_at or now_ts()) + cfg.max_wall
            first = True
            polls = row["polls"] or 0
            misses = 0
            last_payload: dict = {}

            while not self.stop.is_set():
                wait = cfg.first_poll_delay if first else cfg.poll_interval
                first = False
                remaining = deadline - now_ts()
                if remaining <= 0:
                    break
                await interruptible_sleep(
                    min(wait * (0.85 + 0.3 * random.random()), remaining),
                    self.stop)
                if self.stop.is_set():
                    break

                try:
                    last_payload = await self.api.get_run(str(run_id))
                    misses = 0
                except PermanentError as exc:
                    misses += 1
                    if "404" in str(exc) and misses <= cfg.poll_404_grace:
                        self.store.event(key, "WARN", f"poll 404 x{misses}")
                        continue
                    self.store.update(key, state=FAILED,
                                      error=f"poll: {exc}"[:900],
                                      finished_at=now_ts())
                    self.store.event(key, "ERROR", f"poll permanent: {exc}")
                    st.note("fail", task.short, str(exc)[:80])
                    self._finish(row, FAILED)
                    return
                except TransientError as exc:
                    self.store.event(key, "WARN", f"poll transient: {exc}")
                    continue

                polls += 1
                live.polls = polls
                bucket, raw = classify(last_payload, SUCCESS_STATES, FAILURE_STATES)
                live.status = raw or bucket
                self.store.update(key, polls=polls, api_status=raw)

                if bucket in (SUCCEEDED, FAILED):
                    dur = now_ts() - (submitted_at or now_ts())
                    path = self._write_report(key, task, str(run_id), bucket,
                                              raw, last_payload, dur, polls)
                    err = None
                    if bucket == FAILED:
                        err = (deep_find(last_payload, ("error", "message",
                                                        "detail", "reason"))
                               or raw)[:900]
                    self.store.update(key, state=bucket, api_status=raw,
                                      finished_at=now_ts(), duration_s=dur,
                                      report_path=str(path), error=err)
                    self.store.event(key, "INFO",
                                     f"{bucket} status={raw} in {human_dt(dur)}")
                    st.note("ok" if bucket == SUCCEEDED else "fail",
                            task.short, f"{raw} · {human_dt(dur)}")
                    self._finish(row, bucket)
                    return

                if bucket == "?" and raw:
                    self.store.event(key, "WARN", f"unknown status '{raw}'")

            if self.stop.is_set():
                # leave state=RUNNING + run_id persisted -> resumed next start
                self.store.event(key, "INFO", "interrupted, will resume")
                return

            # ---- deadline ----
            dur = now_ts() - (submitted_at or now_ts())
            path = self._write_report(key, task, str(run_id), TIMEOUT,
                                      live.status, last_payload, dur, polls)
            self.store.update(key, state=TIMEOUT, finished_at=now_ts(),
                              duration_s=dur, report_path=str(path),
                              error=f"no terminal status within "
                                    f"{int(cfg.max_wall)}s (last={live.status})")
            self.store.event(key, "WARN", f"timeout after {human_dt(dur)}")
            st.note("timeout", task.short, f"30m deadline, last={live.status}")
            self._finish(row, TIMEOUT)
        finally:
            self.stats.active.pop(key, None)  # type: ignore[union-attr]

    def _finish(self, row: sqlite3.Row, state: str) -> None:
        st = self.stats
        assert st is not None
        st.done += 1
        if state == SUCCEEDED:
            st.succeeded += 1
        elif state == FAILED:
            st.failed += 1
        elif state == TIMEOUT:
            st.timeout += 1
        elif state == DEAD:
            st.dead += 1

    def _write_report(self, key: str, task: Task, run_id: str, state: str,
                      raw_status: str, payload: dict, dur: float,
                      polls: int) -> Path:
        day = datetime.now(timezone.utc).strftime("%Y-%m-%d")
        d = self.cfg.reports_dir / day
        d.mkdir(parents=True, exist_ok=True)
        safe = "".join(c if c.isalnum() or c in "-._" else "_" for c in task.short)
        path = d / f"{safe}__{run_id[:12]}.json"
        doc = {
            "task_key": key,
            "repo_url": task.repo_url,
            "branch": task.branch,
            "playbooks": task.playbooks,
            "goal": task.goal,
            "cd_repo_url": task.cd_repo_url or None,
            "cd_branch": task.cd_branch or None,
            "run_id": run_id,
            "outcome": state,
            "api_status": raw_status,
            "duration_seconds": round(dur, 1),
            "polls": polls,
            "collected_at": utcnow(),
            "response": payload,
        }
        path.write_text(json.dumps(doc, indent=2, default=str))
        return path



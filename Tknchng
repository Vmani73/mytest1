import { TypeScriptExtractor } from './languages/typescript'
import { PythonExtractor } from './languages/python'
import { GoExtractor } from './languages/go'
import { RustExtractor } from './languages/rust'
import { JavaExtractor } from './languages/java'
// ... other extractors

const DEFAULT_EXCLUDE = [
  'node_modules/**', 'vendor/**', 'dist/**', 'build/**',
  'target/**', '.venv/**', 'Pods/**', '.next/**', '.git/**',
  '**/*.min.js', '**/*.min.css', '**/*.map', '**/*.d.ts'
]

const LANG_MAP: Record<string, string> = {
  '.ts': 'typescript', '.tsx': 'typescript', '.js': 'javascript',
  '.jsx': 'javascript', '.mjs': 'javascript', '.py': 'python',
  '.go': 'go', '.rs': 'rust', '.java': 'java', '.cs': 'csharp',
  '.cpp': 'cpp', '.cc': 'cpp', '.hpp': 'cpp', '.c': 'c', '.h': 'c',
  '.swift': 'swift', '.kt': 'kotlin', '.kts': 'kotlin',
  '.php': 'php', '.rb': 'ruby', '.dart': 'dart', '.svelte': 'svelte'
}

export class ExtractionOrchestrator {
  private extractors: Map<string, BaseExtractor>

  constructor(
    private db: DatabaseConnection,
    private grammarDir: string,
    private workspaceRoot: string
  ) {
    this.extractors = new Map([
      ['typescript', new TypeScriptExtractor(grammarDir)],
      ['javascript', new TypeScriptExtractor(grammarDir)],
      ['python', new PythonExtractor(grammarDir)],
      ['go', new GoExtractor(grammarDir)],
      ['rust', new RustExtractor(grammarDir)],
      ['java', new JavaExtractor(grammarDir)],
      // ... others
    ])
  }

  async indexAll(
    onProgress?: (p: IndexProgress) => void,
    force = false
  ): Promise<void> {
    onProgress?.({ phase: 'scanning', current: 0, total: 0 })

    const files = await this.collectSourceFiles()
    const total = files.length

    onProgress?.({ phase: 'extracting', current: 0, total })

    const allProvisionalEdges: ProvisionalEdge[] = []

    for (let i = 0; i < files.length; i++) {
      const filePath = files[i]
      onProgress?.({ phase: 'extracting', current: i + 1, total, currentFile: filePath })

      try {
        await this.indexFile(filePath, force, allProvisionalEdges)
      } catch (err) {
        console.error(`CodeGraph: failed to index ${filePath}`, err)
      }
    }

    onProgress?.({ phase: 'resolving', current: 0, total: allProvisionalEdges.length })

    const resolver = new ReferenceResolver(this.db, this.workspaceRoot)
    resolver.resolve(allProvisionalEdges, (i) => {
      onProgress?.({ phase: 'resolving', current: i, total: allProvisionalEdges.length })
    })

    this.db.setMeta('last_indexed', Date.now().toString())
    onProgress?.({ phase: 'done', current: total, total })
  }

  async indexFile(
    filePath: string,
    force = false,
    provisionalEdges?: ProvisionalEdge[]
  ): Promise<void> {
    const content = fs.readFileSync(filePath, 'utf8')
    const hash = crypto.createHash('sha256').update(content).digest('hex')
    const ext = path.extname(filePath).toLowerCase()
    const lang = LANG_MAP[ext]
    if (!lang) return

    const extractor = this.extractors.get(lang)
    if (!extractor) return

    const existingHash = this.db.getFileHash(filePath)
    if (!force && existingHash === hash) return  // unchanged

    const fileId = crypto.createHash('sha256').update(filePath).digest('hex')
    const relPath = path.relative(this.workspaceRoot, filePath)

    const file: GraphFile = {
      id: fileId,
      path: filePath,
      relPath,
      lang,
      hash,
      size: Buffer.byteLength(content, 'utf8'),
      indexedAt: Date.now()
    }

    // Remove old data for this file
    this.db.deleteFile(fileId)

    // Extract
    const { nodes, edges } = await extractor.extract(file, content)

    // Create file node first
    const fileNode: GraphNode = {
      id: fileId + ':file',
      fileId,
      kind: 'file',
      name: path.basename(filePath),
      fqn: relPath,
      startLine: 1,
      endLine: content.split('\n').length,
      startCol: 0,
      endCol: 0,
      signature: null,
      docstring: null,
      source: null
    }

    this.db.transaction(() => {
      this.db.upsertFile(file)
      this.db.insertNodes([fileNode, ...nodes])
      // Insert only resolved edges now; collect unresolved as provisional
      const resolvedEdges = edges.filter(e => e.resolved)
      const unresolved = edges.filter(e => !e.resolved)
      this.db.insertEdges(resolvedEdges)
      if (provisionalEdges) {
        provisionalEdges.push(...unresolved.map(e => ({ ...e, fileId })))
      }
    })
  }

  private async collectSourceFiles(): Promise<string[]> {
    const config = this.db.getMeta('config')
    const cfg = config ? JSON.parse(config) : {}
    const excludeGlobs: string[] = [...DEFAULT_EXCLUDE, ...(cfg.exclude ?? [])]

    const results: string[] = []
    const walk = (dir: string) => {
      const entries = fs.readdirSync(dir, { withFileTypes: true })
      for (const entry of entries) {
        const fullPath = path.join(dir, entry.name)
        const relPath = path.relative(this.workspaceRoot, fullPath)
        const excluded = excludeGlobs.some(g => minimatch(relPath, g, { dot: true }))
        if (excluded) continue
        if (entry.isDirectory()) { walk(fullPath); continue }
        const ext = path.extname(entry.name).toLowerCase()
        if (LANG_MAP[ext]) results.push(fullPath)
      }
    }
    walk(this.workspaceRoot)
    return results
  }
}

Implement TypeScript/JavaScript/TSX/JSX extractor. Use `web-tree-sitter` WASM.

```typescript
import Parser from 'web-tree-sitter'
import * as path from 'path'
import * as fs from 'fs'
import { BaseExtractor, ExtractResult } from '../base-extractor'
import type { GraphFile, GraphNode, GraphEdge } from '../../types'

export class TypeScriptExtractor extends BaseExtractor {
  private initialized = false

  async init() {
    if (this.initialized) return
    await Parser.init({ locateFile: () => path.join(this.grammarDir, 'tree-sitter.wasm') })
    const lang = await Parser.Language.load(path.join(this.grammarDir, 'tree-sitter-typescript.wasm'))
    this.parser = new Parser()
    this.parser.setLanguage(lang)
    this.initialized = true
  }

  async extract(file: GraphFile, content: string): Promise<ExtractResult> {
    await this.init()
    const tree = this.parser.parse(content)
    const nodes: GraphNode[] = []
    const edges: GraphEdge[] = []

    this.walk(tree.rootNode, file, content, nodes, edges, null)

    return { nodes, edges }
  }

  private walk(
    node: Parser.SyntaxNode,
    file: GraphFile,
    content: string,
    nodes: GraphNode[],
    edges: GraphEdge[],
    parentNodeId: string | null
  ) {
    switch (node.type) {
      case 'class_declaration':
      case 'abstract_class_declaration': {
        const nameNode = node.childForFieldName('name')
        if (!nameNode) break
        const name = nameNode.text
        const id = this.nodeId(file.id, 'class', name, node.startPosition.row + 1)
        const gNode: GraphNode = {
          id,
          fileId: file.id,
          kind: 'class',
          name,
          fqn: null,  // resolved later from imports
          startLine: node.startPosition.row + 1,
          endLine: node.endPosition.row + 1,
          startCol: node.startPosition.column,
          endCol: node.endPosition.column,
          signature: `class ${name}`,
          docstring: this.extractJSDoc(node, content),
          source: null
        }
        nodes.push(gNode)

        // extends
        const heritageNode = node.childForFieldName('type_parameters') ?? node.children.find(c => c.type === 'class_heritage')
        // Walk extends_clause / implements_clause
        for (const child of node.children) {
          if (child.type === 'extends_clause') {
            const baseNameNode = child.children.find(c => c.type === 'identifier')
            if (baseNameNode) {
              edges.push({
                id: this.nodeId(file.id, 'edge:extends', id + baseNameNode.text, node.startPosition.row),
                fromId: id,
                toId: null,
                toName: baseNameNode.text,
                kind: 'extends',
                resolved: false,
                callSiteLine: null
              })
            }
          }
          if (child.type === 'implements_clause') {
            for (const impl of child.children.filter(c => c.type === 'type_identifier')) {
              edges.push({
                id: this.nodeId(file.id, 'edge:implements', id + impl.text, node.startPosition.row),
                fromId: id,
                toId: null,
                toName: impl.text,
                kind: 'implements',
                resolved: false,
                callSiteLine: null
              })
            }
          }
        }

        if (parentNodeId) {
          edges.push({ id: `${parentNodeId}:contains:${id}`, fromId: parentNodeId, toId: id, toName: null, kind: 'contains', resolved: true, callSiteLine: null })
        }

        // Recurse into class body
        for (const child of node.children) this.walk(child, file, content, nodes, edges, id)
        return
      }

      case 'function_declaration':
      case 'function': {
        const nameNode = node.childForFieldName('name')
        if (!nameNode) break
        const name = nameNode.text
        const id = this.nodeId(file.id, 'function', name, node.startPosition.row + 1)
        const params = this.extractParams(node)
        nodes.push({
          id, fileId: file.id, kind: 'function', name, fqn: null,
          startLine: node.startPosition.row + 1, endLine: node.endPosition.row + 1,
          startCol: node.startPosition.column, endCol: node.endPosition.column,
          signature: `function ${name}(${params})`,
          docstring: this.extractJSDoc(node, content),
          source: content.slice(node.startIndex, node.endIndex)
        })
        if (parentNodeId) edges.push({ id: `${parentNodeId}:contains:${id}`, fromId: parentNodeId, toId: id, toName: null, kind: 'contains', resolved: true, callSiteLine: null })
        for (const child of node.children) this.walk(child, file, content, nodes, edges, id)
        return
      }

      case 'method_definition': {
        const nameNode = node.childForFieldName('name')
        if (!nameNode) break
        const name = nameNode.text
        const id = this.nodeId(file.id, 'method', (parentNodeId ?? '') + ':' + name, node.startPosition.row + 1)
        const params = this.extractParams(node)
        nodes.push({
          id, fileId: file.id, kind: 'method', name, fqn: null,
          startLine: node.startPosition.row + 1, endLine: node.endPosition.row + 1,
          startCol: node.startPosition.column, endCol: node.endPosition.column,
          signature: `${name}(${params})`,
          docstring: this.extractJSDoc(node, content), source: null
        })
        if (parentNodeId) edges.push({ id: `${parentNodeId}:contains:${id}`, fromId: parentNodeId, toId: id, toName: null, kind: 'contains', resolved: true, callSiteLine: null })
        for (const child of node.children) this.walk(child, file, content, nodes, edges, id)
        return
      }

      case 'call_expression': {
        // Record a provisional call edge from the enclosing function/method
        if (parentNodeId) {
          const calleeNameNode = node.childForFieldName('function')
          if (calleeNameNode) {
            const calleeName = calleeNameNode.type === 'member_expression'
              ? calleeNameNode.childForFieldName('property')?.text ?? calleeNameNode.text
              : calleeNameNode.text
            edges.push({
              id: this.nodeId(file.id, 'edge:calls', parentNodeId + calleeName + node.startPosition.row, node.startPosition.row),
              fromId: parentNodeId, toId: null, toName: calleeName,
              kind: 'calls', resolved: false,
              callSiteLine: node.startPosition.row + 1
            })
          }
        }
        break
      }

      case 'import_statement': {
        // import { Foo } from './foo'
        const sourceNode = node.childForFieldName('source')
        if (sourceNode) {
          const importPath = sourceNode.text.replace(/['"]/g, '')
          edges.push({
            id: this.nodeId(file.id, 'edge:imports', importPath, node.startPosition.row),
            fromId: file.id + ':file',
            toId: null, toName: importPath,
            kind: 'imports', resolved: false,
            callSiteLine: node.startPosition.row + 1
          })
        }
        break
      }
    }

    for (const child of node.children) {
      this.walk(child, file, content, nodes, edges, parentNodeId)
    }
  }

  private extractJSDoc(node: Parser.SyntaxNode, content: string): string | null {
    const prevSibling = node.previousNamedSibling
    if (prevSibling?.type === 'comment' && prevSibling.text.startsWith('/**')) {
      return prevSibling.text
        .replace(/^\/\*\*|\*\/$/g, '').replace(/^\s*\* ?/gm, '').trim()
    }
    return null
  }

  private extractParams(node: Parser.SyntaxNode): string {
    const paramsNode = node.childForFieldName('parameters')
    if (!paramsNode) return ''
    return paramsNode.children
      .filter(c => c.type === 'required_parameter' || c.type === 'optional_parameter')
      .map(c => c.text)
      .join(', ')
  }
}

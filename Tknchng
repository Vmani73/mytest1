### `src/resolution/resolver.ts`

```typescript
import type { DatabaseConnection } from '../db/connection'
import type { GraphEdge } from '../types'
import * as path from 'path'
import * as fs from 'fs'

export interface ProvisionalEdge extends GraphEdge {
  fileId: string
}

export class ReferenceResolver {
  constructor(
    private db: DatabaseConnection,
    private workspaceRoot: string
  ) {}

  resolve(provisionalEdges: ProvisionalEdge[], onProgress?: (i: number) => void): void {
    for (let i = 0; i < provisionalEdges.length; i++) {
      const edge = provisionalEdges[i]
      onProgress?.(i)

      if (edge.kind === 'imports') {
        this.resolveImport(edge)
      } else if (edge.kind === 'calls') {
        this.resolveCall(edge)
      } else if (edge.kind === 'extends' || edge.kind === 'implements') {
        this.resolveTypeRef(edge)
      }
    }
  }

  private resolveImport(edge: ProvisionalEdge): void {
    if (!edge.toName) return
    const sourceFile = this.db.getFileById(edge.fileId)
    if (!sourceFile) return

    // Resolve relative imports
    let resolved: string | null = null
    if (edge.toName.startsWith('.')) {
      const dir = path.dirname(sourceFile.path)
      const candidates = [
        path.resolve(dir, edge.toName),
        path.resolve(dir, edge.toName + '.ts'),
        path.resolve(dir, edge.toName + '.tsx'),
        path.resolve(dir, edge.toName + '/index.ts'),
        path.resolve(dir, edge.toName + '.js'),
        path.resolve(dir, edge.toName + '/index.js'),
      ]
      resolved = candidates.find(c => fs.existsSync(c)) ?? null
    }

    if (resolved) {
      const targetFile = this.db.getFileByPath(resolved)
      if (targetFile) {
        this.db.updateEdgeResolution(edge.id, targetFile.id + ':file')
      }
    }
  }

  private resolveCall(edge: ProvisionalEdge): void {
    if (!edge.toName) return
    // Exact name match
    const target = this.db.resolveByName(edge.toName)
    if (target) this.db.updateEdgeResolution(edge.id, target.id)
  }

  private resolveTypeRef(edge: ProvisionalEdge): void {
    if (!edge.toName) return
    const target = this.db.resolveByName(edge.toName)
    if (target) this.db.updateEdgeResolution(edge.id, target.id)
  }
}

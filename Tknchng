import * as vscode from 'vscode'
import type { DatabaseConnection } from '../db/connection'

export class HoverProvider implements vscode.HoverProvider {
  constructor(private db: DatabaseConnection) {}

  provideHover(document: vscode.TextDocument, position: vscode.Position): vscode.Hover | null {
    const file = this.db.getFileByPath(document.uri.fsPath)
    if (!file) return null

    const nodes = this.db.getNodesByFile(file.id)
    const node = nodes.find(n =>
      position.line + 1 >= n.startLine &&
      position.line + 1 <= n.endLine
    )
    if (!node) return null

    const callers = this.db.getCallers(node.id, 1)
    const callees = this.db.getCallees(node.id, 1)

    const md = new vscode.MarkdownString()
    md.isTrusted = true
    md.appendMarkdown(`**CodeGraph** — \`${node.kind}\` \`${node.name}\`\n\n`)
    if (node.docstring) md.appendMarkdown(`${node.docstring}\n\n`)
    if (node.signature) md.appendCodeblock(node.signature, 'typescript')
    if (callers.length) md.appendMarkdown(`\n**Callers (${callers.length}):** ${callers.map(c => `\`${c.name}\``).join(', ')}\n`)
    if (callees.length) md.appendMarkdown(`\n**Calls (${callees.length}):** ${callees.map(c => `\`${c.name}\``).join(', ')}\n`)

    return new vscode.Hover(md)
  }
}

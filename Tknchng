```typescript
import * as vscode from 'vscode'
import type { DatabaseConnection } from '../db/connection'
import type { ExtractionOrchestrator } from '../extraction/orchestrator'
import { ContextBuilder } from '../graph/context'

export function registerCommands(
  context: vscode.ExtensionContext,
  db: DatabaseConnection,
  orchestrator: ExtractionOrchestrator
) {
  // codegraph.index — full index with progress notification
  context.subscriptions.push(
    vscode.commands.registerCommand('codegraph.index', async () => {
      await vscode.window.withProgress(
        { location: vscode.ProgressLocation.Notification, title: 'CodeGraph: Indexing...', cancellable: false },
        async (progress) => {
          await orchestrator.indexAll((p) => {
            progress.report({ message: `${p.phase} ${p.current}/${p.total}${p.currentFile ? ': ' + p.currentFile : ''}` })
          })
        }
      )
      vscode.window.showInformationMessage(`CodeGraph: Indexed. ${db.getStats().nodeCount} symbols.`)
    })
  )

  // codegraph.search — quick pick over all symbols
  context.subscriptions.push(
    vscode.commands.registerCommand('codegraph.search', async () => {
      const query = await vscode.window.showInputBox({ prompt: 'Search symbols (CodeGraph)', placeHolder: 'e.g. UserService' })
      if (!query) return
      const results = db.searchNodes(query, undefined, 30)
      const items = results.map(n => ({
        label: `$(symbol-${n.kind}) ${n.name}`,
        description: `${n.kind} — ${n.fqn ?? ''}`,
        detail: db.getFileById(n.fileId)?.relPath,
        node: n
      }))
      const picked = await vscode.window.showQuickPick(items, { matchOnDescription: true, matchOnDetail: true })
      if (picked) {
        const file = db.getFileById(picked.node.fileId)
        if (file) {
          const uri = vscode.Uri.file(file.path)
          const doc = await vscode.workspace.openTextDocument(uri)
          await vscode.window.showTextDocument(doc, {
            selection: new vscode.Range(picked.node.startLine - 1, 0, picked.node.startLine - 1, 0)
          })
        }
      }
    })
  )

  // codegraph.showCallers — show callers in quick pick
  context.subscriptions.push(
    vscode.commands.registerCommand('codegraph.showCallers', async (nodeId: string) => {
      const callers = db.getCallers(nodeId, 3)
      showNodePick(callers, db, 'Callers')
    })
  )

  // codegraph.showCallees
  context.subscriptions.push(
    vscode.commands.registerCommand('codegraph.showCallees', async (nodeId: string) => {
      const callees = db.getCallees(nodeId, 3)
      showNodePick(callees, db, 'Callees')
    })
  )

  // codegraph.showImpact
  context.subscriptions.push(
    vscode.commands.registerCommand('codegraph.showImpact', async (nodeId: string) => {
      const impact = db.getImpact(nodeId, 2)
      showNodePick(impact, db, 'Impact Radius')
    })
  )

  // codegraph.explore — builds context for a natural language question, opens in new editor
  context.subscriptions.push(
    vscode.commands.registerCommand('codegraph.explore', async () => {
      const question = await vscode.window.showInputBox({ prompt: 'CodeGraph Explore: ask a question about your codebase', placeHolder: 'How does authentication work?' })
      if (!question) return
      const builder = new ContextBuilder(db)
      const result = builder.build(question, 30, true)
      const markdown = builder.toMarkdown(result)
      const uri = vscode.Uri.parse('codegraph-explore:' + encodeURIComponent(question))
      // Open virtual document
      const provider = new (class implements vscode.TextDocumentContentProvider {
        provideTextDocumentContent() { return markdown }
      })()
      context.subscriptions.push(vscode.workspace.registerTextDocumentContentProvider('codegraph-explore', provider))
      const doc = await vscode.workspace.openTextDocument(uri)
      await vscode.window.showTextDocument(doc, { preview: false })
    })
  )
}

async function showNodePick(nodes: any[], db: DatabaseConnection, title: string) {
  if (!nodes.length) { vscode.window.showInformationMessage(`CodeGraph: No ${title.toLowerCase()} found.`); return }
  const items = nodes.map(n => ({
    label: `$(symbol-${n.kind}) ${n.name}`,
    description: n.kind,
    detail: db.getFileById(n.fileId)?.relPath,
    node: n
  }))
  const picked = await vscode.window.showQuickPick(items, { placeHolder: title })
  if (picked) {
    const file = db.getFileById(picked.node.fileId)
    if (file) {
      const doc = await vscode.workspace.openTextDocument(vscode.Uri.file(file.path))
      await vscode.window.showTextDocument(doc, {
        selection: new vscode.Range(picked.node.startLine - 1, 0, picked.node.startLine - 1, 0)
      })
    }
  }
}

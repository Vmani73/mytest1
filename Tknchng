import * as vscode from 'vscode'
import type { DatabaseConnection } from '../db/connection'

export class CodeLensProvider implements vscode.CodeLensProvider {
  constructor(private db: DatabaseConnection) {}

  provideCodeLenses(document: vscode.TextDocument): vscode.CodeLens[] {
    const filePath = document.uri.fsPath
    const file = this.db.getFileByPath(filePath)
    if (!file) return []

    const nodes = this.db.getNodesByFile(file.id)
    const lenses: vscode.CodeLens[] = []

    for (const node of nodes) {
      if (node.kind !== 'function' && node.kind !== 'method' && node.kind !== 'class') continue

      const range = new vscode.Range(node.startLine - 1, 0, node.startLine - 1, 0)
      const callerCount = this.db.getCallerCount(node.id)
      const calleeCount = this.db.getCalleeCount(node.id)

      if (callerCount > 0) {
        lenses.push(new vscode.CodeLens(range, {
          title: `$(arrow-up) ${callerCount} caller${callerCount !== 1 ? 's' : ''}`,
          command: 'codegraph.showCallers',
          arguments: [node.id]
        }))
      }

      if (calleeCount > 0) {
        lenses.push(new vscode.CodeLens(range, {
          title: `$(arrow-down) ${calleeCount} callee${calleeCount !== 1 ? 's' : ''}`,
          command: 'codegraph.showCallees',
          arguments: [node.id]
        }))
      }
    }

    return lenses
  }
}

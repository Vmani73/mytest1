## COMPLETE IMPLEMENTATION SPECIFICATIONS

### `src/extension.ts`

```typescript
import * as vscode from 'vscode'
import { DatabaseConnection } from './db/connection'
import { ExtractionOrchestrator } from './extraction/orchestrator'
import { ReferenceResolver } from './resolution/resolver'
import { WorkspaceWatcher } from './sync/watcher'
import { SidebarProvider } from './ui/sidebar-provider'
import { CodeLensProvider } from './ui/codelens-provider'
import { HoverProvider } from './ui/hover-provider'
import { StatusBar } from './ui/status-bar'
import { registerCommands } from './commands/index'
import { registerChatParticipant } from './chat/participant'
import * as path from 'path'

export let db: DatabaseConnection | null = null
export let orchestrator: ExtractionOrchestrator | null = null
export let watcher: WorkspaceWatcher | null = null

export async function activate(context: vscode.ExtensionContext) {
  const workspaceRoot = vscode.workspace.workspaceFolders?.[0]?.uri.fsPath
  if (!workspaceRoot) return

  const dbPath = path.join(workspaceRoot, '.codegraph', 'codegraph.db')
  const grammarDir = context.asAbsolutePath('grammars')

  db = new DatabaseConnection(dbPath)
  await db.initialize()  // runs schema migration

  orchestrator = new ExtractionOrchestrator(db, grammarDir, workspaceRoot)
  watcher = new WorkspaceWatcher(workspaceRoot, db, orchestrator)
  watcher.start()

  // UI
  const sidebar = new SidebarProvider(context.extensionUri, db)
  context.subscriptions.push(
    vscode.window.registerTreeDataProvider('codegraph.symbols', sidebar),
    vscode.window.registerTreeDataProvider('codegraph.files', sidebar),
    vscode.languages.registerCodeLensProvider({ scheme: 'file' }, new CodeLensProvider(db)),
    vscode.languages.registerHoverProvider({ scheme: 'file' }, new HoverProvider(db)),
    new StatusBar(db, context)
  )

  registerCommands(context, db, orchestrator)
  registerChatParticipant(context, db)

  // Auto-trigger index if .codegraph/codegraph.db is fresh/empty
  const stats = db.getStats()
  if (stats.fileCount === 0) {
    vscode.window.showInformationMessage(
      'CodeGraph: No index found. Run "CodeGraph: Index Workspace" to build the knowledge graph.',
      'Index Now'
    ).then(action => {
      if (action === 'Index Now') vscode.commands.executeCommand('codegraph.index')
    })
  }
}

export function deactivate() {
  watcher?.stop()
  db?.close()
}
```


### `src/graph/context.ts` — ContextBuilder

```typescript
import type { DatabaseConnection } from '../db/connection'
import type { GraphNode, GraphFile, ContextResult } from '../types'

export class ContextBuilder {
  constructor(private db: DatabaseConnection) {}

  build(task: string, maxNodes = 20, includeSource = true): ContextResult {
    // 1. Tokenize task
    const terms = task
      .toLowerCase()
      .replace(/[^a-z0-9\s]/g, ' ')
      .split(/\s+/)
      .filter(t => t.length > 2)

    // 2. FTS5 search for each term, collect with scores
    const seen = new Map<string, { node: GraphNode; score: number }>()
    for (const term of terms) {
      const results = this.db.searchNodes(term, undefined, 10)
      for (let i = 0; i < results.length; i++) {
        const node = results[i]
        const score = (seen.get(node.id)?.score ?? 0) + (1 / (i + 1))
        seen.set(node.id, { node, score })
      }
    }

    // 3. Expand top candidates by callers/callees
    const topCandidates = [...seen.values()]
      .sort((a, b) => b.score - a.score)
      .slice(0, 10)

    for (const { node } of topCandidates) {
      const callers = this.db.getCallers(node.id, 1)
      const callees = this.db.getCallees(node.id, 1)
      for (const n of [...callers, ...callees]) {
        if (!seen.has(n.id)) seen.set(n.id, { node: n, score: 0.1 })
      }
    }

    // 4. Score by graph centrality
    const allNodes = [...seen.values()]
    for (const entry of allNodes) {
      const inDegree = this.db.getInDegree(entry.node.id)
      const outDegree = this.db.getOutDegree(entry.node.id)
      entry.score += (inDegree + outDegree) * 0.05
    }

    // 5. Sort, truncate, attach file info
    const sorted = allNodes.sort((a, b) => b.score - a.score).slice(0, maxNodes)

    const entryPoints = sorted
      .filter(e => this.db.getInDegree(e.node.id) === 0)
      .map(e => e.node.id)

    const filesById = new Map<string, GraphFile>()
    const result = sorted.map(({ node, score }) => {
      let file = filesById.get(node.fileId)
      if (!file) {
        file = this.db.getFileById(node.fileId)!
        filesById.set(node.fileId, file)
      }
      return { ...node, file, score }
    })

    return {
      nodes: result,
      entryPoints,
      totalNodes: seen.size
    }
  }

  toMarkdown(result: ContextResult): string {
    const lines: string[] = ['# Code Context\n']
    for (const node of result.nodes) {
      lines.push(`## ${node.name} (${node.kind}) — ${node.file.relPath}:${node.startLine}`)
      if (node.signature) lines.push(`\`\`\`\n${node.signature}\n\`\`\``)
      if (node.docstring) lines.push(node.docstring)
      if (node.source) lines.push(`\`\`\`\n${node.source}\n\`\`\``)
      lines.push('')
    }
    return lines.join('\n')
  }
}

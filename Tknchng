import * as vscode from 'vscode'
import type { DatabaseConnection } from '../db/connection'
import type { ExtractionOrchestrator } from '../extraction/orchestrator'

export class WorkspaceWatcher {
  private watcher: vscode.FileSystemWatcher | null = null
  private debounceTimers = new Map<string, NodeJS.Timeout>()
  private DEBOUNCE_MS = 2000

  constructor(
    private workspaceRoot: string,
    private db: DatabaseConnection,
    private orchestrator: ExtractionOrchestrator
  ) {}

  start() {
    this.watcher = vscode.workspace.createFileSystemWatcher(
      new vscode.RelativePattern(this.workspaceRoot, '**/*.{ts,tsx,js,jsx,py,go,rs,java,cs,cpp,cc,swift,kt,rb,dart}')
    )

    const handle = (uri: vscode.Uri) => this.enqueue(uri.fsPath)

    this.watcher.onDidChange(handle)
    this.watcher.onDidCreate(handle)
    this.watcher.onDidDelete(uri => {
      const fileId = require('crypto').createHash('sha256').update(uri.fsPath).digest('hex')
      this.db.deleteFile(fileId)
    })
  }

  private enqueue(filePath: string) {
    const existing = this.debounceTimers.get(filePath)
    if (existing) clearTimeout(existing)
    const timer = setTimeout(async () => {
      this.debounceTimers.delete(filePath)
      await this.orchestrator.indexFile(filePath, true)
    }, this.DEBOUNCE_MS)
    this.debounceTimers.set(filePath, timer)
  }

  stop() {
    this.watcher?.dispose()
    for (const t of this.debounceTimers.values()) clearTimeout(t)
    this.debounceTimers.clear()
  }
}

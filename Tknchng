### `src/chat/participant.ts` — VS Code Chat Participant (`@codegraph`)

```typescript
import * as vscode from 'vscode'
import type { DatabaseConnection } from '../db/connection'
import { ContextBuilder } from '../graph/context'

export function registerChatParticipant(context: vscode.ExtensionContext, db: DatabaseConnection) {
  const participant = vscode.chat.createChatParticipant('codegraph', async (request, _ctx, stream, token) => {
    const builder = new ContextBuilder(db)
    const result = builder.build(request.prompt, 25, true)

    stream.markdown(`**CodeGraph found ${result.nodes.length} relevant symbols** (${result.totalNodes} total candidates)\n\n`)

    for (const node of result.nodes) {
      stream.markdown(`### \`${node.name}\` — ${node.kind} in \`${node.file.relPath}:${node.startLine}\`\n`)
      if (node.signature) stream.markdown(`\`\`\`typescript\n${node.signature}\n\`\`\`\n`)
      if (node.docstring) stream.markdown(`${node.docstring}\n`)
      if (node.source) stream.markdown(`\`\`\`typescript\n${node.source}\n\`\`\`\n`)
    }

    stream.markdown('\n---\n*Use `codegraph.explore` command for the full context view.*')
  })

  participant.iconPath = vscode.Uri.joinPath(context.extensionUri, 'resources', 'icons', 'codegraph.svg')
  context.subscriptions.push(participant)
}

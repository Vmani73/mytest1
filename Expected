# Required Retry Utility

```python
# src/core/retry.py

import random
import time

def retry_operation(
    func,
    retries=3,
    delay=1,
    backoff=2,
):

    for attempt in range(1, retries + 1):

        try:
            return func()

        except Exception:

            if attempt == retries:
                raise

            sleep_time = (
                delay * (backoff ** (attempt - 1))
            )

            sleep_time += random.uniform(0, 0.5)

            time.sleep(sleep_time)
```


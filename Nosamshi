Implement this exact hardened logic:

function normalizeId(id: unknown): string {
  return String(id ?? "")
    .trim()
    .toLowerCase();
}

function compareExtensions(
  contextExtensions: any[],
  latestExtensions: any[]
) {
  const contextIds = new Set(
    contextExtensions
      .map(ext => normalizeId(ext.extensionId ?? ext.id ?? ext.name))
      .filter(Boolean)
  );

  const latestIds = new Set(
    latestExtensions
      .map(ext => normalizeId(ext.extensionId ?? ext.id ?? ext.name))
      .filter(Boolean)
  );

  console.log("Context IDs:", [...contextIds]);
  console.log("Latest IDs:", [...latestIds]);

  const installed = latestExtensions.filter(ext => {
    const id = normalizeId(
      ext.extensionId ?? ext.id ?? ext.name
    );

    return contextIds.has(id);
  });

  const uninstalled = latestExtensions.filter(ext => {
    const id = normalizeId(
      ext.extensionId ?? ext.id ?? ext.name
    );

    return !contextIds.has(id);
  });

  console.log("Installed Extensions:", installed);
  console.log("Uninstalled Extensions:", uninstalled);

  return {
    installed,
    uninstalled
  };
}


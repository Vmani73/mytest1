3. IMPLEMENT SAFE PROCESS HANDLING
==================================================

Use something similar to:

const { spawn } = require("child_process");

async function runGraphUpdate(projectPath) {
  return new Promise((resolve, reject) => {

    console.log("[GRAPH] Starting graph update");
    console.log("[GRAPH] Project:", projectPath);

    const proc = spawn("python", [
      "-m",
      "graph",
      "update",
      projectPath
    ], {
      shell: true
    });

    let stdout = "";
    let stderr = "";

    proc.stdout.on("data", data => {
      const msg = data.toString();
      stdout += msg;
      console.log("[GRAPH STDOUT]", msg);
    });

    proc.stderr.on("data", data => {
      const msg = data.toString();
      stderr += msg;
      console.error("[GRAPH STDERR]", msg);
    });

    proc.on("error", err => {
      console.error("[GRAPH PROCESS ERROR]", err);
      reject(err);
    });

    proc.on("close", code => {
      console.log("[GRAPH EXIT CODE]", code);

      if (code !== 0) {
        reject(new Error(
          `Graph update failed.\nExit Code: ${code}\n${stderr}`
        ));
        return;
      }

      resolve({
        stdout,
        stderr
      });
    });

    setTimeout(() => {
      console.error("[GRAPH TIMEOUT]");
      proc.kill();
      reject(new Error("Graph update timeout"));
    }, 120000);

  });
}


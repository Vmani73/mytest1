## Testing patterns

Targets Vitest 3.x, RTL 16.x, user-event 14.x, MSW 2.x. **Check the installed
versions and adapt** — for Jest, replace `vi` with `jest`; everything else holds.

**Query priority.** Use the first that works and stop:
`getByRole(role, { name })` → `getByLabelText` → `getByPlaceholderText` /
`getByText` / `getByDisplayValue` → `getByTestId` (last resort, with a comment).
`getBy*` throws when absent; `queryBy*` returns null (only for
`not.toBeInTheDocument()`); `findBy*` returns a promise.

### Providers

```tsx
// src/test-utils/render.tsx
import { render, type RenderOptions } from '@testing-library/react';
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
import { MemoryRouter } from 'react-router-dom';
import type { ReactElement, ReactNode } from 'react';

export function renderWithProviders(
  ui: ReactElement,
  { route = '/', ...options }: RenderOptions & { route?: string } = {},
) {
  // Fresh client per test: a shared cache leaks state between tests.
  // retry:false matters — the default turns one rejected request into a
  // multi-second test that then times out for the wrong reason.
  const queryClient = new QueryClient({
    defaultOptions: { queries: { retry: false, gcTime: 0 } },
  });

  function Wrapper({ children }: { children: ReactNode }) {
    return (
      <QueryClientProvider client={queryClient}>
        <MemoryRouter initialEntries={[route]}>{children}</MemoryRouter>
      </QueryClientProvider>
    );
  }

  return { queryClient, ...render(ui, { wrapper: Wrapper, ...options }) };
}
```

### A component test

```tsx
import { screen } from '@testing-library/react';
import userEvent from '@testing-library/user-event';
import { renderWithProviders } from '@/test-utils/render';
import { UserCard } from './UserCard';

const user = { id: 7, displayName: 'Ada Lovelace', avatarUrl: null };

describe('UserCard', () => {
  it('renders the display name as a heading', () => {
    renderWithProviders(<UserCard user={user} onSelect={vi.fn()} />);
    expect(screen.getByRole('heading', { name: 'Ada Lovelace' })).toBeInTheDocument();
  });

  it('falls back to initials when there is no avatar', () => {
    renderWithProviders(<UserCard user={user} onSelect={vi.fn()} />);
    expect(screen.getByText('AL')).toBeInTheDocument();
    expect(screen.queryByRole('img')).not.toBeInTheDocument();
  });

  it('passes the user id to onSelect when the card is activated', async () => {
    const interact = userEvent.setup();
    const onSelect = vi.fn();
    renderWithProviders(<UserCard user={user} onSelect={onSelect} />);

    await interact.click(screen.getByRole('button', { name: /ada lovelace/i }));

    // The exact argument is the point. toHaveBeenCalled() lets a mutant live.
    expect(onSelect).toHaveBeenCalledTimes(1);
    expect(onSelect).toHaveBeenCalledWith(7);
  });

  it('activates on Enter as well as click', async () => {
    const interact = userEvent.setup();
    const onSelect = vi.fn();
    renderWithProviders(<UserCard user={user} onSelect={onSelect} />);

    await interact.tab();
    await interact.keyboard('{Enter}');

    expect(onSelect).toHaveBeenCalledWith(7);
  });
});
```

### Hooks

```tsx
import { renderHook, act } from '@testing-library/react';
import { useCounter } from './useCounter';

it('clamps the value at the configured maximum', () => {
  const { result } = renderHook(() => useCounter({ max: 2 }));
  act(() => { result.current.increment(); });
  act(() => { result.current.increment(); });
  act(() => { result.current.increment(); });
  expect(result.current.count).toBe(2);
});
```

Every state update goes inside `act`. For async hooks, prefer `waitFor` on the
observable result over `act` around the promise.

### Async and network (MSW 2)

Mock the network, not your own modules. A `vi.mock` of the data layer asserts
you called your own function; MSW asserts the component behaves correctly given
a real response shape.

```tsx
import { http, HttpResponse, delay } from 'msw';
import { setupServer } from 'msw/node';

const server = setupServer(
  http.get('/api/users/:id', () =>
    HttpResponse.json({ id: 7, displayName: 'Ada Lovelace' })),
);

// A request you forgot to mock should fail the test, not silently hang.
beforeAll(() => server.listen({ onUnhandledRequest: 'error' }));
afterEach(() => server.resetHandlers());
afterAll(() => server.close());

it('shows the error state when the request fails', async () => {
  server.use(http.get('/api/users/:id', () => new HttpResponse(null, { status: 500 })));

  renderWithProviders(<UserProfile userId={7} />);

  expect(await screen.findByRole('alert')).toHaveTextContent('Could not load this profile');
  expect(screen.queryByRole('status', { name: /loading/i })).not.toBeInTheDocument();
});

it('shows the loading state while the request is in flight', async () => {
  server.use(http.get('/api/users/:id', async () => {
    await delay(50);
    return HttpResponse.json({ id: 7, displayName: 'Ada Lovelace' });
  }));

  renderWithProviders(<UserProfile userId={7} />);

  expect(screen.getByRole('status', { name: /loading/i })).toBeInTheDocument();
  expect(await screen.findByRole('heading', { name: 'Ada Lovelace' })).toBeInTheDocument();
});
```

### Timers

```tsx
beforeEach(() => { vi.useFakeTimers(); });
afterEach(() => { vi.useRealTimers(); });

it('debounces the search callback to one call per 300ms', async () => {
  // user-event must share the fake clock or every interaction hangs.
  const interact = userEvent.setup({ advanceTimers: vi.advanceTimersByTime });
  const onSearch = vi.fn();
  render(<SearchBox onSearch={onSearch} delayMs={300} />);

  await interact.type(screen.getByRole('searchbox'), 'ada');
  expect(onSearch).not.toHaveBeenCalled();

  await act(async () => { await vi.advanceTimersByTimeAsync(300); });
  expect(onSearch).toHaveBeenCalledTimes(1);
  expect(onSearch).toHaveBeenCalledWith('ada');
});
```

Always restore real timers in `afterEach`; a leaked fake clock breaks every
later file in unpredictable ways.

### Forms

```tsx
it('blocks submission and names the invalid field when the email is malformed', async () => {
  const interact = userEvent.setup();
  const onSubmit = vi.fn();
  render(<SignupForm onSubmit={onSubmit} />);

  await interact.type(screen.getByLabelText('Email'), 'not-an-email');
  await interact.click(screen.getByRole('button', { name: 'Create account' }));

  expect(await screen.findByText('Enter a valid email address')).toBeInTheDocument();
  expect(screen.getByLabelText('Email')).toHaveAccessibleDescription('Enter a valid email address');
  expect(onSubmit).not.toHaveBeenCalled();
});
```

### Error boundaries

```tsx
it('renders the fallback when a child throws', () => {
  // Silence React's caught-error log for this test only, so a real
  // unexpected error elsewhere still surfaces.
  const spy = vi.spyOn(console, 'error').mockImplementation(() => {});
  const Boom = () => { throw new Error('kaboom'); };

  render(<ErrorBoundary fallback={<p role="alert">Something went wrong</p>}><Boom /></ErrorBoundary>);

  expect(screen.getByRole('alert')).toHaveTextContent('Something went wrong');
  spy.mockRestore();
});
```

### jsdom gaps

jsdom has no layout and no observers. Polyfill in the setup file, never per
test: `IntersectionObserver` and `ResizeObserver` (stub classes with
observe/unobserve/disconnect), `window.matchMedia` (returns `matches: false`
plus the listener methods), `Element.prototype.scrollIntoView` (`vi.fn()`).
Anything relying on real measurement — virtualised lists, drag-and-drop
positioning — belongs in an e2e test; say so rather than writing a unit test
that asserts jsdom's zeroes.


### The store

```python
import hashlib
import json
import threading
from dataclasses import dataclass, field
from typing import Optional

@dataclass
class DedupEntry:
    content_hash: str
    original_tokens: int
    first_seen_turn: int
    ref_token: str          # e.g. "[ref:a3f9b]"

@dataclass 
class DedupStore:
    """
    In-memory store for this session.
    Thread-safe. Resets between agent sessions.
    Never persists to disk — content may be sensitive.
    """
    _entries: dict = field(default_factory=dict)  # hash -> DedupEntry
    _lock: threading.Lock = field(default_factory=threading.Lock)
    _current_turn: int = 0
    _tokens_saved: int = 0
    _total_dedup_hits: int = 0
```

### Token counting

```python
def _count_tokens(text: str) -> int:
    """
    Count tokens using tiktoken.
    Falls back to len(text.split()) if tiktoken unavailable.
    Never raises.
    """
    try:
        import tiktoken
        enc = tiktoken.get_encoding("cl100k_base")
        return len(enc.encode(text))
    except Exception:
        return len(text.split())
```

### Content hashing

```python
def _hash_content(content: str) -> str:
    """
    SHA-256 of the exact content string.
    Same content = same hash, always.
    Strips leading/trailing whitespace before hashing
    so trivial formatting differences do not cause cache misses.
    """
    return hashlib.sha256(content.strip().encode()).hexdigest()[:10]
```

### The main function — the ONLY thing called from agent code

```python
def maybe_deduplicate(
    store: DedupStore,
    content: str,
    content_type: str,   # "file_read" | "tool_output" | "api_response" | "rag_chunk"
    label: str = "",     # human-readable label e.g. filename, tool name
) -> str:
    """
    Returns either:
    - The original content (first time this content is seen this session)
    - A short reference string (if content was already injected earlier)

    NEVER modifies content. NEVER summarizes. NEVER loses information.
    The model has already seen the full content on first occurrence.

    Args:
        store:        The session-scoped DedupStore
        content:      The raw tool output string to potentially deduplicate
        content_type: Category of content for logging/reporting
        label:        Human label for logging (e.g. filename)

    Returns:
        str: original content OR reference token
    """
    if not content or not content.strip():
        return content  # never deduplicate empty content

    content_hash = _hash_content(content)
    token_count = _count_tokens(content)

    with store._lock:
        if content_hash in store._entries:
            entry = store._entries[content_hash]
            store._tokens_saved += token_count
            store._total_dedup_hits += 1
            ref = entry.ref_token
            logging.info(
                f"[dedup] HIT {content_type} '{label}' "
                f"hash={content_hash} "
                f"saved={token_count} tokens "
                f"(first seen turn {entry.first_seen_turn}, "
                f"now turn {store._current_turn})"
            )
            return (
                f"{ref}\n"
                f"# [dedup: this {content_type} was already injected in full "
                f"at turn {entry.first_seen_turn}. "
                f"Saved {token_count} tokens.]"
            )
        else:
            ref_token = f"[ref:{content_hash}]"
            store._entries[content_hash] = DedupEntry(
                content_hash=content_hash,
                original_tokens=token_count,
                first_seen_turn=store._current_turn,
                ref_token=ref_token,
            )
            logging.info(
                f"[dedup] NEW {content_type} '{label}' "
                f"hash={content_hash} "
                f"tokens={token_count} "
                f"(stored for dedup)"
            )
            return content  # return original — first time
```

### Turn tracking

```python
def advance_turn(store: DedupStore) -> None:
    """Call this at the start of each agent turn."""
    with store._lock:
        store._current_turn += 1

def reset_session(store: DedupStore) -> None:
    """Call this at the start of a new agent session."""
    with store._lock:
        store._entries.clear()
        store._current_turn = 0
        store._tokens_saved = 0
        store._total_dedup_hits = 0
```

### Session report

```python
def session_report(store: DedupStore) -> dict:
    """
    Returns measured savings for this session.
    All numbers are exact — counted with tiktoken, not estimated.
    """
    with store._lock:
        total_original = sum(
            e.original_tokens for e in store._entries.values()
        )
        return {
            "turns": store._current_turn,
            "unique_content_pieces": len(store._entries),
            "dedup_hits": store._total_dedup_hits,
            "tokens_saved_by_dedup": store._tokens_saved,
            "total_unique_content_tokens": total_original,
            "note": (
                "tokens_saved_by_dedup is the exact number of tokens "
                "NOT sent to vmani because of deduplication. "
                "Counted with tiktoken on actual content."
            )
        }

def print_session_report(store: DedupStore) -> None:
    report = session_report(store)
    print("\n=== DEDUP SESSION REPORT ===")
    print(f"Turns           : {report['turns']}")
    print(f"Unique pieces   : {report['unique_content_pieces']}")
    print(f"Dedup hits      : {report['dedup_hits']}")
    print(f"Tokens saved    : {report['tokens_saved_by_dedup']}")
    print(f"Note            : {report['note']}")
    print("============================\n")
```


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog=APP,
        description="Batch runner for the CodeMind orchestrator API.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""examples:
  run     %(prog)s run --base-url "$ORCH_BASE_URL" \\
              --input repos.csv --playbooks scan,scan_evaluation --goal "generate report"
  shard   %(prog)s run ... --shard 3/20 --state ./state_03
  watch   %(prog)s status --state ./cm_state
  read    %(prog)s report --state ./cm_state --open
  redo    %(prog)s retry  --state ./cm_state --include failed,timeout
""")
    p.add_argument("--version", action="version", version=f"{APP} {VERSION}")
    sub = p.add_subparsers(dest="cmd", required=True)

    def common(sp):
        sp.add_argument("--state", type=Path, default=Path("./cm_state"),
                        help="state directory (db + reports + dashboard)")

    r = sub.add_parser("run", help="submit and poll a batch")
    common(r)
    r.add_argument("--base-url", default=os.environ.get("ORCH_BASE_URL", ""),
                   help="orchestrator base URL, or set ORCH_BASE_URL")
    r.add_argument("--input", type=Path,
                   help="CSV or newline-delimited repo list (omit to resume)")
    r.add_argument("--playbooks", default="",
                   help="comma separated, 1 or 2, default for rows without one")
    r.add_argument("--goal", default="")
    r.add_argument("--branch", default="main")
    r.add_argument("--cd-repo-url", default="", help="optional")
    r.add_argument("--cd-branch", default="", help="optional")
    r.add_argument("--repo-path", default="")
    r.add_argument("--user-id", default=os.environ.get("CODEMIND_USER", ""))
    r.add_argument("--mirror-mode", choices=["true", "false"], default=None)
    r.add_argument("--concurrency", type=int, default=2,
                   help="parallel orchestrator runs (default 2)")
    r.add_argument("--limit", type=int, default=0)
    r.add_argument("--shard", default="1/1", metavar="i/N",
                   help="process shard i of N (1-based)")
    r.add_argument("--first-poll-delay", type=float, default=60.0)
    r.add_argument("--poll-interval", type=float, default=30.0)
    r.add_argument("--max-wall", type=float, default=1800.0,
                   help="per-run deadline in seconds (default 1800 = 30 min)")
    r.add_argument("--submit-gap", type=float, default=2.0)
    r.add_argument("--http-timeout", type=float, default=60.0)
    r.add_argument("--max-http-attempts", type=int, default=6)
    r.add_argument("--max-submit-retries", type=int, default=3)
    r.add_argument("--breaker-threshold", type=int, default=8)
    r.add_argument("--breaker-cooldown", type=float, default=120.0)
    r.add_argument("--token", default=os.environ.get("CODEMIND_TOKEN", ""))
    r.add_argument("--header", action="append", default=[], metavar="K=V")
    r.add_argument("--insecure", action="store_true",
                   help="skip TLS verification (internal CA)")
    r.add_argument("--success-states", default="")
    r.add_argument("--failure-states", default="")
    r.add_argument("--no-ui", action="store_true", help="plain logs, for OCP/nohup")
    r.add_argument("--no-keep-awake", action="store_true")
    r.add_argument("--snapshot-every", type=float, default=60.0)

    s = sub.add_parser("status", help="print a state snapshot")
    common(s)

    rep = sub.add_parser("report", help="build the HTML dashboard")
    common(rep)
    rep.add_argument("--open", action="store_true")
    rep.add_argument("--out", type=Path)

    e = sub.add_parser("export", help="export every run to CSV")
    common(e)
    e.add_argument("--out", type=Path, default=Path("codemind_runs.csv"))

    rt = sub.add_parser("retry", help="reset terminal states back to PENDING")
    common(rt)
    rt.add_argument("--include", default="failed,timeout",
                    help="failed,timeout,dead")

    sub.add_parser("demo", help="run an end-to-end self test against a mock API")
    return p


def cfg_from_args(a: argparse.Namespace) -> Config:
    headers = {}
    for h in getattr(a, "header", []):
        if "=" not in h:
            raise SystemExit(f"--header expects K=V, got {h!r}")
        k, v = h.split("=", 1)
        headers[k.strip()] = v.strip()

    shard, shards = 0, 1
    if getattr(a, "shard", None):
        try:
            i, n = a.shard.split("/")
            shard, shards = int(i) - 1, int(n)
        except Exception:
            raise SystemExit("--shard expects i/N, e.g. 3/20")
        if not (0 <= shard < shards):
            raise SystemExit(f"--shard out of range: {a.shard}")

    pb = [p.strip() for p in (a.playbooks or "").split(",") if p.strip()]
    if len(pb) > 2:
        raise SystemExit("max 2 playbooks per run")

    for extra, target in ((a.success_states, SUCCESS_STATES),
                          (a.failure_states, FAILURE_STATES)):
        for tok in (extra or "").split(","):
            if tok.strip():
                target.add(tok.strip().lower())

    return Config(
        base_url=a.base_url, state_dir=a.state, input_path=a.input,
        playbooks=pb, goal=a.goal, branch=a.branch,
        cd_repo_url=a.cd_repo_url, cd_branch=a.cd_branch,
        repo_path=a.repo_path, user_id=a.user_id,
        mirror_mode=None if a.mirror_mode is None else a.mirror_mode == "true",
        concurrency=max(1, a.concurrency), limit=a.limit,
        shard=shard, shards=shards,
        first_poll_delay=a.first_poll_delay, poll_interval=a.poll_interval,
        max_wall=a.max_wall, submit_gap=a.submit_gap,
        http_timeout=a.http_timeout, max_http_attempts=a.max_http_attempts,
        max_submit_retries=a.max_submit_retries,
        breaker_threshold=a.breaker_threshold,
        breaker_cooldown=a.breaker_cooldown,
        token=a.token, headers=headers, verify=not a.insecure,
        no_ui=a.no_ui, keep_awake=not a.no_keep_awake,
        snapshot_every=a.snapshot_every,
    )


def main(argv: Optional[list[str]] = None) -> int:
    args = build_parser().parse_args(argv)

    if args.cmd == "run":
        cfg = cfg_from_args(args)
        if not cfg.base_url:
            raise SystemExit("--base-url is required (or set ORCH_BASE_URL)")
        if not cfg.input_path and not cfg.db_path.exists():
            raise SystemExit("--input is required the first time (no state yet)")
        try:
            return asyncio.run(cmd_run(cfg))
        except KeyboardInterrupt:
            print("\ninterrupted — state saved, re-run the same command to resume")
            return 130

    if args.cmd == "demo":
        return cmd_demo()

    cfg = Config(state_dir=args.state)
    if not cfg.db_path.exists():
        raise SystemExit(f"no state db at {cfg.db_path}")

    if args.cmd == "status":
        return cmd_status(cfg)
    if args.cmd == "report":
        return cmd_report(cfg, args.open, args.out)
    if args.cmd == "export":
        return cmd_export(cfg, args.out)
    if args.cmd == "retry":
        inc = {s.strip().upper() for s in args.include.split(",") if s.strip()}
        bad = inc - {FAILED, TIMEOUT, DEAD, RUNNING}
        if bad:
            raise SystemExit(f"cannot retry: {', '.join(bad)}")
        return cmd_retry(cfg, inc)
    return 1


if __name__ == "__main__":
    try:
        sys.exit(main())
    except BrokenPipeError:          # piped into head/less
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        sys.exit(0)

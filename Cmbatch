def cmd_demo() -> int:
    import http.server
    import socketserver
    import tempfile

    runs: dict[str, dict] = {}

    class H(http.server.BaseHTTPRequestHandler):
        def log_message(self, *a): pass

        def _send(self, code: int, body: dict) -> None:
            raw = json.dumps(body).encode()
            self.send_response(code)
            self.send_header("content-type", "application/json")
            self.send_header("content-length", str(len(raw)))
            self.end_headers()
            self.wfile.write(raw)

        def do_POST(self):
            n = int(self.headers.get("content-length", 0))
            body = json.loads(self.rfile.read(n) or b"{}")
            if random.random() < 0.15:          # exercise retry path
                return self._send(503, {"detail": "upstream busy"})
            rid = str(uuid.uuid4())
            runs[rid] = {"polls": 0, "repo": body.get("repo_url", "")}
            self._send(200, {"run_id": rid, "status": "queued"})

        def do_GET(self):
            rid = self.path.rstrip("/").rsplit("/", 1)[-1]
            r = runs.get(rid)
            if not r:
                return self._send(404, {"detail": "not found"})
            r["polls"] += 1
            if r["polls"] < 2:
                return self._send(200, {"run_id": rid, "status": "running"})
            bad = random.random() < 0.2
            self._send(200, {
                "run_id": rid,
                "status": "failed" if bad else "completed",
                "error": "playbook assertion failed" if bad else None,
                "report": {"findings": random.randint(0, 9),
                           "repo": r["repo"]}})

    srv = socketserver.ThreadingTCPServer(("127.0.0.1", 0), H)
    srv.daemon_threads = True
    port = srv.server_address[1]
    threading.Thread(target=srv.serve_forever, daemon=True).start()

    tmp = Path(tempfile.mkdtemp(prefix="cm_demo_"))
    inp = tmp / "repos.csv"
    inp.write_text(
        "repo_url,branch,cd_repo_url\n" + "\n".join(
            f"https://github.com/org/svc-{i:03d},main," for i in range(1, 13)))

    cfg = Config(
        base_url=f"http://127.0.0.1:{port}", state_dir=tmp / "state",
        input_path=inp, playbooks=["demo_playbook"],
        goal="generate report", concurrency=2,
        first_poll_delay=0.4, poll_interval=0.4, max_wall=12,
        submit_gap=0.05, snapshot_every=3, keep_awake=False,
        backoff_base=1.2, backoff_cap=2, http_timeout=10)

    print(f"demo: mock orchestrator on {cfg.base_url}, state {cfg.state_dir}\n")
    rc = asyncio.run(cmd_run(cfg))
    srv.shutdown()
    cmd_status(cfg)
    print(f"\ndemo artifacts: {tmp}")
    return rc



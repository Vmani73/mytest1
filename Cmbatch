#!/usr/bin/env python3
"""
codemind_batch.py — production batch runner for the CodeMind orchestrator API.

Single file. No package. Drives:
    POST /api/v1/orchestrator/run          -> returns a run/job id
    GET  /api/v1/orchestrator/runs/{id}    -> poll until terminal

Design guarantees
-----------------
crash-safe      every state transition is committed to SQLite (WAL) before the
                next network call; an interrupted process re-attaches to live
                run_ids on restart instead of resubmitting work
idempotent      a task key is sha256(repo|branch|playbooks|goal|cd_*); completed
                keys are skipped on re-run
bounded         N parallel orchestrator runs (default 2), a global submit gap,
                a shared circuit breaker, and a hard per-run deadline
observable      live terminal dashboard, rolling HTML snapshot, per-run JSON
                artifacts, CSV export, and a queryable state.db
shardable       --shard i/N partitions any input deterministically across
                independent instances

Quick start
-----------
    export ORCH_BASE_URL="https://<orchestrator-host>"     # no host is hardcoded

    python codemind_batch.py run \
        --base-url "$ORCH_BASE_URL" \
        --input repos.csv \
        --playbooks <playbook_1>,<playbook_2> \
        --goal "generate report" \
        --state ./cm_state

    python codemind_batch.py status --state ./cm_state
    python codemind_batch.py report --state ./cm_state --open
    python codemind_batch.py retry  --state ./cm_state --include failed,timeout
    python codemind_batch.py export --state ./cm_state --out runs.csv
    python codemind_batch.py demo                      # end-to-end self test

Dependencies: httpx (required), rich (optional, falls back to plain logging).
"""


def utcnow() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="seconds")


def now_ts() -> float:
    return time.time()


def human_dt(seconds: float) -> str:
    seconds = max(0, int(seconds))
    h, rem = divmod(seconds, 3600)
    m, s = divmod(rem, 60)
    if h:
        return f"{h}h{m:02d}m"
    if m:
        return f"{m}m{s:02d}s"
    return f"{s}s"


def deep_find(obj: Any, keys: tuple[str, ...], want_str: bool = True) -> Optional[str]:
    """Breadth-first search for the first matching key in a nested structure."""
    queue: list[Any] = [obj]
    seen = 0
    while queue and seen < 2000:
        cur = queue.pop(0)
        seen += 1
        if isinstance(cur, dict):
            for k in keys:
                for real in cur:
                    if isinstance(real, str) and real.lower() == k:
                        v = cur[real]
                        if v is None:
                            continue
                        if want_str and isinstance(v, (str, int)):
                            return str(v)
                        if not want_str:
                            return v
            queue.extend(cur.values())
        elif isinstance(cur, list):
            queue.extend(cur[:50])
    return None



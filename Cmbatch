    "running", "in_progress", "in-progress", "inprogress", "pending", "queued",
    "started", "starting", "processing", "created", "new", "submitted",
    "active", "waiting", "scheduled", "accepted", "initializing",
}

RUN_ID_KEYS = ("run_id", "runid", "job_id", "jobid", "execution_id", "task_id", "id")
STATUS_KEYS = ("status", "state", "run_status", "job_status", "phase", "run_state")

RETRYABLE_HTTP = {408, 425, 429, 500, 502, 503, 504, 522, 524}

# task states persisted in sqlite
PENDING, RUNNING, SUCCEEDED, FAILED, TIMEOUT, DEAD = (
    "PENDING", "RUNNING", "SUCCEEDED", "FAILED", "TIMEOUT", "DEAD"
)
TERMINAL = {SUCCEEDED, FAILED, TIMEOUT, DEAD}

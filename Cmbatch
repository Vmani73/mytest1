  rows.innerHTML=rs.map(r=>`<tr>
    <td title="${r.repo_url}">${r.repo}${r.error?`<span class="err">${esc(r.error)}</span>`:""}</td>
    <td>${r.branch||""}</td>
    <td class="s ${r.state}">${r.state.toLowerCase()}</td>
    <td>${esc(r.api_status||"")}</td>
    <td>${(r.run_id||"").slice(0,12)}</td>
    <td>${fmt(r.duration_s)}</td><td>${r.polls||0}</td>
    <td>${r.finished||""}</td>
    <td>${r.report?`<a href="${r.report}">json</a>`:""}</td></tr>`).join("")
    || `<tr><td colspan="9" style="padding:36px;color:var(--dim)">
        No runs match this filter. Clear the search or state chips to see everything.</td></tr>`;
}
const esc=s=>String(s).replace(/[<>&]/g,c=>({"<":"&lt;",">":"&gt;","&":"&amp;"}[c]));
q.oninput=e=>{filter=e.target.value.toLowerCase();draw()};
document.querySelectorAll("th").forEach(th=>th.onclick=()=>{
  const k=th.dataset.k; asc = sortK===k ? !asc : true; sortK=k; draw();});
function dl(){
  const rs=view(), cols=["repo_url","branch","state","api_status","run_id",
    "duration_s","polls","finished","error","report"];
  const csv=[cols.join(",")].concat(rs.map(r=>cols.map(c=>
    `"${String(r[c]??"").replace(/"/g,'""')}"`).join(","))).join("\n");
  const a=document.createElement("a");
  a.href=URL.createObjectURL(new Blob([csv],{type:"text/csv"}));
  a.download="codemind_runs.csv"; a.click();
}
draw();
</script>
"""


def write_html(cfg: Config, store: Store, live: bool = False,
               out: Optional[Path] = None) -> Path:
    rows = store.all_rows()
    base = cfg.state_dir.resolve()
    data = []
    for r in rows:
        rp = ""
        if r["report_path"]:
            with contextlib.suppress(Exception):
                rp = os.path.relpath(r["report_path"], base).replace(os.sep, "/")
        fin = ""
        if r["finished_at"]:
            fin = datetime.fromtimestamp(r["finished_at"]).strftime("%m-%d %H:%M")
        data.append({
            "repo": r["repo_url"].rstrip("/").rsplit("/", 1)[-1],
            "repo_url": r["repo_url"], "branch": r["branch"], "state": r["state"],
            "api_status": r["api_status"], "run_id": r["run_id"],
            "duration_s": round(r["duration_s"], 1) if r["duration_s"] else 0,
            "polls": r["polls"], "finished": fin,
            "error": (r["error"] or "")[:300], "report": rp,
        })
    title = "live" if live else "summary"
    html = (HTML
            .replace("__DATA__", json.dumps(data))
            .replace("__TITLE__", title)
            .replace("__GENERATED__", datetime.now().strftime("%Y-%m-%d %H:%M:%S"))
            .replace("__ENDPOINT__", cfg.base_url or "—")
            .replace("__STATEDIR__", str(cfg.state_dir))
            .replace("__REFRESH__",
                     '<meta http-equiv="refresh" content="30">' if live else ""))
    path = out or cfg.snapshot_path
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(html, encoding="utf-8")
    return path



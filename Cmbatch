PALETTE = {
    "ok": "bold green", "fail": "bold red", "timeout": "bold yellow",
    "dead": "bold magenta", "info": "cyan", "warn": "yellow",
}


class Dashboard:
    def __init__(self, cfg: Config, store: Store, runner: Runner):
        self.cfg, self.store, self.runner = cfg, store, runner
        self.console = Console() if RICH else None

    def render(self) -> Any:
        st = self.runner.stats
        assert st is not None
        cfg = self.cfg

        host = cfg.base_url.split("//")[-1].split(".")[0:3]
        head = Table.grid(expand=True)
        head.add_column(ratio=1)
        head.add_column(justify="right", ratio=1)
        shard = f"shard {cfg.shard + 1}/{cfg.shards}" if cfg.shards > 1 else "single"
        head.add_row(
            Text(f"CODEMIND BATCH  ", style="bold cyan") +
            Text(".".join(host), style="dim"),
            Text(f"{shard}  ·  {cfg.concurrency} parallel  ·  "
                 f"up {human_dt(st.elapsed)}", style="dim"))

        pct = (st.done / st.total * 100) if st.total else 100.0
        filled = int(pct / 2)
        bar = Text("█" * filled + "░" * (50 - filled), style="cyan")
        eta = human_dt(st.eta) if st.eta else "—"

        kpi = Table.grid(expand=True, padding=(0, 2))
        for _ in range(6):
            kpi.add_column(justify="left")
        kpi.add_row(
            Text("done", style="dim"), Text("ok", style="dim"),
            Text("failed", style="dim"), Text("timeout", style="dim"),
            Text("rate/h", style="dim"), Text("eta", style="dim"))
        kpi.add_row(
            Text(f"{st.done}/{st.total}", style="bold white"),
            Text(str(st.succeeded), style="bold green"),
            Text(str(st.failed + st.dead), style="bold red"),
            Text(str(st.timeout), style="bold yellow"),
            Text(f"{st.rate_per_hour:.0f}", style="bold cyan"),
            Text(eta, style="bold white"))

        active = Table(expand=True, box=None, pad_edge=False)
        active.add_column("slot", width=4, style="dim")
        active.add_column("repo", overflow="fold", ratio=3)
        active.add_column("run id", width=14, style="dim")
        active.add_column("status", ratio=1)
        active.add_column("polls", width=6, justify="right", style="dim")
        active.add_column("elapsed", width=8, justify="right")
        for i, lr in enumerate(list(st.active.values())[:cfg.concurrency], 1):
            active.add_row(str(i), lr.repo, lr.run_id[:12] or "—",
                           Text(lr.status, style="cyan"),
                           str(lr.polls), human_dt(now_ts() - lr.started))
        if not st.active:
            active.add_row("—", Text("idle", style="dim"), "", "", "", "")

        tail = Table.grid(expand=True, padding=(0, 1))
        tail.add_column(width=8)
        tail.add_column(ratio=2, overflow="ellipsis")
        tail.add_column(ratio=3, overflow="ellipsis", style="dim")
        for level, repo, msg in st.tail[-8:][::-1]:
            tail.add_row(Text(level.upper(), style=PALETTE.get(level, "white")),
                         repo, msg)

        breaker = self.runner.breaker
        foot = Text(
            f"http {self.runner.api.requests} req · {self.runner.api.retries} retries"
            f" · breaker {'OPEN' if breaker.is_open else 'closed'}"
            f" ({breaker.trips} trips) · resumed {st.resumed}"
            f" · skipped {st.already_done} · state {cfg.state_dir}",
            style="dim")

        return Group(
            Panel(head, border_style="cyan", padding=(0, 1)),
            Panel(Group(bar, Text(f"  {pct:5.1f}%", style="bold"), Text(""), kpi),
                  title="progress", border_style="grey37", padding=(0, 1)),
            Panel(active, title=f"active runs (max {cfg.concurrency})",
                  border_style="grey37", padding=(0, 1)),
            Panel(tail, title="events", border_style="grey37", padding=(0, 1)),
            foot,
        )



@dataclass
class Live_Run:
    key: str
    repo: str
    run_id: str
    started: float
    polls: int = 0
    status: str = "submitting"


class Stats:
    def __init__(self, total: int, already_done: int):
        self.total = total
        self.start = now_ts()
        self.done = 0
        self.succeeded = 0
        self.failed = 0
        self.timeout = 0
        self.dead = 0
        self.resumed = 0
        self.already_done = already_done
        self.active: dict[str, Live_Run] = {}
        self.tail: list[tuple[str, str, str]] = []
        self._lock = threading.Lock()

    def note(self, level: str, repo: str, msg: str) -> None:
        with self._lock:
            self.tail.append((level, repo, msg))
            del self.tail[:-40]

    @property
    def elapsed(self) -> float:
        return now_ts() - self.start

    @property
    def rate_per_hour(self) -> float:
        e = self.elapsed
        return (self.done / e * 3600) if e > 5 and self.done else 0.0

    @property
    def eta(self) -> Optional[float]:
        r = self.rate_per_hour
        if not r:
            return None
        return (self.total - self.done) / r * 3600



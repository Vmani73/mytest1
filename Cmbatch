def make_logger(cfg: Config):
    cfg.state_dir.mkdir(parents=True, exist_ok=True)
    fh = cfg.log_path.open("a", encoding="utf-8")

    def log(msg: str) -> None:
        line = f"{utcnow()} {msg}"
        fh.write(line + "\n")
        fh.flush()
        if cfg.no_ui or not RICH:
            print(line, flush=True)
    return log


async def cmd_run(cfg: Config) -> int:
    lock = InstanceLock(cfg.state_dir)
    lock.acquire()
    awake = KeepAwake(cfg.keep_awake)
    awake.start()
    log = make_logger(cfg)
    store = Store(cfg.db_path)
    store.set_meta("base_url", cfg.base_url)
    store.set_meta("last_start", utcnow())

    try:
        if cfg.input_path:
            tasks = load_tasks(cfg)
            new, dup = store.enqueue(tasks)
            log(f"input {cfg.input_path}: {len(tasks)} tasks "
                f"({new} new, {dup} already tracked)")

        counts = store.counts()
        already = sum(v for k, v in counts.items() if k in TERMINAL)
        rows = store.actionable(cfg.limit)
        resumable = sum(1 for r in rows if r["state"] == RUNNING and r["run_id"])
        log(f"queue: {len(rows)} actionable ({resumable} resumable), "
            f"{already} already terminal, concurrency={cfg.concurrency}, "
            f"keep_awake={awake.mode}")

        if not rows:
            print("Nothing to run. All tasks are in a terminal state.")
            print(f"See the report:  python {Path(sys.argv[0]).name} report "
                  f"--state {cfg.state_dir} --open")
            return 0

        runner = Runner(cfg, store, log)

        loop = asyncio.get_running_loop()

        def request_stop(*_: Any) -> None:
            if not runner.stop.is_set():
                log("shutdown requested — finishing current polls, "
                    "in-flight run_ids are saved and will resume")
                runner.stop.set()

        for sig in (signal.SIGINT, signal.SIGTERM):
            with contextlib.suppress(NotImplementedError, AttributeError):
                loop.add_signal_handler(sig, request_stop)
        if platform.system() == "Windows":
            signal.signal(signal.SIGINT, lambda *_: request_stop())

        if RICH and not cfg.no_ui:
            dash = Dashboard(cfg, store, runner)
            task = asyncio.create_task(runner.run(rows, already))
            with Live(console=dash.console, refresh_per_second=4,
                      screen=False) as live_ui:
                while not task.done():
                    if runner.stats:
                        live_ui.update(dash.render())
                    await asyncio.sleep(0.25)
                if runner.stats:
                    live_ui.update(dash.render())
            await task
        else:
            await runner.run(rows, already)

        st = runner.stats
        path = write_html(cfg, store, live=False)
        final = store.counts()
        print("\n" + "─" * 62)
        print(f"batch finished in {human_dt(st.elapsed if st else 0)}")
        for k in (SUCCEEDED, FAILED, TIMEOUT, DEAD, RUNNING, PENDING):
            if final.get(k):
                print(f"  {k.lower():<10} {final[k]}")
        print(f"\n  dashboard  {path}")
        print(f"  reports    {cfg.reports_dir}")
        print(f"  state      {cfg.db_path}")
        if final.get(FAILED) or final.get(TIMEOUT):
            print(f"\n  retry:  python {Path(sys.argv[0]).name} retry "
                  f"--state {cfg.state_dir} --include failed,timeout")
        return 0
    finally:
        awake.stop()
        store.close()
        lock.release()


def cmd_status(cfg: Config) -> int:
    store = Store(cfg.db_path)
    counts = store.counts()
    total = sum(counts.values())
    durs = sorted(store.durations())
    print(f"\nstate: {cfg.state_dir}   tasks: {total}")
    for k in (PENDING, RUNNING, SUCCEEDED, FAILED, TIMEOUT, DEAD):
        n = counts.get(k, 0)
        if n:
            bar = "█" * int(n / max(total, 1) * 34)
            print(f"  {k.lower():<10} {n:>7}  {bar}")
    if durs:
        p50 = durs[len(durs) // 2]
        p95 = durs[min(len(durs) - 1, int(len(durs) * 0.95))]
        print(f"\n  duration  p50 {human_dt(p50)}   p95 {human_dt(p95)}")
    ev = store.recent_events(8)
    if ev:
        print("\n  recent events")
        for e in ev:
            print(f"    {e['ts']}  {e['level']:<5} {e['msg'][:90]}")
    store.close()
    return 0


def cmd_report(cfg: Config, open_it: bool, out: Optional[Path]) -> int:
    store = Store(cfg.db_path)
    path = write_html(cfg, store, live=False, out=out)
    store.close()
    print(f"dashboard written: {path.resolve()}")
    if open_it:
        with contextlib.suppress(Exception):
            webbrowser.open(path.resolve().as_uri())
    return 0


def cmd_export(cfg: Config, out: Path) -> int:
    store = Store(cfg.db_path)
    rows = store.all_rows()
    cols = ["repo_url", "branch", "playbooks", "state", "api_status", "run_id",
            "duration_s", "polls", "attempt", "error", "report_path",
            "enqueued_at", "updated_at"]
    out.parent.mkdir(parents=True, exist_ok=True)
    with out.open("w", newline="", encoding="utf-8") as fh:
        w = csv.writer(fh)
        w.writerow(cols)
        for r in rows:
            w.writerow([r[c] for c in cols])
    store.close()
    print(f"{len(rows)} rows -> {out.resolve()}")
    return 0


def cmd_retry(cfg: Config, include: set[str]) -> int:
    store = Store(cfg.db_path)
    n = store.reset_states(include)
    store.close()
    print(f"{n} tasks reset to PENDING ({', '.join(sorted(include))}). "
          f"Re-run the same 'run' command to process them.")
    return 0



SCHEMA = """
PRAGMA journal_mode=WAL;
PRAGMA synchronous=NORMAL;

CREATE TABLE IF NOT EXISTS tasks (
    key           TEXT PRIMARY KEY,
    repo_url      TEXT NOT NULL,
    branch        TEXT,
    playbooks     TEXT,
    goal          TEXT,
    cd_repo_url   TEXT,
    cd_branch     TEXT,
    repo_path     TEXT,
    user_id       TEXT,
    mirror_mode   INTEGER,
    state         TEXT NOT NULL,
    run_id        TEXT,
    attempt       INTEGER DEFAULT 0,
    polls         INTEGER DEFAULT 0,
    api_status    TEXT,
    error         TEXT,
    report_path   TEXT,
    enqueued_at   TEXT,
    submitted_at  REAL,
    finished_at   REAL,
    duration_s    REAL,
    updated_at    TEXT
);
CREATE INDEX IF NOT EXISTS ix_state ON tasks(state);

CREATE TABLE IF NOT EXISTS events (
    id    INTEGER PRIMARY KEY AUTOINCREMENT,
    ts    TEXT,
    key   TEXT,
    level TEXT,
    msg   TEXT
);
CREATE INDEX IF NOT EXISTS ix_ev_ts ON events(ts);

CREATE TABLE IF NOT EXISTS meta (k TEXT PRIMARY KEY, v TEXT);
"""


class Store:
    """Thread-safe SQLite wrapper. Every write is committed immediately —
    the DB is the source of truth, memory is only a cache."""

    def __init__(self, path: Path):
        path.parent.mkdir(parents=True, exist_ok=True)
        self.path = path
        self._lock = threading.RLock()
        self.db = sqlite3.connect(str(path), check_same_thread=False, timeout=30)
        self.db.row_factory = sqlite3.Row
        with self._lock:
            self.db.executescript(SCHEMA)
            self.db.commit()

    def close(self) -> None:
        with self._lock, contextlib.suppress(Exception):
            self.db.close()

    # -- writes ----------------------------------------------------------
    def enqueue(self, tasks: Iterable[Task]) -> tuple[int, int]:
        new = dup = 0
        with self._lock:
            for t in tasks:
                cur = self.db.execute(
                    "INSERT OR IGNORE INTO tasks "
                    "(key,repo_url,branch,playbooks,goal,cd_repo_url,cd_branch,"
                    " repo_path,user_id,mirror_mode,state,enqueued_at,updated_at) "
                    "VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?)",
                    (t.key, t.repo_url, t.branch, json.dumps(t.playbooks), t.goal,
                     t.cd_repo_url, t.cd_branch, t.repo_path, t.user_id,
                     None if t.mirror_mode is None else int(t.mirror_mode),
                     PENDING, utcnow(), utcnow()),
                )
                if cur.rowcount:
                    new += 1
                else:
                    dup += 1
            self.db.commit()
        return new, dup

    def update(self, key: str, **fields: Any) -> None:
        if not fields:
            return
        fields["updated_at"] = utcnow()
        cols = ",".join(f"{k}=?" for k in fields)
        with self._lock:
            self.db.execute(f"UPDATE tasks SET {cols} WHERE key=?",
                            (*fields.values(), key))
            self.db.commit()

    def event(self, key: str, level: str, msg: str) -> None:
        with self._lock:
            self.db.execute(
                "INSERT INTO events (ts,key,level,msg) VALUES (?,?,?,?)",
                (utcnow(), key, level, msg[:2000]),
            )
            self.db.commit()

    def reset_states(self, states: set[str]) -> int:
        with self._lock:
            qs = ",".join("?" * len(states))
            cur = self.db.execute(
                f"UPDATE tasks SET state=?, run_id=NULL, error=NULL, attempt=0 "
                f"WHERE state IN ({qs})", (PENDING, *states))
            self.db.commit()
            return cur.rowcount

    def set_meta(self, k: str, v: str) -> None:
        with self._lock:
            self.db.execute("INSERT OR REPLACE INTO meta VALUES (?,?)", (k, v))
            self.db.commit()

    # -- reads -----------------------------------------------------------
    def actionable(self, limit: int = 0) -> list[sqlite3.Row]:
        q = ("SELECT * FROM tasks WHERE state IN (?,?) "
             "ORDER BY CASE state WHEN 'RUNNING' THEN 0 ELSE 1 END, rowid")
        if limit:
            q += f" LIMIT {int(limit)}"
        with self._lock:
            return list(self.db.execute(q, (RUNNING, PENDING)))

    def counts(self) -> dict[str, int]:
        with self._lock:
            rows = self.db.execute(
                "SELECT state, COUNT(*) c FROM tasks GROUP BY state")
            return {r["state"]: r["c"] for r in rows}

    def all_rows(self) -> list[sqlite3.Row]:
        with self._lock:
            return list(self.db.execute("SELECT * FROM tasks ORDER BY rowid"))

    def recent_events(self, n: int = 12) -> list[sqlite3.Row]:
        with self._lock:
            return list(self.db.execute(
                "SELECT * FROM events ORDER BY id DESC LIMIT ?", (n,)))

    def durations(self) -> list[float]:
        with self._lock:
            return [r[0] for r in self.db.execute(
                "SELECT duration_s FROM tasks WHERE duration_s IS NOT NULL")]


def row_to_task(r: sqlite3.Row) -> Task:
    return Task(
        repo_url=r["repo_url"], branch=r["branch"] or "main",
        playbooks=json.loads(r["playbooks"] or "[]"), goal=r["goal"] or "",
        cd_repo_url=r["cd_repo_url"] or "", cd_branch=r["cd_branch"] or "",
        repo_path=r["repo_path"] or "", user_id=r["user_id"] or "",
        mirror_mode=None if r["mirror_mode"] is None else bool(r["mirror_mode"]),
    )



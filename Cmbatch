CSV_ALIASES = {
    "repo_url": {"repo_url", "repo", "url", "repository", "repo_link", "git_url"},
    "branch": {"branch", "repo_branch", "ref"},
    "cd_repo_url": {"cd_repo_url", "cd_repo", "ci_repo_url", "ci_repo", "cd_url"},
    "cd_branch": {"cd_branch", "ci_branch"},
    "playbooks": {"playbooks", "playbook_names", "playbook", "skills"},
    "goal": {"goal", "objective"},
    "repo_path": {"repo_path", "path", "module_path"},
    "user_id": {"user_id", "user", "sso", "requester"},
    "mirror_mode": {"mirror_mode", "mirror"},
}


def _canon(header: str) -> Optional[str]:
    h = header.strip().lower().replace(" ", "_").lstrip("\ufeff")
    for canon, names in CSV_ALIASES.items():
        if h in names:
            return canon
    return None


def _split_list(v: str) -> list[str]:
    return [p.strip() for p in v.replace("|", ";").replace(",", ";").split(";")
            if p.strip()]


def load_tasks(cfg: Config) -> list[Task]:
    path = cfg.input_path
    assert path is not None
    if not path.exists():
        raise SystemExit(f"input not found: {path}")

    rows: list[dict[str, str]] = []
    if path.suffix.lower() in {".csv", ".tsv"}:
        delim = "\t" if path.suffix.lower() == ".tsv" else ","
        with path.open(newline="", encoding="utf-8-sig") as fh:
            reader = csv.reader(fh, delimiter=delim)
            try:
                header = next(reader)
            except StopIteration:
                raise SystemExit("empty CSV")
            canon = [_canon(h) for h in header]
            if "repo_url" not in canon:
                # headerless CSV: treat col0 as repo, col1 as branch
                fh.seek(0)
                for parts in csv.reader(fh, delimiter=delim):
                    if parts and parts[0].strip():
                        rows.append({"repo_url": parts[0].strip(),
                                     "branch": parts[1].strip()
                                     if len(parts) > 1 else ""})
            else:
                for parts in reader:
                    if not parts or not any(p.strip() for p in parts):
                        continue
                    row = {}
                    for c, val in zip(canon, parts):
                        if c:
                            row[c] = val.strip()
                    if row.get("repo_url"):
                        rows.append(row)
    else:
        for line in path.read_text(encoding="utf-8-sig").splitlines():
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            parts = [p.strip() for p in line.split(",")]
            rows.append({"repo_url": parts[0],
                         "branch": parts[1] if len(parts) > 1 else ""})

    tasks: list[Task] = []
    for r in rows:
        pb = _split_list(r.get("playbooks", "")) or list(cfg.playbooks)
        if not pb:
            raise SystemExit(
                "no playbooks: pass --playbooks or add a playbooks column")
        if len(pb) > 2:
            raise SystemExit(f"max 2 playbooks per run, got {len(pb)} for "
                             f"{r['repo_url']}")
        mm = r.get("mirror_mode", "")
        tasks.append(Task(
            repo_url=r["repo_url"],
            branch=r.get("branch") or cfg.branch,
            playbooks=pb,
            goal=r.get("goal") or cfg.goal,
            cd_repo_url=r.get("cd_repo_url") or cfg.cd_repo_url,
            cd_branch=r.get("cd_branch") or cfg.cd_branch,
            repo_path=r.get("repo_path") or cfg.repo_path,
            user_id=r.get("user_id") or cfg.user_id,
            mirror_mode=(mm.lower() in {"1", "true", "yes"}) if mm
            else cfg.mirror_mode,
        ))

    # dedupe + shard
    seen: set[str] = set()
    out: list[Task] = []
    for t in tasks:
        if t.key in seen:
            continue
        seen.add(t.key)
        if cfg.shards > 1:
            bucket = int(hashlib.md5(t.key.encode()).hexdigest(), 16) % cfg.shards
            if bucket != cfg.shard:
                continue
        out.append(t)
    return out



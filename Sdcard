def build_arg_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="sd_elements_scan.py",
        description="Deterministic (non-LLM) SD Elements characteristic scanner.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            "Security note: the GitHub token is NEVER accepted as a command-line "
            "argument. Export it into the environment variable named by "
            "--token-env (default GITHUB_TOKEN) before running this script.\n\n"
            "Example:\n"
            "  export GITHUB_TOKEN=ghp_xxx\n"
            "  python3 sd_elements_scan.py --source-repo owner/repo --component repo "
            "--app-id APP-1 --owner platform-eng --mnemonic app-bundle "
            "--data-classification internal"
        ),
    )
    p.add_argument("--source-repo", required=True,
                    help="Source repository as 'owner/repo' or a full GitHub URL.")
    p.add_argument("--source-ref", default=None,
                    help="Branch, tag, or commit SHA to scan. Defaults to the repo's default branch.")
    p.add_argument("--source-subdir", default=None,
                    help="Restrict scanning to this subdirectory within the source repo (for monorepos).")
    p.add_argument("--cd-repo", default=None,
                    help="Optional CD/deployment repository as 'owner/repo' or a full GitHub URL.")
    p.add_argument("--cd-ref", default=None,
                    help="Branch, tag, or commit SHA for the CD repo. Defaults to its default branch.")

    p.add_argument("--component", required=True, help="Component name (used in output filename and title).")
    p.add_argument("--app-id", required=True, help="Application ID to record in meta.app_id.")
    p.add_argument("--owner", required=True, help="Owning team/org value to record in meta.owner.")
    p.add_argument("--mnemonic", required=True,
                    help="Application bundle mnemonic used to construct the output path.")
    p.add_argument("--data-classification", required=True, choices=["internal", "confidential", "restricted"],
                    help="Data classification for meta.data_classification. Not derivable from code — must be supplied.")

    p.add_argument("--access-scope", default="team", help="Value for meta.access_scope (default: team).")
    p.add_argument("--tags", default="sd-elements,security-requirements,appsec",

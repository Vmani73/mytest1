# JSON assembly
# --------------------------------------------------------------------------

def build_document(args: argparse.Namespace, idx: RepoIndex, source_url: str, head_sha: str) -> dict:
    web_app, web_app_ev = detect_web_application(idx)
    mobile, mobile_ev = detect_mobile_app(idx)
    standalone, standalone_ev = detect_stand_alone(idx, has_web_app=web_app)
    containerized, containerized_ev = detect_containerization(idx)
    consumes_apis, consumes_apis_ev = detect_consumes_apis(idx)
    script_batch, script_batch_ev = detect_script_batch_shell(idx, has_web_app=web_app)
    mainframe, mainframe_ev = detect_mainframe(idx)

    application_type = [
        {"name": "web_application_service_or_web_ui", "detected": web_app, "evidence": web_app_ev},
        {"name": "mobile_app", "detected": mobile, "evidence": mobile_ev},
        {"name": "stand_alone", "detected": standalone, "evidence": standalone_ev},
        {"name": "containerization_solution", "detected": containerized, "evidence": containerized_ev},
        {"name": "consumes_apis", "detected": consumes_apis, "evidence": consumes_apis_ev},
        {"name": "script_batch_shell", "detected": script_batch, "evidence": script_batch_ev},
        {"name": "mainframe", "detected": mainframe, "evidence": mainframe_ev},
    ]

    ext_comp, ext_comp_ev = detect_external_components(idx, args.internal_package_prefixes)
    uploads, uploads_ev = detect_file_uploads(idx)
    secrets, _, secrets_ev = detect_secrets_sensitive_data(idx)
    deserial, deserial_ev = detect_deserialization(idx)
    http_proto, http_proto_ev = detect_http_protocol(idx)

    functional_attributes = [
        {"name": "includes_external_components_or_libraries", "detected": ext_comp, "evidence": ext_comp_ev},
        {"name": "allows_file_uploads", "detected": uploads, "evidence": uploads_ev},
        {"name": "manages_uses_or_owns_secrets_or_sensitive_data", "detected": secrets, "evidence": secrets_ev},
        {"name": "application_deserializes_data", "detected": deserial, "evidence": deserial_ev},
        {"name": "uses_http_based_protocol", "detected": http_proto, "evidence": http_proto_ev},
    ]

    paa_hits, non_paa_hits = _paa_signals(idx)
    (selected_classification, classification_ev, classification_direct,
     classification_conf, classification_notes) = decide_classification(paa_hits, non_paa_hits)
    selected_tier, tier_ev, tier_direct, tier_conf, tier_notes = decide_tier(idx, paa_hits)

    has_content = idx.scanned_file_count > 0

    # A capability group counts as "resolved with direct code evidence" when at
    # least one of its attributes was positively detected from a real signal.
    # An all-false group was resolved by absence of signals, which the
    # Confidence Scoring table treats as inference, not direct evidence.
    app_type_direct = any(a["detected"] for a in application_type)
    func_attr_direct = any(a["detected"] for a in functional_attributes)

    app_type_conf = group_confidence(app_type_direct, has_content)
    func_attr_conf = group_confidence(func_attr_direct, has_content)
    if not has_content:
        tier_conf = "low"
        classification_conf = "low"

    overall_confidence = overall_confidence_from_groups(
        [app_type_direct and has_content, func_attr_direct and has_content,
         tier_direct and has_content, classification_direct and has_content]
    )

    app_type_notes = "" if app_type_direct else (
        "No Application Type attribute was positively detected; this group was resolved by "
        "absence of signals and requires manual review.")
    func_attr_notes = "" if func_attr_direct else (
        "No Functional Attribute was positively detected; this group was resolved by absence "
        "of signals and requires manual review.")
    if idx.truncated:
        trunc = (" The file index was truncated at the configured --max-total-files cap, so "
                  "coverage may be incomplete.")
        app_type_notes = (app_type_notes + trunc).strip()
        func_attr_notes = (func_attr_notes + trunc).strip()

    now_iso = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    provenance = f"{source_url}/commit/{head_sha}"

    tags = [t.strip() for t in args.tags.split(",") if t.strip()]

    doc = {
        "meta": {
            "type": "Application Knowledge",
            "title": f"SD Elements — {args.component}",
            "description": "SD Elements application characteristics derived from source code",
            "app_id": args.app_id,
            "data_classification": args.data_classification,
            "access_scope": args.access_scope,
            "owner": args.owner,
            "provenance": provenance,
            "tags": tags,
            "timestamp": now_iso,
            "confidence": overall_confidence,
            "generated_by": args.generated_by,
        },
        "application_type": application_type,
        "functional_attributes": functional_attributes,
        "security_tier": {
            "selected_tier": selected_tier,
            "evidence": tier_ev,
        },
        "application_classification": {
            "selected_classification": selected_classification,
            "evidence": classification_ev,
        },
        "detection_summary": {
            "application_type": {
                "values_detected": [a["name"] for a in application_type if a["detected"]],
                "confidence": app_type_conf,
                "notes": app_type_notes,
            },
            "functional_attributes": {
                "values_detected": [a["name"] for a in functional_attributes if a["detected"]],
                "confidence": func_attr_conf,
                "notes": func_attr_notes,
            },
            "security_tier": {
                "value": selected_tier,
                "confidence": tier_conf,
                "notes": tier_notes,
            },
            "classification": {
                "value": selected_classification,
                "confidence": classification_conf,
                "notes": classification_notes,
            },
        },
    }
    return doc


# --------------------------------------------------------------------------
# Output schema validation — hard-fails rather than emitting a malformed file
# --------------------------------------------------------------------------

def validate_document(doc: dict) -> None:
    errors = []

    def req(cond: bool, msg: str):
        if not cond:
            errors.append(msg)

    meta = doc.get("meta", {})
    for key in ("type", "title", "description", "app_id", "data_classification", "access_scope",
                "owner", "provenance", "tags", "timestamp", "confidence", "generated_by"):
        req(key in meta, f"meta.{key} is missing")
    req(meta.get("data_classification") in ("internal", "confidential", "restricted"),
        "meta.data_classification must be one of internal|confidential|restricted")
    req(meta.get("confidence") in ("high", "medium", "low"),
        "meta.confidence must be one of high|medium|low")
    req(isinstance(meta.get("tags"), list) and len(meta.get("tags", [])) > 0,
        "meta.tags must be a non-empty list")

    app_types = doc.get("application_type")
    req(isinstance(app_types, list) and len(app_types) > 0, "application_type must be a non-empty list")
    if isinstance(app_types, list):
        names = [a.get("name") for a in app_types]
        req("mainframe" in names, "application_type must include an item with name 'mainframe'")
        req(any(a.get("detected") is True for a in app_types),
            "Section 1 requires at least one application_type to be detected, but none matched. "
            "This usually means the scan scope was wrong (check --source-subdir) or the stack is "
            "not covered by the ruleset. Review manually rather than submitting this artifact.")

    func_attrs = doc.get("functional_attributes")
    req(isinstance(func_attrs, list) and len(func_attrs) > 0, "functional_attributes must be a non-empty list")

    # Output Rules: detected must be boolean; evidence must be natural English with a
    # citation; detected:true => 2-3 sentences; detected:false => 1 sentence.
    for section_name, section in (("application_type", app_types), ("functional_attributes", func_attrs)):
        if not isinstance(section, list):
            continue
        for a in section:
            label = f"{section_name}[{a.get('name')}]"
            detected = a.get("detected")
            evidence = a.get("evidence")
            req(isinstance(detected, bool), f"{label}.detected must be a boolean, not a string")
            req(isinstance(evidence, str) and len(evidence.strip()) > 0,
                f"{label}.evidence must be a non-empty string")
            if isinstance(evidence, str) and evidence.strip():
                n = count_sentences(evidence)
                if detected is True:
                    req(2 <= n <= 3,
                        f"{label}.evidence must be 2-3 sentences for detected:true (found {n}): "
                        f"{evidence[:120]}...")
                    # Output Rules: evidence must name the specific file/class/config
                    # where the signal was found. Citations are rendered as
                    # "<repo>:<path>[:<line>]" by the evidence templater.
                    req(re.search(r"\b(source|cd):[^\s,)]+", evidence) is not None,
                        f"{label}.evidence for detected:true must cite a specific file/class "
                        f"where the signal was found: {evidence[:120]}...")
                elif detected is False:
                    req(n == 1,
                        f"{label}.evidence must be exactly 1 sentence for detected:false "
                        f"(found {n}): {evidence[:120]}...")

    # No placeholders anywhere in the emitted document.
    rendered = json.dumps(doc)
    for placeholder in ("{component}", "{AppId}", "{mnemonic}", "<ISO-8601>", "<internal |",
                        "<high |", "TODO", "PLACEHOLDER", "{input_memory_store",
                        "BOOTSTRAP_SOURCE_URL", "{HEAD_SHA}"):
        req(placeholder not in rendered,
            f"Unresolved placeholder '{placeholder}' found in the generated document")

    tier = doc.get("security_tier", {})
    req(tier.get("selected_tier") in ("Tier 1", "Tier 2", "Tier 3"),
        "security_tier.selected_tier must be exactly one of 'Tier 1', 'Tier 2', 'Tier 3'")
    req(isinstance(tier.get("evidence"), str) and len(tier.get("evidence", "")) > 0,
        "security_tier.evidence must be a non-empty string")

    cls = doc.get("application_classification", {})
    req(cls.get("selected_classification") in ("PAA", "Non PAA Application"),
        "application_classification.selected_classification must be exactly one of 'PAA', 'Non PAA Application'")
    req(isinstance(cls.get("evidence"), str) and len(cls.get("evidence", "")) > 0,
        "application_classification.evidence must be a non-empty string")

    summary = doc.get("detection_summary", {})
    for group in ("application_type", "functional_attributes", "security_tier", "classification"):
        g = summary.get(group)
        req(isinstance(g, dict), f"detection_summary.{group} is missing")
        if isinstance(g, dict):
            req(g.get("confidence") in ("high", "medium", "low"),
                f"detection_summary.{group}.confidence must be one of high|medium|low")

    if errors:
        raise ScanError("Generated document failed schema validation:\n  - " + "\n  - ".join(errors))



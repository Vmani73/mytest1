def detect_secrets_sensitive_data(idx: RepoIndex) -> Tuple[bool, List[Hit], str]:
    vault_hits = idx.scan([
        (r"spring\.cloud\.vault", "spring.cloud.vault config"),
        (r"vault\.hashicorp\.com", "vault.hashicorp.com annotation"),
        (r"secretKeyRef", "K8s secretKeyRef"),
    ])
    value_secret_hits = idx.scan([
        (r"@Value\s*\(\s*\"\$\{[^}]*(password|secret|credential)[^}]*\}\"", "@Value referencing password/secret/credential"),
    ], extensions=[".java", ".kt"])
    crypto_hits = idx.scan([
        (r"\bCipher\b", "Cipher"), (r"\bKeyStore\b", "KeyStore"),
        (r"\bSecretKey\b", "SecretKey"), (r"\bBCryptPasswordEncoder\b", "BCryptPasswordEncoder"),
    ], extensions=[".java", ".kt", ".cs", ".py", ".js", ".ts"])
    pii_hits = idx.scan(
        [(r"\b(" + "|".join(re.escape(tok) for tok in PII_FIELD_TOKENS) + r")\b", "PII field identifier")],

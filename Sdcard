def detect_script_batch_shell(idx: RepoIndex, has_web_app: bool) -> Tuple[bool, str]:
    hits = idx.scan([
        (r"@EnableBatchProcessing\b", "@EnableBatchProcessing"),
        (r"@Scheduled\b", "@Scheduled"),
        (r"\bJobLauncher\b", "JobLauncher (Spring Batch)"),
        (r"\bItemReader\b", "ItemReader (Spring Batch)"),
        (r"\bItemWriter\b", "ItemWriter (Spring Batch)"),
        (r"\bQuartz\b", "Quartz scheduler"),
        (r"\bCronTrigger\b", "CronTrigger"),
    ], extensions=[".java", ".kt", ".xml"])
    sh_files = idx.files_with_ext(".sh") + idx.files_with_ext(".bash")
    jil_hits = idx.scan([(r"insert_job:|job_type:\s*(CMD|BOX)", "AutoSys JIL job definition")],
                         extensions=[".jil"]) + [
        Hit(t, rp, 0, "", "AutoSys JIL file") for t, rp in idx.files_with_ext(".jil")
    ]
    all_hits = hits + jil_hits
    # .sh/.bash files alone are only treated as a positive signal when the
    # component was NOT already classified as a web application and shell
    # scripts make up a majority of the (small) set of scanned source files —
    # this avoids flagging every repo that merely ships a build/deploy helper
    # script as a "script/batch/shell" application.
    if not has_web_app and sh_files:
        code_like = [rp for _, rp in idx.relpaths()
                     if Path(rp).suffix.lower() in (".sh", ".bash", ".py", ".java", ".kt", ".js", ".ts", ".go", ".rb")]
        if code_like and (len(sh_files) / max(1, len(code_like))) > 0.5:
            all_hits = all_hits + [Hit(t, rp, 0, "", "shell script as majority file type") for t, rp in sh_files[:3]]
    if all_hits:
        return True, true_evidence(
            "Spring Batch/Quartz scheduling constructs, an AutoSys JIL definition, or a "
            "shell-script-majority file layout were found.",
            all_hits, "this component operates as a batch/scheduled/shell-script application")
    return False, false_evidence(
        "@EnableBatchProcessing, @Scheduled, JobLauncher/ItemReader/ItemWriter, Quartz/"
        "CronTrigger, AutoSys .jil files, and a shell-script-majority file layout")


def detect_mainframe(idx: RepoIndex) -> Tuple[bool, str]:

SCRIPT_VERSION = "1.0.0"

# --------------------------------------------------------------------------
# Constants: filesystem scanning
# --------------------------------------------------------------------------

SKIP_DIR_NAMES = {
    ".git", "node_modules", "dist", "build", "target", ".gradle", "vendor",
    "__pycache__", ".idea", ".vscode", "out", "bin", "obj", "coverage",
    ".next", ".nuxt", ".venv", "venv", ".tox", ".pytest_cache", "eggs",
    ".mypy_cache", "site-packages",
}

BINARY_SKIP_EXTENSIONS = {
    ".png", ".jpg", ".jpeg", ".gif", ".ico", ".svg", ".woff", ".woff2",
    ".ttf", ".eot", ".otf", ".jar", ".war", ".ear", ".class", ".zip",
    ".tar", ".gz", ".7z", ".rar", ".pdf", ".exe", ".dll", ".so", ".dylib",
    ".bin", ".pyc", ".pyo", ".webp", ".bmp", ".mp4", ".mp3",
    ".avi", ".mov", ".wasm", ".lock",
}

# Prose/documentation file types are excluded from indexing entirely. No rule
# in the source ruleset treats documentation content as valid code evidence,
# and README/CHANGELOG example snippets ("here's how to configure CORS: ...")
# are a systematic source of false positives for keyword-based scanning if
# left in the corpus. This affects every detector uniformly rather than
# patching individual regexes.
DOC_SKIP_EXTENSIONS = {
    ".md", ".markdown", ".rst", ".txt", ".adoc", ".rdoc", ".rtf",
}

DEFAULT_MAX_FILE_SIZE_KB = 512
DEFAULT_MAX_TOTAL_FILES = 20000

# Conventional test-path markers. Used ONLY to exclude test fixtures/assertions
# from risk-scoring detectors (Security Tier, PAA/Classification) — test code
# routinely contains synthetic PII, placeholder payment fields, and permissive
# CORS/auth configuration for the sole purpose of exercising the code under
# test, none of which reflects production risk posture. Capability detectors
# (Application Type, Functional Attributes) intentionally do NOT apply this
# filter, since "the codebase contains deserialization logic" is still true
# even if the only call site found happens to sit in a test file.
TEST_PATH_PATTERN = re.compile(
    r"(^|/)(test|tests|__tests__|spec|specs|src/test)(/|$)|"
    r"(Test|Tests|IT)\.(java|kt|cs)$|"
    r"\.(test|spec)\.(js|ts|tsx|jsx)$|"
    r"test_[\w]+\.py$|[\w]+_test\.py$",
    re.IGNORECASE,
)


def is_test_path(relpath: str) -> bool:
    return bool(TEST_PATH_PATTERN.search(relpath))

GITHUB_TARBALL_ACCEPT = "application/vnd.github+json"


# --------------------------------------------------------------------------
# Error types
# --------------------------------------------------------------------------

class ScanError(RuntimeError):
    """Raised for any condition that should hard-stop the scan with a clear message."""


# --------------------------------------------------------------------------
# Data model
# --------------------------------------------------------------------------

@dataclasses.dataclass(frozen=True)
class Hit:
    """A single positive signal match found during scanning."""
    repo: str            # "source" or "cd"
    path: str             # path relative to repo root
    line: int              # 1-indexed line number, 0 if not line-addressable (e.g. filename match)
    snippet: str            # the matched line/content, truncated
    signal: str               # human-readable description of what this hit represents

    def cite(self) -> str:
        if self.line:
            return f"{self.repo}:{self.path}:{self.line}"
        return f"{self.repo}:{self.path}"


@dataclasses.dataclass(frozen=True)
class Dependency:
    """A single dependency coordinate extracted from a manifest file."""
    repo: str
    manifest: str
    coordinate: str      # e.g. "org.springframework.boot:spring-boot-starter-web" or "axios"
    raw_name: str          # the bare package/artifact name for prefix matching


# --------------------------------------------------------------------------
# GitHub fetch layer — header-based auth only, stdlib only, no git binary
# --------------------------------------------------------------------------

def parse_owner_repo(value: str) -> Tuple[str, str]:
    """Accepts 'owner/repo', a full https URL, or a git URL and returns (owner, repo)."""
    value = value.strip()
    if value.startswith("http://") or value.startswith("https://"):
        parsed = urllib.parse.urlparse(value)
        parts = [p for p in parsed.path.split("/") if p]
        if len(parts) < 2:
            raise ScanError(f"Could not parse owner/repo from URL: {value}")
        owner, repo = parts[0], parts[1]
    elif "/" in value:
        owner, repo = value.split("/", 1)
    else:
        raise ScanError(
            f"Repository '{value}' must be in 'owner/repo' form or a full GitHub URL."
        )
    repo = repo[:-4] if repo.endswith(".git") else repo
    if not owner or not repo:
        raise ScanError(f"Could not parse owner/repo from: {value}")
    return owner, repo


def _github_request(url: str, token: str, accept: str) -> urllib.request.Request:
    headers = {
        "Accept": accept,
        "User-Agent": f"sd-elements-deterministic-scanner/{SCRIPT_VERSION}",
        "X-GitHub-Api-Version": "2022-11-28",
    }
    if token:
        headers["Authorization"] = f"Bearer {token}"
    return urllib.request.Request(url, headers=headers)


def _sleep_for_retry(resp_headers, attempt: int) -> float:
    """
    Computes a backoff delay honoring GitHub's Retry-After / X-RateLimit-Reset
    headers when present, otherwise exponential backoff.
    """
    if resp_headers:
        retry_after = resp_headers.get("Retry-After")
        if retry_after:
            try:
                return min(float(retry_after), 120.0)
            except ValueError:
                pass
        remaining = resp_headers.get("X-RateLimit-Remaining")
        reset = resp_headers.get("X-RateLimit-Reset")
        if remaining == "0" and reset:
            try:
                delta = float(reset) - time.time()
                if 0 < delta <= 300:
                    return delta + 1
            except ValueError:
                pass
    return min(2.0 ** attempt, 60.0)


def _urlopen_with_retry(req: urllib.request.Request, timeout: int, max_attempts: int = 4):
    """
    Opens a request, retrying on 429 (rate limit) and 5xx (transient server
    errors). 401/403-with-no-rate-limit/404 are not retried — those are
    deterministic failures the caller must surface immediately.
    """
    last_error: Optional[Exception] = None
    for attempt in range(max_attempts):
        try:
            return urllib.request.urlopen(req, timeout=timeout)
        except urllib.error.HTTPError as e:
            retryable = e.code == 429 or 500 <= e.code < 600
            if e.code == 403 and e.headers and e.headers.get("X-RateLimit-Remaining") == "0":
                retryable = True
            if not retryable or attempt == max_attempts - 1:
                raise
            delay = _sleep_for_retry(e.headers, attempt)
            print(f"      transient GitHub error {e.code}; retrying in {delay:.0f}s "
                  f"(attempt {attempt + 2}/{max_attempts})", file=sys.stderr)
            time.sleep(delay)
            last_error = e
        except urllib.error.URLError as e:
            if attempt == max_attempts - 1:
                raise
            delay = min(2.0 ** attempt, 30.0)
            print(f"      network error; retrying in {delay:.0f}s "
                  f"(attempt {attempt + 2}/{max_attempts})", file=sys.stderr)
            time.sleep(delay)
            last_error = e
    if last_error:
        raise last_error
    raise ScanError("Request failed with no recorded error.")


def github_get_json(url: str, token: str, timeout: int = 60) -> dict:
    req = _github_request(url, token, GITHUB_TARBALL_ACCEPT)
    try:
        with _urlopen_with_retry(req, timeout) as resp:
            return json.loads(resp.read().decode("utf-8"))
    except urllib.error.HTTPError as e:
        body = ""
        try:
            body = e.read().decode("utf-8", errors="replace")[:500]
        except Exception:
            pass
        if e.code == 401:
            raise ScanError(
                "GitHub API returned 401 Unauthorized. The token is missing, "
                "expired, or invalid. Check the environment variable it was "
                "read from."
            ) from e
        if e.code == 403:
            raise ScanError(
                f"GitHub API returned 403 Forbidden for {url}. This is either "
                "a rate limit or the token lacks access to this repository "
                f"(SSO authorization, org access, or scope). Response: {body}"
            ) from e
        if e.code == 404:
            raise ScanError(
                f"GitHub API returned 404 Not Found for {url}. Verify the "
                "owner/repo name and that the token has read access to it."
            ) from e
        raise ScanError(f"GitHub API error {e.code} for {url}: {body}") from e
    except urllib.error.URLError as e:
        raise ScanError(f"Network error contacting GitHub API ({url}): {e}") from e


def github_download_tarball(
    api_base: str, owner: str, repo: str, ref: str, token: str, dest_file: Path,
    timeout: int = 180,
) -> None:
    url = f"{api_base}/repos/{owner}/{repo}/tarball/{urllib.parse.quote(ref)}"
    req = _github_request(url, token, "application/octet-stream")
    try:
        with _urlopen_with_retry(req, timeout) as resp:
            with open(dest_file, "wb") as f:
                shutil.copyfileobj(resp, f)
    except urllib.error.HTTPError as e:
        if e.code == 401:
            raise ScanError("GitHub tarball download: 401 Unauthorized (bad/expired token).") from e
        if e.code == 404:
            raise ScanError(
                f"GitHub tarball download: 404 Not Found for {owner}/{repo}@{ref}. "
                "Verify the repo name and ref (branch/tag/sha) exist and the "
                "token can read this repository."
            ) from e
        raise ScanError(f"GitHub tarball download failed ({e.code}) for {owner}/{repo}@{ref}.") from e
    except urllib.error.URLError as e:
        raise ScanError(f"Network error downloading tarball for {owner}/{repo}@{ref}: {e}") from e


def fetch_repo_snapshot(
    api_base: str, owner: str, repo: str, ref: Optional[str],
    token: str, work_dir: Path,
) -> Tuple[Path, str, str]:
    """
    Resolves ref -> commit SHA via the API, downloads + extracts the tarball.
    Returns (extracted_root_path, resolved_ref, commit_sha).
    """
    meta = github_get_json(f"{api_base}/repos/{owner}/{repo}", token)
    resolved_ref = ref or meta.get("default_branch")
    if not resolved_ref:
        raise ScanError(f"Could not resolve a default branch for {owner}/{repo}; pass --source-ref explicitly.")

    commit = github_get_json(
        f"{api_base}/repos/{owner}/{repo}/commits/{urllib.parse.quote(resolved_ref)}", token
    )
    sha = commit["sha"]

    tarball_path = work_dir / f"{owner}-{repo}-{sha[:12]}.tar.gz"
    github_download_tarball(api_base, owner, repo, resolved_ref, token, tarball_path)

    extract_dir = work_dir / f"{owner}-{repo}-{sha[:12]}-extracted"
    extract_dir.mkdir(parents=True, exist_ok=True)
    with tarfile.open(tarball_path, "r:gz") as tf:
        base = extract_dir.resolve()
        # Reject absolute paths, traversal, and links pointing outside the
        # extraction root. Symlink/hardlink members are rejected outright:
        # a source snapshot never needs them, and they are the standard
        # tarball-escape vector that a naive path check misses.
        for member in tf.getmembers():
            if member.issym() or member.islnk():
                raise ScanError(
                    f"Refusing to extract link member from tarball: {member.name}")
            member_path = (extract_dir / member.name).resolve()
            if not str(member_path).startswith(str(base) + os.sep) and member_path != base:
                raise ScanError(f"Refusing to extract unsafe tarball member: {member.name}")
        # Python 3.12+ supports extraction filters; use the strictest available.
        try:
            tf.extractall(extract_dir, filter="data")
        except TypeError:
            tf.extractall(extract_dir)

    top_level = [p for p in extract_dir.iterdir() if p.is_dir()]
    if len(top_level) != 1:
        raise ScanError(
            f"Unexpected tarball layout for {owner}/{repo}@{resolved_ref} "
            f"(expected exactly one top-level directory, found {len(top_level)})."
        )
    tarball_path.unlink(missing_ok=True)
    return top_level[0], resolved_ref, sha


# --------------------------------------------------------------------------
# Repository indexing: file content cache + manifest dependency extraction
# --------------------------------------------------------------------------

class RepoIndex:
    """
    Reads every eligible text file under one or more repo roots into memory
    once, and exposes regex scanning + basename/dir lookups + dependency
    lists over that cache. "eligible" = not in a skip-dir, not a binary
    extension, under the size cap.
    """

    def __init__(self, max_file_size_kb: int = DEFAULT_MAX_FILE_SIZE_KB,
                 max_total_files: int = DEFAULT_MAX_TOTAL_FILES):
        self.max_file_size_bytes = max_file_size_kb * 1024
        self.max_total_files = max_total_files
        self._roots: Dict[str, Path] = {}          # repo_tag -> root path
        self._files: Dict[str, List[str]] = {}       # repo_tag -> list of relpaths (posix)
        self._contents: Dict[Tuple[str, str], str] = {}  # (repo_tag, relpath) -> text
        self.dependencies: List[Dependency] = []
        self.scanned_file_count = 0
        self.truncated = False
        # Files skipped for exceeding --max-file-size-kb. Tracked and reported
        # because a silently skipped oversized SecurityConfig or pom.xml is a
        # false-negative source the operator must be able to see.
        self.oversized_skipped: List[str] = []

    def add_root(self, repo_tag: str, root: Path) -> None:
        self._roots[repo_tag] = root
        self._files[repo_tag] = []
        # The cap is applied per repository root, matching the CLI help text.
        indexed_in_this_root = 0
        for dirpath, dirnames, filenames in os.walk(root):
            dirnames[:] = [d for d in dirnames if d not in SKIP_DIR_NAMES and not d.startswith(".git")]
            for fname in filenames:
                if indexed_in_this_root >= self.max_total_files:
                    self.truncated = True
                    break
                fpath = Path(dirpath) / fname
                relpath = fpath.relative_to(root).as_posix()
                ext = fpath.suffix.lower()
                if ext in BINARY_SKIP_EXTENSIONS or ext in DOC_SKIP_EXTENSIONS:
                    continue
                try:
                    size = fpath.stat().st_size
                except OSError:
                    continue
                if size == 0:
                    continue
                if size > self.max_file_size_bytes:
                    self.oversized_skipped.append(f"{repo_tag}:{relpath}")
                    continue
                text = self._read_text(fpath)
                if text is None:
                    continue
                self._files[repo_tag].append(relpath)
                self._contents[(repo_tag, relpath)] = text
                self.scanned_file_count += 1
                indexed_in_this_root += 1
                self._maybe_parse_manifest(repo_tag, relpath, text)
            if indexed_in_this_root >= self.max_total_files:
                self.truncated = True
                break

    def content(self, repo_tag: str, relpath: str) -> str:
        """Public accessor for indexed file content."""
        return self._contents.get((repo_tag, relpath), "")

    @staticmethod
    def _read_text(path: Path) -> Optional[str]:
        """
        Reads a file as text, or returns None if it is not text.

        An extension denylist alone is insufficient: latin-1 decodes *any*
        byte sequence successfully, so an unlisted binary extension (.dat,
        .pack, proprietary formats) would be decoded into garbage and then
        regex-scanned, producing spurious signal hits. A NUL byte in the
        first block is the standard, cheap binary heuristic.
        """
        try:
            with open(path, "rb") as f:
                head = f.read(8192)
        except OSError:
            return None
        if b"\x00" in head:
            return None
        for enc in ("utf-8", "latin-1"):
            try:
                with open(path, "r", encoding=enc) as f:
                    return f.read()
            except (UnicodeDecodeError, OSError):
                continue
        return None

    # -- lookups -----------------------------------------------------------

    def repo_tags(self) -> List[str]:
        return list(self._roots.keys())

    def relpaths(self, repo_tag: Optional[str] = None) -> List[Tuple[str, str]]:
        """Returns list of (repo_tag, relpath) across the requested scope."""
        tags = [repo_tag] if repo_tag else self.repo_tags()
        out = []
        for t in tags:
            for rp in self._files.get(t, []):
                out.append((t, rp))
        return out

    def has_basename(self, basename: str, repo_tag: Optional[str] = None) -> List[Hit]:
        hits = []
        for t, rp in self.relpaths(repo_tag):
            if Path(rp).name == basename:
                hits.append(Hit(t, rp, 0, "", f"file present: {basename}"))
        return hits

    def files_with_ext(self, ext: str, repo_tag: Optional[str] = None) -> List[Tuple[str, str]]:
        ext = ext.lower()
        return [(t, rp) for t, rp in self.relpaths(repo_tag) if rp.lower().endswith(ext)]

    def scan(
        self, patterns: Sequence[Tuple[str, str]], repo_tag: Optional[str] = None,
        extensions: Optional[Sequence[str]] = None, name_filter_substrings: Optional[Sequence[str]] = None,
        max_hits: int = 25, exclude_test_paths: bool = False,
    ) -> List[Hit]:
        """
        patterns: list of (regex_str, signal_description)
        extensions: if given, only scan files whose suffix is in this list
        name_filter_substrings: if given, only scan files whose basename contains one of these
        exclude_test_paths: if True, skip files under conventional test directories/naming
            (see TEST_PATH_PATTERN). Used by risk-scoring detectors only — see module note.
        """
        compiled = [(re.compile(p), desc) for p, desc in patterns]
        hits: List[Hit] = []
        for t, rp in self.relpaths(repo_tag):
            if exclude_test_paths and is_test_path(rp):
                continue
            if extensions is not None and Path(rp).suffix.lower() not in extensions:
                continue
            if name_filter_substrings is not None:
                base = Path(rp).name
                if not any(s in base for s in name_filter_substrings):
                    continue
            text = self._contents.get((t, rp))
            if text is None:
                continue
            for regex, desc in compiled:
                m = regex.search(text)
                if m:
                    line_no = text.count("\n", 0, m.start()) + 1
                    line_text = text.splitlines()[line_no - 1].strip() if line_no <= len(text.splitlines()) else m.group(0)
                    hits.append(Hit(t, rp, line_no, line_text[:220], desc))
                    if len(hits) >= max_hits:
                        return hits
        return hits

    # -- manifest dependency extraction -------------------------------------

    def _maybe_parse_manifest(self, repo_tag: str, relpath: str, text: str) -> None:
        base = Path(relpath).name
        try:
            if base == "pom.xml":
                self.dependencies.extend(self._parse_pom(repo_tag, relpath, text))
            elif base == "package.json":
                self.dependencies.extend(self._parse_package_json(repo_tag, relpath, text))
            elif base in ("build.gradle", "build.gradle.kts"):
                self.dependencies.extend(self._parse_build_gradle(repo_tag, relpath, text))
            elif base == "requirements.txt":
                self.dependencies.extend(self._parse_requirements_txt(repo_tag, relpath, text))
            elif base == "go.mod":
                self.dependencies.extend(self._parse_go_mod(repo_tag, relpath, text))
            elif base.endswith(".csproj"):
                self.dependencies.extend(self._parse_csproj(repo_tag, relpath, text))
        except Exception:
            # A malformed manifest must not abort the whole scan; it simply
            # contributes zero dependency evidence from that one file.
            pass

    @staticmethod
    def _parse_pom(repo_tag: str, relpath: str, text: str) -> List[Dependency]:
        import xml.etree.ElementTree as ET
        deps = []
        try:
            root = ET.fromstring(text)
        except ET.ParseError:
            return deps
        for dep in root.iter():
            if dep.tag.endswith("}dependency") or dep.tag == "dependency":
                gid, aid = None, None
                for child in dep:
                    local = child.tag.split("}")[-1]
                    if local == "groupId":
                        gid = (child.text or "").strip()
                    elif local == "artifactId":
                        aid = (child.text or "").strip()
                if gid and aid:
                    deps.append(Dependency(repo_tag, relpath, f"{gid}:{aid}", gid))
        return deps

    @staticmethod
    def _parse_package_json(repo_tag: str, relpath: str, text: str) -> List[Dependency]:
        deps = []
        try:
            data = json.loads(text)
        except json.JSONDecodeError:
            return deps
        for key in ("dependencies", "devDependencies", "peerDependencies", "optionalDependencies"):
            for name in (data.get(key) or {}).keys():
                deps.append(Dependency(repo_tag, relpath, name, name))
        return deps

    @staticmethod
    def _parse_build_gradle(repo_tag: str, relpath: str, text: str) -> List[Dependency]:
        deps = []
        # Covers: implementation("group:artifact:version") / 'group:artifact:version'
        for m in re.finditer(
            r"""(?:implementation|api|compile|runtimeOnly|testImplementation|compileOnly|annotationProcessor)"""
            r"""\s*[\(\s]\s*['"]([\w.\-]+):([\w.\-]+):[\w.\-\+]+['"]""",
            text,
        ):
            gid, aid = m.group(1), m.group(2)
            deps.append(Dependency(repo_tag, relpath, f"{gid}:{aid}", gid))
        # Covers: implementation group: 'g', name: 'n', version: 'v'
        for m in re.finditer(
            r"""group:\s*['"]([\w.\-]+)['"]\s*,\s*name:\s*['"]([\w.\-]+)['"]""",
            text,
        ):
            gid, aid = m.group(1), m.group(2)
            deps.append(Dependency(repo_tag, relpath, f"{gid}:{aid}", gid))
        return deps

    @staticmethod
    def _parse_requirements_txt(repo_tag: str, relpath: str, text: str) -> List[Dependency]:
        deps = []
        for line in text.splitlines():
            line = line.strip()
            if not line or line.startswith("#") or line.startswith("-"):
                continue
            name = re.split(r"[=<>!~;\[]", line)[0].strip()
            if name:
                deps.append(Dependency(repo_tag, relpath, name, name))
        return deps

    @staticmethod
    def _parse_go_mod(repo_tag: str, relpath: str, text: str) -> List[Dependency]:
        deps = []
        for m in re.finditer(r"^\s*([\w.\-/]+)\s+v[\w.\-+]+", text, re.MULTILINE):
            mod = m.group(1)
            if mod in ("go", "module"):
                continue
            deps.append(Dependency(repo_tag, relpath, mod, mod))
        return deps

    @staticmethod
    def _parse_csproj(repo_tag: str, relpath: str, text: str) -> List[Dependency]:
        deps = []
        for m in re.finditer(r'<PackageReference\s+Include="([^"]+)"', text):
            name = m.group(1)
            deps.append(Dependency(repo_tag, relpath, name, name))
        return deps


# --------------------------------------------------------------------------
# Evidence text templating
# --------------------------------------------------------------------------

def _cite_list(hits: Sequence[Hit], limit: int = 3) -> str:
    seen, out = set(), []
    for h in hits:
        c = h.cite()
        if c not in seen:
            seen.add(c)
            out.append(c)
        if len(out) >= limit:
            break
    return ", ".join(out)


def count_sentences(text: str) -> int:
    """
    Counts sentences for Output Rules enforcement (detected:true => 2-3
    sentences; detected:false => 1 sentence). A boundary is a terminal
    punctuation mark followed by whitespace and a capital letter, which
    avoids miscounting file paths ('Owner.java:151'), version numbers, and
    abbreviations ('e.g. ssn').
    """
    if not text.strip():
        return 0
    return len(re.findall(r"[.!?]\s+[A-Z]", text)) + 1


def true_evidence(what_found: str, hits: Sequence[Hit], confirms: str, context: str = "") -> str:
    """
    Evidence string for detected=true. Per Output Rules this must be 2-3
    sentences: (1) what was found and where, (2) what it confirms, and
    optionally (3) security-relevant context.

    Citations are embedded parenthetically inside sentence 1 rather than
    emitted as a separate 'Found at ...' sentence, which would push every
    evidence string to 3-4 sentences and violate the rule.
    """
    where = _cite_list(hits)
    stem = what_found.strip().rstrip(".")
    s1 = f"{stem} ({where})." if where else f"{stem}."
    s2 = f"This confirms {confirms.strip().rstrip('.')}."
    parts = [s1, s2]
    if context:
        ctx = context.strip().rstrip(".")
        # Force a capitalized opening so the sentence counter and the reader
        # both see a clean boundary.
        ctx = ctx[0].upper() + ctx[1:] if ctx else ctx
        parts.append(ctx + ".")
    return " ".join(parts)


def false_evidence(scanned_desc: str) -> str:
    """Exactly 1 sentence for detected=false, per Output Rules."""
    return (f"Scanned for {scanned_desc.strip().rstrip('.')} — no matching signals were "
            "found in the scanned repository content.")



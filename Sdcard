        if k8s:
            detail.append("Kubernetes/OpenShift manifests")
        return True, true_evidence(
            "Containerization/deployment tooling was found (" + ", ".join(detail) + ").",
            hits, "the application is containerized and deployed via Kubernetes/OpenShift/Helm")
    return False, false_evidence(
        "a Dockerfile, docker-compose file, Helm Chart.yaml/values.yaml (including in the "
        "CD repository if supplied), and Kubernetes/OpenShift manifest 'kind:' declarations")



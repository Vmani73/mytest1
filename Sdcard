        if pii_hits:
            detail.append("PII-named fields (e.g. ssn, cardNumber, taxId)")
        text = true_evidence(
            "Secret-management configuration or sensitive-data field identifiers were found "
            "(" + ", ".join(detail) + ").",
            all_hits, "the application manages, uses, or owns secrets or sensitive data")
        return True, all_hits, text
    return False, [], false_evidence(
        "spring.cloud.vault/vault.hashicorp.com config, K8s secretKeyRef, @Value secret/"
        "password/credential references, Cipher/KeyStore/SecretKey/BCryptPasswordEncoder, "
        "PII field identifiers, and @SensitiveData/@PII annotations")



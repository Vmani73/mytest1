FALSE_POSITIVE_SUFFIXES = (
    "Log", "Format", "Codec", "Test", "Tests", "Mock", "Stub", "Util",
    "Utils", "Config", "Configuration", "Exception", "Formatter",
)


def _class_name_hits(idx: RepoIndex, tokens: Sequence[str], repo_tag: Optional[str] = None,
                      exclude_test_paths: bool = False) -> List[Hit]:
    """
    Filename-based class-name signal match (Java/C# convention: filename ==
    class name).

    Two guards suppress the false positives a bare substring match produces,
    which matter because these tokens drive the Tier 1 (High Risk) decision:

    1. camelCase-continuation guard: the token must not be immediately
       followed by a lowercase letter. Without this, 'Transactional*'
       (standard Spring naming) matches 'Transaction', and 'Wireless*'
       matches 'Wire' — escalating ordinary components to Tier 1.
    2. Suffix denylist: names like 'TransactionLog' or 'WireFormat' describe
       logging/serialization concerns, not payment processing.
    """
    hits = []
    for t, rp in idx.relpaths(repo_tag):
        if exclude_test_paths and is_test_path(rp):
            continue
        if Path(rp).suffix.lower() not in (".java", ".kt", ".cs", ".ts", ".tsx", ".py", ".go"):
            continue
        base = Path(rp).stem
        for token in tokens:
            pos = base.find(token)
            if pos < 0:
                continue
            tail = base[pos + len(token):]
            # camelCase continuation => the token is part of a longer word.
            if tail and tail[0].islower():
                continue
            if any(base.endswith(token + suf) for suf in FALSE_POSITIVE_SUFFIXES):
                continue
            hits.append(Hit(t, rp, 0, base, f"class/file name contains '{token}'"))
            break
    return hits


def detect_web_application(idx: RepoIndex) -> Tuple[bool, str]:
    hits = idx.scan([
        (r"@RestController\b", "@RestController annotation"),
        (r"@Controller\b", "@Controller annotation"),
        (r"@SpringBootApplication\b", "@SpringBootApplication annotation"),
        (r"@app\.route\s*\(", "Flask @app.route"),
        (r"\burlpatterns\s*=", "Django urlpatterns"),
        (r"\bapp\.(get|post|put|delete|patch)\s*\(", "Express/Fastify route handler"),
    ], extensions=[".java", ".kt", ".py", ".js", ".ts"])

    web_dep_names = {"react", "@angular/core", "vue", "next", "express", "fastify", "flask", "django"}
    dep_hits = [Hit(d.repo, d.manifest, 0, d.coordinate, "web framework dependency")
                for d in idx.dependencies
                if d.raw_name in web_dep_names or d.coordinate.endswith(":spring-boot-starter-web")]

    # .tsx/.html component files are a Section 1 signal in their own right.
    # Converted to Hit objects here — passing raw (repo, path) tuples into the
    # evidence templater would crash on citation rendering.
    component_file_hits = [
        Hit(t, rp, 0, "", "front-end component file")
        for t, rp in (idx.files_with_ext(".tsx") + idx.files_with_ext(".html"))
    ]

    # Next.js routing directories only count when Next.js is actually a declared
    # dependency; a bare folder named "app" or "pages" is far too common to treat
    # as a framework signal on its own.
    has_next = any(d.raw_name == "next" for d in idx.dependencies)
    nextjs_hits: List[Hit] = []
    if has_next:
        for t, rp in idx.relpaths():
            top = rp.split("/")[0]
            if top in ("pages", "app") or rp.startswith("src/pages/") or rp.startswith("src/app/"):
                nextjs_hits.append(Hit(t, rp, 0, "", "Next.js routing directory"))
                break

    all_hits = hits + dep_hits + nextjs_hits + component_file_hits
    if all_hits:
        extra = []
        if dep_hits:
            extra.append("a web framework dependency is declared")
        if component_file_hits:
            extra.append(f"{len(component_file_hits)} .tsx/.html component file(s) are present")
        if nextjs_hits:
            extra.append("a Next.js routing directory is present")
        context = "; ".join(extra) if extra else ""
        return True, true_evidence(
            "A web server/controller annotation or front-end framework signal was found",
            all_hits, "this is a web application, service, or web UI", context)
    return False, false_evidence(
        "@RestController/@Controller/@SpringBootApplication, Flask/Django routing, "
        "Express/Fastify handlers, React/Angular/Vue/Next.js dependencies, and .tsx/.html "
        "component files")


def detect_mobile_app(idx: RepoIndex) -> Tuple[bool, str]:
    manifest_hits = idx.has_basename("AndroidManifest.xml")
    podfile_hits = idx.has_basename("Podfile")
    xcodeproj_hits = [Hit(t, rp, 0, "", "xcodeproj present")
                       for t, rp in idx.relpaths() if rp.endswith(".xcodeproj")]
    rn_dep = [d for d in idx.dependencies if d.raw_name == "react-native"]
    android_gradle = idx.scan([(r"com\.android\.application", "com.android.application Gradle plugin")],
                               name_filter_substrings=["build.gradle"])
    flutter_hits = idx.scan([(r"flutter\s*:", "flutter dependency in pubspec.yaml")],
                             extensions=[".yaml", ".yml"], name_filter_substrings=["pubspec"])
    all_hits = manifest_hits + podfile_hits + xcodeproj_hits + android_gradle + flutter_hits
    if rn_dep:
        all_hits = all_hits + [Hit(d.repo, d.manifest, 0, d.coordinate, "react-native dependency") for d in rn_dep]
    if all_hits:
        return True, true_evidence(
            "A mobile-platform project marker was found — AndroidManifest.xml, a "
            "com.android.application Gradle plugin, a Podfile/.xcodeproj, a react-native "
            "dependency, or a Flutter pubspec",
            all_hits, "this repository contains a native or cross-platform mobile app")
    return False, false_evidence(
        "AndroidManifest.xml, com.android.application in build.gradle, Podfile, *.xcodeproj, "
        "react-native in package.json, and a Flutter pubspec.yaml")


def detect_stand_alone(idx: RepoIndex, has_web_app: bool) -> Tuple[bool, str]:
    if has_web_app:
        return False, ("The application was classified as a web application/service "
                        "(spring-boot-starter-web or an equivalent web framework dependency "
                        "is present), so it is not a standalone executable.")
    java_main = idx.scan([(r"public\s+static\s+void\s+main\s*\(\s*String", "Java main() entrypoint")],
                          extensions=[".java", ".kt"])
    py_main = idx.scan([(r"if\s+__name__\s*==\s*['\"]__main__['\"]", "Python __main__ entrypoint")],
                        extensions=[".py"])
    has_py_web_import = idx.scan([(r"^\s*(from|import)\s+(flask|django|fastapi)", "Python web framework import")],
                                  extensions=[".py"])
    csproj_exe = idx.scan([(r"<OutputType>Exe</OutputType>", "csproj OutputType=Exe")], extensions=[".csproj"])
    aspnet_dep = [d for d in idx.dependencies if "Microsoft.AspNetCore" in d.raw_name]
    hits = []
    if java_main:
        hits += java_main
    if py_main and not has_py_web_import:
        hits += py_main
    if csproj_exe and not aspnet_dep:
        hits += csproj_exe
    if hits:
        return True, true_evidence(
            "A standalone process entrypoint (Java main(), Python __main__ guard with no "
            "web-framework import, or a .csproj with OutputType=Exe and no ASP.NET Core "
            "reference) was found.",
            hits, "this component runs as a standalone executable rather than a hosted service")
    return False, false_evidence(
        "a Java/Kotlin main() with no spring-boot-starter-web, a .csproj OutputType=Exe "
        "with no Microsoft.AspNetCore reference, or a Python __main__ guard with no "
        "Flask/Django/FastAPI import")



    """Returns (paa_positive_hits, non_paa_positive_hits). Test paths excluded — see module note."""
    permit_all_raw = idx.scan([
        (r"\.permitAll\s*\(\s*\)", "Spring Security permitAll()"),
        (r"antMatchers\s*\([^)]*\)\s*\.\s*permitAll\s*\(", "antMatchers(...).permitAll()"),
        (r"requestMatchers\s*\([^)]*\)\s*\.\s*permitAll\s*\(", "requestMatchers(...).permitAll()"),
    ], extensions=[".java", ".kt"], max_hits=50, exclude_test_paths=True)
    permit_all = [h for h in permit_all_raw if not any(s in h.snippet for s in HEALTH_PATH_SUBSTRINGS)]

    resource_server_hits = idx.scan([
        (r"resource[_-]?server[\s\S]{0,200}?introspection[\s\S]{0,200}?(public|anonymous)",
         "resource_server with public token introspection"),
        (r"introspection[_-]?endpoint[\s\S]{0,120}?(public|no-auth|anonymous)",
         "public token introspection endpoint"),
    ], exclude_test_paths=True)

    ingress_no_auth = []
    for t, rp in idx.relpaths():
        if is_test_path(rp) or Path(rp).suffix.lower() not in (".yaml", ".yml"):
            continue
        text = idx.content(t, rp)
        if re.search(r"kind:\s*Ingress\b", text) and "nginx.ingress.kubernetes.io/auth-url" not in text:
            ingress_no_auth.append(Hit(t, rp, 0, "", "K8s Ingress with no auth-url annotation"))

    route_no_auth = []
    for t, rp in idx.relpaths():
        if is_test_path(rp) or Path(rp).suffix.lower() not in (".yaml", ".yml"):
            continue
        text = idx.content(t, rp)
        if re.search(r"kind:\s*Route\b", text) and re.search(r"tls:\s*\{\s*\}", text) \
                and not re.search(r"oauth-proxy|auth-url|authenticat", text, re.IGNORECASE):
            route_no_auth.append(Hit(t, rp, 0, "", "OCP Route with empty tls: {} and no auth middleware"))

    cors_wildcard = idx.scan([
        (r"Access-Control-Allow-Origin[\"']?\s*:\s*[\"']?\*", "CORS wildcard header"),
        (r"@CrossOrigin\s*\(\s*origins\s*=\s*\"\*\"", "@CrossOrigin(origins=\"*\")"),
        (r"origin\s*:\s*\[?[\"']\*[\"']", "CORS config origin: '*'"),
    ], exclude_test_paths=True)
    cors_wildcard = [h for h in cors_wildcard if not any(s in h.snippet for s in HEALTH_PATH_SUBSTRINGS)]

    public_annot = idx.scan([
        (r"@PublicEndpoint\b", "@PublicEndpoint annotation"),
        (r"security:\s*\[\s*\]", "OpenAPI spec empty security: []"),
    ], exclude_test_paths=True)

    paa_hits = (permit_all + ingress_no_auth + route_no_auth + cors_wildcard
                + public_annot + resource_server_hits)

    non_paa_hits = idx.scan([
        (r"\.authenticated\s*\(\s*\)", "Spring Security .authenticated()"),
        (r"\.hasRole\s*\(", "Spring Security .hasRole()"),
    ], extensions=[".java", ".kt"], exclude_test_paths=True)
    non_paa_hits += idx.scan([
        (r"\b[\w-]+\.(internal|corp|svc\.cluster\.local)\b", "internal-only DNS name"),
    ], exclude_test_paths=True)
    return paa_hits, non_paa_hits


def decide_classification(
    paa_hits: List[Hit], non_paa_hits: List[Hit]
) -> Tuple[str, str, bool, str, str]:
    """
    Returns (selected_classification, evidence_text, resolved_directly,
    group_confidence, notes).

    resolved_directly feeds the overall Confidence Scoring table (direct
    evidence vs. inference). group_confidence is the per-group value reported
    in detection_summary: 'high' when the signals are unambiguous, 'medium'
    when direct signals conflict (both public-access and auth-required signals
    present, so PAA precedence was applied over a contested picture), and
    'low' when the outcome is a default.
    """
    if paa_hits:
        conflict = bool(non_paa_hits)
        text = true_evidence(
            "A public-access signal was found — an unauthenticated permitAll() route, an "
            "Ingress with no auth-url annotation, an OCP Route with empty tls: {} and no auth "
            "middleware, or a CORS wildcard on a non-health endpoint",
            paa_hits,
            "the application is classified Publicly Accessible (PAA), which takes precedence "
            "over any authentication controls found elsewhere in the codebase")
        if conflict:
            notes = ("Authentication-required signals were also found (" +
                      _cite_list(non_paa_hits, 2) + "); PAA was still selected because at least "
                      "one endpoint or asset is reachable without authentication, per the 'PAA "
                      "takes precedence' rule. Recommend security-engineer review to confirm scope.")
            return "PAA", text, True, "medium", notes
        return "PAA", text, True, "high", ""
    if non_paa_hits:
        text = true_evidence(
            "Authentication-required patterns were found with no conflicting public-access "
            "signal — Spring Security .authenticated()/.hasRole(), or internal-only DNS naming",
            non_paa_hits, "the application is classified Non PAA Application")
        return "Non PAA Application", text, True, "high", ""
    text = ("No public-access signals (permitAll(), open Ingress/Route, CORS wildcard) and no "
            "explicit authentication-required signals (.authenticated(), .hasRole(), internal-"
            "only DNS) were found in the scanned content. Non PAA Application was applied as "
            "the default classification rather than derived from direct code evidence.")
    notes = ("Resolved by absence of signals, not direct evidence. This default must be "
              "confirmed by a security engineer before submission.")
    return "Non PAA Application", text, False, "low", notes


def decide_tier(idx: RepoIndex, paa_hits: List[Hit]) -> Tuple[str, str, bool, str, str]:
    """
    Returns (selected_tier, evidence_text, resolved_directly, group_confidence, notes).
    Highest-matching tier wins (Tier 1 overrides Tier 2; Tier 2 overrides Tier 3).

    group_confidence is 'medium' when Tier 1 rests solely on the PAA
    cross-reference (no payment or token-issuance signal of its own), since
    that inference is weaker than a direct payment/token signal.
    """
    payment_hits = _class_name_hits(idx, ("Payment", "Transaction", "CardNumber", "PAN",
                                           "AccountDebit", "Wire", "ACH"), exclude_test_paths=True)
    token_issuance_hits = idx.scan([
        (r"@EnableAuthorizationServer\b", "@EnableAuthorizationServer"),
        (r"\bJwtTokenStore\b", "JwtTokenStore"),
        (r"\bTokenEnhancer\b", "TokenEnhancer"),
        (r"Jwts\s*\.\s*builder\s*\(", "Jwts.builder() JWT construction"),
        (r"\.signWith\s*\(", "JWT .signWith() signing call"),
        (r"\bSignatureAlgorithm\b", "SignatureAlgorithm (JWT signing)"),
        (r"\bJwtEncoder\b", "JwtEncoder (Spring Security JWT issuance)"),
    ], extensions=[".java", ".kt"], exclude_test_paths=True)

    if payment_hits or token_issuance_hits or paa_hits:
        reasons, cites = [], []
        if payment_hits:
            reasons.append("payment/financial class or file names")
            cites += payment_hits
        if token_issuance_hits:
            reasons.append("authentication-token issuance constructs")
            cites += token_issuance_hits
        if paa_hits and not payment_hits and not token_issuance_hits:
            reasons.append("an externally-reachable entry point with no authentication wall")
            cites += paa_hits
        text = true_evidence(
            "Tier 1 (High Risk) signals were found in the codebase: " + "; ".join(reasons),
            cites,
            "the component meets the Tier 1 criteria, which override Tier 2 and Tier 3")
        if not payment_hits and not token_issuance_hits:
            notes = ("Tier 1 rests solely on the PAA cross-reference rule (unauthenticated "
                      "public entry point implies Tier 1). No payment or token-issuance signals "
                      "were found. Recommend security-engineer review to confirm data sensitivity.")
            tier_conf = "medium"
        else:
            notes = ""
            tier_conf = "high"
        return "Tier 1", text, True, tier_conf, notes

    # Tier 2 — PII, PCI-scoped fields, regulated-data references, secrets/vault usage.
    pii_hits = idx.scan(
        [(r"\b(ssn|SSN|dateOfBirth|date_of_birth|taxId|tax_id|email|phoneNumber|phone_number)\b",
          "PII field identifier")],
        extensions=[".java", ".kt", ".py", ".ts", ".tsx", ".cs"], exclude_test_paths=True)
    name_pair_hits = idx.scan(
        [(r"firstName[\s\S]{0,120}lastName|lastName[\s\S]{0,120}firstName", "firstName+lastName co-occurrence")],
        extensions=[".java", ".kt", ".py", ".ts", ".tsx", ".cs"], exclude_test_paths=True)
    regulated_hits = idx.scan([(r"\b(GDPR|CCPA|HIPAA)\b", "regulated-data reference")], exclude_test_paths=True)
    pci_hits = idx.scan(
        [(r"\b(cardNumber|cvv|pan|track1|track2)\b", "PCI-scoped field identifier")],
        extensions=[".java", ".kt", ".py", ".ts", ".tsx", ".cs"], exclude_test_paths=True)
    secrets_present, secrets_hits, _ = detect_secrets_sensitive_data(idx)
    secrets_hits = [h for h in secrets_hits if not is_test_path(h.path)]
    secrets_present = bool(secrets_hits)

    tier2_hits = pii_hits + name_pair_hits + regulated_hits + pci_hits
    if secrets_present:
        tier2_hits = tier2_hits + secrets_hits

    if tier2_hits:
        reasons = []
        if pii_hits or name_pair_hits:
            reasons.append("PII field identifiers or first/last-name co-occurrence")
        if regulated_hits:
            reasons.append("regulated-data references (GDPR/CCPA/HIPAA)")
        if pci_hits:
            reasons.append("PCI-scoped field identifiers")
        if secrets_present and not (pii_hits or name_pair_hits or regulated_hits or pci_hits):
            reasons.append("secrets/vault usage")
        text = true_evidence(
            "Tier 2 (Medium Risk) signals were found in the codebase: " + "; ".join(reasons),
            tier2_hits,
            "the component handles sensitive data without meeting the Tier 1 payment, "
            "token-issuance, or unauthenticated-public-entry-point criteria")
        return "Tier 2", text, True, "high", ""

    text = ("No Tier 1 or Tier 2 signals (payment/financial class names, authentication-token "
            "issuance, unauthenticated public entry points, PII fields, regulated-data "
            "references, PCI-scoped fields, or secrets/vault usage) were found in the scanned "
            "content. Tier 3 (Low Risk) was applied as the default tier rather than derived "
            "from direct code evidence.")
    notes = ("Resolved by absence of signals, not direct evidence. This default must be "
              "confirmed by a security engineer before submission.")
    return "Tier 3", text, False, "low", notes


# --------------------------------------------------------------------------
# Confidence scoring — implements the Confidence Scoring table verbatim
#
#   high    | All four groups resolved with direct code evidence
#           | (>=1 signal per detected attribute)
#   medium  | 3 of 4 groups resolved with direct evidence; remaining inferred
#   low     | >=2 groups resolved only by inference or absence of signals
#           | (default tier/classification applied)
#
# "Direct" means the group's outcome was driven by at least one concrete
# signal hit in scanned content. "Inferred" means the group fell back to a
# default (Tier 3 by absence, Non PAA by absence) or produced no detections
# at all. The four groups are: application_type, functional_attributes,
# security_tier, application_classification.
# --------------------------------------------------------------------------

def overall_confidence_from_groups(direct_flags: Sequence[bool]) -> str:
    if len(direct_flags) != 4:
        raise ScanError(
            f"Confidence scoring expects exactly 4 groups, received {len(direct_flags)}."
        )
    direct_count = sum(1 for f in direct_flags if f)
    if direct_count == 4:
        return "high"
    if direct_count == 3:
        return "medium"
    return "low"


def group_confidence(resolved_directly: bool, has_scannable_content: bool) -> str:
    """Per-group confidence for detection_summary.*.confidence."""
    if not has_scannable_content:
        return "low"
    return "high" if resolved_directly else "low"



    p.add_argument("--output-dir", default=".", help="Root directory under which the bundle path is created.")
    p.add_argument("--token-env", default="GITHUB_TOKEN",
                    help="Name of the environment variable holding the GitHub token (default: GITHUB_TOKEN).")
    p.add_argument("--github-api-base", default="https://api.github.com",
                    help="GitHub API base URL (override for GitHub Enterprise, e.g. https://ghe.example.com/api/v3).")
    p.add_argument("--github-web-base", default="https://github.com",
                    help="GitHub web base URL used to build the provenance link.")
    p.add_argument("--max-file-size-kb", type=int, default=DEFAULT_MAX_FILE_SIZE_KB,
                    help=f"Skip files larger than this size in KB (default: {DEFAULT_MAX_FILE_SIZE_KB}).")
    p.add_argument("--max-total-files", type=int, default=DEFAULT_MAX_TOTAL_FILES,
                    help=f"Hard cap on number of files indexed per repo (default: {DEFAULT_MAX_TOTAL_FILES}).")
    p.add_argument("--keep-temp", action="store_true",
                    help="Do not delete the temporary extracted repository snapshot after the scan.")
    p.add_argument("--print-only", action="store_true",
                    help="Print the resulting JSON to stdout and do NOT write the output file.")
    return p


def internal_prefix_list(raw: str) -> List[str]:
    return [x.strip() for x in raw.split(",") if x.strip()]


def resolve_output_path(output_dir: str, mnemonic: str, component: str) -> Path:
    path = (Path(output_dir) / "application-bundle" / mnemonic / "components" / component
            / "supplementary-sources" / f"{component}-sd-elements.json")
    path.parent.mkdir(parents=True, exist_ok=True)
    return path


def get_token(token_env: str) -> str:
    token = os.environ.get(token_env)
    if not token:
        raise ScanError(
            f"Environment variable '{token_env}' is not set. Export a GitHub token into it "
            f"before running this script, e.g.:\n\n  export {token_env}=ghp_your_token_here\n\n"
            "The token is never accepted as a command-line argument."
        )
    return token


def main(argv: Optional[Sequence[str]] = None) -> int:
    args = build_arg_parser().parse_args(argv)
    args.internal_package_prefixes = internal_prefix_list(args.internal_package_prefixes)

    try:
        if args.max_file_size_kb <= 0:
            raise ScanError("--max-file-size-kb must be a positive integer.")
        if args.max_total_files <= 0:
            raise ScanError("--max-total-files must be a positive integer.")
        if not args.component.strip():
            raise ScanError("--component must not be empty.")
        if not args.mnemonic.strip():
            raise ScanError("--mnemonic must not be empty.")
        if not [t for t in args.tags.split(",") if t.strip()]:
            raise ScanError("--tags must contain at least one non-empty tag.")
        token = get_token(args.token_env)
        source_owner, source_repo = parse_owner_repo(args.source_repo)
        source_web_url = f"{args.github_web_base}/{source_owner}/{source_repo}"

        work_dir = Path(tempfile.mkdtemp(prefix="sd_elements_scan_"))
        idx = RepoIndex(max_file_size_kb=args.max_file_size_kb, max_total_files=args.max_total_files)

        print(f"[1/4] Fetching source repository {source_owner}/{source_repo} ...", file=sys.stderr)
        src_root, src_ref, src_sha = fetch_repo_snapshot(
            args.github_api_base, source_owner, source_repo,
            args.source_ref, token, work_dir)
        scan_root = src_root / args.source_subdir if args.source_subdir else src_root
        if not scan_root.exists():
            raise ScanError(f"--source-subdir '{args.source_subdir}' does not exist in the fetched snapshot.")
        idx.add_root("source", scan_root)
        print(f"      resolved ref={src_ref} sha={src_sha[:12]} files_indexed={len(idx._files.get('source', []))}",
              file=sys.stderr)

        if args.cd_repo:
            cd_owner, cd_repo = parse_owner_repo(args.cd_repo)
            print(f"[2/4] Fetching CD repository {cd_owner}/{cd_repo} ...", file=sys.stderr)
            cd_root, cd_ref, cd_sha = fetch_repo_snapshot(
                args.github_api_base, cd_owner, cd_repo,
                args.cd_ref, token, work_dir)
            idx.add_root("cd", cd_root)
            print(f"      resolved ref={cd_ref} sha={cd_sha[:12]} files_indexed={len(idx._files.get('cd', []))}",
                  file=sys.stderr)
        else:
            print("[2/4] No --cd-repo supplied; skipping CD repository scan.", file=sys.stderr)

        if idx.truncated:
            print(f"      WARNING: file index truncated at --max-total-files={args.max_total_files}; "
                  "results may be incomplete for very large repositories.", file=sys.stderr)
        if idx.oversized_skipped:
            print(f"      WARNING: {len(idx.oversized_skipped)} file(s) exceeded "
                  f"--max-file-size-kb={args.max_file_size_kb} and were not scanned; "
                  "signals inside them will not appear in the artifact. First few: "
                  + ", ".join(idx.oversized_skipped[:5]), file=sys.stderr)

        print("[3/4] Running deterministic signal detection ...", file=sys.stderr)
        doc = build_document(args, idx, source_web_url, src_sha)

        print("[4/4] Validating against output schema ...", file=sys.stderr)
        validate_document(doc)

        rendered = json.dumps(doc, indent=2, ensure_ascii=False)

        if args.print_only:
            print(rendered)
        else:
            out_path = resolve_output_path(args.output_dir, args.mnemonic, args.component)
            out_path.write_text(rendered + "\n", encoding="utf-8")
            print(f"Wrote: {out_path}", file=sys.stderr)
            print(f"Overall confidence: {doc['meta']['confidence']}", file=sys.stderr)
            print(f"Security tier: {doc['security_tier']['selected_tier']}", file=sys.stderr)
            print(f"Classification: {doc['application_classification']['selected_classification']}",
                  file=sys.stderr)

        if not args.keep_temp:
            shutil.rmtree(work_dir, ignore_errors=True)
        return 0

    except ScanError as e:
        print(f"ERROR: {e}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        print("Interrupted.", file=sys.stderr)
        return 130


if __name__ == "__main__":
    sys.exit(main())

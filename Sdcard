def detect_external_components(idx: RepoIndex, internal_prefixes: Sequence[str]) -> Tuple[bool, str]:
    if not idx.dependencies:
        return False, ("No dependency manifest (pom.xml, package.json, build.gradle, "
                        "requirements.txt, go.mod, or *.csproj) with declared dependencies "
                        "was found in the scanned content.")
    external = []
    for d in idx.dependencies:
        if internal_prefixes and any(d.raw_name.startswith(p) or d.coordinate.startswith(p) for p in internal_prefixes):
            continue
        external.append(d)
    if external:
        sample = ", ".join(sorted({d.coordinate for d in external})[:5])
        hits = [Hit(d.repo, d.manifest, 0, d.coordinate, "external dependency") for d in external[:5]]
        prefix_note = (f" (dependencies matching internal prefixes {list(internal_prefixes)} were excluded)"
                        if internal_prefixes else " (no internal-prefix exclusion list was supplied, so all "
                        "declared dependencies were treated as external)")
        return True, true_evidence(
            f"{len(external)} external dependency declaration(s) were found across the "
            f"scanned manifests, including: {sample}.",
            hits, "the application includes external components/libraries", prefix_note)
    return False, false_evidence(
        f"dependencies not matching the supplied internal-prefix list {list(internal_prefixes)}")



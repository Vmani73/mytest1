log.info("stage_start", stage=self.name, job_id=ctx.job_id, tokens_before=N)

# At stage end:
log.info("stage_complete", stage=self.name, job_id=ctx.job_id, 
         tokens_before=N, tokens_after=M, delta=N-M, wall_ms=elapsed)

# On QualityGate revert:
log.warning("quality_gate_revert", stage=self.name, block_id=block_id,
            missing_entities=entities, action="reverted_to_original")

# On optional dependency missing:
log.info("fallback_activated", feature="tree_sitter", fallback="code_skeletonizer",
         reason="tree-sitter-java not installed")

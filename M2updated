“is_hard_blocker”: true,
“resolution_options”: [
“A) Saga pattern — choreography with compensating transactions”,
“B) Saga pattern — orchestration with explicit rollback steps”,
“C) Keep both services in same deployment unit (do not split)”,
“D) Two-phase commit (not recommended — adds complexity)”
]

codebase-memory-mcp cli search_graph --project $PROJECT \
  --name-pattern "Test|Spec|Suite|Feature|Scenario" \
  --label Class --limit 40

# 9. By typical test folders / files
codebase-memory-mcp cli search_graph --project $PROJECT \
  --file-pattern ".*(test|tests|spec|specs|e2e|integration|functional|features|__tests__|cypress|playwright).*" \

    DEFAULTS = {
        "marker_regex": r"""(@pact-foundation/pact|au\.com\.dius\.pact|PactNet|from pact import|pact-python|@PactTestFor|@Provider\(|PactVerificationContext)""",
        "js_request_regex": r"""withRequest\(\s*\{""",
        "method_field_regex": r"""method\s*:\s*['"](\w+)['"]""",
        "path_field_regex": r"""path\s*:\s*(?:['"]([^'"]+)['"]|\w+\(\s*['"]([^'"]+)['"])""",
        "jvm_path_regex": r"""\.path\(\s*"([^"]+)"\s*\)""",
        "jvm_method_regex": r"""\.method\(\s*"(\w+)"\s*\)""",
        "py_request_regex": r"""\.with_request\(\s*['"](\w+)['"]\s*,\s*['"]([^'"]+)['"]""",
        "dotnet_request_regex": r"""WithRequest\(\s*HttpMethod\.(\w+)\s*,\s*"([^"]+)\"""",
        "provider_regex": r"""(Verifier\(|@Provider\(|PactVerificationContext|verifyProvider|\.Verify\(\))""",
    }

    def detect(self, env: Env) -> list[str]:
        self.files = [f for f in env.ctx.tracked if env.ctx.is_test(f) and self.rx("marker_regex").search("\n".join(env.ctx.lines(f)))]
        return self.files

    def tests(self, env: Env) -> None:
        env.contracts = getattr(env, "contracts", [])
        for f in self.files:
            lines = env.ctx.lines(f)
            text = "\n".join(lines)
            tf = env.test_file(f, "pact")
            tf.role = "test"
            for c in tf.cases:
                lo, hi = c.start - 1, c.end
                chunk = "\n".join(lines[lo:hi])
                inter = []
                for m in self.rx("js_request_regex").finditer(chunk):
                    blk = chunk[m.end(): m.end() + 400]
                    mm, mp = self.rx("method_field_regex").search(blk), self.rx("path_field_regex").search(blk)
                    if mp:
                        inter.append(((mm.group(1).upper() if mm else None), mp.group(1) or mp.group(2)))
                for mp in self.rx("jvm_path_regex").finditer(chunk):
                    mm = self.rx("jvm_method_regex").search(chunk[mp.end(): mp.end() + 200]) or \
                        self.rx("jvm_method_regex").search(chunk[max(0, mp.start() - 200): mp.start()])
                    inter.append(((mm.group(1).upper() if mm else None), mp.group(1)))
                for m in self.rx("py_request_regex").finditer(chunk):
                    inter.append((m.group(1).upper(), m.group(2)))
                for m in self.rx("dotnet_request_regex").finditer(chunk):
                    inter.append((m.group(1).upper(), m.group(2)))
                if inter:
                    # interactions are served by the Pact mock server, not by this system
                    c.invocations = [i for i in c.invocations if i.kind not in ("http",)]
                    for meth, path in inter:
                        c.invocations.append(Invocation(f, c.start, "contract", meth, path, "pact consumer interaction",
                                                        CONF_HIGH, meth is not None))
                        env.contracts.append({"role": "consumer", "method": meth, "path": path, "test": f"{f}:{c.start}"})
                elif self.rx("provider_regex").search(chunk):
                    c.invocations.append(Invocation(f, c.start, "contract", "VERIFY", "provider verification",
                                                    "pact provider verification", CONF_MEDIUM))
                    env.contracts.append({"role": "provider", "test": f"{f}:{c.start}"})
            if not tf.cases and self.rx("provider_regex").search(text):
                ln = next((i for i, l in enumerate(lines, 1) if self.rx("provider_regex").search(l)), 1)
                _add_case(env, tf, "provider verification", ln, len(lines),
                          [Invocation(f, ln, "contract", "VERIFY", "provider verification", "pact provider verification",
                                      CONF_MEDIUM)])


@plugin
class GraphQLDocuments(Plugin):
    name = "graphql_documents"
    summary = "GraphQL operations sent by tests (query/mutation documents)"
    DEFAULTS = {"operation_regex": r"""\b(query|mutation|subscription)\b\s*(\w+)?\s*(\([^)]*\))?\s*\{"""}

    def detect(self, env: Env) -> list[str]:
        rx = self.rx("operation_regex")
        return [f for f in env.ctx.tracked if env.ctx.is_test(f) and rx.search("\n".join(env.ctx.lines(f)))]

    @staticmethod
    def top_fields(text: str, start: int) -> list[str]:
        depth, out, i, tok = 0, [], start, ""
        while i < len(text):
            ch = text[i]
            if ch == "{":
                depth += 1
            elif ch == "}":
                depth -= 1
                if depth == 0:
                    break
            elif ch == "(" and depth == 1:
                j = text.find(")", i)
                i = j if j > 0 else i
            elif depth == 1 and (ch.isalnum() or ch == "_"):
                tok += ch
                i += 1
                continue
            if depth == 1 and tok:
                out.append(tok)
            tok = ""
            i += 1
        return [t for t in out if not t[0].isdigit() and t not in ("on", "fragment")]

    def tests(self, env: Env) -> None:
        rx = self.rx("operation_regex")
        for f in sorted(env.test_files):
            tf = env.test_files[f]
            if tf.role != "test":
                continue
            lines = env.ctx.lines(f)
            ranges = [(c, c.start, c.end) for c in tf.cases]
            for case, a, b in ranges:
                text = "\n".join(lines[a - 1:b])
                for u in case.used:
                    uf, _, rng = u.rpartition(":")
                    if "-" in rng and uf != f:
                        ua, ub = (int(x) for x in rng.split("-"))
                        text += "\n" + "\n".join(env.ctx.lines(uf)[ua - 1:ub])
                for m in rx.finditer(text):
                    op = m.group(1).upper().replace("SUBSCRIPTION", "SUBSCRIBE")
                    alias_free = re.sub(r"\b\w+\s*:\s*(?=\w)", "", text[m.end() - 1: m.end() + 4000])
                    for fld in self.top_fields(alias_free, 0):
                        case.invocations.append(Invocation(f, a + text[:m.start()].count("\n"), "graphql", op, fld,
                                                           "graphql document", CONF_HIGH))


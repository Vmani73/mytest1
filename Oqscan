SERVICE_KINDS = {"http", "ui_route", "graphql", "rpc", "message_consumer", "serverless", "scheduler",
                 "gateway_route", "batch_job", "worker"}


def public_api(env: Env, roots: list[str], reason: str) -> None:
    """Library public API: what the package root re-exports, plus public methods of exported classes."""
    q = lambda s: env.cbm.cypher(env.project, s)
    for root in roots:
        root = norm(root)
        for x_qn, x_name, x_label, x_file, x_s, x_e in q(
                "MATCH (a:File)-[:IMPORTS]->(x:Function|Method|Class|Variable) WHERE a.file_path = "
                f"{cypher_str(root)} RETURN x.qualified_name, x.name, x.label, x.file_path, x.start_line, x.end_line"):
            if env.ctx.is_external(x_file) or env.ctx.is_test(x_file):
                continue
            c = env.candidate(x_qn, x_name, x_label, x_file, x_s, x_e)
            c.signals.add("S10_public_api")
            env.register(c, "library_api", "library_api", f"exported by {root} ({reason})",
                         {"method": "CALL", "path": x_name, "source": root, "kind": "call"}, CONF_HIGH)
            if x_label == "Class":
                for m_qn, m_name, m_file, m_s, m_e in q(
                        "MATCH (c:Class)-[:DEFINES_METHOD]->(m:Method) WHERE c.qualified_name = "
                        f"{cypher_str(x_qn)} RETURN m.qualified_name, m.name, m.file_path, m.start_line, m.end_line"):
                    if not m_name.startswith("_"):
                        mc = env.candidate(m_qn, m_name, "Method", m_file, m_s, m_e)
                        mc.signals.add("S10_public_api")
                        env.register(mc, "library_api", "library_api", f"method of exported {x_name}",
                                     {"method": "CALL", "path": f"{x_name}.{m_name}", "source": root, "kind": "call"},
                                     CONF_HIGH)


def library_surface_without_root(env: Env, roots: Optional[list] = None) -> None:
    """No usable package-root exports (Java, C#, Go, or a Python root that re-exports nothing):
    in a repo with no service entry points, the public API is (a) public top-level classes/functions
    of public modules inside the package directories, else (b) production types that nothing else
    in production uses."""
    pkg_dirs = sorted({str(Path(r).parent).replace("\\", "/") for r in (roots or [])})
    if pkg_dirs:
        for name, fp, a, b in env.graph.classes:
            mod = Path(fp).stem
            if any(fp.startswith(d + "/") for d in pkg_dirs) and not name.startswith("_") and not mod.startswith("_"):
                env.register(env.candidate(f"{fp}#{name}", name, "Class", fp, a, b), "library_api", "library_api",
                             f"public class of package module {fp} (library repo)",
                             {"method": "CALL", "path": name, "source": fp, "kind": "call"}, CONF_MEDIUM)
        for r in env.graph.prod.values():
            fp = norm(r[3])
            if any(fp.startswith(d + "/") for d in pkg_dirs) and r[2] == "Function" and not r[1].startswith("_") \
                    and not Path(fp).stem.startswith("_") and "." not in r[0].split(Path(fp).stem, 1)[-1].strip("."):
                env.register(env.candidate(r[0], r[1], r[2], fp, r[4], r[5]), "library_api", "library_api",
                             f"public function of package module {fp} (library repo)",
                             {"method": "CALL", "path": r[1], "source": fp, "kind": "call"}, CONF_MEDIUM)
        return
    for c in list(env.cands.values()):
        if "S9_orphan_class" in c.signals:
            env.register(c, "library_api", "library_api", "public type unused by other production code (library repo)",
                         {"method": "CALL", "path": c.name, "source": c.file, "kind": "call"}, CONF_MEDIUM)
            for row in _methods_of_class(env, c.file, c.start, c.end):
                if not row[1].startswith("_") and row[1] != c.name:
                    mc = env.candidate(*row)
                    env.register(mc, "library_api", "library_api", f"method of {c.name} (library repo)",
                                 {"method": "CALL", "path": f"{c.name}.{row[1]}", "source": c.file, "kind": "call"},
                                 CONF_MEDIUM)


def entry_kind(c: Candidate) -> str:
    order = ["http", "ui_route", "graphql", "rpc", "message_consumer", "serverless", "scheduler", "batch_job", "worker",
             "gateway_route", "cli", "startup_runner", "library_api"]
    for k in order:
        if k in c.kinds:
            return k
    if c.triggers:
        t = c.triggers[0].get("kind", "http")
        return {"ui": "ui_route", "http": "http"}.get(t, t)
    for sig, kind in (("S10_public_api", "library_api"), ("S2_passed_as_value", "registered_callback"),
                      ("S4_imported_not_called", "registered_function"), ("S11_named_in_string", "named_in_config"),
                      ("S3_called_from_top_level", "script_main"), ("S7_top_level_program", "program_root"),
                      ("S8_bootstrap_file", "program_root"), ("S1_route_handler", "http")):
        if sig in c.signals:
            return kind
    return "other"


def resolve_project(cbm: CBMClient, repo: Path, no_index: bool, timeout_s: float) -> str:
    if no_index:
        projects, offset = [], 0
        while True:  # list_projects is paginated
            page = cbm.call("list_projects", {"format": "json", "offset": offset, "limit": 200})
            batch = page.get("projects", [])
            projects.extend(batch)
            offset += len(batch)
            if not batch or offset >= int(page.get("total", offset)):
                break
        want = norm(str(repo)).lower()
        match = [p for p in projects if norm(str(Path(p.get("root_path") or ".").resolve())).lower() == want]
        if not match:
            raise QScanError(f"{repo} is not indexed; run without --no-index", EXIT_USAGE)
        return match[0]["name"]
    log.info("indexing %s", repo)
    res = cbm.call("index_repository", {"repo_path": str(repo), "format": "json"}, timeout_s=max(timeout_s, 3600))
    project = res.get("project")
    if not project or res.get("status") not in ("indexed", None):
        raise QScanError(f"indexing failed: {json.dumps(res)[:300]}", EXIT_INDEX)
    return project


def language_coverage(ctx: RepoContext, cbm: CBMClient, project: str, missing: list[str]) -> list[dict]:
    """Per file extension: tracked code files vs files CBM parsed into the graph."""
    parsed = {norm(r[0]) for r in cbm.cypher(project, "MATCH (f:File)-[:DEFINES]->(x) RETURN DISTINCT f.file_path")}
    by_ext: dict = defaultdict(lambda: [0, 0])
    for f in ctx.tracked:
        if not ctx.is_code(f) or "." not in f.rsplit("/", 1)[-1]:
            continue
        ext = f.rsplit(".", 1)[-1].lower()
        by_ext[ext][0] += 1
        by_ext[ext][1] += f in parsed
    return [{"ext": e, "files": v[0], "with_symbols": v[1]} for e, v in sorted(by_ext.items(), key=lambda kv: -kv[1][0])
            if v[0] >= 1][:25]


def scan(repo: Path, rules: Rules, args: argparse.Namespace) -> dict:
    ctx = RepoContext(repo, rules)
    cbm = CBMClient(timeout_s=args.timeout)
    try:
        project = resolve_project(cbm, repo, args.no_index, args.timeout)
        env = Env(ctx, cbm, project, rules)
        log.info("graph signals")
        cands, graph = discover(ctx, cbm, project, [])
        graph.classes = [(r[1], norm(r[2]), to_int(r[3]), to_int(r[4])) for r in cbm.cypher(
            project, "MATCH (c:Class) RETURN c.qualified_name, c.name, c.file_path, c.start_line, c.end_line")
            if r[2] and not ctx.is_external(r[2])]
        graph.classes_all = list(graph.classes)
        graph.classes = [c for c in graph.classes_all if ctx.is_production_code(c[1])]
        env.graph, env.cands = graph, cands
        plugins = active_plugins(env, rules)
        log.info("active plugins: %s", ", ".join(p.name for p in plugins) or "none")
        run_phase(env, plugins, "entry_points")
        exclude_client_interfaces(env)
        roots = [norm(r) for r in args.public_root]
        service = any(c.confirmed and (c.kinds & SERVICE_KINDS or c.signals & {"S1_route_handler"})
                      for c in env.cands.values())
        if roots:
            public_api(env, roots, "--public-root")
        elif not service:
            man = next((p for p in plugins if p.name == "manifests"), None)
            auto = man.library_roots(env) if man else []
            before = sum(1 for c in env.cands.values() if "library_api" in c.kinds)
            if auto:
                public_api(env, auto, "package manifest")
            if sum(1 for c in env.cands.values() if "library_api" in c.kinds) == before:
                library_surface_without_root(env, auto)
        dedupe_triggers(env.cands)
        log.info("tests")
        build_constants(env)
        build_composed_constants(env)
        discover_code_tests(env)
        run_phase(env, plugins, "tests")
        run_phase(env, plugins, "link")
        map_all_tests(env)
        direct_entry_calls(env)
        log.info("flows")
        collect_outbound(env)
        run_phase(env, plugins, "outbound")
        links = link_outbound(env)
        missing = unindexed_files(ctx, cbm, project)
        langs = language_coverage(ctx, cbm, project, missing)
        runtime = RuntimeCoverage(ctx, parse_coverage(find_coverage_reports(repo, args.coverage)), args.coverage)

        confirmed = sorted((c for c in env.cands.values() if c.confirmed), key=lambda c: (c.file, c.start, c.qn))
        review = sorted((c for c in env.cands.values() if not c.confirmed), key=lambda c: (c.file, c.start, c.qn))
        ep_id = {c.qn: f"EP{i + 1}" for i, c in enumerate(confirmed)}

        # test cases per entry point
        cases_of: dict = defaultdict(list)
        for tf in env.test_files.values():
            if not tf.functional:
                continue
            for case in tf.cases:
                for inv in case.invocations:
                    for qn in inv.mapped:
                        if case not in cases_of[qn]:
                            cases_of[qn].append(case)
        # outbound links grouped by source callable; UI-route indirect coverage
        links_from: dict = defaultdict(list)
        for l in links:
            if l["targets"]:
                links_from[l["from"]].append(l)

        depth = int(rules.get("limits.trace_depth"))
        max_flows = int(rules.get("limits.max_flows"))
        trace_timeout = float(rules.get("limits.trace_timeout_s"))
        log.info("flows and scenarios for %d entry points", len(confirmed))
        entries, flows_by_cap = [], defaultdict(list)
        callees_of: dict = {}
        for idx, c in enumerate(confirmed):
            callees_of[c.qn] = trace_callees(cbm, project, c.qn, depth, trace_timeout) \
                if c.label in CALLABLE and idx < max_flows else []
        # frontend pages: outbound calls made from the component file (and files it imports)
        file_links: dict = defaultdict(list)
        for l in links:
            if l["targets"]:
                file_links[l["at"].rsplit(":", 1)[0]].append(l)
        indirect_of: dict = defaultdict(list)
        out_of: dict = {}
        for c in confirmed:
            own = owners_of(env, c.qn, callees_of[c.qn])
            outs = [l for q in own for l in links_from.get(q, [])]
            if "ui_route" in c.kinds or (c.triggers and c.triggers[0].get("kind") == "ui"):
                files = {c.file} | set(env.graph.imports_of.get(c.file, ()))
                outs += [l for f in files for l in file_links.get(f, [])]
                for case in cases_of.get(c.qn, []):
                    for l in outs:
                        for tq in l["targets"]:
                            indirect_of[tq].append(f"{case.file}:{case.start} via {trigger_text(c.triggers[0]) if c.triggers else c.name}")
            seen, uniq = set(), []
            for l in outs:
                k = (l["at"], tuple(l["targets"]))
                if k not in seen:
                    seen.add(k)
                    uniq.append(l)
            out_of[c.qn] = uniq

        for idx, c in enumerate(confirmed):
            callees = callees_of[c.qn]
            cases = cases_of.get(c.qn, [])
            scenarios = derive_scenarios(ctx, c, callees, graph)
            assessable = bool(c.triggers) or bool(cases)
            scenario_coverage(scenarios, cases, sorted(set(indirect_of.get(c.qn, []))), assessable, runtime)
            steps = []
            for qn, hop in callees:
                r = graph.prod.get(qn)
                if r:
                    steps.append({"step": r[1], "at": f"{norm(r[3])}:{to_int(r[4])}", "hop": hop})
            cap = capability_of(ctx, c)
            calls_out = [{"at": l["at"], "call": f"{l.get('method') or ''} {l['path']}".strip(), "kind": l["kind"],
                          "to": [ep_id[t] for t in l["targets"] if t in ep_id]} for l in out_of.get(c.qn, [])]
            entries.append({
                "id": ep_id[c.qn], "kind": entry_kind(c), "confidence": c.confidence, "name": c.name,
                "handler": f"{c.file}:{c.start}", "file": c.file, "lines": [c.start, c.end], "label": c.label,
                "triggers": [trigger_text(t) for t in c.triggers],
                "trigger_sources": [t.get("source", "") for t in c.triggers],
                "signals": sorted(c.signals), "evidence": c.evidence[:6], "capability": cap,
                "flow": steps[:25], "calls_out": calls_out[:25],
                "tests": sorted({f"{k.file}:{k.start}" for k in cases}),
                "tests_indirect": sorted(set(indirect_of.get(c.qn, [])))[:20],
                "scenarios": scenarios, "qualified_name": c.qn})
            flows_by_cap[cap].append(ep_id[c.qn])

        gaps = []
        for e in entries:
            if not e["triggers"] and not e["tests"]:
                continue  # coverage not assessable without an external trigger
            if not e["tests"]:
                sev = "MEDIUM" if e["tests_indirect"] else "HIGH"
                gaps.append({"entry_point": e["id"], "severity": sev, "confidence": e["confidence"],
                             "what": f"{e['triggers'][0] if e['triggers'] else e['name']} ({e['name']}) has no test case calling it"
                                     + (" directly (only exercised via UI pages)" if e["tests_indirect"] else ""),
                             "evidence": f"handler {e['handler']}; registered at {e['trigger_sources'][0] if e['trigger_sources'] else e['handler']}"})
                continue
            for sc in e["scenarios"]:
                if sc["status"] in GAP_STATUSES:
                    gaps.append({"entry_point": e["id"], "severity": "MEDIUM", "confidence": min_conf(e["confidence"], CONF_MEDIUM),
                                 "what": f"scenario not tested: {sc['title']} -> {sc['expect']}", "evidence": sc["evidence"]})

        tests_out = []
        unmatched, external = [], Counter()
        for tf in sorted(env.test_files.values(), key=lambda t: t.file):
            if not tf.functional:
                continue
            rows = []
            for case in tf.cases:
                for inv in case.invocations:
                    rows.append({"case": case.name, "line": inv.line, "at": f"{inv.file}:{inv.line}",
                                 "call": f"{inv.method or '?'} {inv.target}" if inv.kind != "call" else f"call {inv.target.rsplit('.', 1)[-1]}",
                                 "kind": inv.kind, "via": inv.via, "confidence": inv.confidence,
                                 "mapped_to": [ep_id.get(q, q) for q in inv.mapped], "match": inv.match})
                    if not inv.mapped and inv.kind in ("http", "ui", "graphql", "rpc", "cli"):
                        unmatched.append({"test": f"{tf.file}:{case.start}", "call": f"{inv.method or '?'} {inv.target}",
                                          "via": inv.via})
                        external[f"{inv.method or '?'} {inv.target}"] += 1
            tests_out.append({"file": tf.file, "framework": tf.framework, "cases": len(tf.cases),
                              "cases_with_calls": sum(1 for c in tf.cases if c.invocations),
                              "asserted_statuses": sorted({s for c in tf.cases for s in c.statuses}), "calls": rows})
        test_only = not entries or all(e["kind"] in ("program_root", "script_main", "other") for e in entries)
        summary = {
            "entry_points": len(entries),
            "entry_points_by_kind": dict(sorted(Counter(e["kind"] for e in entries).items())),
            "entry_points_by_confidence": dict(sorted(Counter(e["confidence"] for e in entries).items())),
            "needs_review_candidates": len(review),
            "functional_test_files": len(tests_out),
            "functional_test_cases": sum(t["cases_with_calls"] for t in tests_out),
            "entry_points_with_trigger": sum(1 for e in entries if e["triggers"]),
            "entry_points_with_tests": sum(1 for e in entries if e["tests"]),
            "entry_points_only_indirect": sum(1 for e in entries if not e["tests"] and e["tests_indirect"]),
            "expected_scenarios": sum(len(e["scenarios"]) for e in entries),
            "scenarios_by_status": dict(sorted(Counter(s["status"].split(" (")[0] for e in entries for s in e["scenarios"]).items())),
            "gaps": len(gaps), "gaps_high": sum(1 for g in gaps if g["severity"] == "HIGH"),
            "unindexed_files": len(missing),
            "runtime_coverage": bool(runtime.available),
            "test_only_repository": test_only and bool(tests_out),
        }
        return {
            "tool": {"name": "qscan", "version": __version__, "rules_sha256": rules.sha256,
                     "rules": str(rules.path)},
            "repo": {"path": str(repo), "commit": ctx.commit, "cbm_project": project},
            "summary": summary,
            "plugins": {"active": env.plugin_log, "errors": env.plugin_errors},
            "language_coverage": langs,
            "entry_points": entries,
            "business_flows": {k: v for k, v in sorted(flows_by_cap.items())},
            "distributed_links": [{"from": ep_id.get(l["from"], l["from"]), "at": l["at"], "kind": l["kind"],
                                   "call": f"{l.get('method') or ''} {l['path']}".strip(),
                                   "to": [ep_id.get(t, t) for t in l["targets"]]} for l in links],
            "outbound_unresolved": [{"at": l["at"], "kind": l["kind"], "call": f"{l.get('method') or ''} {l['path']}".strip()}
                                    for l in links if not l["targets"]][:500],
            "functional_tests": tests_out,
            "contracts": getattr(env, "contracts", []),
            "external_targets": [{"call": k, "count": v} for k, v in external.most_common(200)],
            "unmatched_test_calls": unmatched[:1000],
            "gaps": gaps,
            "needs_review": [{"name": c.name, "qualified_name": c.qn, "at": f"{c.file}:{c.start}", "file": c.file,
                              "lines": [c.start, c.end], "label": c.label, "signals": sorted(c.signals),
                              "evidence": c.evidence[:3]} for c in review],
            "limitations": {
                "unindexed_files": missing,
                "entry_points_without_trigger": [e["id"] for e in entries if not e["triggers"]],
                "runtime_coverage_reports": [str(p) for p in runtime.sources] if runtime.available else [],
                "notes": LIMITATION_NOTES,
            },
        }
    finally:
        cbm.close()


LIMITATION_NOTES = [
    "Static analysis: a 'LIKELY COVERED' scenario means a mapped test case asserts the expected status; it does not prove the exact branch ran. Supply runtime coverage (JaCoCo, Cobertura, lcov, coverage.py JSON, Istanbul) with --coverage to turn that into proof.",
    "Language support is bounded by codebase-memory-mcp: files it does not parse are listed under unindexed files, and language_coverage shows parsed vs tracked files per extension.",
    "Entry points need registration evidence (graph signal or plugin). Behaviour created only at runtime (reflection, generated code not committed, service-mesh routing outside the repo) is not visible.",
    "needs_review lists symbols with no production caller and no registration evidence: framework-invoked entry points OR dead code.",
    "Scenarios come from code evidence (error branches, status codes, auth/validation checks) in the handler and in-repo callees; business rules not visible in code are not inferred.",
    "Indirect coverage (a UI test loading a page that calls an API) is reported separately and never counted as direct coverage.",
]

# --------------------------------------------------------------------------
# Text report
# --------------------------------------------------------------------------
def render(report: dict, limit: int) -> str:
    out: list[str] = []
    w = out.append
    s = report["summary"]
    bar = "=" * 110

    def more(n: int) -> None:
        if n > limit:
            w(f"  ... {n - limit} more (see --json)")

    w(bar)
    w(f"QUALITY SCAN  {report['repo']['path']}  commit {report['repo']['commit'][:12]}")
    w(f"qscan {report['tool']['version']}  rules {report['tool']['rules_sha256']}")
    w(bar)
    w("SUMMARY")
    w(f"  Entry points ............................ {s['entry_points']}  "
      + ", ".join(f"{k} {v}" for k, v in s["entry_points_by_kind"].items()))
    w("  Entry point confidence .................. " + ", ".join(f"{k} {v}" for k, v in s["entry_points_by_confidence"].items()))
    w(f"  Candidates needing review ............... {s['needs_review_candidates']} (no caller, no registration: framework-invoked or dead code)")
    w(f"  Functional test files / test cases ...... {s['functional_test_files']} / {s['functional_test_cases']}")
    w(f"  Entry points with a resolved trigger .... {s['entry_points_with_trigger']}")
    w(f"  Entry points called by a test case ...... {s['entry_points_with_tests']}  (+{s['entry_points_only_indirect']} only indirectly via UI pages)")
    w(f"  Expected scenarios ...................... {s['expected_scenarios']}  "
      + ", ".join(f"{k}: {v}" for k, v in s["scenarios_by_status"].items()))
    w(f"  Gaps .................................... {s['gaps']} ({s['gaps_high']} high)")
    w(f"  Runtime coverage report used ............ {'yes' if s['runtime_coverage'] else 'no (static analysis only)'}")
    w(f"  Files CBM did not index ................. {s['unindexed_files']}")
    if s.get("test_only_repository"):
        w("  NOTE: no application entry points found - this looks like a test-only repository; see EXTERNAL TARGETS.")

    w(f"\n{bar}\nDETECTED TECHNOLOGIES (plugins that found evidence)\n{bar}")
    for p in report["plugins"]["active"]:
        ev = ", ".join(p["evidence"][:3])
        w(f"  {p['plugin']:20} {p['evidence_count']:>4}  {p['summary'][:70]}")
        if ev:
            w(f"  {'':20}       e.g. {ev[:150]}")
    for e in report["plugins"]["errors"]:
        w(f"  ERROR in plugin {e['plugin']} ({e['phase']}): {e['error'][:150]}")

    eps = report["entry_points"]
    w(f"\n{bar}\n1. ENTRY POINTS ({len(eps)})\n{bar}")
    for e in eps[:limit]:
        trig = e["triggers"][0] if e["triggers"] else "-"
        w(f"  {e['id']:>5} {e['confidence']:6} {e['kind']:18} {trig[:44]:44} {e['name'][:26]:26} {e['handler']}")
        w(f"        evidence: {e['evidence'][0][:120] if e['evidence'] else '-'}")
    more(len(eps))

    w(f"\n{bar}\n2. BUSINESS FLOWS (by capability)\n{bar}")
    by_id = {e["id"]: e for e in eps}
    caps = list(report["business_flows"].items())
    for cap, ids in caps[:limit]:
        w(f"  [{cap}]  {len(ids)} entry point(s)")
        for i in ids[:6]:
            e = by_id[i]
            chain = " -> ".join(st["step"] for st in e["flow"][:6]) or "(no in-repo callees)"
            w(f"     {(e['triggers'][0] if e['triggers'] else e['name'])[:40]:40} : {e['name']} -> {chain[:110]}")
            for co in e["calls_out"][:3]:
                w(f"     {'':40}   calls {co['kind']} {co['call'][:50]} -> {', '.join(co['to']) or '?'}  ({co['at']})")
        if len(ids) > 6:
            w(f"     ... {len(ids) - 6} more in this capability")
    more(len(caps))
    links = [l for l in report["distributed_links"] if l["to"]]
    if links:
        w(f"\n  Cross-component links ({len(links)}): " + "; ".join(f"{l['from']} -{l['kind']}-> {','.join(l['to'][:3])}" for l in links[:12])
          + (" ..." if len(links) > 12 else ""))

    w(f"\n{bar}\n3. EXPECTED FUNCTIONAL SCENARIOS AND WHAT IS PRESENT\n{bar}")
    for e in eps[:limit]:
        w(f"  {e['id']} {e['triggers'][0] if e['triggers'] else e['name']}  ({e['handler']})")
        for sc in e["scenarios"]:
            tests = f"  <- {sc['tests'][0]}" if sc.get("tests") else ""
            w(f"     [{sc['status'].split(' (')[0]}] {sc['type']}: {sc['title'][:85]} => {sc['expect'][:30]}")
            w(f"         evidence {sc['evidence']}{tests}")
    more(len(eps))

    ft = report["functional_tests"]
    w(f"\n{bar}\n4. EXISTING FUNCTIONAL TESTS ({len(ft)} files)\n{bar}")
    for t in ft[:limit]:
        mapped = sorted({m for c in t["calls"] for m in c["mapped_to"]}, key=lambda x: (len(x), x))
        w(f"  {t['file']}  [{t['framework']}] cases={t['cases']} with-calls={t['cases_with_calls']} -> "
          f"{', '.join(mapped)[:90] or '(no entry point matched)'}")
    more(len(ft))
    if report["contracts"]:
        w(f"  Contracts (Pact): {len(report['contracts'])} interaction(s)/verification(s); consumer interactions run against a mock server and are not counted as coverage.")
    if report["external_targets"]:
        w(f"  Calls that match no entry point in this repo (external targets / unresolved): {len(report['external_targets'])}")
        for t in report["external_targets"][:min(limit, 10)]:
            w(f"     {t['count']:>4}x {t['call'][:100]}")

    gaps = report["gaps"]
    w(f"\n{bar}\n5. GAPS ({len(gaps)})\n{bar}")
    for g in sorted(gaps, key=lambda g: (g["severity"] != "HIGH", g["entry_point"]))[:limit]:
        w(f"  {g['entry_point']:>5} {g['severity']:6} {g['what'][:110]}")
        w(f"        evidence {g['evidence'][:120]}  (confidence {g['confidence']})")
    more(len(gaps))

    lim = report["limitations"]
    w(f"\n{bar}\n6. LIMITATIONS\n{bar}")
    w(f"  Entry points with no resolved trigger (coverage not assessed): {len(lim['entry_points_without_trigger'])}")
    w(f"  Files CBM did not index ({len(lim['unindexed_files'])}): " + ", ".join(lim["unindexed_files"][:8])
      + (" ..." if len(lim["unindexed_files"]) > 8 else ""))
    low = [l for l in report["language_coverage"] if l["files"] >= 3 and l["with_symbols"] < l["files"] * 0.5]
    if low:
        w("  Weak parser coverage: " + ", ".join(f".{l['ext']} {l['with_symbols']}/{l['files']} files with symbols" for l in low[:8]))
    if report["outbound_unresolved"]:
        w(f"  Outbound calls whose target is not in this repo: {len(report['outbound_unresolved'])} (pass the other repos together to link them)")
    for n in lim["notes"]:
        w(f"  - {n}")
    return "\n".join(out)


def render_cross_repo(links: list[dict]) -> str:
    out = ["=" * 110, f"CROSS-REPOSITORY FLOWS ({len(links)})", "=" * 110]
    for l in links[:200]:
        out.append(f"  {l['from_repo']}:{l['from']} --{l['kind']} {l['call']}--> {l['to_repo']}:{','.join(l['to'])}  ({l['at']})")
    return "\n".join(out)

# --------------------------------------------------------------------------
# CLI
# --------------------------------------------------------------------------
def cross_repo_links(reports: list[dict]) -> list[dict]:
    """Outbound calls of one repository resolved against entry points of the others."""
    out = []
    for r in reports:
        for o in r["outbound_unresolved"]:
            kind, call = o["kind"], o["call"]
            parts = call.split(" ", 1)
            method, path = (parts[0], parts[1]) if len(parts) == 2 and parts[0].isupper() else (None, call)
            for other in reports:
                if other is r:
                    continue
                hits = []
                for e in other["entry_points"]:
                    for t in e["triggers"]:
                        tm, _, tp = t.partition(" ")
                        if kind == "http" and tm not in ("UI",) and path_match(path, tp) and (not method or tm in (method, "ANY")):
                            hits.append(e["id"])
                        elif kind == "message" and tm == "TOPIC" and tp.lower() == path.lower():
                            hits.append(e["id"])
                if hits:
                    out.append({"from_repo": Path(r["repo"]["path"]).name, "from": o["at"], "at": o["at"], "kind": kind,
                                "call": call, "to_repo": Path(other["repo"]["path"]).name, "to": sorted(set(hits))[:5]})
    return out


def main(argv: Optional[list[str]] = None) -> int:
    ap = argparse.ArgumentParser(prog="qscan", description="Functional quality scan of one or more repositories (CBM-based).")
    ap.add_argument("repos", nargs="+", help="path(s) to git repositories; several = one system (cross-repo flows)")
    ap.add_argument("--rules", help="optional rules JSON (overrides built-in DEFAULT_RULES; plugin settings under 'plugins')")
    ap.add_argument("--dump-rules", action="store_true", help="print the built-in rules and plugin defaults as JSON and exit")
    ap.add_argument("--list-plugins", action="store_true", help="list plugins and exit")
    ap.add_argument("--json", metavar="FILE", help="also write the full report as JSON")
    ap.add_argument("--public-root", action="append", default=[], help="library package root file (repeatable); "
                                                                       "auto-detected from manifests when omitted")
    ap.add_argument("--coverage", action="append", default=[], help="runtime coverage report (JaCoCo XML, Cobertura XML, "
                                                                    "lcov.info, coverage.py JSON, Istanbul JSON); repeatable. "
                                                                    "Default: auto-discovered under the repo")
    ap.add_argument("--no-index", action="store_true", help="reuse the existing CBM index")
    ap.add_argument("--limit", type=int, default=50, help="max rows printed per section (JSON is always complete)")
    ap.add_argument("--timeout", type=float, default=300.0, help="seconds to wait for each CBM call")
    ap.add_argument("--fail-on", choices=["high-gaps", "any-gaps"], help="exit with code 6 when gaps are found (quality gate)")
    ap.add_argument("-v", "--verbose", action="store_true")
    ap.add_argument("--version", action="version", version=f"qscan {__version__}")
    if argv is None and len(sys.argv) > 1 and sys.argv[1] in ("--dump-rules", "--list-plugins"):
        argv = sys.argv[1:] + ["."]
    args = ap.parse_args(argv)
    logging.basicConfig(level=logging.DEBUG if args.verbose else logging.INFO,
                        format="%(levelname)s %(message)s", stream=sys.stderr)
    try:
        rules = Rules(Path(args.rules) if args.rules else None)
    except QScanError as e:
        log.error("%s", e)
        return e.code
    if args.dump_rules:
        full = dict(rules.data)
        full["plugins"] = {**{cls.name: cls.DEFAULTS for cls in PLUGINS if cls.DEFAULTS}, **(rules.data.get("plugins") or {})}
        print(json.dumps(full, indent=2))
        return EXIT_OK
    if args.list_plugins:
        for cls in PLUGINS:
            print(f"{cls.name:22} {cls.summary}")
        return EXIT_OK
    reports = []
    for r in args.repos:
        repo = Path(r).resolve()
        if not repo.is_dir():
            log.error("not a directory: %s", repo)
            return EXIT_USAGE
        try:
            reports.append(scan(repo, rules, args))
        except QScanError as e:
            log.error("%s", e)
            return e.code
        except KeyboardInterrupt:
            log.error("interrupted")
            return EXIT_INTERNAL
    for rep in reports:
        print(render(rep, max(1, args.limit)))
    cross = cross_repo_links(reports) if len(reports) > 1 else []
    if len(reports) > 1:
        print(render_cross_repo(cross))
    if args.json:
        payload = reports[0] if len(reports) == 1 else {"repositories": reports, "cross_repo_links": cross}
        try:
            Path(args.json).write_text(json.dumps(payload, indent=2, sort_keys=False, default=sorted), encoding="utf-8")
        except OSError as e:
            log.error("cannot write %s: %s", args.json, e)
            return EXIT_USAGE
        log.info("JSON report written to %s", args.json)
    if args.fail_on:
        bad = sum((rep["summary"]["gaps_high"] if args.fail_on == "high-gaps" else rep["summary"]["gaps"]) for rep in reports)
        if bad:
            log.error("quality gate: %d gap(s) (%s)", bad, args.fail_on)
            return EXIT_GATE
    return EXIT_OK


if __name__ == "__main__":
    sys.exit(main())


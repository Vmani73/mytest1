STATUS_COVERED_RUNTIME = "COVERED (runtime: line executed by tests, mapped test asserts it)"
STATUS_EXECUTED_RUNTIME = "EXECUTED (runtime) - no mapped test asserts it"
STATUS_NOT_EXECUTED = "NOT COVERED (runtime: line never executed)"
STATUS_LIKELY = "LIKELY COVERED (static: a mapped test case asserts the expected status)"
STATUS_EXERCISED = "EXERCISED, NOT ASSERTED (a mapped test calls it; expected outcome not asserted)"
STATUS_INDIRECT = "EXERCISED INDIRECTLY (only via a UI test that loads a page calling it)"
STATUS_NOT_COVERED = "NOT COVERED (no test case calls it)"
STATUS_CANNOT_VERIFY = "CANNOT VERIFY (no status code in the code evidence)"
STATUS_NOT_ASSESSED = "NOT ASSESSED (no external trigger resolved)"
GAP_STATUSES = {STATUS_NOT_COVERED, STATUS_NOT_EXECUTED}


def scenario_coverage(scenarios: list[dict], cases: list[TestCase], indirect: list[str], assessable: bool,
                      runtime: Optional[RuntimeCoverage]) -> None:
    """Per scenario: a status code only counts when it is asserted INSIDE a test case
    (or a helper/step it uses) that is mapped to this entry point. Runtime coverage,
    when supplied, decides whether the scenario's evidence line was executed."""
    refs = [f"{c.file}:{c.start}" for c in cases]
    for sc in scenarios:
        rt = runtime.status(sc["evidence"]) if runtime and runtime.available else None
        want = set(sc.get("statuses") or [])
        asserting = [f"{c.file}:{c.start}" for c in cases if want & c.statuses]
        if not assessable and not cases:
            sc["status"], sc["tests"] = STATUS_NOT_ASSESSED, []
            if rt is False:
                sc["status"] = STATUS_NOT_EXECUTED
            continue
        if rt is False:
            sc["status"], sc["tests"] = STATUS_NOT_EXECUTED, []
            continue
        if not cases:
            sc["status"], sc["tests"] = (STATUS_INDIRECT, indirect[:5]) if indirect and sc["type"] == "happy_path" else (STATUS_NOT_COVERED, [])
            if rt is True:
                sc["status"] = STATUS_EXECUTED_RUNTIME
            continue
        if asserting:
            sc["status"], sc["tests"] = (STATUS_COVERED_RUNTIME if rt else STATUS_LIKELY), asserting[:5]
        elif sc["type"] == "happy_path":
            sc["status"], sc["tests"] = (STATUS_EXECUTED_RUNTIME if rt else STATUS_EXERCISED), refs[:5]
        elif not want:
            sc["status"], sc["tests"] = (STATUS_EXECUTED_RUNTIME if rt else STATUS_CANNOT_VERIFY), []
        else:
            sc["status"], sc["tests"] = (STATUS_EXECUTED_RUNTIME if rt else STATUS_NOT_COVERED), []


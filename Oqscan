# --------------------------------------------------------------------------
# Entry-point plugins beyond HTTP routes
# --------------------------------------------------------------------------
def _prod_files(env: Env, exts: Optional[Iterable[str]] = None) -> list[str]:
    ex = {e.lower() for e in exts} if exts else None
    return [f for f in env.ctx.tracked if env.ctx.is_production_code(f)
            and (ex is None or f.rsplit(".", 1)[-1].lower() in ex)]


def _config_files(env: Env, exts: Iterable[str]) -> list[str]:
    ex = {e.lower() for e in exts}
    return [f for f in env.ctx.tracked if not env.ctx.is_test(f) and f.rsplit(".", 1)[-1].lower() in ex
            and not env.ctx.is_generated(f)]


def _bind_below(env: Env, file: str, line: int, window: int = 8) -> Optional[Candidate]:
    """Callable whose definition starts within `window` lines below an annotation."""
    row = env.bind_decorated(file, line, window)
    return env.candidate(*row) if row else None


def _bind_name(env: Env, name: str, near_file: str) -> Optional[Candidate]:
    """Production callable by simple name; prefer the same file, then imported files."""
    rows = [r for r in env.callables_named(name.split(".")[-1]) if env.ctx.is_production_code(r[3])]
    if not rows:
        return None
    same = [r for r in rows if r[3] == near_file]
    imported = [r for r in rows if r[3] in env.graph.imports_of.get(near_file, ())]
    pick = same or imported or rows
    return env.candidate(*pick[0]) if len(pick) == 1 or same else None


def _class_ranges(env: Env, file: str) -> list[tuple[str, int, int]]:
    return [(n, a, b) for n, fp, a, b in env.graph.classes if fp == file]


def _methods_of_class(env: Env, file: str, start: int, end: int) -> list[tuple]:
    return [r for r in env.callables_in(file) if start <= r[4] <= end]


def _brace_depths(lines: list[str]) -> list[int]:
    """Bracket depth ({[ minus }]) at the start of each line, ignoring string contents."""
    depths, d = [], 0
    rx = re.compile(r"""(['"`])(?:\\.|(?!\1).)*\1""")
    for line in lines:
        depths.append(d)
        clean = rx.sub("", line)
        d += clean.count("{") + clean.count("[") - clean.count("}") - clean.count("]")
    return depths


def _camel(tag: str) -> str:
    parts = tag.split("-")
    return parts[0] + "".join(p[:1].upper() + p[1:] for p in parts[1:])


def class_decl_matches(rx: re.Pattern, lines: list[str], max_line: int, window: int = 12) -> list[tuple]:
    """(match, 1-based line) for class-declaration regexes, applied to a few lines starting at each
    line that declares a class. Scanning whole files with these lazily-quantified patterns is
    quadratic on files without braces (Python), so the search window is bounded."""
    out = []
    for i, line in enumerate(lines):
        if len(line) > max_line or "class" not in line or not re.search(r"\bclass\s+\w", line):
            continue
        m = rx.search("\n".join(lines[i:i + window]))
        if m and m.start() <= len(line):
            out.append((m, i + 1))
    return out


@plugin
class UIRouter(Plugin):
    name = "ui_router"
    summary = "Client-side routers: React Router (JSX/objects), Angular, Vue, AngularJS $routeProvider"
    DEFAULTS = {
        "extensions": ["js", "jsx", "ts", "tsx", "vue", "mjs"],
        "object_path_regex": r"""(?<![\w$])path\s*:\s*(['"`])([^'"`]*)\1""",
        "object_target_regex": r"""(?:component|element|Component|loadComponent|loadChildren|lazy)\s*:\s*(?:\(\)\s*=>\s*import\(\s*['"`]([^'"`]+)['"`]\)(?:\.then\([^)]*?(?:m|mod)\.(\w+)\))?|<?\s*([A-Z][\w$]*))""",
        "object_redirect_regex": r"""\bredirectTo\s*:""",
        "object_window_lines": 6,
        "jsx_route_regex": r"""<Route\b[^>]*?\bpath\s*=\s*\{?\s*(['"`])([^'"`]*)\1""",
        "jsx_target_regex": r"""\b(?:element|component|Component|render)\s*=\s*\{\s*(?:\(\)\s*=>\s*)?<?\s*([A-Z][\w$.]*)""",
        "jsx_child_regex": r"""<([A-Z][\w$]*)\b""",
        "angularjs_when_regex": r"""(?:\.|^\s*)when\(\s*(['"])([^'"]+)\1\s*,\s*\{""",
        "jsx_component_path_regex": r"""<([A-Z][\w$.]*)\b[^<>]*?\bpath\s*=\s*\{?\s*(['"`])([^'"`]*)\2""",
        "jsx_non_component_tags": ["Route", "Redirect", "Navigate", "Link", "NavLink", "Match"],
        "angularjs_target_regex": r"""(?:template\s*:\s*['"]<([a-z][\w-]*)|controller\s*:\s*['"](\w+)|templateUrl\s*:\s*['"]([^'"]+))""",
        "angularjs_component_decl_regex": r"""\.component\(\s*['"](\w+)['"]""",
    }

    def detect(self, env: Env) -> list[str]:
        files = _prod_files(env, self.cfg["extensions"])
        hits = []
        rx_o, rx_t = self.rx("object_path_regex"), self.rx("object_target_regex")
        rx_j = self.rx("jsx_route_regex")
        rx_jc = self.rx("jsx_component_path_regex")
        self.files = []
        for f in files:
            text = "\n".join(env.ctx.lines(f))
            if (rx_o.search(text) and rx_t.search(text)) or rx_j.search(text) or self.rx('angularjs_when_regex', re.M).search(text) or \
                    any(m.group(1) not in self.cfg["jsx_non_component_tags"] for m in rx_jc.finditer(text)):
                self.files.append(f)
                hits.append(f)
        return hits

    def _target(self, env: Env, file: str, comp: Optional[str], spec: Optional[str], line: int) -> Candidate:
        if spec:
            tf = resolve_import(env.ctx, file, spec)
            if tf:
                rows = env.callables_in(tf)
                cls = [c for c in _class_ranges(env, tf)]
                name = comp or (cls[0][0] if cls else Path(tf).stem)
                if cls:
                    return env.candidate(f"{tf}#{name}", name, "Class", tf, cls[0][1], cls[0][2])
                if rows:
                    return env.candidate(*rows[0])
                return env.candidate(f"{tf}#module", Path(tf).stem, "Module", tf, 1, 0)
        if comp:
            short = comp.split(".")[-1]
            for n, fp, a, b in env.graph.classes:
                if n == short:
                    return env.candidate(f"{fp}#{n}", n, "Class", fp, a, b)
            c = _bind_name(env, short, file)
            if c:
                return c
            return env.synthetic(file, line, short, "Class")
        return env.synthetic(file, line, f"route@{line}", "Module")

    def entry_points(self, env: Env) -> None:
        rx_o, rx_t, rx_redir = self.rx("object_path_regex"), self.rx("object_target_regex"), self.rx("object_redirect_regex")
        rx_j, rx_jt, rx_jc = self.rx("jsx_route_regex"), self.rx("jsx_target_regex"), self.rx("jsx_child_regex")
        rx_w, rx_wt = self.rx("angularjs_when_regex", re.M), self.rx("angularjs_target_regex")
        rx_decl = self.rx("angularjs_component_decl_regex")
        window = int(self.cfg["object_window_lines"])
        comp_decl: dict = {}
        for f in _prod_files(env, self.cfg["extensions"]):
            for i, line in enumerate(env.ctx.lines(f), 1):
                m = rx_decl.search(line)
                if m:
                    comp_decl.setdefault(m.group(1), (f, i))
        for f in self.files:
            lines = env.ctx.lines(f)
            depths = _brace_depths(lines)
            stack: list[tuple[int, str]] = []
            jsx_stack: list[str] = []
            for i, line in enumerate(lines):
                if len(line) > env.ctx.max_line:
                    continue
                src = f"{f}:{i + 1}"
                # object-style routes (React Router objects, Angular, Vue)
                for m in rx_o.finditer(line):
                    d = depths[i]
                    while stack and stack[-1][0] >= d:
                        stack.pop()
                    path = m.group(2)
                    full = path if path.startswith("/") else join_path(*(p for _, p in stack), path)
                    stack.append((d, path if not path.startswith("/") else path))
                    win = "\n".join(lines[i:i + window])
                    mt = rx_t.search(win)
                    if not mt or (rx_redir.search(win) and not mt):
                        continue
                    if rx_redir.search(lines[i]) or (not mt and rx_redir.search(win)):
                        continue
                    target = self._target(env, f, mt.group(2) or mt.group(3), mt.group(1), i + 1)
                    env.register(target, self.name, "ui_route", f"route {full or '/'} at {src}",
                                 {"method": "UI", "path": full or "/", "source": src, "kind": "ui"})
                # JSX <Route path=...>
                for m in rx_j.finditer(line):
                    tag_end = line.find(">", m.end())
                    tag = line[m.start(): tag_end + 1 if tag_end >= 0 else len(line)]
                    k = i
                    while tag_end < 0 and k + 1 < len(lines) and k < i + 8:
                        k += 1
                        tag += " " + lines[k].strip()
                        tag_end = lines[k].find(">")
                    self_closing = tag.rstrip().endswith("/>")
                    path = m.group(2)
                    full = path if path.startswith("/") else join_path(*jsx_stack, path)
                    mt = rx_jt.search(tag)
                    comp = mt.group(1) if mt else None
                    if comp is None and not self_closing:
                        nxt = "\n".join(lines[k + 1:k + 4]) if tag_end >= 0 else ""
                        mc = rx_jc.search(nxt)
                        comp = mc.group(1) if mc and mc.group(1) != "Route" else None
                    if comp:
                        target = self._target(env, f, comp, None, i + 1)
                        env.register(target, self.name, "ui_route", f"route {full or '/'} at {src}",
                                     {"method": "UI", "path": full or "/", "source": src, "kind": "ui"})
                    if not self_closing:
                        jsx_stack.append(path)
                for m in self.rx("jsx_component_path_regex").finditer(line):
                    if m.group(1) in self.cfg["jsx_non_component_tags"]:
                        continue
                    target = self._target(env, f, m.group(1), None, i + 1)
                    env.register(target, self.name, "ui_route", f"route {m.group(3) or '/'} at {src}",
                                 {"method": "UI", "path": m.group(3) or "/", "source": src, "kind": "ui"})
                closes = line.count("</Route>")
                for _ in range(min(closes, len(jsx_stack))):
                    jsx_stack.pop()
                # AngularJS $routeProvider.when('/x', {...})
                m = rx_w.search(line)
                if m:
                    win = "\n".join(lines[i:i + window])
                    mt = rx_wt.search(win)
                    comp = None
                    if mt and mt.group(1):
                        comp = _camel(mt.group(1))
                    elif mt and mt.group(2):
                        comp = mt.group(2)
                    if comp and comp in comp_decl:
                        cf, cl = comp_decl[comp]
                        target = env.synthetic(cf, cl, comp, "Class")
                    else:
                        target = self._target(env, f, comp, None, i + 1)
                    env.register(target, self.name, "ui_route", f"route {m.group(2)} at {src}",
                                 {"method": "UI", "path": m.group(2), "source": src, "kind": "ui"})


@plugin
class Messaging(Plugin):
    name = "messaging"
    summary = "Message/event consumers (Kafka, RabbitMQ, JMS, SQS, Service Bus, Celery, MassTransit, event handlers)"
    DEFAULTS = {
        "annotation_regex": r"""@(KafkaListener|RabbitListener|JmsListener|SqsListener|StreamListener|KafkaHandler|RabbitHandler|PulsarListener|NatsListener|ServiceActivator|EventPattern|MessagePattern|Process|OnQueueActive|Processor|SubscribeMessage|OnEvent)\b(\([^)]*\))?""",
        "attribute_trigger_regex": r"""\[(ServiceBusTrigger|QueueTrigger|EventHubTrigger|KafkaTrigger|RabbitMQTrigger|EventGridTrigger|BlobTrigger|CosmosDBTrigger)\s*\(\s*(?:@?"([^"]*)")?""",
        "python_decorator_regex": r"""^\s*@(?:[\w.]+\.)?(task|shared_task|actor|agent|subscriber|consumer|on_message|handle_message|receiver)\b(\([^)]*\))?""",
        "subscribe_call_regex": r"""\.(?:consume|subscribe|on|addListener|process)\(\s*(['"`])([\w.:/\-*#]+)\1\s*,\s*(?:async\s+)?([A-Za-z_$][\w$.]*)\s*[,)]""",
        "handler_class_regex": r"""\bclass\s+(\w+)\b[^{;]*?(?::|implements|extends)\s*[^{;]*?\b(I?\w*(?:Consumer|EventHandler|MessageHandler|IntegrationEventHandler|MessageListener|NotificationHandler)\b)""",
        "handler_method_regex": r"""^(?:handle|handleasync|consume|consumeasync|onmessage|process|receive)$""",
        "invoke_marker_regex": r"""^\s*(?:from\s+invoke\s+import|import\s+invoke\b)""",
        "topic_arg_regex": r"""(?:topics?|queues?|destination|value|channel|queueName|topicName|subject)\s*=\s*\{?\s*["']([^"']+)""",
        "first_string_regex": r"""["']([^"']+)["']""",
        "extensions": ["java", "kt", "cs", "py", "js", "ts", "go", "scala"],
    }

    def detect(self, env: Env) -> list[str]:
        self.files = _prod_files(env, self.cfg["extensions"])
        keys = ["annotation_regex", "attribute_trigger_regex", "python_decorator_regex", "subscribe_call_regex",
                "handler_class_regex"]
        hits = []
        for k in keys:
            hits += grep_files(env, self.rx(k), self.files, limit=20)
        return hits

    def entry_points(self, env: Env) -> None:
        rx_topic, rx_first = self.rx("topic_arg_regex"), self.rx("first_string_regex")
        rx_hm = self.rx("handler_method_regex", re.I)

        def topic_of(args: str) -> str:
            m = rx_topic.search(args or "") or rx_first.search(args or "")
            return m.group(1) if m else ""

        for f in self.files:
            lines = env.ctx.lines(f)
            for i, line in enumerate(lines, 1):
                if len(line) > env.ctx.max_line:
                    continue
                src = f"{f}:{i}"
                m = self.rx("annotation_regex").search(line)
                if m:
                    args = m.group(2) or " ".join(lines[i - 1:i + 2])
                    c = _bind_below(env, f, i)
                    if c:
                        t = topic_of(args)
                        env.register(c, self.name, "message_consumer", f"@{m.group(1)} at {src}",
                                     {"method": "TOPIC", "path": t or m.group(1), "source": src, "kind": "message"})
                    continue
                m = self.rx("attribute_trigger_regex").search(line)
                if m:
                    c = env.callable_at(f, i)
                    c = env.candidate(*c) if c else _bind_below(env, f, i)
                    if c:
                        env.register(c, self.name, "message_consumer", f"[{m.group(1)}] at {src}",
                                     {"method": "TOPIC", "path": m.group(2) or m.group(1), "source": src, "kind": "message"})
                    continue
                if f.endswith(".py"):
                    m = self.rx("python_decorator_regex").search(line)
                    if m and m.group(1) == "task" and self.rx("invoke_marker_regex", re.M).search("\n".join(lines[:60])):
                        c = _bind_below(env, f, i, 4)
                        if c:
                            env.register(c, self.name, "cli", f"invoke task at {src}",
                                         {"method": "CLI", "path": c.name, "source": src, "kind": "cli"})
                        continue
                    if m:
                        c = _bind_below(env, f, i, 4)
                        if c:
                            env.register(c, self.name, "message_consumer", f"@{m.group(1)} at {src}",
                                         {"method": "TOPIC", "path": topic_of(m.group(2)) or c.name, "source": src,
                                          "kind": "message"}, CONF_MEDIUM)
                        continue
                m = self.rx("subscribe_call_regex").search(line)
                if m and not env.ctx.is_test(f):
                    c = _bind_name(env, m.group(3), f)
                    if c:
                        env.register(c, self.name, "message_consumer", f"subscribed to {m.group(2)} at {src}",
                                     {"method": "TOPIC", "path": m.group(2), "source": src, "kind": "message"}, CONF_MEDIUM)
            for m, line_no in class_decl_matches(self.rx("handler_class_regex"), lines, env.ctx.max_line):
                rng = next(((a, b) for n, a, b in _class_ranges(env, f) if n == m.group(1)), None)
                if not rng:
                    continue
                for row in _methods_of_class(env, f, rng[0], rng[1]):
                    if rx_hm.match(row[1]):
                        env.register(env.candidate(*row), self.name, "message_consumer",
                                     f"{m.group(1)} implements {m.group(2)} ({f}:{line_no})",
                                     {"method": "TOPIC", "path": m.group(1), "source": f"{f}:{line_no}", "kind": "message"})


@plugin
class Schedulers(Plugin):
    name = "schedulers_batch"
    summary = "Scheduled jobs, batch jobs, workers and startup runners (@Scheduled, Quartz, Spring Batch, Hangfire, BackgroundService, Celery beat, node-cron, Airflow, CronJob)"
    DEFAULTS = {
        "annotation_regex": r"""(?:@(Scheduled|Schedule|Schedules|Cron|Interval|Timeout|periodic_task|scheduled_job|repeat_every)\b|\[(TimerTrigger)\b)(\s*\([^)]*\))?""",
        "call_regex": r"""(?:cron\.schedule|schedule\.scheduleJob|scheduler\.add_job|RecurringJob\.AddOrUpdate|BackgroundJob\.Enqueue|agenda\.define|new\s+CronJob)\s*(?:<[^>]*>)?\(\s*(?:(['"`])([^'"`]*)\1\s*,\s*)?(?:(['"`])([^'"`]*)\3\s*,\s*)?(?:\(?\s*\w*\s*\)?\s*=>\s*)?([A-Za-z_$][\w$.]*)?""",
        "schedule_do_regex": r"""schedule\.every\([^)]*\)[\w.()]*\.do\(\s*([A-Za-z_][\w.]*)""",
        "class_regex": r"""\bclass\s+(\w+)\b[^{;]*?(?::|implements|extends)\s*[^{;]*?\b(Job|QuartzJobBean|IJob|BackgroundService|IHostedService|CommandLineRunner|ApplicationRunner|Tasklet|ItemProcessor|ItemReader|ItemWriter|IInvocable)\b""",
        "class_entry_methods": {"Job": "execute", "QuartzJobBean": "executeInternal", "IJob": "Execute",
                                "BackgroundService": "ExecuteAsync", "IHostedService": "StartAsync",
                                "CommandLineRunner": "run", "ApplicationRunner": "run", "Tasklet": "execute",
                                "ItemProcessor": "process", "ItemReader": "read", "ItemWriter": "write", "IInvocable": "Invoke"},
        "class_kinds": {"Job": "scheduler", "QuartzJobBean": "scheduler", "IJob": "scheduler",
                        "BackgroundService": "worker", "IHostedService": "worker", "CommandLineRunner": "startup_runner",
                        "ApplicationRunner": "startup_runner", "Tasklet": "batch_job", "ItemProcessor": "batch_job",
                        "ItemReader": "batch_job", "ItemWriter": "batch_job", "IInvocable": "scheduler"},
        "batch_job_bean_regex": r"""^\s*(?:public\s+)?(?:Job|Flow)\s+(\w+)\s*\(""",
        "airflow_dag_regex": r"""(?:\bDAG\(\s*(?:dag_id\s*=\s*)?['"]([\w.\-]+)['"]|^\s*@dag\b)""",
        "k8s_cronjob_regex": r"""^\s*kind:\s*CronJob\b""",
        "cron_arg_regex": r"""(?:cron|fixedRate|fixedDelay|every|schedule)\s*=?\s*["']?([^"',)]+)""",
        "extensions": ["java", "kt", "cs", "py", "js", "ts", "go", "scala"],
    }

    def detect(self, env: Env) -> list[str]:
        self.files = _prod_files(env, self.cfg["extensions"])
        hits = []
        for k in ("annotation_regex", "call_regex", "schedule_do_regex", "class_regex", "airflow_dag_regex"):
            hits += grep_files(env, self.rx(k), self.files, limit=20)
        self.yaml = [f for f in _config_files(env, ["yaml", "yml"]) if any(self.rx("k8s_cronjob_regex").match(l) for l in env.ctx.lines(f))]
        return hits + self.yaml

    def entry_points(self, env: Env) -> None:
        rx_cron = self.rx("cron_arg_regex")
        for f in self.files:
            lines = env.ctx.lines(f)
            for i, line in enumerate(lines, 1):
                if len(line) > env.ctx.max_line:
                    continue
                src = f"{f}:{i}"
                m = self.rx("annotation_regex").search(line)
                if m:
                    c = _bind_below(env, f, i) or (env.candidate(*env.callable_at(f, i)) if m.group(2) and env.callable_at(f, i) else None)
                    if c:
                        mc = rx_cron.search(m.group(3) or "")
                        env.register(c, self.name, "scheduler", f"{m.group(1) or m.group(2)} at {src}",
                                     {"method": "SCHEDULE", "path": (mc.group(1).strip() if mc else (m.group(1) or m.group(2))),
                                      "source": src, "kind": "schedule"})
                    continue
                m = self.rx("call_regex").search(line)
                if m:
                    name = m.group(5)
                    c = _bind_name(env, name, f) if name else None
                    if c is None:
                        c = env.synthetic(f, i, f"scheduled@{i}")
                    env.register(c, self.name, "scheduler", f"scheduled at {src}",
                                 {"method": "SCHEDULE", "path": m.group(2) or m.group(4) or "", "source": src, "kind": "schedule"},
                                 CONF_MEDIUM)
                    continue
                m = self.rx("schedule_do_regex").search(line)
                if m:
                    c = _bind_name(env, m.group(1), f)
                    if c:
                        env.register(c, self.name, "scheduler", f"schedule.every at {src}",
                                     {"method": "SCHEDULE", "path": line.strip()[:60], "source": src, "kind": "schedule"})
                    continue
                m = self.rx("batch_job_bean_regex").search(line)
                if m and any("@Bean" in l for l in lines[max(0, i - 4):i]):
                    c = _bind_below(env, f, i, 1)
                    if c:
                        env.register(c, self.name, "batch_job", f"batch job bean {m.group(1)} at {src}",
                                     {"method": "JOB", "path": m.group(1), "source": src, "kind": "batch"})
                    continue
                if f.endswith(".py"):
                    m = self.rx("airflow_dag_regex").search(line)
                    if m:
                        c = _bind_below(env, f, i, 3) if not m.group(1) else env.synthetic(f, i, m.group(1), "Module")
                        if c:
                            env.register(c, self.name, "batch_job", f"Airflow DAG at {src}",
                                         {"method": "JOB", "path": m.group(1) or c.name, "source": src, "kind": "batch"})
            for m, _ln in class_decl_matches(self.rx("class_regex"), lines, env.ctx.max_line):
                base = m.group(2)
                rng = next(((a, b) for n, a, b in _class_ranges(env, f) if n == m.group(1)), None)
                if not rng:
                    continue
                want = self.cfg["class_entry_methods"].get(base, "").lower()
                for row in _methods_of_class(env, f, rng[0], rng[1]):
                    if row[1].lower() == want:
                        kind = self.cfg["class_kinds"].get(base, "scheduler")
                        env.register(env.candidate(*row), self.name, kind, f"{m.group(1)} : {base} ({f})",
                                     {"method": "JOB" if kind != "startup_runner" else "CLI", "path": m.group(1),
                                      "source": f"{f}:{rng[0]}", "kind": "batch" if kind != "startup_runner" else "cli"})
        for f in self.yaml:
            for i, line in enumerate(env.ctx.lines(f), 1):
                if self.rx("k8s_cronjob_regex").match(line):
                    env.register(env.synthetic(f, i, f"CronJob@{Path(f).name}", "Module"), self.name, "scheduler",
                                 f"Kubernetes CronJob {f}:{i}", {"method": "SCHEDULE", "path": Path(f).stem, "source": f"{f}:{i}",
                                                                 "kind": "schedule"}, CONF_MEDIUM)


@plugin
class Serverless(Plugin):
    name = "serverless"
    summary = "Serverless function handlers (AWS SAM/CloudFormation, Serverless Framework, CDK, Azure Functions)"
    DEFAULTS = {
        "template_marker_regex": r"""(AWS::Serverless::Function|AWS::Lambda::Function|^functions:\s*$|^service:\s*\S)""",
        "handler_regex": r"""^\s*Handler:\s*['"]?([^'"\s]+)""",
        "codeuri_regex": r"""^\s*CodeUri:\s*['"]?([^'"\s]+)""",
        "sls_handler_regex": r"""^\s*handler:\s*['"]?([^'"\s]+)""",
        "event_path_regex": r"""^\s*Path:\s*['"]?([^'"\s]+)""",
        "event_method_regex": r"""^\s*Method:\s*['"]?(\w+)""",
        "sls_http_regex": r"""^\s*(?:-\s*)?(?:http|httpApi):\s*(?:(\w+)\s+(\S+))?""",
        "sls_path_regex": r"""^\s*path:\s*['"]?([^'"\s]+)""",
        "sls_method_regex": r"""^\s*method:\s*['"]?(\w+)""",
        "event_type_regex": r"""^\s*Type:\s*(Api|HttpApi|SQS|SNS|Schedule|ScheduleV2|S3|DynamoDB|Kinesis|EventBridgeRule|CloudWatchEvent)\b""",
        "cdk_handler_regex": r"""handler\s*:\s*['"]([\w./]+)['"]""",
        "azure_function_regex": r"""\[(?:Function|FunctionName)\(\s*"([^"]+)"\s*\)\]""",
        "azure_http_regex": r"""\[HttpTrigger\([^\]]*?((?:"(?:get|post|put|patch|delete)"\s*,?\s*)+)[^\]]*?(?:Route\s*=\s*"([^"]*)")?""",
        "code_extensions": ["py", "js", "ts", "mjs", "java", "cs", "go"],
    }

    def detect(self, env: Env) -> list[str]:
        rx = self.rx("template_marker_regex", re.M)
        self.templates = [f for f in _config_files(env, ["yaml", "yml", "json", "template"])
                          if rx.search("\n".join(env.ctx.lines(f)))]
        self.az = grep_files(env, self.rx("azure_function_regex"), _prod_files(env, ["cs"]))
        cdk = grep_files(env, self.rx("cdk_handler_regex"), _prod_files(env, ["ts", "js", "py"]))
        self.cdk = cdk
        return self.templates + self.az + cdk

    def _resolve(self, env: Env, handler: str, base_dir: str) -> Optional[Candidate]:
        """app.lambda_handler | index.handler | pkg.Class::method | Asm::Ns.Class::Method -> callable."""
        if "::" in handler:
            func = handler.split("::")[-1]
            cls = handler.split("::")[-2].split(".")[-1]
        else:
            mod, _, func = handler.rpartition(".")
            cls = None
        rows = [r for r in env.callables_named(func) if env.ctx.is_production_code(r[3])]
        if cls:
            rows = [r for r in rows if cls.lower() in r[0].lower() or Path(r[3]).stem.lower() == cls.lower()] or rows
        else:
            mod_path = mod.replace(".", "/")
            pref = [r for r in rows if mod_path and (f"/{mod_path}." in "/" + r[3] or r[3].startswith(f"{base_dir}/{mod_path}."))]
            in_dir = [r for r in rows if base_dir and r[3].startswith(base_dir)]
            rows = pref or in_dir or rows
        return env.candidate(*rows[0]) if rows else None

    def entry_points(self, env: Env) -> None:
        for f in self.templates:
            lines = env.ctx.lines(f)
            base = str(Path(f).parent).replace("\\", "/").strip(".")
            fn_blocks = []
            for i, line in enumerate(lines):
                m = self.rx("handler_regex").match(line) or self.rx("sls_handler_regex").match(line)
                if m:
                    fn_blocks.append((i, m.group(1)))
            for n, (i, handler) in enumerate(fn_blocks):
                end = fn_blocks[n + 1][0] if n + 1 < len(fn_blocks) else len(lines)
                start = max(0, i - 15)
                block = lines[start:end]
                code_uri = next((self.rx("codeuri_regex").match(l).group(1) for l in block if self.rx("codeuri_regex").match(l)), "")
                bdir = "/".join(x for x in (base, code_uri.strip("./").rstrip("/")) if x)
                c = self._resolve(env, handler, bdir)
                if c is None:
                    c = env.synthetic(f, i + 1, handler.split(".")[-1].split("::")[-1])
                events = []
                for k, l in enumerate(lines[i:end]):
                    mt = self.rx("event_type_regex").match(l)
                    if mt and mt.group(1) in ("Api", "HttpApi"):
                        win = lines[i + k:i + k + 8]
                        p = next((self.rx("event_path_regex").match(x).group(1) for x in win if self.rx("event_path_regex").match(x)), None)
                        mm = next((self.rx("event_method_regex").match(x).group(1) for x in win if self.rx("event_method_regex").match(x)), None)
                        if p:
                            events.append(({"method": None if (mm or "any").lower() == "any" else mm.upper(), "path": p,
                                            "kind": "http"}, i + k + 1))
                    elif mt:
                        events.append(({"method": "EVENT", "path": mt.group(1), "kind": "event"}, i + k + 1))
                    ms = self.rx("sls_http_regex").match(l)
                    if ms and ("http" in l):
                        win = lines[i + k:i + k + 6]
                        if ms.group(1) and ms.group(2):
                            events.append(({"method": ms.group(1).upper(), "path": ms.group(2), "kind": "http"}, i + k + 1))
                        else:
                            p = next((self.rx("sls_path_regex").match(x).group(1) for x in win if self.rx("sls_path_regex").match(x)), None)
                            mm = next((self.rx("sls_method_regex").match(x).group(1) for x in win if self.rx("sls_method_regex").match(x)), None)
                            if p:
                                events.append(({"method": mm.upper() if mm else None, "path": p, "kind": "http"}, i + k + 1))
                if not events:
                    env.register(c, self.name, "serverless", f"function handler {handler} ({f}:{i + 1})",
                                 {"method": "INVOKE", "path": handler, "source": f"{f}:{i + 1}", "kind": "function"})
                for ev, ln in events:
                    env.register(c, self.name, "serverless", f"function handler {handler} ({f}:{i + 1})",
                                 {**ev, "path": ev["path"] if ev["kind"] != "http" else join_path(ev["path"]),
                                  "source": f"{f}:{ln}"})
        for loc in self.az:
            f, ln = loc.rsplit(":", 1)
            lines = env.ctx.lines(f)
            for i, line in enumerate(lines, 1):
                m = self.rx("azure_function_regex").search(line)
                if not m:
                    continue
                c = _bind_below(env, f, i, 3)
                if not c:
                    continue
                win = " ".join(lines[i - 1:i + 6])
                mh = self.rx("azure_http_regex").search(win)
                if mh:
                    for verb in re.findall(r'"(\w+)"', mh.group(1)):
                        env.register(c, self.name, "serverless", f"Azure Function {m.group(1)} ({f}:{i})",
                                     {"method": verb.upper(), "path": join_path("api", mh.group(2) or m.group(1)),
                                      "source": f"{f}:{i}", "kind": "http"})
                else:
                    env.register(c, self.name, "serverless", f"Azure Function {m.group(1)} ({f}:{i})",
                                 {"method": "INVOKE", "path": m.group(1), "source": f"{f}:{i}", "kind": "function"})
        for loc in self.cdk:
            f, ln = loc.rsplit(":", 1)
            for i, line in enumerate(env.ctx.lines(f), 1):
                m = self.rx("cdk_handler_regex").search(line)
                if m and "." in m.group(1):
                    c = self._resolve(env, m.group(1), "")
                    if c:
                        env.register(c, self.name, "serverless", f"CDK function handler {m.group(1)} ({f}:{i})",
                                     {"method": "INVOKE", "path": m.group(1), "source": f"{f}:{i}", "kind": "function"},
                                     CONF_MEDIUM)


@plugin
class GRPC(Plugin):
    name = "grpc"
    summary = "gRPC services from .proto files bound to their server implementations"
    DEFAULTS = {
        "service_regex": r"""^\s*service\s+(\w+)\s*\{""",
        "rpc_regex": r"""^\s*rpc\s+(\w+)\s*\(""",
        "impl_markers": ["{S}ImplBase", "{S}Servicer", "{S}Base", "Register{S}Server", "Unimplemented{S}Server",
                         "{S}.service", "{S}Service", "{S}Handler"],
    }

    def detect(self, env: Env) -> list[str]:
        self.services: dict = {}
        for f in env.ctx.tracked:
            if not f.endswith(".proto"):
                continue
            svc = None
            for i, line in enumerate(env.ctx.lines(f), 1):
                ms = self.rx("service_regex").match(line)
                if ms:
                    svc = ms.group(1)
                    self.services.setdefault(svc, [])
                    continue
                mr = self.rx("rpc_regex").match(line)
                if mr and svc:
                    self.services[svc].append((mr.group(1), f"{f}:{i}"))
                if line.strip() == "}":
                    svc = None
        return [f"{s} ({len(r)} rpc)" for s, r in self.services.items() if r]

    def entry_points(self, env: Env) -> None:
        prod = _prod_files(env)
        texts = {f: "\n".join(env.ctx.lines(f)) for f in prod}
        for svc, rpcs in self.services.items():
            markers = [m.replace("{S}", svc) for m in self.cfg["impl_markers"]]
            impl_files = [f for f, t in texts.items() if any(mk in t for mk in markers) and not f.endswith(".proto")
                          and not env.ctx.is_generated(f)]
            for rpc, where in rpcs:
                for f in impl_files:
                    for row in env.callables_in(f):
                        if row[1].lower() == rpc.lower():
                            env.register(env.candidate(*row), self.name, "rpc", f"implements rpc {svc}/{rpc} ({where})",
                                         {"method": "RPC", "path": f"{svc}/{rpc}", "source": where, "kind": "rpc"})


@plugin
class GraphQL(Plugin):
    name = "graphql"
    summary = "GraphQL operations bound to resolvers (SDL + resolver maps, Spring GraphQL/DGS, Graphene, Strawberry, Ariadne, HotChocolate)"
    DEFAULTS = {
        "sdl_type_regex": r"""\b(?:extend\s+)?type\s+(Query|Mutation|Subscription)\b[^{]*\{""",
        "resolver_map_regex": r"""\b(Query|Mutation|Subscription)\w*\s*(?::\s*\{|(?::[^=\n]*)?=\s*\{)""",
        "resolver_key_regex": r"""^\s*(?:async\s+)?([A-Za-z_$][\w$]*)\s*(?::|\()""",
        "annotation_regex": r"""@(QueryMapping|MutationMapping|SubscriptionMapping|DgsQuery|DgsMutation|DgsSubscription)\b(?:\(\s*(?:name\s*=\s*|field\s*=\s*)?"(\w+)")?""",
        "schema_mapping_regex": r"""@(?:SchemaMapping|DgsData)\(\s*[^)]*?(?:typeName|parentType)\s*=\s*"(Query|Mutation|Subscription)"[^)]*?field\s*=\s*"(\w+)\"""",
        "python_class_regex": r"""^\s*class\s+(\w*(?:Query|Mutation|Subscription)\w*)\s*\(""",
        "python_resolver_regex": r"""^\s*def\s+resolve_(\w+)\s*\(""",
        "python_field_decorator_regex": r"""^\s*@(?:strawberry\.(field|mutation|subscription)|(query|mutation)\.field\(\s*['"](\w+)['"])""",
        "dotnet_class_regex": r"""\[(?:ExtendObjectType|QueryType|MutationType)\b[^\]]*\]|class\s+(Query|Mutation)\b""",
        "extensions": ["js", "ts", "mjs", "java", "kt", "py", "cs", "graphql", "gql"],
    }

    def detect(self, env: Env) -> list[str]:
        self.files = _prod_files(env, self.cfg["extensions"]) + [f for f in env.ctx.tracked
                                                                   if f.endswith((".graphql", ".gql")) and not env.ctx.is_test(f)]
        hits = []
        for k in ("sdl_type_regex", "resolver_map_regex", "annotation_regex", "python_class_regex"):
            hits += grep_files(env, self.rx(k), self.files, limit=10)
        self.sdl_fields: dict = {}
        for f in self.files:
            lines = env.ctx.lines(f)
            for i, line in enumerate(lines):
                m = self.rx("sdl_type_regex").search(line)
                if not m:
                    continue
                depth = line.count("{") - line.count("}")
                for k in range(i + 1, min(len(lines), i + 400)):
                    l2 = lines[k]
                    if depth == 1:
                        mf = re.match(r"^\s*(\w+)\s*[(:]", l2)
                        if mf:
                            self.sdl_fields.setdefault(mf.group(1), (m.group(1), f"{f}:{k + 1}"))
                    depth += l2.count("{") - l2.count("}")
                    if depth <= 0:
                        break
        return hits

    def _reg(self, env: Env, c: Candidate, op: str, field_: str, src: str) -> None:
        env.register(c, self.name, "graphql", f"{op} {field_} resolver ({src})",
                     {"method": op.upper().replace("SUBSCRIPTION", "SUBSCRIBE"), "path": field_, "source": src,
                      "kind": "graphql"})

    def entry_points(self, env: Env) -> None:
        for f in self.files:
            if f.endswith((".graphql", ".gql")):
                continue
            lines = env.ctx.lines(f)
            depths = _brace_depths(lines)
            py_class = None
            for i, line in enumerate(lines):
                if len(line) > env.ctx.max_line:
                    continue
                src = f"{f}:{i + 1}"
                m = self.rx("resolver_map_regex").search(line)
                if m and not f.endswith(".py"):
                    op, d0 = m.group(1), depths[i] + line[:m.end()].count("{") - line[:m.start()].count("}")
                    for k in range(i + 1, min(len(lines), i + 500)):
                        if depths[k] < d0:
                            break
                        if depths[k] == d0:
                            mk = self.rx("resolver_key_regex").match(lines[k])
                            if mk:
                                name = mk.group(1)
                                rest = lines[k][mk.end():].strip().rstrip(",")
                                c = None
                                if re.fullmatch(r"[A-Za-z_$][\w$.]*", rest or ""):
                                    c = _bind_name(env, rest, f)
                                if c is None:
                                    row = env.callable_at(f, k + 1)
                                    c = env.candidate(*row) if row and row[4] == k + 1 else env.synthetic(f, k + 1, name)
                                self._reg(env, c, op, name, f"{f}:{k + 1}")
                    continue
                m = self.rx("annotation_regex").search(line)
                if m:
                    c = _bind_below(env, f, i + 1)
                    if c:
                        op = "Query" if "Query" in m.group(1) else "Mutation" if "Mutation" in m.group(1) else "Subscription"
                        self._reg(env, c, op, m.group(2) or c.name, src)
                    continue
                m = self.rx("schema_mapping_regex").search(line)
                if m:
                    c = _bind_below(env, f, i + 1)
                    if c:
                        self._reg(env, c, m.group(1), m.group(2), src)
                    continue
                if f.endswith(".py"):
                    mc = self.rx("python_class_regex").match(line)
                    if mc:
                        py_class = (mc.group(1), len(line) - len(line.lstrip()))
                        continue
                    if py_class and line.strip() and (len(line) - len(line.lstrip())) <= py_class[1]:
                        py_class = None
                    mr = self.rx("python_resolver_regex").match(line)
                    if mr and py_class:
                        row = env.callable_at(f, i + 1)
                        c = env.candidate(*row) if row else env.synthetic(f, i + 1, f"resolve_{mr.group(1)}")
                        op = "Mutation" if "Mutation" in py_class[0] else "Query"
                        self._reg(env, c, op, mr.group(1), src)
                        continue
                    md = self.rx("python_field_decorator_regex").match(line)
                    if md:
                        c = _bind_below(env, f, i + 1, 3)
                        if c:
                            op = (md.group(1) or md.group(2) or "query").capitalize()
                            op = "Query" if op == "Field" else op
                            self._reg(env, c, op, md.group(3) or c.name, src)
        # SDL fields whose resolver is a same-named method/function (HotChocolate, Kickstart, gqlgen ...)
        named = {f for c in env.cands.values() for t in c.triggers if t.get("kind") == "graphql" for f in [t["path"]]}
        for field_, (op, where) in self.sdl_fields.items():
            if field_ in named:
                continue
            rows = [r for r in env.callables_named(field_) if env.ctx.is_production_code(r[3])]
            rows += [r for r in env.callables_named(field_[:1].upper() + field_[1:]) if env.ctx.is_production_code(r[3])]
            if len(rows) == 1:
                self._reg(env, env.candidate(*rows[0]), op, field_, where)


@plugin
class Gateways(Plugin):
    name = "gateways"
    summary = "API gateway / reverse-proxy routes (Spring Cloud Gateway, Zuul, Ocelot, YARP, nginx)"
    DEFAULTS = {
        "scg_path_regex": r"""(?:-\s*)?Path\s*=\s*([^\s,'"]+(?:,[^\s,'"]+)*)""",
        "scg_uri_regex": r"""^\s*(?:-\s*)?uri:\s*(\S+)""",
        "zuul_regex": r"""^\s*zuul\s*:""",
        "zuul_path_regex": r"""^\s*path:\s*['"]?(/[^'"\s]*)""",
        "zuul_service_regex": r"""^\s*(?:serviceId|url):\s*(\S+)""",
        "ocelot_upstream_regex": r""""UpstreamPathTemplate"\s*:\s*"([^"]+)\"""",
        "yarp_path_regex": r""""Path"\s*:\s*"(/[^"]+)\"""",
        "nginx_location_regex": r"""^\s*location\s+(?:[=~^*]+\s+)?(/\S*)\s*\{""",
        "nginx_proxy_regex": r"""proxy_pass\s+(\S+);""",
        "rewrite_source_regex": r"""\bsource\s*:\s*['"](/[^'"]*)['"]""",
        "rewrite_destination_regex": r"""\bdestination\s*:\s*['"]([^'"]+)['"]""",
        "rewrite_config_regex": r"""(?:^|/)(?:next\.config\.(?:js|mjs|ts)|vercel\.json|netlify\.toml)$""",
    }

    def detect(self, env: Env) -> list[str]:
        self.rewrites = [f for f in env.ctx.tracked if self.rx("rewrite_config_regex").search(f)
                         and self.rx("rewrite_source_regex").search("\n".join(env.ctx.lines(f)))]
        self.cfgs = _config_files(env, ["yml", "yaml", "properties", "json", "conf"])
        hits = []
        for f in self.cfgs:
            text = "\n".join(env.ctx.lines(f))
            if ("Path=" in text and "uri:" in text) or self.rx("zuul_regex", re.M).search(text) \
                    or "UpstreamPathTemplate" in text or ('"ReverseProxy"' in text) or ("proxy_pass" in text):
                hits.append(f)
        self.cfgs = hits
        return hits + self.rewrites

    def entry_points(self, env: Env) -> None:
        for f in self.rewrites:
            lines = env.ctx.lines(f)
            for i, line in enumerate(lines):
                m = self.rx("rewrite_source_regex").search(line)
                if not m:
                    continue
                d = self.rx("rewrite_destination_regex").search(" ".join(lines[i:i + 3]))
                c = env.synthetic(f, i + 1, f"rewrite {m.group(1)}", "Module")
                env.register(c, self.name, "gateway_route", f"rewrite {m.group(1)} -> {d.group(1) if d else '?'} ({f}:{i + 1})",
                             {"method": None, "path": m.group(1), "source": f"{f}:{i + 1}", "kind": "http"}, CONF_MEDIUM)
                if d:
                    env.outbound.append({"from": c.qn, "kind": "http", "method": None, "path": d.group(1),
                                         "at": f"{f}:{i + 1}", "via": "rewrite"})
        for f in self.cfgs:
            lines = env.ctx.lines(f)
            for i, line in enumerate(lines):
                src = f"{f}:{i + 1}"
                found = []
                m = self.rx("scg_path_regex").search(line)
                if m and "Path" in line:
                    uri = next((self.rx("scg_uri_regex").match(l).group(1) for l in reversed(lines[max(0, i - 8):i])
                                if self.rx("scg_uri_regex").match(l)), "")
                    found = [(p, uri) for p in m.group(1).split(",")]
                elif self.rx("zuul_path_regex").match(line) and any(self.rx("zuul_regex").match(l) for l in lines[:i]):
                    svc = next((self.rx("zuul_service_regex").match(l).group(1) for l in lines[i + 1:i + 5]
                                if self.rx("zuul_service_regex").match(l)), "")
                    found = [(self.rx("zuul_path_regex").match(line).group(1), svc)]
                else:
                    for key in ("ocelot_upstream_regex", "yarp_path_regex"):
                        mm = self.rx(key).search(line)
                        if mm:
                            found = [(mm.group(1), "")]
                    mn = self.rx("nginx_location_regex").match(line)
                    if mn:
                        px = next((self.rx("nginx_proxy_regex").search(l).group(1) for l in lines[i + 1:i + 8]
                                   if self.rx("nginx_proxy_regex").search(l)), None)
                        if px:
                            found = [(mn.group(1), px)]
                for path, target in found:
                    c = env.synthetic(f, i + 1, f"gateway {path}", "Module")
                    env.register(c, self.name, "gateway_route", f"gateway route {path} -> {target or '?'} ({src})",
                                 {"method": None, "path": path.replace("{**catch-all}", "**").replace("{everything}", "**"),
                                  "source": src, "kind": "http"}, CONF_MEDIUM)
                    env.outbound.append({"from": c.qn, "kind": "gateway", "target": target, "path": path, "at": src})


@plugin
class XmlWebConfig(Plugin):
    name = "xml_web_config"
    summary = "XML-configured web entry points (web.xml servlets, struts.xml actions, Spring MVC view-controllers)"
    DEFAULTS = {
        "servlet_regex": r"""<servlet>\s*""",
        "servlet_name_regex": r"""<servlet-name>\s*([^<\s]+)\s*</servlet-name>""",
        "servlet_class_regex": r"""<servlet-class>\s*([^<\s]+)\s*</servlet-class>""",
        "url_pattern_regex": r"""<url-pattern>\s*([^<\s]+)\s*</url-pattern>""",
        "servlet_methods": ["doGet", "doPost", "doPut", "doDelete", "service"],
        "struts_package_regex": r"""<package\b[^>]*?(?:namespace\s*=\s*"([^"]*)")?[^>]*>""",
        "struts_action_regex": r"""<action\b[^>]*?\bname\s*=\s*"([^"]+)"[^>]*>""",
        "attr_class_regex": r"""\bclass\s*=\s*"([^"]+)\"""",
        "attr_method_regex": r"""\bmethod\s*=\s*"([^"]+)\"""",
        "struts_default_method": "execute",
        "struts_annotation_regex": r"""@Action\(\s*(?:value\s*=\s*)?"([^"]+)\"""",
        "struts_namespace_regex": r"""@Namespace\(\s*"([^"]*)"\s*\)""",
        "view_controller_regex": r"""<mvc:view-controller\b[^>]*?\bpath\s*=\s*"([^"]+)\"""",
        "struts_convention_marker": "struts2-convention-plugin",
        "struts_convention_packages": ["actions", "action", "struts", "struts2"],
        "struts_convention_suffix": "Action",
        "server_page_extensions": ["jsp", "jspx"],
        "web_root_regex": r"""(?:^|/)(?:src/main/webapp|WebContent|webapp)/""",
        "private_dir_regex": r"""(?:^|/)(?:WEB-INF|META-INF)/""",
    }

    def detect(self, env: Env) -> list[str]:
        self.xml = [f for f in env.ctx.tracked if f.endswith(".xml") and not env.ctx.is_test(f)
                    and re.search(r"<(servlet|action|mvc:view-controller)\b", "\n".join(env.ctx.lines(f)))]
        self.java = grep_files(env, self.rx("struts_annotation_regex"), _prod_files(env, ["java"]))
        self.convention = any(self.cfg["struts_convention_marker"] in "\n".join(env.ctx.lines(f))
                              for f in env.ctx.tracked if f.endswith(("pom.xml", ".gradle", ".gradle.kts")))
        ex = set(self.cfg["server_page_extensions"])
        self.pages = [f for f in env.ctx.tracked if f.rsplit(".", 1)[-1].lower() in ex and not env.ctx.is_test(f)
                      and re.search(self.cfg["web_root_regex"], f) and not re.search(self.cfg["private_dir_regex"], f)]
        return self.xml + self.java + (["struts2-convention-plugin"] if self.convention else []) + self.pages

    def _class_methods(self, env: Env, fqcn: str) -> list[tuple]:
        simple = fqcn.split(".")[-1]
        path = fqcn.replace(".", "/")
        out = []
        for n, fp, a, b in env.graph.classes:
            if n == simple and (path in fp or True):
                out.extend(_methods_of_class(env, fp, a, b))
        return out

    def entry_points(self, env: Env) -> None:
        for f in self.xml:
            lines = env.ctx.lines(f)
            text = "\n".join(lines)
            # servlets
            classes = {}
            for m in re.finditer(r"<servlet>(.*?)</servlet>", text, re.S):
                n, c = self.rx("servlet_name_regex").search(m.group(1)), self.rx("servlet_class_regex").search(m.group(1))
                if n and c:
                    classes[n.group(1)] = c.group(1)
            for m in re.finditer(r"<servlet-mapping>(.*?)</servlet-mapping>", text, re.S):
                n = self.rx("servlet_name_regex").search(m.group(1))
                if not n or n.group(1) not in classes:
                    continue
                ln = text[:m.start()].count("\n") + 1
                for up in self.rx("url_pattern_regex").findall(m.group(1)):
                    methods = [r for r in self._class_methods(env, classes[n.group(1)]) if r[1] in self.cfg["servlet_methods"]]
                    for row in methods or []:
                        verb = row[1][2:].upper() if row[1].startswith("do") else None
                        env.register(env.candidate(*row), self.name, "http", f"servlet {n.group(1)} {up} ({f}:{ln})",
                                     {"method": verb, "path": up, "source": f"{f}:{ln}", "kind": "http"})
            # struts actions
            ns = ""
            for i, line in enumerate(lines, 1):
                mp = self.rx("struts_package_regex").search(line)
                if mp and "<package" in line:
                    ns = mp.group(1) or ""
                ma = self.rx("struts_action_regex").search(line)
                if not ma or "<action" not in line:
                    continue
                name = ma.group(1)
                cls = self.rx("attr_class_regex").search(line)
                meth = self.rx("attr_method_regex").search(line)
                src = f"{f}:{i}"
                rows = self._class_methods(env, cls.group(1)) if cls else []
                if "*" in name and meth and "{1}" in meth.group(1):
                    for row in rows:
                        mname = meth.group(1).replace("{1}", row[1])
                        if mname == row[1]:
                            path = join_path(ns, name.replace("*", row[1]))
                            env.register(env.candidate(*row), self.name, "http", f"struts action {name} ({src})",
                                         {"method": None, "path": path, "source": src, "kind": "http"})
                    continue
                want = meth.group(1) if meth else self.cfg["struts_default_method"]
                row = next((r for r in rows if r[1] == want), None)
                c = env.candidate(*row) if row else env.synthetic(f, i, name)
                env.register(c, self.name, "http", f"struts action {name} ({src})",
                             {"method": None, "path": join_path(ns, name), "source": src, "kind": "http"})
            for m in self.rx("view_controller_regex").finditer(text):
                ln = text[:m.start()].count("\n") + 1
                env.register(env.synthetic(f, ln, f"view {m.group(1)}"), self.name, "http",
                             f"view-controller {m.group(1)} ({f}:{ln})",
                             {"method": "GET", "path": m.group(1), "source": f"{f}:{ln}", "kind": "http"})
        for f in self.pages:
            path = "/" + re.split(self.cfg["web_root_regex"], f, maxsplit=1)[-1]
            env.register(env.candidate(f"{f}#page", Path(f).name, "File", f, 1, len(env.ctx.lines(f))), self.name,
                         "http", f"server page {f}", {"method": "GET", "path": path, "source": f, "kind": "http"}, CONF_MEDIUM)
        if self.convention:
            pk = set(self.cfg["struts_convention_packages"])
            suffix = self.cfg["struts_convention_suffix"]
            for name, fp, a, b in env.graph.classes:
                parts = fp.split("/")
                if not name.endswith(suffix) or name == suffix or not (pk & set(parts[:-1])):
                    continue
                idx = max(i for i, p in enumerate(parts[:-1]) if p in pk)
                ns = "/".join(parts[idx + 1:-1])
                route = re.sub(r"(?<!^)(?=[A-Z])", "-", name[: -len(suffix)]).lower()
                meth = next((r for r in _methods_of_class(env, fp, a, b) if r[1] == "execute"), None)
                c = env.candidate(*meth) if meth else env.candidate(f"{fp}#{name}", name, "Class", fp, a, b)
                env.register(c, self.name, "http", f"Struts convention action {name} ({fp})",
                             {"method": None, "path": join_path(ns, route), "source": f"{fp}:{a}", "kind": "http"},
                             CONF_MEDIUM)
        for loc in self.java:
            f = loc.rsplit(":", 1)[0]
            lines = env.ctx.lines(f)
            ns = next((self.rx("struts_namespace_regex").search(l).group(1) for l in lines
                       if self.rx("struts_namespace_regex").search(l)), "")
            for i, line in enumerate(lines, 1):
                m = self.rx("struts_annotation_regex").search(line)
                if m:
                    c = _bind_below(env, f, i, 6)
                    if c:
                        env.register(c, self.name, "http", f"@Action {m.group(1)} ({f}:{i})",
                                     {"method": None, "path": join_path(ns, m.group(1)), "source": f"{f}:{i}", "kind": "http"})


@plugin
class Manifests(Plugin):
    name = "manifests"
    summary = "Package manifests: console scripts / bin entries (CLI) and library roots (pyproject, setup.py, package.json, Cargo)"
    DEFAULTS = {
        "py_script_regex": r"""^\s*['"]?([\w.\-]+)['"]?\s*=\s*['"]([\w.]+):(\w+)['"]""",
        "setup_console_regex": r"""['"]([\w.\-]+)\s*=\s*([\w.]+):(\w+)['"]""",
        "package_name_regex": r"""^\s*name\s*=\s*['"]([\w.\-]+)['"]""",
    }

    def detect(self, env: Env) -> list[str]:
        names = ("pyproject.toml", "setup.py", "setup.cfg", "package.json", "Cargo.toml")
        self.manifests = [f for f in env.ctx.tracked if f.rsplit("/", 1)[-1] in names and not env.ctx.is_test(f)
                          and "node_modules/" not in f]
        return self.manifests

    def library_roots(self, env: Env) -> list[str]:
        roots = []
        for f in self.manifests:
            base = str(Path(f).parent).replace("\\", "/").strip(".").strip("/")
            pre = f"{base}/" if base else ""
            name = Path(f).name
            text = "\n".join(env.ctx.lines(f))
            if name == "package.json":
                try:
                    doc = json.loads(text)
                except json.JSONDecodeError:
                    continue
                if doc.get("private"):
                    continue
                for key in ("main", "module"):
                    val = doc.get(key)
                    if isinstance(val, str):
                        cand = os.path.normpath(pre + val).replace("\\", "/")
                        for c in (cand, cand + ".js", cand + ".ts", cand + "/index.js", cand + "/index.ts"):
                            if c in env.ctx.tracked_set:
                                roots.append(c)
                                break
            elif name == "Cargo.toml":
                if f"{pre}src/lib.rs" in env.ctx.tracked_set:
                    roots.append(f"{pre}src/lib.rs")
            else:
                m = self.rx("package_name_regex", re.M).search(text)
                if m:
                    pkg = m.group(1).replace("-", "_").lower()
                    for c in (f"{pre}src/{pkg}/__init__.py", f"{pre}{pkg}/__init__.py"):
                        if c in env.ctx.tracked_set:
                            roots.append(c)
        return sorted(set(roots))

    def entry_points(self, env: Env) -> None:
        for f in self.manifests:
            lines = env.ctx.lines(f)
            name = Path(f).name
            if name == "package.json":
                try:
                    doc = json.loads("\n".join(lines))
                except json.JSONDecodeError:
                    continue
                bins = doc.get("bin") or {}
                if isinstance(bins, str):
                    bins = {doc.get("name", "cli"): bins}
                base = str(Path(f).parent).replace("\\", "/").strip(".").strip("/")
                for cmd, rel in bins.items():
                    target = os.path.normpath((base + "/" if base else "") + rel).replace("\\", "/")
                    if target in env.ctx.tracked_set:
                        c = env.candidate(f"{target}#bin", Path(target).stem, "Module", target, 1, 0)
                        env.register(c, self.name, "cli", f"package.json bin {cmd} -> {rel}",
                                     {"method": "CLI", "path": cmd, "source": f, "kind": "cli"})
                continue
            in_scripts = False
            for i, line in enumerate(lines, 1):
                s = line.strip()
                if s.startswith("["):
                    in_scripts = s in ("[project.scripts]", "[tool.poetry.scripts]", "[options.entry_points]",
                                       "[project.gui-scripts]")
                m = (self.rx("py_script_regex").match(line) if in_scripts else None) or \
                    (self.rx("setup_console_regex").search(line) if name in ("setup.py", "setup.cfg") else None)
                if m:
                    cmd, mod, func = m.group(1), m.group(2), m.group(3)
                    rows = [r for r in env.callables_named(func) if mod.replace(".", "/") in r[3]
                            or r[3].endswith(mod.split(".")[-1] + ".py")]
                    if rows:
                        env.register(env.candidate(*rows[0]), self.name, "cli", f"console script {cmd} = {mod}:{func} ({f}:{i})",
                                     {"method": "CLI", "path": cmd, "source": f"{f}:{i}", "kind": "cli"})


@plugin
class ProgramRoots(Plugin):
    name = "program_roots"
    summary = "Process entry points: main() functions, __main__ guards, application bootstrap files"
    DEFAULTS = {
        "main_regex": r"""(?:\bstatic\s+(?:async\s+)?(?:void|int|Task(?:<int>)?)\s+[Mm]ain\s*\(|^\s*func\s+main\s*\(\s*\)|^\s*(?:pub\s+)?fn\s+main\s*\(|^\s*fun\s+main\s*\(|^\s*object\s+\w+\s+extends\s+App\b)""",
        "python_main_guard_regex": r"""^if\s+__name__\s*==\s*['"]__main__['"]\s*:""",
        "bootstrap_regex": r"""(?:WebApplication\.Create(?:Slim)?Builder|Host\.CreateDefaultBuilder|CreateHostBuilder|SpringApplication\.run|bootstrapApplication\(|platformBrowserDynamic\(\)|\bcreateApp\(|ReactDOM\.render\(|\bcreateRoot\(|\bhydrateRoot\(|new\s+ApolloServer\(|\.listen\(\s*(?:port|PORT|process\.env|config\.|\d)|uvicorn\.run\(|\bapp\.run\(|serve_forever\(|execute_from_command_line\(|angular\s*\.\s*module\(\s*['"][\w.]+['"]\s*,\s*\[|NestFactory\.create)""",
        "bootstrap_file_regex": r"""(?:^|/)(?:instrumentation\.(?:ts|js)|wsgi\.py|asgi\.py|manage\.py|__main__\.py)$""",
        "extensions": ["java", "kt", "cs", "go", "rs", "py", "js", "jsx", "ts", "tsx", "mjs", "scala"],
        "ignore_calls": ["print", "exit", "len", "str", "int", "list", "dict", "set", "super", "isinstance", "getattr",
                         "setdefault", "basicConfig", "getLogger", "ArgumentParser", "parse_args", "path", "join", "run"],
    }

    _CALL = re.compile(r"(?<![\w.])((?:\w+\.)?[A-Za-z_]\w*)\s*\(")

    def _register_invoked(self, env: Env, f: str, lines: list[str], start: int, where: str) -> None:
        """Functions the program root hands control to: calls inside the `if __name__ == "__main__":` block
        (or at the top level of a __main__.py), e.g. `sys.exit(main())`. They are the real process entry."""
        names = []
        if where == "guard":
            for ln in lines[start:start + 40]:
                if ln.strip() and not ln[0].isspace():
                    break
                names += [m.group(1) for m in self._CALL.finditer(_STRIP_STRINGS.sub('""', ln))]
        else:
            for ln in lines:
                if ln and not ln[0].isspace() and not ln.startswith(("def ", "class ", "@", "#", "import ", "from ")):
                    names += [m.group(1) for m in self._CALL.finditer(_STRIP_STRINGS.sub('""', ln))]
        for full in dict.fromkeys(names):
            name = full.split(".")[-1]
            if name in self.cfg["ignore_calls"]:
                continue
            rows = [r for r in env.callables_named(name) if env.ctx.is_production_code(r[3])]
            near = [r for r in rows if r[3] == f or r[3] in env.graph.imports_of.get(f, set())]
            pick = near if near else (rows if len(rows) == 1 else [])
            if len(pick) == 1:
                c = env.candidate(*pick[0])
                env.register(c, self.name, "program_root", f"invoked by the process root {f}",
                             {"method": "RUN", "path": Path(f).stem, "source": f"{f}:{start + 1}", "kind": "process"},
                             CONF_MEDIUM)

    def detect(self, env: Env) -> list[str]:
        self.files = _prod_files(env, self.cfg["extensions"])
        hits = []
        for k in ("main_regex", "python_main_guard_regex", "bootstrap_regex"):
            hits += grep_files(env, self.rx(k, re.M), self.files, limit=100)
        hits += [f for f in self.files if self.rx("bootstrap_file_regex").search(f)]
        return hits

    def entry_points(self, env: Env) -> None:
        rx_main, rx_guard = self.rx("main_regex", re.M), self.rx("python_main_guard_regex", re.M)
        rx_boot, rx_file = self.rx("bootstrap_regex"), self.rx("bootstrap_file_regex")
        for f in self.files:
            lines = env.ctx.lines(f)
            done = False
            for i, line in enumerate(lines, 1):
                if len(line) > env.ctx.max_line:
                    continue
                if rx_main.search(line):
                    row = env.callable_at(f, i, lookahead=2)
                    c = env.candidate(*row) if row else env.synthetic(f, i, "main")
                    env.register(c, self.name, "program_root", f"process entry {line.strip()[:60]} ({f}:{i})",
                                 {"method": "RUN", "path": Path(f).stem, "source": f"{f}:{i}", "kind": "process"})
                    done = True
                elif rx_guard.search(line):
                    c = env.candidate(f"{f}#module", "<module>", "Module", f, 1, len(lines))
                    env.register(c, self.name, "program_root", f"__main__ guard ({f}:{i})",
                                 {"method": "RUN", "path": Path(f).stem, "source": f"{f}:{i}", "kind": "process"})
                    self._register_invoked(env, f, lines, i, "guard")
                    done = True
            if done:
                continue
            boot = next((i for i, l in enumerate(lines, 1) if len(l) <= env.ctx.max_line and rx_boot.search(l)), None)
            if (boot and f not in env.graph.imported_files) or rx_file.search(f):
                ln = boot or 1
                c = env.candidate(f"{f}#module", "<module>", "Module", f, 1, len(lines))
                env.register(c, self.name, "program_root", f"application bootstrap ({f}:{ln})",
                             {"method": "RUN", "path": Path(f).stem, "source": f"{f}:{ln}", "kind": "process"},
                             CONF_MEDIUM)
                if f.endswith("__main__.py"):
                    self._register_invoked(env, f, lines, 0, "module")


@plugin
class Scripts(Plugin):
    name = "scripts"
    summary = "Executable scripts (shell, PowerShell, batch) - operational/tooling entry points"
    DEFAULTS = {"extensions": ["sh", "bash", "zsh", "ps1", "bat", "cmd"]}

    def detect(self, env: Env) -> list[str]:
        ex = set(self.cfg["extensions"])
        self.files = [f for f in env.ctx.tracked if f.rsplit(".", 1)[-1].lower() in ex and not env.ctx.is_test(f)
                      and "node_modules/" not in f]
        return self.files

    def entry_points(self, env: Env) -> None:
        for f in self.files:
            c = env.candidate(f"{f}#script", Path(f).name, "File", f, 1, len(env.ctx.lines(f)))
            env.register(c, self.name, "script", f"executable script {f}",
                         {"method": "RUN", "path": Path(f).name, "source": f, "kind": "process"}, CONF_MEDIUM)

# --------------------------------------------------------------------------
# Test model (framework-agnostic core)
#   * a test file is split into cases (and setup hooks) by brace or indentation scope
#   * invocations are found per line: path literals, resolved constants, template
#     strings, named-route helpers, UI navigation, GraphQL documents, CLI calls
#   * helpers / page objects / API wrappers are followed through their bodies
#   * status codes are only credited when asserted inside the same case
# --------------------------------------------------------------------------
_STRIP_STRINGS = re.compile(r"""'(?:[^'\\\n]|\\.)*'|"(?:[^"\\\n]|\\.)*"|`[^`]*`""")
_IDENT_CALL = re.compile(r"""(?:(?<![\w$.])|(?<=\.))([A-Za-z_$][\w$]*)\s*\(""")
_DOTTED = re.compile(r"""(?<![\w$])((?:this|self|[A-Za-z_$][\w$]*)(?:\.[A-Za-z_$][\w$]*)+|[A-Za-z_$][\w$]*)""")
BRACE_EXT = {"java", "kt", "kts", "cs", "js", "jsx", "ts", "tsx", "mjs", "cjs", "go", "scala", "php", "groovy", "swift", "rs", "dart", "c", "cpp"}
INDENT_EXT = {"py", "feature", "robot", "yaml", "yml"}


def block_end(lines: list[str], start: int, ext: str) -> int:
    """0-based last line of the block that starts at `start` (a declaration line)."""
    if ext in INDENT_EXT:
        base = len(lines[start]) - len(lines[start].lstrip())
        j = start + 1
        # skip decorator / annotation lines that precede the def
        while j < len(lines) and lines[start].lstrip().startswith("@") and lines[j].lstrip().startswith("@"):
            j += 1
        if lines[start].lstrip().startswith("@"):
            base = len(lines[j - 1]) - len(lines[j - 1].lstrip()) if j - 1 > start else base
            j = max(j, start + 1)
            while j < len(lines) and not re.match(r"\s*(async\s+)?def\b", lines[j]):
                j += 1
            j += 1
        # a signature may span several lines (def f(\n    a,\n    b,\n) -> None:): the body starts after its ':'
        d = j - 1 if lines[start].lstrip().startswith("@") else start
        while d < len(lines) and not re.match(r"\s*(async\s+)?(def|class)\b", lines[d]) and d < j + 2:
            d += 1
        depth_p, h = 0, d
        while h < min(len(lines), d + 40):
            code = lines[h].split("#", 1)[0]
            depth_p += code.count("(") + code.count("[") - code.count(")") - code.count("]")
            if depth_p <= 0 and code.rstrip().endswith(":"):
                break
            h += 1
        else:
            h = d
        if h > d and h + 1 > j:
            j = h + 1
        last = j - 1
        while j < len(lines):
            l = lines[j]
            if l.strip():
                ind = len(l) - len(l.lstrip())
                if ind <= base:
                    break
                last = j
            j += 1
        return max(last, start)
    depth, opened = 0, False
    # the body opens at the first `{` that ends a line (`test('x', async ({ page }) => {` has braces in the
    # parameter list that must not be mistaken for the body)
    body_line, body_col = None, 0
    for j in range(start, min(len(lines), start + 7)):
        code = _STRIP_STRINGS.sub("", lines[j].split("//", 1)[0]).rstrip()
        if code.endswith("{"):
            body_line, body_col = j, len(code) - 1
            break
    for j in range(start, min(len(lines), start + 3000)):
        clean = _STRIP_STRINGS.sub("", lines[j].split("//", 1)[0] if not lines[j].lstrip().startswith("#") else "")
        if body_line is not None:
            if j < body_line:
                continue
            if j == body_line:
                clean = clean[body_col:]
        for ch in clean:
            if ch == "{":
                depth += 1
                opened = True
            elif ch == "}":
                depth -= 1
                if opened and depth <= 0:
                    return j
        if not opened and j > start + 6:   # declaration without a body (e.g. abstract)
            return start
    return min(len(lines) - 1, start + 3000)


def build_constants(env: Env) -> None:
    """name -> values for string constants that look like paths/URLs (code + test code).
    Stored as NAME, Container.NAME and file::NAME."""
    rules = env.rules
    rx_assign = rules.rx("tests.constant_assign_regex")
    rx_container = rules.rx("tests.constant_container_regex")
    rx_path = rules.rx("tests.path_like_regex", re.I)
    rx_var = rules.rx("tests.variable_prefix_regex")
    rx_tmpl_assign = re.compile(r"""(?<![\w$.])([A-Za-z_$][\w$]*)\s*(?::\s*[\w<>\[\]|.]+\s*)?=\s*`([^`\n]{1,300})`""")
    code_ext = set(rules.get("tests.constant_file_ext"))
    for f in env.ctx.tracked:
        if f.rsplit(".", 1)[-1].lower() not in code_ext or env.ctx.is_generated(f):
            continue
        lines = env.ctx.lines(f)
        containers: list[tuple[int, str]] = []
        for i, line in enumerate(lines):
            if len(line) > env.ctx.max_line:
                continue
            ind = len(line) - len(line.lstrip())
            mc = rx_container.search(line)
            if mc:
                while containers and containers[-1][0] >= ind:
                    containers.pop()
                containers.append((ind, mc.group(1) or mc.group(2)))
                continue
            found = [(m.group(1), m.group(3)) for m in rx_assign.finditer(line)]
            for m in rx_tmpl_assign.finditer(line):
                found.append((m.group(1), rx_var.sub("", m.group(2))))
            for name, value in found:
                if not (rx_path.match(value) or re.match(r"^https?://", value)):
                    continue
                while containers and containers[-1][0] >= ind and not line.lstrip().startswith(("this.", "self.")):
                    containers.pop()
                env.constants[name].add(value)
                env.constants[f"{f}::{name}"].add(value)
                if containers:
                    env.constants[f"{containers[-1][1]}.{name}"].add(value)


_CONCAT_ASSIGN = re.compile(r"""(?<![\w$.])([A-Za-z_$][\w$]*)\s*(?::\s*[\w<>\[\]|.]+\s*)?=(?!=)\s*((?:[A-Za-z_$][\w$.]*|"[^"\n]*"|'[^'\n]*')(?:\s*\+\s*(?:[A-Za-z_$][\w$.]*|"[^"\n]*"|'[^'\n]*'))+)\s*;?\s*$""")


def build_composed_constants(env: Env) -> None:
    """NAME = OTHER_CONSTANT + "/{id}"  /  BASE + SUFFIX: constants composed from known constants and literals."""
    code_ext = set(env.rules.get("tests.constant_file_ext"))
    rx_path = env.rules.rx("tests.path_like_regex", re.I)
    pending = []
    for f in env.ctx.tracked:
        if f.rsplit(".", 1)[-1].lower() not in code_ext or env.ctx.is_generated(f):
            continue
        for i, line in enumerate(env.ctx.lines(f)):
            if "+" in line and "=" in line and len(line) <= env.ctx.max_line:
                m = _CONCAT_ASSIGN.search(line)
                if m:
                    pending.append((f, m.group(1), re.split(r"\s*\+\s*", m.group(2).strip())))
    for _ in range(3):
        progress = False
        for f, name, parts in pending:
            if f"{f}::{name}" in env.constants:
                continue
            out = []
            for p in parts:
                if p[:1] in "\"'":
                    out.append(p[1:-1])
                else:
                    v = _const_value(env, p, f, None)
                    if v is None:
                        out = None
                        break
                    out.append(v)
            if out is None:
                continue
            value = "".join(out)
            if rx_path.match(value) or re.match(r"^https?://", value):
                env.constants[name].add(value)
                env.constants[f"{f}::{name}"].add(value)
                progress = True
        if not progress:
            break


def _const_value(env: Env, token: str, file: str, cls: Optional[str]) -> Optional[str]:
    tail = token.split(".")[-1]
    keys = []
    if token.startswith(("this.", "self.")) and cls:
        keys.append(f"{cls}.{tail}")
    keys += [f"{file}::{tail}" if token.startswith(("this.", "self.")) or "." not in token else "", token]
    if "." in token and not token.startswith(("this.", "self.")):
        keys.append(".".join(token.split(".")[-2:]))
    for k in keys:
        vals = env.constants.get(k) if k else None
        if vals and len(vals) == 1:
            return next(iter(vals))
    return None


class InvocationExtractor:
    """Per-line extraction of calls into the system under test (generic)."""

    def __init__(self, env: Env):
        r = env.rules
        self.env = env
        self.rx_lit = r.rx("tests.string_literal_regex")
        self.rx_camel = r.rx("tests.method_camel_regex")
        self.rx_path = r.rx("tests.path_like_regex", re.I)
        self.rx_var = r.rx("tests.variable_prefix_regex")
        self.rx_method = r.rx("tests.method_word_regex", re.I)
        self.rx_lookback = r.rx("tests.method_lookback_regex", re.I)
        self.rx_asset = r.rx("tests.static_asset_regex", re.I)
        self.rx_nav = r.rx("tests.ui_navigation_regex")
        self.rx_stub = r.rx("tests.stub_line_regex")
        self.rx_named = r.rx("tests.named_route_call_regex")
        self.rx_cli = r.rx("tests.cli_invocation_regex")
        self.rx_assert = r.rx("tests.assertion_call_regex")
        self.rx_dyn = r.rx("tests.dynamic_http_call_regex")
        self.rx_tmpl = re.compile(r"\$\{\s*([\w$.]+)\s*\}|\{\{\s*([\w$.]+)\s*\}\}")
        self.rx_concat = re.compile(r"""([A-Za-z_$][\w$.]*)\s*\+\s*(['"`])([^'"`]*)\2""")
        self.lookback = int(r.get("tests.method_lookback_lines"))

    def _resolve_templates(self, s: str, file: str, cls: Optional[str]) -> str:
        def sub(m: re.Match) -> str:
            v = _const_value(self.env, m.group(1) or m.group(2), file, cls)
            return v if v is not None else m.group(0)
        return self.rx_tmpl.sub(sub, s)

    def _method(self, lines: list[str], i: int, upto: int) -> Optional[str]:
        line = lines[i]
        mw = self.rx_method.search(line[:upto]) or self.rx_method.search(line)
        if not mw:   # PascalCase client APIs: GetAsync(, PutAsJsonAsync(, ExecutePost<T>(
            mw = self.rx_camel.search(line[:upto + 1]) or self.rx_camel.search(line[:upto + 40])
        if not mw:
            for back in range(1, self.lookback + 1):
                if i - back < 0:
                    break
                prev = lines[i - back]
                mw = self.rx_lookback.search(prev)
                if mw or prev.rstrip().endswith((";", ")", "}")):
                    break
        return mw.group(1).upper() if mw else None

    def _clean_path(self, value: str) -> Optional[str]:
        v = self.rx_var.sub("", value.strip())
        v = re.sub(r"\$\{[^}]*\}|#\{[^}]*\}|\{\{[^}]*\}\}", "{x}", v)
        if v.startswith("{x}/"):
            v = v[3:]       # `${baseUrl}/login`, `${Cypress.env("apiUrl")}/login`: the leading value is the host/base URL
        if re.match(r"^https?://", v):
            v = re.sub(r"^https?://[^/]+", "", v) or "/"
        if not self.rx_path.match(v) or self.rx_asset.search(v.split("?")[0]):
            return None
        return v

    def _in_assertion(self, line: str, pos: int) -> bool:
        """Literal is an argument of an assertion/matcher call (expected URL), not a request."""
        depth = 0
        for k in range(pos - 1, -1, -1):
            ch = line[k]
            if ch == ")":
                depth += 1
            elif ch == "(":
                if depth == 0:
                    m = self.rx_assert.search(line[:k + 1])
                    return bool(m)
                depth -= 1
        return False

    def line(self, file: str, lines: list[str], i: int, cls: Optional[str] = None) -> list[Invocation]:
        env, line = self.env, lines[i]
        if len(line) > env.ctx.max_line or self.rx_stub.search(line):
            return []
        out: list[Invocation] = []
        nav = self.rx_nav.search(line)
        if nav:
            raw = nav.group(2) if nav.group(2) is not None else None
            if raw is None and nav.group(3):
                raw = _const_value(env, nav.group(3), file, cls)
                via = "constant" if raw else ""
            else:
                via = "literal"
            if raw is not None:
                raw = self._resolve_templates(raw, file, cls)
                for sep in ("#!/", "#/"):
                    if sep in raw:
                        raw = "/" + raw.split(sep, 1)[1]
                if raw.startswith("./"):
                    raw = raw[1:]
                elif raw and not raw.startswith(("/", "http", "{", "$")) and re.match(r"^[\w.\-]+(?:/[\w.\-{}]*)*$", raw):
                    raw = "/" + raw
                p = self._clean_path(raw) if raw.startswith(("/", "http", "{", "$")) or "/" in raw else None
                if p is None and raw in ("", "/", "."):
                    p = "/"
                if p is not None:
                    out.append(Invocation(file, i + 1, "ui", "UI", p, via, CONF_HIGH if via == "literal" else CONF_MEDIUM))
                    return out
            elif nav.group(2) is None and (nav.group(3) or nav.group(0).startswith("Open.")):
                # navigation whose target is a runtime value (parameter, baseUrl + arg): still a UI drive
                out.append(Invocation(file, i + 1, "ui", "UI", "<dynamic>", "navigation (target computed at runtime)", CONF_LOW))
                return out
        mn = self.rx_named.search(line)
        if mn:
            out.append(Invocation(file, i + 1, "http", self._method(lines, i, mn.start()), f"name:{mn.group(2)}",
                                  "named-route", CONF_MEDIUM, explicit_method=False))
        md = self.rx_dyn.search(line)
        if md and not self.rx_lit.search(line[md.end():md.end() + 2]):
            out.append(Invocation(file, i + 1, "http", md.group(1).upper(), "<dynamic>", "http client call (URL computed at runtime)",
                                  CONF_LOW, True))
        mc = self.rx_cli.search(line)
        if mc:
            target = next(g for g in mc.groups()[1:] if g)
            out.append(Invocation(file, i + 1, "cli", "CLI", target, "cli-call", CONF_MEDIUM))
        seen_spans = []
        for m in self.rx_lit.finditer(line):
            if self._in_assertion(line, m.start()):
                continue
            value = self._resolve_templates(m.group(2), file, cls)
            if "/" not in value:
                continue
            meth = self._method(lines, i, m.start())
            if meth and not value.startswith(("/", "http", "{", "$", ".")) and re.fullmatch(r"[A-Za-z][\w\-]*(?:/[\w\-{}.:]+)+", value):
                value = "/" + value      # client.Post("api/auth"): relative to the client's base address
            p = self._clean_path(value)
            if p is None:
                continue
            seen_spans.append((m.start(), m.end()))
            out.append(Invocation(file, i + 1, "http", meth, p, "literal", CONF_HIGH if meth else CONF_MEDIUM,
                                  explicit_method=meth is not None))
        for m in self.rx_concat.finditer(line):
            base = _const_value(env, m.group(1), file, cls)
            if base is None:
                continue
            p = self._clean_path(base.rstrip("/") + "/" + m.group(3).lstrip("/"))
            if p:
                out = [o for o in out if not (o.via == "literal" and p.endswith(o.target))]
                meth = self._method(lines, i, m.start())
                out.append(Invocation(file, i + 1, "http", meth, p, "constant", CONF_MEDIUM, meth is not None))
        if not out:
            clean = _STRIP_STRINGS.sub('""', line)
            for m in _DOTTED.finditer(clean):
                tok = m.group(1)
                if "." not in tok and tok[:1].islower():
                    continue  # bare lower-case identifiers are too ambiguous to resolve
                v = _const_value(env, tok, file, cls)
                if v is None:
                    continue
                p = self._clean_path(v)
                if p:
                    meth = self._method(lines, i, m.start())
                    out.append(Invocation(file, i + 1, "http", meth, p, "constant", CONF_MEDIUM, meth is not None))
        return out


def segment_cases(env: Env, f: str, framework: str) -> tuple[list[TestCase], list[tuple[int, int]]]:
    """Test cases and setup hooks of a code test file (0-based inclusive ranges)."""
    lines = env.ctx.lines(f)
    ext = f.rsplit(".", 1)[-1].lower()
    rx_decl = env.rules.rx("tests.test_declaration_regex", re.I)
    rx_hook = env.rules.rx("tests.hook_declaration_regex")
    rx_name = env.rules.rx("tests.test_name_regex")
    cases, hooks = [], []
    i = 0
    while i < len(lines):
        line = lines[i]
        if len(line) > env.ctx.max_line:
            i += 1
            continue
        is_case = bool(rx_decl.search(line))
        is_hook = not is_case and bool(rx_hook.search(line))
        if not (is_case or is_hook):
            i += 1
            continue
        end = block_end(lines, i, "py" if ext == "py" else ext if ext in BRACE_EXT else "py")
        if is_hook:
            hooks.append((i, end))
            i = end + 1 if end > i else i + 1
            continue
        mname = rx_name.search(" ".join(lines[i:i + 3]))
        name = mname.group(1) or mname.group(2) if mname else f"case@{i + 1}"
        cases.append(TestCase(f, (name or f"case@{i + 1}").strip(), i + 1, end + 1, framework))
        # nested cases (it inside describe is not a case decl, so no overlap); move past the declaration line only
        i = i + 1 if end == i else (i + 1 if ext not in BRACE_EXT and ext != "py" else end + 1)
    return cases, hooks


def statuses_in(env: Env, f: str, start: int, end: int) -> set:
    rx = env.rules.rx("tests.status_assert_regex")
    names = env.rules.get("tests.status_assert_names")
    found = set()
    for text in env.ctx.lines(f)[max(0, start - 1):end]:
        for m in rx.finditer(text):
            if m.group(1):
                found.add(int(m.group(1)))
            elif m.group(2) in names:
                found.add(names[m.group(2)])
            elif m.group(3):
                found.add(int(m.group(3)))
    return found


class HelperIndex:
    """Bodies of test-support callables (page objects, API clients, custom commands)
    and the invocations each one makes, followed recursively."""

    def __init__(self, env: Env, extractor: InvocationExtractor):
        self.env, self.x = env, extractor
        self.by_name: dict[str, list[tuple[str, int, int, Optional[str]]]] = defaultdict(list)
        rx_reg = env.rules.rx("tests.registered_helper_regex")
        rx_decl = env.rules.rx("tests.test_declaration_regex", re.I)
        for r in env.graph.callables.values():
            f = norm(r[3])
            if not f or not env.ctx.is_test(f) or re.match(r"(?i)test", r[1]):
                continue
            a = to_int(r[4])
            head = env.ctx.lines(f)[max(0, a - 2):a + 1]
            if any(rx_decl.search(l) for l in head):
                continue  # a test case is not a helper
            self.by_name[r[1]].append((f, a, to_int(r[5]), self._class_of(f, a)))
        for f in env.ctx.tracked:
            if not env.ctx.is_test(f) or f.rsplit(".", 1)[-1].lower() not in BRACE_EXT:
                continue
            lines = env.ctx.lines(f)
            for i, line in enumerate(lines):
                m = rx_reg.search(line)
                if m:
                    end = block_end(lines, i, "js")
                    self.by_name[m.group(1)].append((f, i + 1, end + 1, None))
        # helpers that forward one of their parameters to a named-route function
        self.name_forwarders: dict[str, Optional[str]] = {}
        rx_fwd = re.compile(r"\b(?:" + env.rules.get("tests.named_route_functions") + r")\(\s*([A-Za-z_]\w*)\s*[,)]")
        rx_def = re.compile(r"\b(?:def|function|func|fun)\s+(\w+)\s*\(([^)]*)")
        for name, defs in list(self.by_name.items()):
            for f, a, b, _ in defs:
                lines = env.ctx.lines(f)
                head = " ".join(lines[a - 1:a + 2])
                md = rx_def.search(head)
                params = re.findall(r"([A-Za-z_]\w*)\s*(?:[:=,)]|$)", md.group(2)) if md else []
                body = "\n".join(lines[a - 1:b])
                mf = rx_fwd.search(body)
                if mf and mf.group(1) in params:
                    mw = re.match(r"(?i)(get|post|put|patch|delete)\b", name)
                    self.name_forwarders[name] = mw.group(1).upper() if mw else None
        self.max_defs = int(env.rules.get("tests.helper_max_definitions"))
        self.depth = int(env.rules.get("tests.helper_depth"))
        self._memo: dict = {}

    def _class_of(self, f: str, line: int) -> Optional[str]:
        for n, fp, a, b in self.env.graph.classes_all:
            if fp == f and a <= line <= b:
                return n
        return None

    _DEF = re.compile(r"""(?:\bdef|\bfunction|\bfunc|\bfun|\bvoid|\bclass|\bnew)\s+$""")

    def calls_in(self, f: str, start: int, end: int) -> list[str]:
        names = []
        for text in self.env.ctx.lines(f)[start - 1:end]:
            if len(text) > self.env.ctx.max_line:
                continue                      # minified / generated line: no reliable call syntax
            clean = _STRIP_STRINGS.sub('""', text)
            for m in _IDENT_CALL.finditer(clean):
                if not self._DEF.search(clean[:m.start()]):
                    names.append(m.group(1))
        return names

    def invocations(self, name: str, from_file: str, depth: int = 0, stack: tuple = ()) -> list[Invocation]:
        defs = self.by_name.get(name, [])
        if not defs or len(defs) > self.max_defs or depth >= self.depth:
            return []
        imported = self.env.graph.imports_of.get(from_file, set())
        near = [d for d in defs if d[0] == from_file or d[0] in imported] or defs
        out = []
        for f, a, b, cls in near:
            key = (f, a)
            if key in stack:
                continue
            if key not in self._memo:
                lines = self.env.ctx.lines(f)
                own = []
                for i in range(a - 1, min(b, len(lines))):
                    own.extend(self.x.line(f, lines, i, cls))
                for n in set(self.calls_in(f, a, b)):
                    if n != name:
                        own.extend(self.invocations(n, f, depth + 1, stack + (key,)))
                self._memo[key] = own
            for inv in self._memo[key]:
                out.append(Invocation(inv.file, inv.line, inv.kind, inv.method, inv.target,
                                      inv.via if inv.via.startswith("helper") else f"helper {name}()",
                                      min_conf(inv.confidence, CONF_MEDIUM), inv.explicit_method))
        return out

    _MEMBER_REF = re.compile(r"(?<![\w$.])([a-z_][\w$]*)\s*\.\s*([A-Za-z_][\w$]*)")

    def class_invocations(self, f: str, start: int, end: int, _depth: int = 0) -> tuple[list[Invocation], list[tuple[str, int, int]]]:
        """Test code reaches a driver / page-object / client class through an instance variable
        (`userApiDriver.Register.Perform(...)`, `self.login_page.submit()`). The variable names the class (case
        and underscores ignored) and the member the test touches is looked up in that class: a method of that
        name, or a property/field assignment (`Register = factory.Create(... => client.Post("/api/user"))`).
        Only those member bodies are scanned, never the whole class."""
        if not hasattr(self, "_class_by_key"):
            self._class_by_key: dict = defaultdict(list)
            for n, fp, a, b in self.env.graph.classes_all:
                if self.env.ctx.is_test(fp):
                    self._class_by_key[re.sub(r"[_\W]", "", n).lower()].append((n, fp, a, b))
        out, ranges, seen = [], [], set()
        lines = self.env.ctx.lines(f)
        for text in lines[start - 1:end]:
            if len(text) > self.env.ctx.max_line:
                continue
            for m in self._MEMBER_REF.finditer(_STRIP_STRINGS.sub('""', text)):
                key = re.sub(r"[_\W]", "", m.group(1)).lower()
                member = m.group(2)
                if key in ("self", "this", "cls", "base", "super") or key not in self._class_by_key:
                    continue
                for n, fp, a, b in self._class_by_key[key][:2]:
                    if fp == f and a <= start <= b:
                        continue
                    cl = self.env.ctx.lines(fp)
                    spans = [(r[4], r[5]) for r in self.env.callables_in(fp) if r[1] == member and a <= r[4] <= b]
                    if not spans:
                        rx_assign = re.compile(r"\b" + re.escape(member) + r"\s*=(?!=)")
                        for k in range(a, min(b, len(cl))):
                            if rx_assign.search(cl[k]):
                                e = k
                                while e < min(b, len(cl)) - 1 and not cl[e].rstrip().endswith(";") and e - k < 8:
                                    e += 1
                                spans.append((k + 1, e + 1))
                    for sa, sb in spans[:3]:
                        if (fp, sa) in seen:
                            continue
                        seen.add((fp, sa))
                        for i in range(sa - 1, min(sb, len(cl))):
                            for inv in self.x.line(fp, cl, i, n):
                                out.append(Invocation(inv.file, inv.line, inv.kind, inv.method, inv.target,
                                                      f"driver {n}.{member}", min_conf(inv.confidence, CONF_MEDIUM),
                                                      inv.explicit_method))
                        ranges.append((fp, sa, sb))
                        if _depth < 3:     # the member may itself drive another driver
                            more, more_r = self.class_invocations(fp, sa, sb, _depth + 1)
                            out.extend(more)
                            ranges.extend(more_r)
        return out, ranges

    def used_ranges(self, name: str, from_file: str) -> list[tuple[str, int, int]]:
        defs = self.by_name.get(name, [])
        if not defs or len(defs) > self.max_defs:
            return []
        imported = self.env.graph.imports_of.get(from_file, set())
        near = [d for d in defs if d[0] == from_file or d[0] in imported] or defs
        return [(f, a, b) for f, a, b, _ in near]


_ASSIGN = re.compile(r"""^\s*(?:(?:const|let|var|final|val|String|string|auto)\s+)?([A-Za-z_$][\w$]*)\s*(?::\s*\w+\s*)?=(?!=)""")


def method_from_variable(lines: list[str], inv: Invocation, end: int, rx_method: re.Pattern) -> None:
    """url = reverse('x') / url = '/a' ... client.get(url): take the method from the later call."""
    if inv.explicit_method or inv.line - 1 >= len(lines):
        return
    m = _ASSIGN.match(lines[inv.line - 1])
    if not m:
        return
    var = re.escape(m.group(1))
    use = re.compile(r"\b(get|post|put|patch|delete|head|options)\w*\s*[<(]\s*(?:f?['\"]?)?" + var + r"\b", re.I)
    for k in range(inv.line, min(end, len(lines))):
        mu = use.search(lines[k])
        if mu:
            inv.method, inv.explicit_method = mu.group(1).upper(), True
            inv.confidence = best_conf(inv.confidence, CONF_MEDIUM)
            return


def fill_case(env: Env, case: TestCase, helpers: HelperIndex, extractor: InvocationExtractor,
              cls: Optional[str] = None) -> None:
    lines = env.ctx.lines(case.file)
    for i in range(case.start - 1, min(case.end, len(lines))):
        case.invocations.extend(extractor.line(case.file, lines, i, cls))
    for inv in case.invocations:
        method_from_variable(lines, inv, case.end, extractor.rx_method)
    case.statuses |= statuses_in(env, case.file, case.start, case.end)
    if helpers.name_forwarders:
        rx_call = re.compile(r"\b(" + "|".join(map(re.escape, helpers.name_forwarders)) + r")\(([^)]*?)['\"]([\w:.\-]+)['\"]")
        for i in range(case.start - 1, min(case.end, len(lines))):
            for m in rx_call.finditer(" ".join(lines[i:i + 2])):
                if "/" not in m.group(3) and m.start() < len(lines[i]):
                    case.invocations.append(Invocation(case.file, i + 1, "http", helpers.name_forwarders[m.group(1)],
                                                       f"name:{m.group(3)}", f"helper {m.group(1)}() route name",
                                                       CONF_MEDIUM, helpers.name_forwarders[m.group(1)] is not None))
    cinvs, cranges = helpers.class_invocations(case.file, case.start, case.end)
    if cinvs:
        have = {(i.target, i.method) for i in case.invocations}
        case.invocations.extend(i for i in cinvs if (i.target, i.method) not in have)
        for f, a, b in cranges:
            case.used.append(f"{f}:{a}-{b}")
    for name in sorted(set(helpers.calls_in(case.file, case.start, case.end))):
        invs = helpers.invocations(name, case.file)
        if invs:
            case.invocations.extend(invs)
            for f, a, b in helpers.used_ranges(name, case.file):
                case.used.append(f"{f}:{a}-{b}")
                case.statuses |= statuses_in(env, f, a, b)


def discover_code_tests(env: Env) -> None:
    """Generic code-based test files (any language): cases, hooks, invocations."""
    extractor = InvocationExtractor(env)
    helpers = HelperIndex(env, extractor)
    env.extractor, env.helpers = extractor, helpers
    code_ext = set(env.rules.get("tests.constant_file_ext"))
    for f in env.ctx.tracked:
        if f in env.test_files or not env.ctx.is_test(f) or f.rsplit(".", 1)[-1].lower() not in code_ext:
            continue
        cases, hooks = segment_cases(env, f, "code")
        tf = env.test_file(f, "code", "test" if cases else "support")
        tf.cases.extend(cases)
        for c in cases:
            fill_case(env, c, helpers, extractor, helpers._class_of(f, c.start))
        lines = env.ctx.lines(f)
        for a, b in hooks:
            for i in range(a, b + 1):
                got = extractor.line(f, lines, i)
                tf.loose.extend(got)
                # the page a setup hook opens is the page under test for the cases of that file;
                # API calls in hooks (seed data, log in) are setup, not coverage
                for inv in got:
                    if inv.kind == "ui":
                        for c in cases:
                            c.invocations.append(Invocation(inv.file, inv.line, "ui", "UI", inv.target, "setup hook",
                                                            CONF_MEDIUM, True))


# ---- matching ---------------------------------------------------------------
def match_invocation(inv: Invocation, index: dict, max_handlers: int) -> None:
    """Map one invocation to entry points. index: kind -> list[(Candidate, trigger)]."""
    hits = []
    if inv.kind in ("http", "ui"):
        if inv.target.startswith("name:"):
            return
        if static_len(inv.target) == 0 and norm_path(inv.target) != "/":
            inv.match = "none"
            return
        for c, t in index.get(inv.kind, []):
            if t["method"] and inv.method and inv.kind == "http" and t["method"] != inv.method:
                continue
            if static_len(t["path"]) == 0 and not (t["method"] and inv.method == t["method"]) and inv.kind == "http":
                continue
            for p in [t["path"]] + t.get("aliases", []):
                how = path_match(inv.target, p)
                if how:
                    hits.append((how, c, t))
                    break
        use = [h for h in hits if h[0] == "exact"] or hits
        if use:
            best = max(static_len(h[2]["path"]) for h in use)
            use = [h for h in use if static_len(h[2]["path"]) == best]
        if len({h[1].qn for h in use}) > 1 and inv.file:
            # several handlers share the path (microservices / modules): prefer the same module as the caller
            def shared(c: Candidate) -> int:
                a_, b_ = inv.file.split("/"), c.file.split("/")
                n = 0
                while n < min(len(a_), len(b_)) - 1 and a_[n] == b_[n]:
                    n += 1
                return n
            top = max(shared(h[1]) for h in use)
            if top > 0:
                use = [h for h in use if shared(h[1]) == top]
    elif inv.kind in ("graphql", "rpc", "message", "cli"):
        want = inv.target.lower()
        for c, t in index.get(inv.kind, []):
            path = t["path"].lower()
            if path == want or (inv.kind == "rpc" and path.split("/")[-1] == want.split("/")[-1]):
                hits.append(("exact", c, t))
        use = hits
    elif inv.kind == "call":
        inv.match = "graph_call" if inv.mapped else "none"
        return
    else:
        use = []
    qns = sorted({h[1].qn for h in use})
    inv.mapped = qns if 0 < len(qns) <= max_handlers else []
    inv.match = use[0][0] if inv.mapped else ("ambiguous" if qns else "none")
    if inv.match == "suffix":
        inv.confidence = min_conf(inv.confidence, CONF_MEDIUM)


def trigger_index(env: Env) -> dict:
    idx: dict = defaultdict(list)
    for c in env.cands.values():
        if not c.confirmed:
            continue
        for t in c.triggers:
            k = t.get("kind", "http")
            idx["http" if k in ("http",) else k].append((c, t))
    return idx


def _call_extent(lines: list[str], i: int, max_lines: int = 8) -> str:
    """Text of the registration call that starts on line i (0-based): up to the parenthesis that closes
    its first '(' - never the neighbouring registrations (their route names would be mixed in)."""
    chunk, depth, opened = [], 0, False
    for k in range(i, min(len(lines), i + max_lines)):
        line = lines[k]
        for pos, ch in enumerate(line):
            if ch == "(":
                depth, opened = depth + 1, True
            elif ch == ")":
                depth -= 1
                if opened and depth <= 0:
                    chunk.append(line[:pos + 1])
                    return " ".join(chunk)
        chunk.append(line)
    return " ".join(chunk)


def resolve_named_routes(env: Env) -> None:
    """name:<route-name> invocations -> concrete route (names read at registration sites)."""
    rx = env.rules.rx("tests.route_name_decl_regex")
    for c in env.cands.values():
        for t in c.triggers:
            src = t.get("source", "")
            if ":" not in src or t.get("kind") not in ("http", None):
                continue
            f, _, ln = src.rpartition(":")
            if not ln.isdigit():
                continue
            lines = env.ctx.lines(f)
            n = int(ln)
            window = _call_extent(lines, n - 1)
            for m in rx.finditer(window):
                name = next(g for g in m.groups() if g)
                env.route_names[name].append((c, t))
                ns = next((re.search(r"app_name\s*=\s*['\"](\w+)", l) for l in lines if "app_name" in l), None)
                if ns:
                    env.route_names[f"{ns.group(1)}:{name}"].append((c, t))
    for c in env.cands.values():
        for t in c.triggers:
            if t.get("name"):
                env.route_names[t["name"]].append((c, t))
    for tf in env.test_files.values():
        for case in tf.cases:
            for inv in case.invocations:
                if inv.target.startswith("name:"):
                    hits = env.route_names.get(inv.target[5:], [])
                    if hits:
                        c, t = hits[0]
                        inv.target = t["path"]
                        inv.method = inv.method or t["method"]
                        inv.mapped = sorted({h[0].qn for h in hits})[:2]
                        inv.match = "named-route"


def map_all_tests(env: Env) -> None:
    idx = trigger_index(env)
    max_handlers = int(env.rules.get("tests.max_mapped_handlers"))
    resolve_named_routes(env)
    for tf in env.test_files.values():
        for case in tf.cases:
            for inv in case.invocations:
                if inv.match in ("named-route", "graph_call") and inv.mapped:
                    continue
                match_invocation(inv, idx, max_handlers)
        for inv in tf.loose:
            match_invocation(inv, idx, max_handlers)


def direct_entry_calls(env: Env) -> None:
    """Test cases that call entry-point functions directly (library API, CLI mains,
    registered functions) - via CBM CALLS edges and via helpers."""
    targets = {}
    handler_like = {"serverless", "message_consumer", "scheduler", "batch_job", "worker"}   # tested by invoking the handler directly
    for c in env.cands.values():
        if c.confirmed and c.label in CALLABLE + ("Class",) and (c.kinds & {"library_api", "cli", "startup_runner", "program_root"}
                                                                  or c.signals & {"S10_public_api"}):
            targets[c.name] = c
    handlers: dict = defaultdict(list)
    for c in env.cands.values():
        if c.confirmed and c.label in CALLABLE and c.kinds & handler_like:
            handlers[c.name].append(c)
    if not targets and not handlers:
        return
    rx_mock = env.rules.rx("tests.mock_marker_regex")
    helpers: HelperIndex = env.helpers
    for tf in env.test_files.values():
        for case in tf.cases:
            names = set(helpers.calls_in(case.file, case.start, case.end))
            for u in case.used:
                f, _, rng = u.rpartition(":")
                if "-" in rng:
                    ua, ub = (int(x) for x in rng.split("-", 1))
                    names |= set(helpers.calls_in(f, ua, ub))
            files = {case.file} | {u.rpartition(":")[0] for u in case.used}
            imported = set().union(*(env.graph.imports_of.get(f, set()) for f in files))
            for n in sorted(names & set(targets)):
                c = targets[n]
                if c.file not in imported and c.file not in files:
                    continue
                case.invocations.append(Invocation(case.file, case.start, "call", "CALL", c.qn, "direct call",
                                                   CONF_MEDIUM, True, [c.qn], "graph_call"))
            if handlers:
                text = " ".join(env.ctx.lines(case.file))
                for n in sorted(names & set(handlers)):
                    for c in handlers[n]:
                        owner = c.qn.rsplit(".", 2)[-2] if c.qn.count(".") >= 1 else ""
                        stem = Path(c.file).stem
                        if (stem and re.search(r"\b" + re.escape(stem) + r"\b", text)) or (owner and re.search(r"\b" + re.escape(owner) + r"\b", text)):
                            mocked = rx_mock.search(text) is not None
                            case.invocations.append(Invocation(case.file, case.start, "call", "CALL", c.qn, "direct handler call",
                                                               CONF_LOW if mocked else CONF_MEDIUM, not mocked, [c.qn], "graph_call"))


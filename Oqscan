@plugin
class CBMRoutes(Plugin):
    name = "cbm_routes"
    summary = "Route nodes and HANDLES edges recorded by codebase-memory-mcp"

    def detect(self, env: Env) -> list[str]:
        self.rows = env.cbm.cypher(env.project, "MATCH (h:Function|Method)-[:HANDLES]->(r:Route) "
                                                "RETURN r.qualified_name, r.name, h.qualified_name, h.file_path, h.start_line")
        return [f"{norm(r[3])}:{to_int(r[4])}" for r in self.rows]

    def entry_points(self, env: Env) -> None:
        for r_qn, r_name, h_qn, _f, _l in self.rows:
            c = env.cands.get(h_qn)
            if c is None:
                continue
            m = re.match(r"__route__(\w+)__(.*)", r_qn or "")
            method = m.group(1).upper() if m else None
            if method not in (None, "ANY", "GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"):
                continue  # CBM also records config URLs (e.g. INFRA) as routes
            c.triggers.append({"method": None if method in (None, "ANY") else method,
                               "path": m.group(2) if m else r_name, "source": "cbm_route", "kind": "http",
                               "plugin": self.name})
            c.kinds.add("http")



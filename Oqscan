def _add_case(env: Env, tf: TestFile, name: str, start: int, end: int, invs: list, statuses: Optional[set] = None,
              used: Optional[list] = None) -> TestCase:
    c = TestCase(tf.file, name, start, end, tf.framework, list(invs), set(statuses or ()), list(used or ()))
    tf.cases.append(c)
    return c


_IDENT = re.compile(r"(?<![\w$.\"'])([A-Za-z_$][\w$]*)(?![\w$(\"':])")


def _import_targets(env: Env, f: str, name: str) -> list[str]:
    """Tracked files that `f` imports `name` from (JS/TS/Python/Ruby-style relative imports),
    read from the import lines themselves so test-side files are covered too."""
    rx_mod = re.compile(r"""['"]([^'"]+)['"]|from\s+([.\w]+)\s+import""")
    base = f.rsplit("/", 1)[0] if "/" in f else ""
    out = []
    for text in env.ctx.lines(f):
        if name not in text or not re.search(r"\b(import|require|from)\b", text):
            continue
        m = rx_mod.search(text)
        mod = (m.group(1) or m.group(2)) if m else None
        if not mod or not mod.startswith("."):
            continue
        if "/" in mod or mod.startswith("./") or mod.startswith("../"):
            path = os.path.normpath(os.path.join(base, mod)).replace("\\", "/")
        else:  # python relative module: .pkg.mod
            dots = len(mod) - len(mod.lstrip("."))
            up = base
            for _ in range(dots - 1):
                up = up.rsplit("/", 1)[0] if "/" in up else ""
            path = (up + "/" if up else "") + mod.lstrip(".").replace(".", "/")
        stem = re.sub(r"\.(js|jsx|ts|tsx|mjs|cjs)$", "", path)
        for cand in (path, stem + ".ts", stem + ".tsx", stem + ".js", stem + ".jsx", stem + ".mjs",
                     stem + ".py", stem + "/index.ts", stem + "/index.js"):
            if cand in env.ctx.tracked_set:
                out.append(cand)
                break
    return out


def _handler_ranges(env: Env, f: str, a: int, b: int) -> list[tuple[str, int, int]]:
    """Step/route handlers passed by reference (`Given(/re/, openWebsite)`): the identifier
    is resolved through the file's imports to a callable, or, for a default-exported
    anonymous function, to the whole imported file."""
    names = set()
    for text in env.ctx.lines(f)[a - 1:b]:
        if len(text) > env.ctx.max_line:
            continue
        names.update(m.group(1) for m in _IDENT.finditer(_STRIP_STRINGS.sub('""', text)))
    out = []
    for name in sorted(names):
        for imp in _import_targets(env, f, name):
            if imp == f:
                continue
            rows = [r for r in env.callables_in(imp) if r[1] == name]
            if rows:
                out.append((imp, rows[0][4], rows[0][5]))
            else:
                out.append((imp, 1, len(env.ctx.lines(imp))))
            break
    return out


def _range_invocations(env: Env, f: str, a: int, b: int) -> tuple[list, set, list]:
    """Invocations, asserted statuses and helper ranges used within lines a..b (1-based)."""
    x: InvocationExtractor = env.extractor
    h: HelperIndex = env.helpers
    lines = env.ctx.lines(f)
    invs, used = [], [f"{f}:{a}-{b}"]
    cls = h._class_of(f, a)
    for i in range(a - 1, min(b, len(lines))):
        invs.extend(x.line(f, lines, i, cls))
    statuses = statuses_in(env, f, a, b)
    for hf, ha, hb in _handler_ranges(env, f, a, b):
        used.append(f"{hf}:{ha}-{hb}")
        hcls = h._class_of(hf, ha)
        for i in range(ha - 1, min(hb, len(env.ctx.lines(hf)))):
            invs.extend(x.line(hf, env.ctx.lines(hf), i, hcls))
        for name in sorted(set(h.calls_in(hf, ha, hb))):
            invs.extend(h.invocations(name, hf))
        statuses |= statuses_in(env, hf, ha, hb)
    cinvs, cranges = h.class_invocations(f, a, b)
    invs.extend(cinvs)
    used.extend(f"{cf}:{ca}-{cb}" for cf, ca, cb in cranges)
    for name in sorted(set(h.calls_in(f, a, b))):
        got = h.invocations(name, f)
        if got:
            invs.extend(got)
            for hf, ha, hb in h.used_ranges(name, f):
                used.append(f"{hf}:{ha}-{hb}")
                statuses |= statuses_in(env, hf, ha, hb)
    return invs, statuses, used


@plugin
class Karate(Plugin):
    name = "karate"
    summary = "Karate .feature API/UI tests (path/method/url steps)"
    DEFAULTS = {
        "marker_regex": r"""^\s*(?:Given|And|When|Then|\*)\s+(?:url|path|method|request|driver)\b""",
        "path_regex": r"""^\s*(?:Given|And|When|\*)\s+path\s+(.+)$""",
        "method_regex": r"""^\s*(?:Given|And|When|Then|\*)\s+method\s+(\w+)""",
        "def_regex": r"""^\s*(?:Given|And|When|Then|\*)\s+def\s+(\w+)\s*=\s*(['"])([^'"]*)\2\s*$""",
        "url_regex": r"""^\s*(?:Given|And|When|\*)\s+url\s+(['"])([^'"]+)\1""",
        "driver_regex": r"""^\s*(?:Given|And|When|\*)\s+driver\s+(['"])([^'"]+)\1""",
        "scenario_regex": r"""^\s*Scenario(?: Outline)?:\s*(.*)$""",
        "status_regex": r"""^\s*(?:Then|And|\*)\s+status\s+(\d{3})""",
    }

    def detect(self, env: Env) -> list[str]:
        rx = self.rx("marker_regex", re.I)
        self.files = [f for f in env.ctx.tracked if f.endswith(".feature") and any(rx.match(l) for l in env.ctx.lines(f))]
        return self.files

    def tests(self, env: Env) -> None:
        for f in self.files:
            lines = env.ctx.lines(f)
            tf = env.test_file(f, "karate")
            kvars = {}
            for line in lines:
                md = self.rx("def_regex").match(line)
                if md:
                    kvars[md.group(1)] = md.group(3)
            starts = [i for i, l in enumerate(lines) if self.rx("scenario_regex").match(l)]
            bg = next((i for i, l in enumerate(lines) if re.match(r"^\s*Background\s*:", l)), None)
            bg_lines = list(range(bg + 1, starts[0])) if bg is not None and starts and bg < starts[0] else []
            for n, s in enumerate(starts):
                e = (starts[n + 1] - 1) if n + 1 < len(starts) else len(lines) - 1
                invs, statuses = [], set()
                for i in bg_lines + list(range(s, e + 1)):      # Background steps run before every scenario
                    line = lines[i]
                    ms = self.rx("status_regex").match(line)
                    if ms:
                        statuses.add(int(ms.group(1)))
                    mk = self.rx("path_regex", re.I).match(line)
                    if mk:
                        segs = []
                        for part in (x.strip() for x in mk.group(1).split(",")):
                            if not part or part.startswith("#"):
                                continue
                            pieces = [x.strip() for x in part.split("+")]
                            if all(x[:1] in "'\"" or x in kvars for x in pieces):
                                segs.append("".join(kvars.get(x, x.strip("'\"")) for x in pieces))
                            else:
                                segs.append("{" + part + "}")
                        method = None
                        for l2 in lines[i + 1:i + 8]:
                            mm = self.rx("method_regex", re.I).match(l2)
                            if mm:
                                method = mm.group(1).upper()
                                break
                            if self.rx("path_regex", re.I).match(l2):
                                break
                        invs.append(Invocation(f, i + 1, "http", method, join_path(*segs), "karate path", CONF_HIGH, bool(method)))
                    mu = self.rx("url_regex", re.I).match(line) or self.rx("driver_regex", re.I).match(line)
                    if mu and "/" in re.sub(r"^https?://[^/]+", "", mu.group(2)):
                        kind = "ui" if "driver" in line else "http"
                        p = re.sub(r"^https?://[^/]+", "", mu.group(2))
                        method = None
                        if kind == "http":
                            for l2 in lines[i + 1:i + 8]:
                                mm = self.rx("method_regex", re.I).match(l2)
                                if mm:
                                    method = mm.group(1).upper()
                                    break
                        invs.append(Invocation(f, i + 1, kind, "UI" if kind == "ui" else method, p, "karate url",
                                               CONF_HIGH, True))
                name = self.rx("scenario_regex").match(lines[s]).group(1).strip() or f"scenario@{s + 1}"
                _add_case(env, tf, name, s + 1, e + 1, invs, statuses)


def _step_regex(expr: str, style: str) -> Optional[re.Pattern]:
    """Cucumber expression / regex / parse-format step pattern -> compiled regex."""
    e = expr
    if style == "js_regex":
        body = e[1:e.rindex("/")]
        try:
            return re.compile(body)
        except re.error:
            return None
    if e.startswith("^") or e.endswith("$") or style == "regex":
        try:
            return re.compile(e.replace('""', '"'))
        except re.error:
            pass
    out, i = [], 0
    while i < len(e):
        ch = e[i]
        if ch == "{":
            j = e.find("}", i)
            if j < 0:
                out.append(re.escape(e[i:]))
                break
            tok = e[i + 1:j].split(":")[0].strip()
            out.append({"int": r"-?\d+", "float": r"-?\d*\.?\d+", "word": r"\S+",
                        "string": r"""(?:"[^"]*"|'[^']*')""", "": r".*"}.get(tok, r".+?"))
            i = j + 1
        elif ch == "(" and e.find(")", i) > i:
            j = e.find(")", i)
            out.append("(?:" + re.escape(e[i + 1:j]) + ")?")
            i = j + 1
        elif ch == "\\" and i + 1 < len(e):
            out.append(re.escape(e[i + 1]))
            i += 2
        else:
            out.append(re.escape(ch))
            i += 1
    pat = "".join(out)
    pat = re.sub(r"(\w+)/(\w+)", r"(?:\1|\2)", pat)  # cucumber alternation a/b
    try:
        return re.compile("^" + pat + "$")
    except re.error:
        return None


@plugin
class GherkinBDD(Plugin):
    name = "gherkin_bdd"
    summary = "Gherkin .feature files linked to step definitions (Cucumber JVM/JS, behave, pytest-bdd, SpecFlow/Reqnroll, WebdriverIO, cypress-cucumber)"
    DEFAULTS = {
        "scenario_regex": r"""^\s*(Scenario(?: Outline| Template)?|Example)\s*:\s*(.*)$""",
        "background_regex": r"""^\s*Background\s*:""",
        "step_regex": r"""^\s*(Given|When|Then|And|But|\*)\s+(.+?)\s*$""",
        "block_end_regex": r"""^\s*(Feature|Rule|Examples|Scenarios|Scenario|Scenario Outline|Scenario Template|Example|Background)\s*:|^\s*@""",
        "stepdef_patterns": {
            "java": r"""@(?:Given|When|Then|And|But|Step|Gegeben|Wenn|Dann)\(\s*"((?:[^"\\]|\\.)*)\"""",
            "kt": r"""@(?:Given|When|Then|And|But|Step)\(\s*"((?:[^"\\]|\\.)*)\"""",
            "js": r"""(?<![\w$.])(?:Given|When|Then|And|But|defineStep|Step)\(\s*(/(?:[^/\\\n]|\\.)+/[gimsuy]*|'(?:[^'\\]|\\.)*'|"(?:[^"\\]|\\.)*"|`[^`]*`)""",
            "py": r"""^\s*@(?:given|when|then|step)\(\s*(?:parsers\.\w+\(\s*)?u?r?(['"])((?:\\.|(?!\1).)*)\1""",
            "cs": r"""\[(?:Given|When|Then|StepDefinition)\(\s*@?"((?:[^"]|"")*)\"""",
            "rb": r"""^\s*(?:Given|When|Then|And)\s*\(?\s*/(.*)/""",
        },
        "karate_marker_regex": r"""^\s*(?:Given|And|When|Then|\*)\s+(?:url|path|method|request|driver)\b""",
    }

    def detect(self, env: Env) -> list[str]:
        rk = self.rx("karate_marker_regex", re.I)
        self.features = [f for f in env.ctx.tracked if f.endswith(".feature")
                         and not any(rk.match(l) for l in env.ctx.lines(f))]
        return self.features

    def _stepdefs(self, env: Env) -> list[tuple[re.Pattern, str, int, int]]:
        defs = []
        pats = self.cfg["stepdef_patterns"]
        for f in env.ctx.tracked:
            ext = f.rsplit(".", 1)[-1].lower()
            key = {"ts": "js", "tsx": "js", "mjs": "js", "jsx": "js", "kts": "kt"}.get(ext, ext)
            if key not in pats:
                continue
            rx = self.rx_for(key, pats[key])
            lines = env.ctx.lines(f)
            text_has = bool(rx.search("\n".join(lines[:4000])))
            if not text_has:
                continue
            text = "\n".join(l if len(l) <= env.ctx.max_line else "" for l in lines)
            for m in rx.finditer(text):
                i = text.count("\n", 0, m.start(m.lastindex))   # the definition may span lines
                expr = m.group(m.lastindex)
                style = "expr"
                if key == "js":
                    if expr.startswith("/"):
                        style = "js_regex"
                    else:
                        expr = expr[1:-1]
                elif key == "rb":
                    style = "regex"
                elif key == "cs" and ("(" in expr or "\\" in expr):
                    style = "regex"
                elif key == "java" and expr.startswith("^"):
                    style = "regex"
                    expr = expr.encode().decode("unicode_escape") if "\\\\" in expr else expr
                if key == "py":
                    expr = re.sub(r"\\(['\"])", r"\1", expr)
                pat = _step_regex(expr, style)
                if pat is None:
                    continue
                end = block_end(lines, i, "py" if key == "py" else "java")
                defs.append((pat, f, i + 1, end + 1))
        return defs

    def rx_for(self, key: str, pattern: str) -> re.Pattern:
        k = ("stepdef", key)
        if k not in self._rx:
            self._rx[k] = re.compile(pattern, re.M)
        return self._rx[k]

    def tests(self, env: Env) -> None:
        defs = self._stepdefs(env)
        self.unmatched_steps = 0
        for _p, sf, _a, _b in defs:
            tf = env.test_files.get(sf)
            if tf is not None:
                tf.role = "step_definitions"
                tf.cases.clear()
            else:
                env.test_file(sf, "step_definitions", "step_definitions")
        memo: dict = {}

        def resolve(step: str) -> Optional[tuple]:
            text = re.sub(r"<([^>]+)>", r"\1", step)
            for pat, sf, a, b in defs:
                if pat.match(step) or pat.match(text):
                    return sf, a, b
            return None

        for f in self.features:
            lines = env.ctx.lines(f)
            tf = env.test_file(f, "gherkin")
            background: list[tuple[int, str]] = []
            scen_starts = [k for k, l in enumerate(lines) if self.rx("scenario_regex").match(l)]
            bg = next((k for k, l in enumerate(lines) if self.rx("background_regex").match(l)), None)
            if bg is not None:
                k = bg + 1
                while k < len(lines) and not self.rx("block_end_regex").match(lines[k]):
                    ms = self.rx("step_regex").match(lines[k])
                    if ms:
                        background.append((k + 1, ms.group(2)))
                    k += 1
            for n, s in enumerate(scen_starts):
                e = (scen_starts[n + 1] - 1) if n + 1 < len(scen_starts) else len(lines) - 1
                steps = list(background)
                k = s + 1
                while k <= e:
                    if self.rx("block_end_regex").match(lines[k]) and not self.rx("step_regex").match(lines[k]):
                        if lines[k].strip().startswith("Examples") or lines[k].strip().startswith("Scenarios"):
                            break
                        if lines[k].lstrip().startswith("@"):
                            k += 1
                            continue
                        break
                    ms = self.rx("step_regex").match(lines[k])
                    if ms:
                        steps.append((k + 1, ms.group(2)))
                    k += 1
                invs, statuses, used = [], set(), []
                for ln, text in steps:
                    hit = resolve(text)
                    if hit is None:
                        self.unmatched_steps += 1
                        continue
                    if hit not in memo:
                        memo[hit] = _range_invocations(env, *hit)
                    si, ss, su = memo[hit]
                    for inv in si:
                        invs.append(Invocation(inv.file, inv.line, inv.kind, inv.method, inv.target,
                                               f"step '{text[:60]}' -> {hit[0]}:{hit[1]}" + (f" ({inv.via})" if inv.via else ""),
                                               min_conf(inv.confidence, CONF_MEDIUM), inv.explicit_method))
                    statuses |= ss
                    used.extend(su)
                name = self.rx("scenario_regex").match(lines[s]).group(2).strip() or f"scenario@{s + 1}"
                _add_case(env, tf, name, s + 1, e + 1, invs, statuses, used)
        if self.unmatched_steps:
            env.plugin_log.append({"plugin": self.name, "summary": "steps without a matching step definition",
                                   "evidence": [], "evidence_count": self.unmatched_steps})


@plugin
class RobotFramework(Plugin):
    name = "robot_framework"
    summary = "Robot Framework suites (.robot/.resource): test cases -> keywords -> SeleniumLibrary/RequestsLibrary/Python keyword libraries"
    DEFAULTS = {
        "section_regex": r"""^\*{3}\s*([\w ]+?)\s*\*{3}""",
        "variable_regex": r"""^(\$\{[^}]+\})\s{2,}(.+)$""",
        "nav_keywords": ["open browser", "go to", "navigate to"],
        "http_keywords": {"get on session": "GET", "post on session": "POST", "put on session": "PUT",
                          "delete on session": "DELETE", "patch on session": "PATCH", "get": "GET", "post": "POST",
                          "put": "PUT", "delete": "DELETE", "patch": "PATCH"},
    }

    def detect(self, env: Env) -> list[str]:
        self.files = [f for f in env.ctx.tracked if f.endswith((".robot", ".resource"))]
        return self.files

    def _parse(self, env: Env, f: str) -> dict:
        lines = env.ctx.lines(f)
        sec, out = "", {"vars": {}, "tests": [], "keywords": {}, "resources": [], "libraries": []}
        cur = None
        for i, raw in enumerate(lines):
            m = self.rx("section_regex").match(raw)
            if m:
                sec = m.group(1).lower()
                cur = None
                continue
            if not raw.strip() or raw.lstrip().startswith("#"):
                continue
            cells = [c.strip() for c in re.split(r"\s{2,}|\t", raw.strip()) if c.strip()]
            if sec.startswith("variable"):
                mv = self.rx("variable_regex").match(raw)
                if mv:
                    out["vars"][mv.group(1).lower()] = mv.group(2).strip()
            elif sec.startswith("setting"):
                if cells and cells[0].lower() in ("suite setup", "test setup", "test template", "task template") and len(cells) > 1:
                    out.setdefault("setup", []).append((i + 1, cells[0].lower(), cells[1:]))
                if cells and cells[0].lower() == "resource" and len(cells) > 1:
                    out["resources"].append(cells[1])
                if cells and cells[0].lower() == "library" and len(cells) > 1:
                    out["libraries"].append(cells[1])
            elif sec.startswith(("test case", "task", "keyword")):
                if not raw[0].isspace():
                    cur = {"name": raw.strip(), "line": i + 1, "end": i + 1, "steps": []}
                    (out["tests"].append(cur) if not sec.startswith("keyword")
                     else out["keywords"].__setitem__(raw.strip().lower(), cur))
                elif cur is not None and cells and not cells[0].startswith("["):
                    cur["steps"].append((i + 1, cells))
                    cur["end"] = i + 1
        return out

    def tests(self, env: Env) -> None:
        parsed = {f: self._parse(env, f) for f in self.files}
        lib_funcs: dict = {}
        for f, p in parsed.items():
            for lib in p["libraries"]:
                if lib.endswith(".py") or "/" in lib or "." in lib:
                    target = os.path.normpath(str(Path(f).parent / lib)).replace("\\", "/")
                    for cand in (target, target + ".py", lib.replace(".", "/") + ".py"):
                        for r in env.callables_in(cand):
                            lib_funcs[r[1].lower()] = r
        all_vars: dict = {}
        for p in parsed.values():
            all_vars.update(p["vars"])
        all_kw: dict = {}
        for f, p in parsed.items():
            for k, v in p["keywords"].items():
                all_kw.setdefault(k, (f, v))

        def subst(s: str) -> str:
            for _ in range(5):
                new = re.sub(r"\$\{([^}]+)\}", lambda m: all_vars.get(f"${{{m.group(1).lower()}}}", m.group(0)), s)
                if new == s:
                    break
                s = new
            return s

        nav = set(self.cfg["nav_keywords"])
        httpk = self.cfg["http_keywords"]

        def run_steps(f: str, steps: list, depth: int, invs: list, used: list) -> None:
            if depth > 5:
                return
            for ln, cells in steps:
                while len(cells) > 1 and re.match(r"^[$@&]\{[^}]+\}\s*=$", cells[0]):
                    cells = cells[1:]  # ${result}=    Keyword    args
                kw = re.sub(r"^(?:given|when|then|and|but)\s+", "", cells[0].lower())
                if kw not in all_kw:  # keywords with embedded arguments: user "${name}" logs in
                    for name, (kf2, kd2) in all_kw.items():
                        if "${" in name:
                            pat = "^" + re.sub(r"\\\$\\\{[^}]*\\\}", ".+?", re.escape(name)) + "$"
                            if re.match(pat, kw):
                                kw = name
                                break
                args = cells[1:]
                if kw in nav and args:
                    url = subst(args[0] if kw != "open browser" else args[0])
                    path = re.sub(r"^https?://[^/]+", "", url) or "/"
                    invs.append(Invocation(f, ln, "ui", "UI", path if path.startswith("/") else "/" + path,
                                           "robot navigation", CONF_HIGH))
                elif kw in httpk and args:
                    path = subst(args[-1] if kw.endswith("session") and len(args) > 1 else args[0])
                    path = re.sub(r"^https?://[^/]+", "", path)
                    if "/" in path:
                        invs.append(Invocation(f, ln, "http", httpk[kw], path, "robot request", CONF_HIGH))
                elif kw in all_kw:
                    kf, kdef = all_kw[kw]
                    used.append(f"{kf}:{kdef['line']}-{kdef['end']}")
                    run_steps(kf, kdef["steps"], depth + 1, invs, used)
                else:
                    r = lib_funcs.get(kw.replace(" ", "_"))
                    if r:
                        ri, _s, ru = _range_invocations(env, norm(r[3]), to_int(r[4]), to_int(r[5]))
                        invs.extend(ri)
                        used.extend(ru)

        for f, p in parsed.items():
            if not p["tests"]:
                if p["keywords"]:
                    env.test_file(f, "robot", "support")
                continue
            tf = env.test_file(f, "robot")
            setup_invs, setup_used, template = [], [], None
            for ln, what, cells in p.get("setup", []):
                if what.endswith("template"):
                    template = cells[0]
                else:
                    run_steps(f, [(ln, cells)], 0, setup_invs, setup_used)
            for t in p["tests"]:
                invs, used = [], []
                steps = t["steps"]
                if template:  # templated test: the template keyword is the test body
                    steps = [(t["line"], [template])] + steps
                run_steps(f, steps, 0, invs, used)
                invs += [Invocation(x.file, x.line, x.kind, x.method, x.target, "suite setup", CONF_MEDIUM, x.explicit_method)
                         for x in setup_invs if x.kind == "ui"]
                name = re.split(r"\s{2,}|\t", t["name"])[0]
                _add_case(env, tf, name, t["line"], t["end"], invs, set(), used + setup_used)


@plugin
class RequestFiles(Plugin):
    name = "request_files"
    summary = "API request collections: JMeter .jmx, .http/.rest files, Postman collections"
    DEFAULTS = {
        "jmx_sampler_regex": r"""<HTTPSamplerProxy\b[^>]*testname="([^"]*)\"""",
        "jmx_path_regex": r"""name="HTTPSampler\.path">([^<]*)<""",
        "jmx_method_regex": r"""name="HTTPSampler\.method">([A-Z]+)<""",
        "http_request_regex": r"""^\s*(GET|POST|PUT|PATCH|DELETE|HEAD|OPTIONS)\s+(\S+)""",
        "postman_marker": "\"_postman_id\"",
        "postman_status_regex": r"""(?:to\.have\.status\(\s*|response\.code\)\.to\.(?:eql|equal)\(\s*|responseCode\.code\s*={2,3}\s*)(\d{3})""",
    }

    def detect(self, env: Env) -> list[str]:
        self.jmx = [f for f in env.ctx.tracked if f.endswith(".jmx")]
        self.http = [f for f in env.ctx.tracked if f.endswith((".http", ".rest"))]
        self.postman = [f for f in env.ctx.tracked if f.endswith(".json") and
                        ("postman" in f.lower() or self.cfg["postman_marker"] in "\n".join(env.ctx.lines(f)[:50]))]
        return self.jmx + self.http + self.postman

    @staticmethod
    def _strip(p: str) -> str:
        p = re.sub(r"^\{\{[^}]+\}\}", "", p.strip())
        p = re.sub(r"^https?://[^/]+", "", p)
        p = re.sub(r"\{\{([^}]+)\}\}", r"{\1}", p)
        return p if p.startswith("/") else "/" + p

    def tests(self, env: Env) -> None:
        for f in self.jmx:
            text = "\n".join(env.ctx.lines(f))
            tf = env.test_file(f, "jmeter")
            starts = [m.start() for m in self.rx("jmx_sampler_regex").finditer(text)] or [0]
            for n, s in enumerate(starts):
                chunk = text[s: starts[n + 1] if n + 1 < len(starts) else len(text)]
                mp, mm = self.rx("jmx_path_regex").search(chunk), self.rx("jmx_method_regex").search(chunk)
                if not mp:
                    continue
                ln = text[:s].count("\n") + 1
                inv = Invocation(f, ln, "http", mm.group(1) if mm else None, self._strip(mp.group(1)), "jmeter sampler")
                name = self.rx("jmx_sampler_regex").search(chunk)
                _add_case(env, tf, name.group(1) if name else f"sampler@{ln}", ln, ln, [inv])
        for f in self.http:
            tf = env.test_file(f, "http-file")
            for i, line in enumerate(env.ctx.lines(f), 1):
                m = self.rx("http_request_regex").match(line)
                if m:
                    _add_case(env, tf, f"{m.group(1)} {m.group(2)}", i, i,
                              [Invocation(f, i, "http", m.group(1), self._strip(m.group(2)), "http file")])
        for f in self.postman:
            try:
                doc = json.loads("\n".join(env.ctx.lines(f)))
            except json.JSONDecodeError:
                env.plugin_errors.append({"plugin": self.name, "phase": "tests", "error": f"invalid JSON {f}"})
                continue
            tf = env.test_file(f, "postman")
            text = "\n".join(env.ctx.lines(f))

            def walk(items: list, prefix: str = "") -> None:
                for it in items or []:
                    if not isinstance(it, dict):
                        continue
                    if "item" in it:
                        walk(it["item"], prefix + it.get("name", "") + "/")
                        continue
                    req = it.get("request")
                    if not isinstance(req, dict):
                        continue
                    url = req.get("url")
                    raw = url.get("raw") if isinstance(url, dict) else url
                    if isinstance(url, dict) and not raw and url.get("path"):
                        raw = "/" + "/".join(url["path"])
                    if not raw:
                        continue
                    name = it.get("name", "request")
                    pos = text.find(json.dumps(name)) if name else -1
                    ln = text[:pos].count("\n") + 1 if pos >= 0 else 1
                    statuses = set()
                    for ev in it.get("event") or []:
                        for l in (ev.get("script") or {}).get("exec") or []:
                            statuses |= {int(s) for s in self.rx("postman_status_regex").findall(l)}
                    _add_case(env, tf, prefix + name, ln, ln,
                              [Invocation(f, ln, "http", (req.get("method") or "GET").upper(), self._strip(raw), "postman")],
                              statuses)
            walk(doc.get("item") if isinstance(doc, dict) else [])


@plugin
class LoadTests(Plugin):
    name = "load_tests"
    summary = "Load/performance suites that drive the API (Gatling, Artillery, Locust, k6)"
    DEFAULTS = {
        "gatling_scenario_regex": r"""\bscenario\(\s*"([^"]+)"\s*\)""",
        "gatling_request_regex": r"""\.(get|post|put|patch|delete)\(\s*"([^"]+)"\s*\)""",
        "artillery_marker_regex": r"""^\s*scenarios\s*:""",
        "artillery_request_regex": r"""^\s*-\s*(get|post|put|patch|delete)\s*:""",
        "artillery_url_regex": r"""^\s*url\s*:\s*['"]?([^'"\s]+)""",
        "locust_marker_regex": r"""\b(HttpUser|HttpLocust|FastHttpUser)\b""",
        "locust_request_regex": r"""\.client\.(get|post|put|patch|delete)\(\s*f?(['"])([^'"]+)\2""",
        "k6_marker_regex": r"""from\s+['"]k6/http['"]""",
        "k6_request_regex": r"""\bhttp\.(get|post|put|patch|del)\(\s*(['"`])([^'"`]+)\2""",
    }

    def detect(self, env: Env) -> list[str]:
        self.found = {"gatling": [], "artillery": [], "locust": [], "k6": []}
        for f in env.ctx.tracked:
            ext = f.rsplit(".", 1)[-1].lower()
            if ext not in ("scala", "java", "kt", "yml", "yaml", "py", "js", "ts"):
                continue
            text = "\n".join(env.ctx.lines(f)[:400])
            if ext in ("scala", "java", "kt") and "io.gatling" in text:
                self.found["gatling"].append(f)
            elif ext in ("yml", "yaml") and self.rx("artillery_marker_regex", re.M).search(text) and "target" in text:
                self.found["artillery"].append(f)
            elif ext == "py" and self.rx("locust_marker_regex").search(text):
                self.found["locust"].append(f)
            elif ext in ("js", "ts") and self.rx("k6_marker_regex").search(text):
                self.found["k6"].append(f)
        return [f for v in self.found.values() for f in v]

    def tests(self, env: Env) -> None:
        for kind, files in self.found.items():
            for f in files:
                lines = env.ctx.lines(f)
                tf = env.test_file(f, kind)
                tf.role, tf.cases = "test", []
                invs = []
                for i, line in enumerate(lines, 1):
                    if kind == "gatling":
                        for m in self.rx("gatling_request_regex").finditer(line):
                            p = re.sub(r"\$\{[^}]+\}", "{x}", m.group(2))
                            invs.append(Invocation(f, i, "http", m.group(1).upper(), p if p.startswith("/") else "/" + p, "gatling"))
                    elif kind == "artillery":
                        m = self.rx("artillery_request_regex").match(line)
                        if m:
                            u = next((self.rx("artillery_url_regex").match(l) for l in lines[i:i + 4] if self.rx("artillery_url_regex").match(l)), None)
                            if u:
                                invs.append(Invocation(f, i, "http", m.group(1).upper(), re.sub(r"\{\{\s*(\w+)\s*\}\}", r"{\1}", u.group(1)), "artillery"))
                    else:
                        m = self.rx("locust_request_regex" if kind == "locust" else "k6_request_regex").search(line)
                        if m:
                            verb = m.group(1).upper().replace("DEL", "DELETE") if m.group(1) != "delete" else "DELETE"
                            p = re.sub(r"\{[^}]*\}|\$\{[^}]*\}", "{x}", m.group(3))
                            p = re.sub(r"^\{x\}", "", p)
                            invs.append(Invocation(f, i, "http", verb, p if p.startswith("/") else "/" + p, kind))
                if invs:
                    name = (self.rx("gatling_scenario_regex").search("\n".join(lines)) or None)
                    _add_case(env, tf, name.group(1) if name else Path(f).stem, 1, len(lines), invs)



class HttpRegistrations(Plugin):
    name = "http_registrations"
    summary = "Route registration calls and annotations (app.get('/x', h), @GetMapping, [HttpGet], @app.route ...)"

    def detect(self, env: Env) -> list[str]:
        rx_v = env.rules.rx("routing.verb_call_regex", re.I)
        rx_a = env.rules.rx("routing.annotation_regex", re.I)
        prod = [f for f in env.ctx.tracked if env.ctx.is_production_code(f)]
        return grep_files(env, rx_v, prod) + grep_files(env, rx_a, prod)

    def entry_points(self, env: Env) -> None:
        before = {qn: len(c.triggers) for qn, c in env.cands.items()}
        bind_http_registrations(env)
        resolve_prefixes(env.ctx, env.cands)
        apply_context_paths(env)
        for qn, c in env.cands.items():
            new = c.triggers[before.get(qn, 0):]
            for t in new:
                t.setdefault("kind", "http")
                t.setdefault("plugin", self.name)
            if new:
                c.signals.add(f"P_{self.name}")
                c.kinds.add("http")
                c.plugin_conf = best_conf(c.plugin_conf, CONF_HIGH)
                c.evidence.append(f"registered at {new[0]['source']}")



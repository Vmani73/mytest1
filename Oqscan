def trace_callees(cbm: CBMClient, project: str, qn: str, depth: int, timeout_s: float) -> list[tuple[str, int]]:
    try:
        res = cbm.call("trace_path", {"project": project, "function_name": qn, "direction": "outbound",
                                      "depth": depth, "format": "json"}, timeout_s)
    except QScanError as e:
        log.warning("trace_path failed for %s: %s", qn, e)
        return []
    out = []
    callees = res.get("callees") or {}
    for g in (callees.get("groups", []) if isinstance(callees, dict) else []):
        prefix = g.get("qn_prefix", "")
        for row in g.get("rows", []):
            q = f"{prefix}.{row[0]}" if prefix else row[0]
            if q != qn:  # CBM lists the function as its own callee
                out.append((q, to_int(row[1]) if len(row) > 1 else 0))
    return sorted(set(out), key=lambda x: (x[1], x[0]))


def exclude_client_interfaces(env: Env) -> None:
    """Declarative HTTP clients (Feign, Refit, MicroProfile RestClient, @HttpExchange)
    use the same annotations as controllers but describe OUTBOUND calls."""
    rx = env.rules.rx("flows.client_interface_regex")
    files = {f for f in env.ctx.tracked if env.ctx.is_production_code(f) and rx.search("\n".join(env.ctx.lines(f)))}
    if not files:
        return
    for c in list(env.cands.values()):
        if c.file not in files:
            continue
        keep = []
        for t in c.triggers:
            if t.get("kind") == "http" and t.get("plugin") in ("http_registrations", "cbm_routes"):
                env.outbound.append({"from": c.qn, "kind": "http", "method": t["method"], "path": t["path"],
                                     "at": t.get("source", c.file), "via": "declarative client"})
            else:
                keep.append(t)
        c.triggers = keep
        if not keep:
            c.signals = {s for s in c.signals if s not in ("P_http_registrations", "S1_route_handler")}
            c.kinds.discard("http")
            c.evidence.append("declarative HTTP client interface (outbound, not an entry point)")


def collect_outbound(env: Env) -> None:
    """HTTP client calls with resolvable paths, message producers and gRPC stub calls in production code."""
    rx_client = env.rules.rx("flows.http_client_regex")
    rx_prod = env.rules.rx("flows.producer_regex")
    x: InvocationExtractor = env.extractor
    for f in env.ctx.tracked:
        if not env.ctx.is_production_code(f) or f.rsplit(".", 1)[-1].lower() not in BRACE_EXT | {"py", "vue", "rb"}:
            continue
        lines = env.ctx.lines(f)
        for i, line in enumerate(lines):
            if len(line) > env.ctx.max_line:
                continue
            if rx_client.search(line):
                for inv in x.line(f, lines, i):
                    if inv.kind == "http":
                        row = env.callable_at(f, i + 1)
                        env.outbound.append({"from": row[0] if row else f, "kind": "http", "method": inv.method,
                                             "path": inv.target, "at": f"{f}:{i + 1}", "via": inv.via})
            m = rx_prod.search(line)
            topic = next((g for g in m.groups()[1:] if g), None) if m else None
            if topic:
                row = env.callable_at(f, i + 1)
                env.outbound.append({"from": row[0] if row else f, "kind": "message", "method": "TOPIC",
                                     "path": topic, "at": f"{f}:{i + 1}", "via": "producer"})


def link_outbound(env: Env) -> list[dict]:
    """Resolve outbound records to entry points of this repository."""
    idx = trigger_index(env)
    links = []
    for o in env.outbound:
        kind = o["kind"]
        targets = []
        if kind == "http":
            inv = Invocation(o["at"].rsplit(":", 1)[0], 0, "http", o.get("method"), o["path"], o.get("via", ""))
            match_invocation(inv, idx, 2)
            targets = inv.mapped
        elif kind == "message":
            targets = sorted({c.qn for c, t in idx.get("message", []) if t["path"].lower() == o["path"].lower()})
        elif kind == "gateway":
            svc = re.sub(r"^(lb|http|https)://", "", o.get("target") or "").split("/")[0].split(":")[0].lower()
            if svc:
                targets = sorted({c.qn for c in env.cands.values() if c.confirmed and c.triggers
                                  and svc in c.file.lower().replace("_", "-") and "gateway_route" not in c.kinds})[:50]
        links.append({**o, "targets": targets})
    return links


def owners_of(env: Env, qn: str, callees: list[tuple[str, int]]) -> set:
    """Files/callables belonging to an entry point's flow (for attributing outbound calls)."""
    own = {qn}
    own.update(q for q, _ in callees)
    return own


# ---- runtime coverage ----------------------------------------------------------
COVERAGE_FILE_NAMES = ("jacoco.xml", "jacocoTestReport.xml", "coverage.xml", "cobertura.xml", "cobertura-coverage.xml",
                       "lcov.info", "coverage-final.json", "coverage.json")


def find_coverage_reports(root: Path, explicit: list[str], max_depth: int = 6) -> list[Path]:
    found = [Path(p) for p in explicit]
    if explicit:
        return found
    for dirpath, dirnames, filenames in os.walk(root):
        rel_depth = len(Path(dirpath).relative_to(root).parts)
        dirnames[:] = [d for d in dirnames if d not in (".git", "node_modules", ".venv", "venv", "__pycache__")
                       and rel_depth < max_depth]
        for fn in filenames:
            if fn in COVERAGE_FILE_NAMES:
                found.append(Path(dirpath) / fn)
    return sorted(found)


def parse_coverage(paths: list[Path]) -> dict[str, set]:
    """report path -> executed line numbers. Supports JaCoCo XML, Cobertura XML, lcov,
    coverage.py JSON and Istanbul coverage-final.json."""
    import xml.etree.ElementTree as ET
    executed: dict[str, set] = defaultdict(set)
    for p in paths:
        try:
            name = p.name
            if name.endswith(".info"):
                cur = None
                for line in p.read_text(encoding="utf-8", errors="replace").splitlines():
                    if line.startswith("SF:"):
                        cur = norm(line[3:].strip())
                    elif line.startswith("DA:") and cur:
                        ln, hits = line[3:].split(",")[:2]
                        if int(hits) > 0:
                            executed[cur].add(int(ln))
            elif name.endswith(".json"):
                doc = json.loads(p.read_text(encoding="utf-8", errors="replace"))
                if isinstance(doc, dict) and "files" in doc:
                    for fp, d in doc["files"].items():
                        executed[norm(fp)].update(d.get("executed_lines", []))
                elif isinstance(doc, dict):
                    for fp, d in doc.items():
                        if isinstance(d, dict) and "statementMap" in d:
                            for sid, cnt in (d.get("s") or {}).items():
                                if cnt and sid in d["statementMap"]:
                                    executed[norm(d.get("path", fp))].add(int(d["statementMap"][sid]["start"]["line"]))
            else:
                tree = ET.parse(str(p))
                root = tree.getroot()
                if root.tag == "report":  # JaCoCo
                    for pkg in root.iter("package"):
                        for sf in pkg.iter("sourcefile"):
                            key = norm(f"{pkg.get('name', '')}/{sf.get('name')}")
                            for ln in sf.iter("line"):
                                if int(ln.get("ci", "0")) > 0:
                                    executed[key].add(int(ln.get("nr")))
                else:  # Cobertura
                    for cls in root.iter("class"):
                        key = norm(cls.get("filename", ""))
                        for ln in cls.iter("line"):
                            if int(ln.get("hits", "0")) > 0:
                                executed[key].add(int(ln.get("number")))
        except (OSError, ValueError, KeyError, json.JSONDecodeError, ET.ParseError) as e:
            log.warning("cannot read coverage report %s: %s", p, e)
    return dict(executed)


class RuntimeCoverage:
    def __init__(self, ctx: RepoContext, executed: dict[str, set], sources: list[str]):
        self.sources = sources
        self.by_repo_file: dict[str, set] = {}
        tracked = ctx.tracked
        by_name: dict = defaultdict(list)
        for t in tracked:
            by_name[t.rsplit("/", 1)[-1]].append(t)
        for rp, lines in executed.items():
            base = rp.rsplit("/", 1)[-1]
            cands = [t for t in by_name.get(base, []) if rp.endswith(t) or t.endswith(rp.lstrip("./"))]
            if len(cands) == 1:
                self.by_repo_file.setdefault(cands[0], set()).update(lines)

    @property
    def available(self) -> bool:
        return bool(self.by_repo_file)

    def status(self, ref: str) -> Optional[bool]:
        """True executed, False file measured but line not executed, None not measured."""
        f, _, ln = ref.split(" ")[0].rpartition(":")
        if f not in self.by_repo_file or not ln.isdigit():
            return None
        n = int(ln)
        lines = self.by_repo_file[f]
        return n in lines or (n + 1) in lines

# --------------------------------------------------------------------------
# Expected scenarios (from code evidence) and their coverage
# --------------------------------------------------------------------------
def trigger_text(t: Optional[dict]) -> str:
    if not t:
        return "-"
    return f"{t['method'] or 'ANY'} {t['path']}"


def capability_of(ctx: RepoContext, c: Candidate) -> str:
    ignored = set(ctx.rules.get("routing.capability_ignored_segments"))
    if c.triggers:
        segs = [x for x in norm_path(c.triggers[0]["path"]).split("/") if x and not is_param(x) and x not in ignored]
        if segs:
            return segs[0]
    parent = Path(c.file).parent
    return parent.name or "root"


def derive_scenarios(ctx: RepoContext, c: Candidate, callees: list[tuple[str, int]], graph: Graph) -> list[dict]:
    s = ctx.rules
    rx_err = s.rx("scenarios.error_line_regex")
    rx_cond = s.rx("scenarios.condition_regex")
    rx_num = s.rx("scenarios.status_number_regex")
    rx_msg = s.rx("scenarios.message_regex")
    rx_auth = s.rx("scenarios.auth_regex")
    rx_valid = s.rx("scenarios.validation_regex")
    names = s.get("scenarios.status_names")
    lookback = int(s.get("scenarios.condition_lookback_lines"))
    max_neg = int(s.get("limits.max_negative_scenarios_per_entry_point"))
    callee_depth = int(s.get("limits.scenario_callee_depth"))
    trig = c.triggers[0] if c.triggers else None
    action = trigger_text(trig) if trig else f"invoke {c.name}"
    scenarios = [{"type": "happy_path", "title": f"valid request: {action} succeeds",
                  "expect": "success (2xx)" if trig and trig.get("kind", "http") == "http" else "completes successfully",
                  "statuses": [200, 201, 202, 204] if trig and trig.get("kind", "http") == "http" else [],
                  "evidence": f"{c.file}:{c.start}"}]
    if c.label not in CALLABLE or c.end < c.start:
        return scenarios
    lines = ctx.lines(c.file)
    above = lines[max(0, c.start - 4):c.start]
    decos = graph.decorated.get(c.qn, [])
    annotations = [l.strip() for l in above if l.strip().startswith(("@", "[", "#["))]
    annotations += [l.strip() for l in lines[c.start - 1:c.start] if l.strip().startswith(("@", "[", "#["))]
    # route registration lines carry paths/names ("/login", "auth:login") that are not auth checks
    rx_verb, rx_annot = s.rx("routing.verb_call_regex", re.I), s.rx("routing.annotation_regex", re.I)
    annotations = [l for l in annotations if not (rx_verb.search(l) or rx_annot.search(l))]
    auth_hit = next((d for d in decos if rx_auth.search(d)), None) or next((l for l in annotations if rx_auth.search(l)), None)
    if auth_hit:
        scenarios.append({"type": "auth", "title": f"request without valid authentication/permission: {action} is rejected",
                          "expect": "/".join(str(x) for x in s.get("scenarios.auth_status")),
                          "statuses": list(s.get("scenarios.auth_status")), "evidence": f"{c.file}:{c.start} ({auth_hit[:60]})"})
    body = lines[c.start - 1:c.end]
    valid_hit = next(((k, l.strip()) for k, l in enumerate(body[:15]) if rx_valid.search(l)), None)
    if valid_hit:
        scenarios.append({"type": "validation", "title": f"invalid or missing input: {action} is rejected",
                          "expect": "/".join(str(x) for x in s.get("scenarios.validation_status")),
                          "statuses": list(s.get("scenarios.validation_status")),
                          "evidence": f"{c.file}:{c.start + valid_hit[0]} ({valid_hit[1][:60]})"})
    scopes = [(c.file, c.start, c.end, c.name)]
    for qn, hop in callees:
        r = graph.prod.get(qn)
        if r and hop <= callee_depth and to_int(r[5]) >= to_int(r[4]):
            scopes.append((norm(r[3]), to_int(r[4]), to_int(r[5]), r[1]))
    seen = set()
    negatives = []
    for file_, start, end, owner in scopes:
        src = ctx.lines(file_)
        for ln in range(max(start, 1), min(end, len(src)) + 1):
            line = src[ln - 1]
            if len(line) > ctx.max_line or not rx_err.search(line):
                continue
            k, depth = ln, line.count("(") - line.count(")")
            while depth > 0 and k < min(len(src), ln + 6):  # include the rest of a multi-line call
                line += " " + src[k].strip()
                depth += src[k].count("(") - src[k].count(")")
                k += 1
            status = None
            mn = rx_num.search(line)
            if mn:
                status = int(mn.group(1))
            else:
                status = next((v for k, v in names.items() if re.search(r"\b" + re.escape(k) + r"\b", line)), None)
            cond = None
            for back in range(0, lookback + 1):
                if ln - 1 - back < 0:
                    break
                mc = rx_cond.match(src[ln - 1 - back])
                if mc:
                    cond = mc.group(1).strip().rstrip(":{").strip()[:100]
                    break
            mm = rx_msg.search(line)
            msg = mm.group(2) if mm else None
            key = (status, msg, cond)
            if key in seen:
                continue
            seen.add(key)
            when = f"when {cond}" if cond else "on this error path"
            negatives.append({"type": "negative", "title": f"{action} fails {when}",
                              "expect": " ".join(x for x in (str(status) if status else "error", f'"{msg}"' if msg else "") if x),
                              "statuses": [status] if status else [],
                              "evidence": f"{file_}:{ln}" + ("" if owner == c.name else f" (in {owner})")})
    scenarios.extend(negatives[:max_neg])
    return scenarios


def unindexed_files(ctx: RepoContext, cbm: CBMClient, project: str) -> list[str]:
    indexed = {norm(r[0]) for r in cbm.cypher(project, "MATCH (f:File) RETURN f.file_path")}
    binary = set(ctx.rules.get("files.binary_ext"))
    return sorted(f for f in ctx.tracked if f not in indexed and f.rsplit(".", 1)[-1].lower() not in binary)



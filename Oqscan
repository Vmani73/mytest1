def _deep_merge(base: dict, over: dict) -> dict:
    out = dict(base)
    for k, v in over.items():
        out[k] = _deep_merge(out[k], v) if isinstance(v, dict) and isinstance(out.get(k), dict) else v
    return out


class Rules:
    """Built-in DEFAULT_RULES, optionally deep-merged with a JSON file (--rules)."""

    def __init__(self, path: Optional[Path] = None):
        override: dict = {}
        if path is not None:
            try:
                override = json.loads(path.read_bytes())
            except FileNotFoundError as e:
                raise QScanError(f"rules file not found: {path}", EXIT_USAGE) from e
            except json.JSONDecodeError as e:
                raise QScanError(f"rules file is not valid JSON: {path}: {e}", EXIT_USAGE) from e
            if not isinstance(override, dict):
                raise QScanError(f"rules file must contain a JSON object: {path}", EXIT_USAGE)
        self.data: dict = _deep_merge(DEFAULT_RULES, override)
        self.path = path or Path("built-in")
        plugin_defaults = {cls.name: cls.DEFAULTS for cls in PLUGINS}
        blob = json.dumps({"rules": self.data, "plugins": plugin_defaults}, sort_keys=True, default=str).encode()
        self.sha256 = hashlib.sha256(blob).hexdigest()[:12]
        self._rx: dict[str, re.Pattern] = {}

    def get(self, dotted: str) -> Any:
        node: Any = self.data
        for part in dotted.split("."):
            if not isinstance(node, dict) or part not in node:
                raise QScanError(f"rules are missing '{dotted}'", EXIT_USAGE)
            node = node[part]
        return node

    def rx(self, dotted: str, flags: int = 0) -> re.Pattern:
        key = f"{dotted}/{flags}"
        if key not in self._rx:
            try:
                self._rx[key] = re.compile(self.get(dotted), flags)
            except re.error as e:
                raise QScanError(f"invalid regex '{dotted}' in rules: {e}", EXIT_USAGE) from e
        return self._rx[key]

# --------------------------------------------------------------------------
# Repository context: tracked files, file cache, path classification
# --------------------------------------------------------------------------
def norm(path: Optional[str]) -> str:
    return (path or "").replace("\\", "/")


def to_int(value: Any) -> int:
    try:
        return int(value or 0)
    except (TypeError, ValueError):
        return 0


class RepoContext:
    def __init__(self, root: Path, rules: Rules):
        self.root = root
        self.rules = rules
        self.tracked = self._git(["ls-files"]).splitlines()
        self.tracked_set = set(self.tracked)
        try:
            self.commit = self._git(["rev-parse", "HEAD"]).strip()
        except QScanError:
            self.commit = "unknown"
        self._lines: dict[str, list[str]] = {}
        self._generated: dict[str, bool] = {}
        self._test_rx = rules.rx("files.test_path_regex", re.I)
        self._non_code = set(rules.get("files.non_code_ext"))
        self._build_files = set(rules.get("files.build_files"))
        self._gen_name = rules.rx("files.generated_name_regex", re.I)
        self._gen_head = rules.rx("files.generated_header_regex", re.I)
        self.max_line = int(rules.get("limits.max_line_chars"))
        self.max_bytes = int(rules.get("limits.max_file_bytes"))

    def _git(self, args: list[str]) -> str:
        try:
            proc = subprocess.run(["git", "-C", str(self.root), *args], capture_output=True,
                                  text=True, encoding="utf-8", errors="replace", timeout=120)
        except FileNotFoundError as e:
            raise QScanError("git is not installed or not on PATH", EXIT_USAGE) from e
        except subprocess.TimeoutExpired as e:
            raise QScanError(f"git {' '.join(args)} timed out", EXIT_INTERNAL) from e
        if proc.returncode != 0:
            raise QScanError(f"{self.root} is not a git repository ({proc.stderr.strip()})", EXIT_USAGE)
        return proc.stdout

    def lines(self, rel: str) -> list[str]:
        """File lines (cached). Oversized/unreadable files return []."""
        rel = norm(rel)
        if rel not in self._lines:
            path = self.root / rel
            try:
                if path.stat().st_size > self.max_bytes:
                    log.debug("skipping large file %s", rel)
                    self._lines[rel] = []
                else:
                    self._lines[rel] = path.read_text(encoding="utf-8", errors="replace").splitlines()
            except OSError as e:
                log.debug("cannot read %s: %s", rel, e)
                self._lines[rel] = []
        return self._lines[rel]

    def is_test(self, path: Optional[str]) -> bool:
        return bool(path) and bool(self._test_rx.search(norm(path)))

    @staticmethod
    def is_external(path: Optional[str]) -> bool:
        return not path or path.startswith("<")  # CBM pseudo-paths such as <python-builtins>

    def is_generated(self, path: Optional[str]) -> bool:
        p = norm(path)
        if not p:
            return False
        if p not in self._generated:
            result = bool(self._gen_name.search(p))
            if not result and p in self.tracked_set:
                head = "\n".join(self.lines(p)[:5])
                result = bool(self._gen_head.search(head))
            self._generated[p] = result
        return self._generated[p]

    def is_code(self, path: Optional[str]) -> bool:
        p = norm(path)
        if not p:
            return False
        if p.rsplit("/", 1)[-1].lower() in self._build_files:
            return False
        if p.rsplit(".", 1)[-1].lower() in self._non_code:
            return False
        return not self.is_generated(p)

    def is_production_code(self, path: Optional[str]) -> bool:
        return not self.is_test(path) and not self.is_external(path) and self.is_code(path)

# --------------------------------------------------------------------------
# CBM MCP client (stdio JSON-RPC) with timeouts and complete pagination
# --------------------------------------------------------------------------
def cypher_str(value: str) -> str:
    """Quote a value as a Cypher string literal."""
    return '"' + value.replace("\\", "\\\\").replace('"', '\\"') + '"'


class CBMClient:
    def __init__(self, binary: str = "codebase-memory-mcp", timeout_s: float = 300.0):
        exe = shutil.which(binary)
        if not exe:
            raise QScanError(f"'{binary}' not found on PATH; install codebase-memory-mcp", EXIT_CBM)
        self.timeout_s = timeout_s
        try:
            self.proc = subprocess.Popen([exe], stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                         stderr=subprocess.DEVNULL, text=True, encoding="utf-8",
                                         errors="replace", bufsize=1)
        except OSError as e:
            raise QScanError(f"cannot start {exe}: {e}", EXIT_CBM) from e
        self._ids = itertools.count(1)
        self._out: "queue.Queue[Optional[str]]" = queue.Queue()
        threading.Thread(target=self._pump, daemon=True).start()
        self._rpc("initialize", {"protocolVersion": "2025-06-18", "capabilities": {},
                                 "clientInfo": {"name": "qscan", "version": __version__}})
        self._send({"jsonrpc": "2.0", "method": "notifications/initialized"})

    def _pump(self) -> None:
        assert self.proc.stdout is not None
        for line in self.proc.stdout:
            self._out.put(line)
        self._out.put(None)

    def _send(self, msg: dict) -> None:
        assert self.proc.stdin is not None
        try:
            self.proc.stdin.write(json.dumps(msg) + "\n")
            self.proc.stdin.flush()
        except (BrokenPipeError, OSError) as e:
            raise QScanError(f"CBM process is not accepting input: {e}", EXIT_CBM) from e

    def _rpc(self, method: str, params: dict, timeout_s: Optional[float] = None) -> dict:
        rid = next(self._ids)
        self._send({"jsonrpc": "2.0", "id": rid, "method": method, "params": params})
        wait = timeout_s or self.timeout_s
        while True:
            try:
                line = self._out.get(timeout=wait)
            except queue.Empty as e:
                raise QScanError(f"CBM did not answer '{method}' within {wait:.0f}s", EXIT_CBM) from e
            if line is None:
                raise QScanError("CBM process exited unexpectedly", EXIT_CBM)
            try:
                msg = json.loads(line)
            except json.JSONDecodeError:
                log.debug("ignoring non-JSON CBM output: %.120s", line)
                continue
            if msg.get("id") != rid:
                continue
            if "error" in msg:
                raise QScanError(f"CBM {method} error: {msg['error']}", EXIT_CBM)
            return msg["result"]

    def call(self, tool: str, args: dict, timeout_s: Optional[float] = None) -> dict:
        res = self._rpc("tools/call", {"name": tool, "arguments": args}, timeout_s)
        if res.get("isError"):
            text = (res.get("content") or [{}])[0].get("text", "")
            raise QScanError(f"CBM tool {tool} failed: {text[:300]}", EXIT_CBM)
        if res.get("structuredContent") is not None:
            return res["structuredContent"]
        try:
            return json.loads(res["content"][0]["text"])
        except (KeyError, IndexError, json.JSONDecodeError) as e:
            raise QScanError(f"CBM tool {tool} returned an unexpected payload", EXIT_CBM) from e

    def cypher(self, project: str, query: str) -> list[list]:
        """All rows of a read-only query. query_graph truncates at an output
        budget, so follow next_cursor and verify the count against `total`."""
        rows: list[list] = []
        cursor: Optional[str] = None
        expected: Optional[int] = None
        while True:
            args = {"project": project, "query": query, "format": "json",
                    "max_rows": 99998, "max_output_tokens": 4000000}
            if cursor:
                args["cursor"] = cursor
            data = self.call("query_graph", args)
            rows.extend(data.get("rows", []))
            if expected is None and data.get("total_relation") == "eq":
                expected = data.get("total")
            if not data.get("has_more"):
                break
            cursor = data.get("next_cursor")
            if not cursor:
                raise QScanError(f"CBM reported more rows but no cursor for: {query}", EXIT_CBM)
        if expected is not None and len(rows) != expected:
            raise QScanError(f"incomplete CBM result ({len(rows)}/{expected}) for: {query}", EXIT_CBM)
        return rows

    def close(self) -> None:
        try:
            if self.proc.stdin:
                self.proc.stdin.close()
            self.proc.wait(timeout=10)
        except (OSError, subprocess.TimeoutExpired):
            log.debug("CBM did not exit cleanly; terminating")
            self.proc.kill()

# --------------------------------------------------------------------------
# Triggers: external URL/route for each entry point
# --------------------------------------------------------------------------
def norm_path(p: str) -> str:
    p = re.sub(r"^https?://[^/]+", "", p.strip())
    if "/#/" in p or p.startswith("#/"):  # hash routing: the route follows '#'
        p = p.split("#", 1)[1]
    p = p.split("?", 1)[0].split("#", 1)[0]
    if not p.startswith("/"):
        p = "/" + p
    p = re.sub(r"/{2,}", "/", p)
    return (p.rstrip("/") or "/").lower()


def is_param(seg: str) -> bool:
    return bool(re.fullmatch(r"\{[^}]*\}|:[\w]+\??|<[^>]*>|\*+|\[[^\]]*\]|\(.*\)", seg))


def static_len(path: str) -> int:
    return len([x for x in norm_path(path).split("/") if x and not is_param(x)])


def join_path(*parts: str) -> str:
    segs = [p.strip("/") for p in parts if p and p.strip("/")]
    return "/" + "/".join(segs)


def path_match(test_path: str, template: str, max_prefix: int = 3) -> Optional[str]:
    """'exact', 'suffix' (one side has extra leading segments such as /api or a
    context path), or None. Parameters match any single segment."""
    t = [x for x in norm_path(test_path).split("/") if x]
    r = [x for x in norm_path(template).split("/") if x]

    def eq(a: list, b: list) -> bool:
        return len(a) == len(b) and all(is_param(y) or is_param(x) or x == y for x, y in zip(a, b))

    if eq(t, r):
        return "exact"
    if not [x for x in r if not is_param(x)]:
        return None
    for k in range(1, max_prefix + 1):
        if len(t) - k == len(r) and eq(t[k:], r):
            return "suffix"
        if len(r) - k == len(t) and t and eq(t, r[k:]):
            return "suffix"
    return None


def resolve_import(ctx: RepoContext, base_file: str, spec: str) -> Optional[str]:
    if not spec.startswith("."):
        return None
    target = os.path.normpath(str(Path(norm(base_file)).parent / spec)).replace("\\", "/")
    exts = ctx.rules.get("files.ui_import_extensions")
    idx = ctx.rules.get("files.ui_index_files")
    for cand in (target, *(target + e for e in exts), *(f"{target}/{i}" for i in idx)):
        if cand in ctx.tracked_set:
            return cand
    return None

# --------------------------------------------------------------------------
# Entry-point discovery (graph signals)
# --------------------------------------------------------------------------
@dataclass
class Candidate:
    qn: str
    name: str
    label: str
    file: str
    start: int
    end: int
    signals: set = field(default_factory=set)
    evidence: list = field(default_factory=list)
    triggers: list = field(default_factory=list)
    kinds: set = field(default_factory=set)         # entry kinds asserted by plugins
    plugin_conf: str = ""                           # best confidence a plugin gave

    @property
    def confirmed(self) -> bool:
        return (bool(self.signals & STRONG_SIGNALS) or bool(self.triggers)
                or any(s.startswith("P_") for s in self.signals))

    @property
    def confidence(self) -> str:
        """HIGH: registration found and trigger resolved; MEDIUM: strong graph or plugin
        evidence without a resolved trigger; LOW: weak signals only (needs review)."""
        if self.triggers and (self.plugin_conf == CONF_HIGH or self.signals & {"S1_route_handler", "S14_convention_route"}):
            return CONF_HIGH
        if self.triggers or self.plugin_conf or self.signals & STRONG_SIGNALS:
            return CONF_MEDIUM
        return CONF_LOW


@dataclass
class Graph:
    """Graph facts reused across stages."""
    callables: dict  # qn -> (qn, name, label, file, start, end), all callables
    prod: dict       # subset in production code
    decorated: dict  # qn -> [decorator names]
    imports_of: dict  # file -> set(imported file)
    imported_files: set
    defines_code: set
    classes: list = field(default_factory=list)  # (name, file, start, end) of production classes
    by_name: dict = field(default_factory=dict)  # name -> [callable rows]
    classes_all: list = field(default_factory=list)  # classes incl. test code


def discover(ctx: RepoContext, cbm: CBMClient, project: str, public_roots: list[str]
             ) -> tuple[dict[str, Candidate], Graph]:
    rules = ctx.rules
    q: Callable[[str], list[list]] = lambda s: cbm.cypher(project, s)

    callables = {r[0]: r for r in q("MATCH (f:Function|Method) RETURN f.qualified_name, f.name, "
                                    "f.label, f.file_path, f.start_line, f.end_line")}
    prod = {k: r for k, r in callables.items() if ctx.is_production_code(r[3])}

    inbound: dict = defaultdict(lambda: defaultdict(list))
    for etype in ("CALLS", "CALL_REFERENCE"):
        for src_qn, src_label, src_file, tgt_qn in q(
                f"MATCH (a)-[:{etype}]->(f:Function|Method) RETURN a.qualified_name, "
                "a.label, a.file_path, f.qualified_name"):
            if src_qn != tgt_qn:  # CBM can emit spurious self-loops
                inbound[tgt_qn][etype].append((src_qn, src_label, src_file))

    decorated: dict = defaultdict(list)
    for f_qn, d_name in q("MATCH (f:Function|Method)-[:DECORATES]->(d) RETURN f.qualified_name, d.name"):
        decorated[f_qn].append(d_name)

    route_handlers: dict = defaultdict(list)
    for r_qn, h_qn in q("MATCH (r:Route)-[:HANDLES]-(h:Function|Method) RETURN r.qualified_name, h.qualified_name"):
        route_handlers[h_qn].append(r_qn)

    imported_by: dict = defaultdict(set)
    for src_file, tgt_qn in q("MATCH (a:File)-[:IMPORTS]->(f:Function|Method) RETURN a.file_path, f.qualified_name"):
        imported_by[tgt_qn].add(src_file)
    calls_from_file: dict = defaultdict(set)
    for src_file, tgt_qn in q("MATCH (a)-[:CALLS]->(f:Function|Method) RETURN a.file_path, f.qualified_name"):
        calls_from_file[src_file].add(tgt_qn)

    # CBM links every Python file to builtin classes with DEFINES; count only
    # definitions whose own path is the file.
    defines_code = {r[0] for r in q("MATCH (f:File)-[:DEFINES]->(x:Function|Method|Class) "
                                    "RETURN DISTINCT f.file_path, x.file_path") if r[0] == r[1]}
    imports_of: dict = defaultdict(set)
    imported_files = set()
    for a, b in q("MATCH (a:File)-[:IMPORTS]->(b) RETURN DISTINCT a.file_path, b.file_path"):
        if a and b and a != b:
            imports_of[a].add(b)
            if not ctx.is_test(a) and ctx.is_code(a):  # only production code importers count
                imported_files.add(b)
    public_set = {norm(r) for r in public_roots}
    reexport_hubs = {f for f in {f for fs in imported_by.values() for f in fs}
                     if f not in defines_code and f in imported_files and norm(f) not in public_set}

    cands: dict[str, Candidate] = {}

    def add(qn: str, name: str, label: str, file: str, start: Any, end: Any, signal: str, ev: str) -> None:
        c = cands.setdefault(qn, Candidate(qn, name, label, norm(file), to_int(start), to_int(end)))
        c.signals.add(signal)
        c.evidence.append(ev)

    lang_decorators = set(rules.get("signals.language_decorators"))
    for qn, r in prod.items():
        inb = inbound.get(qn, {})
        calls = inb.get("CALLS", [])
        prod_callers = [s for s in calls if not ctx.is_test(s[2]) and s[1] in CALLABLE + ("Class",)]
        module_callers = [s for s in calls if not ctx.is_test(s[2]) and s[1] in ("Module", "File")]
        refs = [s for s in inb.get("CALL_REFERENCE", []) if not ctx.is_test(s[2])]
        base = (qn, r[1], r[2], r[3], r[4], r[5])
        if qn in route_handlers:
            add(*base, "S1_route_handler", f"route node(s) {sorted(route_handlers[qn])[:3]}")
        if refs:
            add(*base, "S2_passed_as_value", f"referenced by {sorted({s[0].rsplit('.', 1)[-1] for s in refs})[:5]}")
        if module_callers:
            add(*base, "S3_called_from_top_level", f"called at top level of {sorted({s[2] for s in module_callers})[:3]}")
        importers = {f for f in imported_by.get(qn, ()) if not ctx.is_test(f) and f not in reexport_hubs}
        not_called = sorted(f for f in importers if qn not in calls_from_file.get(f, set()))
        if not_called and not prod_callers:
            add(*base, "S4_imported_not_called", f"imported but not called by {not_called[:3]}")
        if not prod_callers and not module_callers and not refs:
            add(*base, "S6_no_production_caller", "called only by tests" if calls else "no inbound calls")
        # CBM's name-based resolution can invent callers, so a non-language
        # decorator keeps the symbol a candidate even when callers exist.
        app_decos = sorted({d for d in decorated.get(qn, []) if d not in lang_decorators})
        if app_decos:
            add(*base, "S5_decorated", f"decorators {app_decos}")

    by_name: dict = defaultdict(list)
    for qn, r in prod.items():
        by_name[r[1]].append(qn)

    # S11: named in a string ('Ctrl@method', 'ctrl#action', 'pkg.mod:function')
    string_ref = rules.rx("signals.string_ref_regex")
    scan_ext = set(rules.get("files.string_scan_ext"))
    for f in ctx.tracked:
        if ctx.is_test(f) or f.rsplit(".", 1)[-1].lower() not in scan_ext:
            continue
        for lineno, line in enumerate(ctx.lines(f), 1):
            if len(line) > ctx.max_line or not any(ch in line for ch in "@#:"):
                continue
            for m in string_ref.finditer(line):
                container, member = m.group(2), m.group(4)
                if member not in by_name:
                    continue
                key = re.split(r"[\\/.]", container)[-1].lower().replace("_", "")
                dotted = container.replace("/", ".").replace("\\", ".").lower()
                for qn in by_name[member]:
                    if key and (key in qn.lower().replace("_", "") or dotted in qn.lower()):
                        r = prod[qn]
                        add(qn, r[1], r[2], r[3], r[4], r[5], "S11_named_in_string", f"{f}:{lineno} {m.group(0)}")

    # S12: function values bound to names (CBM stores them as Variable nodes)
    func_value = rules.rx("signals.function_value_regex")
    var_in = {r[0] for r in q("MATCH (a)-[:CALLS|USAGE|CALL_REFERENCE]->(v:Variable) "
                              "RETURN DISTINCT v.qualified_name, a.file_path, a.label, v.file_path")
              if not ctx.is_test(r[1]) and not (r[2] in ("Module", "File") and r[1] == r[3])}
    for v_qn, v_name, v_file, v_line in q("MATCH (v:Variable) RETURN v.qualified_name, v.name, v.file_path, v.start_line"):
        if v_qn in var_in or not ctx.is_production_code(v_file):
            continue
        src = ctx.lines(v_file)
        ln = to_int(v_line)
        if not 0 < ln <= len(src):
            continue
        text = src[ln - 1]
        if re.search(r"\b" + re.escape(v_name) + r"\s*=", text) and func_value.search(text):
            end = ln
            while end < len(src) and end - ln < 400:  # body ends at next top-level line
                nxt = src[end]
                if nxt and not nxt[0].isspace():
                    if nxt.lstrip().startswith(("}", ")", "]")):
                        end += 1
                    break
                end += 1
            add(v_qn, v_name, "Function", v_file, ln, end, "S12_function_value", "function value bound to a name")

    # S13: modules nothing imports and that define no class
    class_files = {r[0] for r in q("MATCH (f:File)-[:DEFINES]->(c:Class) RETURN DISTINCT f.file_path, c.file_path")
                   if r[0] == r[1]}
    init_names = set(rules.get("files.package_init_names"))
    for m_qn, m_file in q("MATCH (m:Module) RETURN m.qualified_name, m.file_path"):
        if (not ctx.is_production_code(m_file) or m_file in imported_files or m_file in class_files
                or Path(norm(m_file)).stem in init_names):
            continue
        add(m_qn, "<module>", "Module", m_file, 1, 0, "S13_unimported_module", "no production file imports this module")

    # S7: top-level code calling in-repo production functions
    mod_targets: dict = defaultdict(set)
    for m_qn, m_file, t_qn in q("MATCH (m:Module)-[:CALLS]->(t:Function|Method) "
                                "RETURN m.qualified_name, m.file_path, t.qualified_name"):
        if t_qn in prod:
            mod_targets[(m_qn, m_file)].add(prod[t_qn][1])
    for (m_qn, m_file), names in sorted(mod_targets.items()):
        if ctx.is_production_code(m_file):
            add(m_qn, "<module>", "Module", m_file, 1, 0, "S7_top_level_program", f"top level calls {sorted(names)[:5]}")

    # S4c / S9: classes
    all_classes = q("MATCH (c:Class) RETURN c.qualified_name, c.name, c.file_path, c.start_line, c.end_line")
    class_rows = q("MATCH (a:File)-[:IMPORTS]->(c:Class) RETURN a.file_path, c.qualified_name, "
                   "c.name, c.file_path, c.start_line, c.end_line")
    folder_classes: dict = defaultdict(list)
    for row in all_classes:
        if row[2]:
            folder_classes[norm(row[2]).rsplit("/", 1)[0]].append(row)
    for imp_file, folder in q("MATCH (a:File)-[:IMPORTS]->(d:Folder) RETURN a.file_path, d.file_path"):
        for c_qn, c_name, c_file, c_s, c_e in folder_classes.get(norm(folder), []):
            class_rows.append([imp_file, c_qn, c_name, c_file, c_s, c_e])
    class_used = {r[0] for r in q("MATCH (a)-[:CALLS|INHERITS|IMPLEMENTS]->(c:Class) RETURN DISTINCT c.qualified_name")}
    for imp_file, c_qn, c_name, c_file, c_s, c_e in class_rows:
        if ctx.is_test(imp_file) or not ctx.is_production_code(c_file) or c_qn in class_used:
            continue
        add(c_qn, c_name, "Class", c_file, c_s, c_e, "S4c_imported_class_not_called", f"imported by {imp_file}")
    referenced = {r[1] for r in q("MATCH (a)-[:CALLS|USAGE|USES_TYPE|INHERITS|IMPLEMENTS|IMPORTS|CALL_REFERENCE]->(c:Class) "
                                  "RETURN DISTINCT a.file_path, c.qualified_name") if not ctx.is_test(r[0])}
    imported_classes = {r[1] for r in class_rows}
    for c_qn, c_name, c_file, c_s, c_e in all_classes:
        if not ctx.is_production_code(c_file) or c_qn in referenced or c_qn in imported_classes:
            continue
        add(c_qn, c_name, "Class", c_file, c_s, c_e, "S9_orphan_class", "no production code references this class")

    # S10: library public API
    for root in public_roots:
        root = norm(root)
        for x_qn, x_name, x_label, x_file, x_s, x_e in q(
                "MATCH (a:File)-[:IMPORTS]->(x:Function|Method|Class|Variable) WHERE a.file_path = "
                f"{cypher_str(root)} RETURN x.qualified_name, x.name, x.label, x.file_path, x.start_line, x.end_line"):
            if ctx.is_external(x_file):
                continue
            add(x_qn, x_name, x_label, x_file, x_s, x_e, "S10_public_api", f"exported by {root}")
            if x_label == "Class":
                for m_qn, m_name, m_file, m_s, m_e in q(
                        "MATCH (c:Class)-[:DEFINES_METHOD]->(m:Method) WHERE c.qualified_name = "
                        f"{cypher_str(x_qn)} RETURN m.qualified_name, m.name, m.file_path, m.start_line, m.end_line"):
                    if not m_name.startswith("_"):
                        add(m_qn, m_name, "Method", m_file, m_s, m_e, "S10_public_api", f"method of exported {x_name}")

    # S8: bootstrap-only files
    importer_qn: dict = {}
    for f, fq in q("MATCH (a:File)-[:IMPORTS]->() RETURN DISTINCT a.file_path, a.qualified_name"):
        importer_qn.setdefault(f, fq)
    for f, fq in sorted(importer_qn.items()):
        if ctx.is_production_code(f) and f not in imported_files and f not in defines_code:
            add(f"{fq}#file", "<file>", "File", f, 1, 0, "S8_bootstrap_file",
                "imports code, defines nothing, imported by no production file")

    graph = Graph(callables, prod, dict(decorated), dict(imports_of), imported_files, defines_code)
    for r in callables.values():
        graph.by_name.setdefault(r[1], []).append(r)
    return cands, graph

# --------------------------------------------------------------------------
# Plugin framework
#
# The core (graph signals, path matching, test-case model, flows, scenarios,
# report) is framework-agnostic. Every framework/tool specific behaviour is a
# Plugin subclass. A plugin:
#   - declares DEFAULTS (its data: regexes, file names, tables); a rules file can
#     override any key under "plugins": {"<name>": {...}}
#   - detect(env)        -> list of evidence strings; [] = plugin inactive
#   - entry_points(env)  -> adds candidates / triggers
#   - tests(env)         -> adds test files / cases / invocations
#   - link(env)          -> resolves invocations after all tests are known
#   - outbound(env)      -> records calls leaving a service (distributed flows)
# Each phase of each plugin runs isolated: an exception is recorded in the
# report (limitations) and the scan continues.
# --------------------------------------------------------------------------
CONF_HIGH, CONF_MEDIUM, CONF_LOW = "HIGH", "MEDIUM", "LOW"
_CONF_ORDER = {CONF_HIGH: 3, CONF_MEDIUM: 2, CONF_LOW: 1}


def best_conf(*values: str) -> str:
    vals = [v for v in values if v]
    return max(vals, key=lambda v: _CONF_ORDER[v]) if vals else CONF_LOW


def min_conf(*values: str) -> str:
    vals = [v for v in values if v]
    return min(vals, key=lambda v: _CONF_ORDER[v]) if vals else CONF_LOW


@dataclass
class Invocation:
    """One call a test makes into the system under test."""
    file: str
    line: int
    kind: str                 # http | ui | graphql | rpc | message | cli | call
    method: Optional[str]     # HTTP verb, UI, QUERY/MUTATION, RPC, TOPIC, CLI, CALL
    target: str               # path, operation name, Service/Method, topic, qualified name
    via: str = ""             # how it was resolved (literal, constant, helper, step, named-route...)
    confidence: str = CONF_HIGH
    explicit_method: bool = True
    mapped: list = field(default_factory=list)
    match: str = "none"


def is_strong(inv: "Invocation") -> bool:
    """Evidence that a test drives the system through an external interface: an HTTP call
    with an explicit method, UI navigation, GraphQL/RPC/CLI/contract call, a direct call of a
    library/CLI entry point, or anything resolved through helpers/steps/named routes."""
    if inv.via.startswith("direct handler call"):
        return inv.explicit_method      # handler invoked with collaborators mocked out is a unit test, not a functional one
    if inv.kind != "http":
        return True
    return inv.explicit_method or inv.via not in ("literal", "constant")


@dataclass
class TestCase:
    file: str
    name: str
    start: int
    end: int
    framework: str
    invocations: list = field(default_factory=list)
    statuses: set = field(default_factory=set)          # status codes asserted in this case
    used: list = field(default_factory=list)            # helper/step locations used (file:line)


@dataclass
class TestFile:
    file: str
    framework: str
    role: str = "test"         # test | step_definitions | support | data
    cases: list = field(default_factory=list)
    loose: list = field(default_factory=list)            # invocations outside any case (helpers)

    @property
    def functional(self) -> bool:
        return self.role == "test" and any(is_strong(i) for c in self.cases for i in c.invocations)


class Env:
    """Shared state for one repository scan."""

    def __init__(self, ctx: "RepoContext", cbm: "CBMClient", project: str, rules: "Rules"):
        self.ctx, self.cbm, self.project, self.rules = ctx, cbm, project, rules
        self.graph: Optional[Graph] = None
        self.cands: dict[str, Candidate] = {}
        self.test_files: dict[str, TestFile] = {}
        self.constants: dict[str, set] = defaultdict(set)    # name / Container.name -> values
        self.route_names: dict[str, list] = defaultdict(list)  # route name -> [(qn, trigger)]
        self.outbound: list[dict] = []                         # calls leaving a component
        self.plugin_log: list[dict] = []
        self.plugin_errors: list[dict] = []
        self.public_roots: list[str] = []
        self._by_file: Optional[dict] = None

    # ---- graph lookups -------------------------------------------------
    def callables_in(self, file: str) -> list[tuple]:
        """(qn, name, label, file, start, end) for callables in a file, sorted by start."""
        if self._by_file is None:
            idx: dict = defaultdict(list)
            for r in self.graph.callables.values():
                if r[3]:
                    idx[norm(r[3])].append((r[0], r[1], r[2], norm(r[3]), to_int(r[4]), to_int(r[5])))
            for v in idx.values():
                v.sort(key=lambda x: (x[4], x[0]))
            self._by_file = dict(idx)
        return self._by_file.get(norm(file), [])

    def callable_at(self, file: str, line: int, lookahead: int = 0) -> Optional[tuple]:
        """Innermost callable containing `line`, or one starting within `lookahead` lines below."""
        rows = self.callables_in(file)
        starting = [r for r in rows if line <= r[4] <= line + lookahead]
        if starting:
            return starting[0]
        containing = [r for r in rows if r[4] <= line <= r[5]]
        return min(containing, key=lambda r: r[5] - r[4]) if containing else None

    def bind_decorated(self, file: str, line: int, window: int = 8) -> Optional[tuple]:
        """Callable that an annotation/decorator on `line` (1-based) belongs to.
        CBM ranges may start at the first annotation, so a containing callable whose
        lines before `line` are only annotations/comments/blank counts too."""
        lines = self.ctx.lines(file)
        rx_head = re.compile(r"^\s*(@|\[|#\[|//|/\*|\*|#|$)")
        for r in sorted(self.callables_in(file), key=lambda r: -r[4]):
            if r[4] <= line <= r[5] and line - r[4] <= 12:
                if all(rx_head.match(lines[k - 1]) for k in range(r[4], line) if 0 < k <= len(lines)):
                    return r
        after = [r for r in self.callables_in(file) if line < r[4] <= line + window]
        if after:
            r = min(after, key=lambda r: r[4])
            between = lines[line:r[4] - 1]
            if all(rx_head.match(l) or not l.strip() or l.strip().endswith((",", "(", ")")) for l in between):
                return r
        return None

    def callables_named(self, name: str) -> list[tuple]:
        return [(r[0], r[1], r[2], norm(r[3]), to_int(r[4]), to_int(r[5]))
                for r in self.graph.by_name.get(name, [])]

    # ---- candidates ----------------------------------------------------
    def candidate(self, qn: str, name: str, label: str, file: str, start: int, end: int) -> Candidate:
        c = self.cands.get(qn)
        if c is None:
            c = self.cands[qn] = Candidate(qn, name, label, norm(file), to_int(start), to_int(end))
        return c

    def synthetic(self, file: str, line: int, name: str, label: str = "Function") -> Candidate:
        """Entry point declared by configuration/code that CBM has no node for."""
        return self.candidate(f"{norm(file)}:{line}#{name}", name, label, file, line, line)

    def register(self, c: Candidate, plugin: str, kind: str, evidence: str, trigger: Optional[dict] = None,
                 confidence: str = CONF_HIGH) -> None:
        c.signals.add(f"P_{plugin}")
        c.kinds.add(kind)
        c.evidence.append(evidence)
        c.plugin_conf = best_conf(c.plugin_conf, confidence)
        if trigger is not None:
            t = {"method": trigger.get("method"), "path": trigger["path"], "source": trigger.get("source", evidence),
                 "kind": trigger.get("kind", kind), "plugin": plugin}
            if trigger.get("name"):
                t["name"] = trigger["name"]
            if "_reg" in trigger:
                t["_reg"] = trigger["_reg"]
            c.triggers.append(t)

    def test_file(self, file: str, framework: str, role: str = "test") -> TestFile:
        tf = self.test_files.get(file)
        if tf is None:
            tf = self.test_files[file] = TestFile(file, framework, role)
        return tf


class Plugin:
    name = "base"
    summary = ""
    DEFAULTS: dict = {}

    def __init__(self, rules: "Rules"):
        override = (rules.data.get("plugins") or {}).get(self.name, {})
        self.cfg = {**self.DEFAULTS, **override}
        self._rx: dict = {}

    def rx(self, key: str, flags: int = 0) -> re.Pattern:
        k = (key, flags)
        if k not in self._rx:
            try:
                self._rx[k] = re.compile(self.cfg[key], flags)
            except (KeyError, re.error) as e:
                raise QScanError(f"plugin {self.name}: bad or missing regex '{key}': {e}", EXIT_USAGE) from e
        return self._rx[k]

    def detect(self, env: Env) -> list[str]:
        return []

    def entry_points(self, env: Env) -> None:
        return None

    def tests(self, env: Env) -> None:
        return None

    def link(self, env: Env) -> None:
        return None

    def outbound(self, env: Env) -> None:
        return None


PLUGINS: list = []


def plugin(cls):
    """Class decorator: register a plugin (order of registration = run order)."""
    PLUGINS.append(cls)
    return cls


def run_phase(env: Env, plugins: list, phase: str) -> None:
    for p in plugins:
        try:
            getattr(p, phase)(env)
        except QScanError:
            raise
        except Exception as e:  # isolation boundary: one plugin must not stop the scan
            log.warning("plugin %s failed in %s: %s", p.name, phase, e)
            log.debug("plugin failure", exc_info=True)
            env.plugin_errors.append({"plugin": p.name, "phase": phase, "error": f"{type(e).__name__}: {e}"})


def active_plugins(env: Env, rules: "Rules") -> list:
    disabled = set((rules.data.get("plugins") or {}).get("_disabled", []))
    out = []
    for cls in PLUGINS:
        if cls.name in disabled:
            continue
        p = cls(rules)
        try:
            evidence = p.detect(env)
        except QScanError:
            raise
        except Exception as e:  # isolation boundary
            env.plugin_errors.append({"plugin": p.name, "phase": "detect", "error": f"{type(e).__name__}: {e}"})
            continue
        if evidence:
            env.plugin_log.append({"plugin": p.name, "summary": p.summary, "evidence": sorted(evidence)[:5],
                                   "evidence_count": len(evidence)})
            out.append(p)
    return out


def grep_files(env: Env, rx: re.Pattern, files: Iterable[str], limit: int = 50) -> list[str]:
    """file:line of lines matching rx (bounded), used for detect() evidence."""
    hits = []
    for f in files:
        for i, line in enumerate(env.ctx.lines(f), 1):
            if len(line) <= env.ctx.max_line and rx.search(line):
                hits.append(f"{f}:{i}")
                if len(hits) >= limit:
                    return hits
                break
    return hits

# --------------------------------------------------------------------------
# Routing plugins (HTTP and UI). Generic registration patterns live in
# DEFAULT_RULES["routing"]; framework conventions are separate plugins.
# --------------------------------------------------------------------------
def openapi_operations(ctx: RepoContext) -> list[tuple[str, str, str, str]]:
    """(METHOD, path, operationId, where) from OpenAPI/Swagger documents."""
    detect = ctx.rules.rx("routing.openapi_detect_regex", re.M)
    verbs = {v.lower() for v in ctx.rules.get("routing.verbs")}
    ops = []
    for f in ctx.tracked:
        low = f.lower()
        if ctx.is_test(f) or not low.endswith((".yml", ".yaml", ".json")):
            continue
        lines = ctx.lines(f)
        text = "\n".join(lines)
        if not detect.search(text):
            continue
        if low.endswith(".json"):
            try:
                doc = json.loads(text)
            except json.JSONDecodeError:
                log.warning("OpenAPI document %s is not valid JSON; skipped", f)
                continue
            paths = doc.get("paths") if isinstance(doc, dict) else None
            for path, item in (paths or {}).items():
                for m, op in (item or {}).items():
                    if m in verbs and isinstance(op, dict) and op.get("operationId"):
                        ops.append((m.upper(), path, op["operationId"], f))
            continue
        in_paths, path, path_ind, method = False, None, None, None
        for i, line in enumerate(lines, 1):
            if not line.strip() or line.lstrip().startswith("#"):
                continue
            ind = len(line) - len(line.lstrip())
            if re.match(r"^paths:\s*$", line):
                in_paths, path = True, None
                continue
            if in_paths and ind == 0:
                in_paths = False
            if not in_paths:
                continue
            mp = re.match(r"""^\s*['"]?(/[^'":]*)['"]?:\s*$""", line)
            if mp and (path_ind is None or ind <= path_ind):
                path, path_ind, method = mp.group(1), ind, None
                continue
            mm = re.match(r"^\s*(\w+):\s*$", line)
            if mm and mm.group(1) in verbs and path and ind > (path_ind or 0):
                method = mm.group(1).upper()
                continue
            mo = re.match(r"""^\s*operationId:\s*['"]?([\w$]+)""", line)
            if mo and path and method:
                ops.append((method, path, mo.group(1), f"{f}:{i}"))
    return ops


def locate_definition(env: "Env", reg_file: str, name: str, obj: Optional[str]) -> Optional[Candidate]:
    """Find `name` defined in the module imported as `obj` (or in reg_file / its imports)
    when the graph has no node for it (exports.x = ..., const x = wrap(...), object members)."""
    rows = [r for r in env.callables_named(name) if env.ctx.is_production_code(r[3])]
    files: list[str] = []
    if obj:
        rx_imp = re.compile(r"\b(?:const|let|var|import)\s+\{?\s*(?:\*\s+as\s+)?" + re.escape(obj)
                            + r"\b[^;\n]*?(?:require\(\s*|from\s+)['\"](\.[^'\"]+)['\"]")
        for line in env.ctx.lines(reg_file):
            m = rx_imp.search(line)
            if m:
                tf = resolve_import(env.ctx, reg_file, m.group(1))
                if tf:
                    files.append(tf)
    else:
        files = [reg_file] + sorted(env.graph.imports_of.get(reg_file, ()))
    for r in rows:
        if r[3] in files:
            return env.candidate(*r)
    defs = [re.compile(p.replace("NAME", re.escape(name))) for p in env.rules.get("routing.definition_patterns")]
    for tf in files:
        lines = env.ctx.lines(tf)
        for i, line in enumerate(lines):
            if any(d.search(line) for d in defs):
                end = block_end(lines, i, "js" if not tf.endswith(".py") else "py")
                return env.candidate(f"{tf}:{i + 1}#{name}", name, "Function", tf, i + 1, end + 1)
    return None


def registration_args(window: str) -> list[str]:
    """Top-level arguments that follow the path literal of a registration call."""
    args, cur, depth, quote, i = [], "", 0, "", 0
    while i < len(window):
        ch = window[i]
        if quote:
            cur += ch
            if ch == "\\" and i + 1 < len(window):
                cur += window[i + 1]
                i += 1
            elif ch == quote:
                quote = ""
        elif ch in "'\"`":
            quote = ch
            cur += ch
        elif ch in "([{":
            depth += 1
            cur += ch
        elif ch in ")]}":
            if depth == 0:
                break
            depth -= 1
            cur += ch
        elif ch == "," and depth == 0:
            args.append(cur.strip())
            cur = ""
        else:
            cur += ch
        i += 1
    if cur.strip():
        args.append(cur.strip())
    return [a for a in args if a]


_INLINE = re.compile(r"^(?:async\s*)?(?:\(|function\b|[A-Za-z_$][\w$]*\s*=>|lambda\b|delegate\b|func\s*\(|fn\s*\(|\|)")


def resolve_handler_arg(env: "Env", f: str, i: int, raw: list[str], args: list[str], method: Optional[str], path: str,
                        pick: Callable, by_name: dict, rx_string_ref: re.Pattern, skip_ids: set) -> Optional[Candidate]:
    """The handler is the LAST positional argument (or view_func=/handler=); earlier ones are middleware."""
    kw = [a.split("=", 1)[1].strip() for a in args if re.match(r"^(?:view_func|handler|endpoint|action|to)\s*=(?!=)", a)]
    pos = [a for a in args if not re.match(r"^\w+\s*=(?![=>])", a)]
    arg = kw[0] if kw else (pos[-1] if pos else "")
    if not arg:
        return None
    for sm in rx_string_ref.finditer(arg):  # 'Controller@method', 'ctrl#action', 'pkg.mod:func'
        member, container = sm.group(4), sm.group(2)
        key = re.split(r"[\\/.]", container)[-1].lower().replace("_", "")
        opts = [c for c in by_name.get(member, []) if key and key in c.qn.lower().replace("_", "")]
        got = opts[0] if len(opts) == 1 else pick(member, f)
        if got:
            return got
    ma = re.search(r"\[\s*([\w\\]+)::class\s*,\s*['\"](\w+)['\"]\s*\]", arg)  # [Controller::class, 'method']
    if ma:
        return pick(ma.group(2), f) or locate_definition(env, f, ma.group(2), None)
    if _INLINE.match(arg) or "=>" in arg.split("(", 1)[0]:
        end = block_end(raw, i, "js")
        c = env.candidate(f"{f}:{i + 1}#inline", f"{method or 'ANY'} {path}", "Function", f, i + 1, end + 1)
        c.evidence.append("inline handler at the registration")
        return c
    if re.fullmatch(r"[\w$.:\\]+", arg):
        parts = re.split(r"\.|::", arg)
        name, obj = parts[-1], (parts[-2] if len(parts) > 1 else None)
        if name.lower() in skip_ids:
            return None
        return pick(name, f) or locate_definition(env, f, name, obj)
    # wrapped handler: catchAsync(fn), asyncHandler(ctrl.x), expressPlayground({...})
    inner = re.findall(r"([A-Za-z_$][\w$]*(?:\.[A-Za-z_$][\w$]*)?)\s*[,)]", arg)
    for ref in reversed(inner):
        parts = ref.split(".")
        got = pick(parts[-1], f) or locate_definition(env, f, parts[-1], parts[0] if len(parts) > 1 else None)
        if got:
            return got
    if path.startswith("/"):
        end = block_end(raw, i, "js")
        c = env.candidate(f"{f}:{i + 1}#inline", f"{method or 'ANY'} {path}", "Function", f, i + 1, end + 1)
        c.evidence.append("handler built by a call at the registration")
        return c
    return None


def bind_http_registrations(env: "Env") -> None:
    """Verb-call (app.get('/x', h)) and annotation (@GetMapping('/x')) registrations."""
    ctx, cands, graph = env.ctx, env.cands, env.graph
    rules = ctx.rules
    verbs = set(rules.get("routing.verbs"))
    rx_verb = rules.rx("routing.verb_call_regex", re.I)
    rx_annot = rules.rx("routing.annotation_regex", re.I)
    rx_class_prefix = rules.rx("routing.class_prefix_regex", re.I)
    rx_class_decl = rules.rx("routing.class_declaration_regex")
    rx_class_name = rules.rx("routing.class_name_regex")
    rx_methods_kw = rules.rx("routing.methods_keyword_regex", re.I)
    rx_string_ref = rules.rx("signals.string_ref_regex")
    ctrl_token = rules.get("routing.controller_token")
    skip_ids = set(rules.get("routing.binding_skip_identifiers"))

    by_name: dict = defaultdict(list)
    by_file: dict = defaultdict(list)
    for c in cands.values():
        by_name[c.name].append(c)
        by_file[c.file].append(c)

    def pick(name: str, reg_file: str) -> Optional[Candidate]:
        opts = by_name.get(name, [])
        if not opts:  # handler that no graph signal flagged yet: any production callable
            opts = [env.candidate(r[0], r[1], r[2], r[3], r[4], r[5]) for r in env.callables_named(name)
                    if ctx.is_production_code(r[3])]
        if len(opts) == 1:
            return opts[0]
        near = [c for c in opts if c.file == reg_file or c.file in graph.imports_of.get(reg_file, ())]
        return near[0] if len(near) == 1 else None

    funcs_by_file: dict = defaultdict(list)
    for r in graph.callables.values():
        if r[3]:
            funcs_by_file[norm(r[3])].append((to_int(r[4]), to_int(r[5]), r[1]))

    for f in ctx.tracked:
        if not ctx.is_production_code(f):
            continue
        raw = ctx.lines(f)
        if not raw:
            continue
        lines = [l + " " + raw[k + 1].strip() if l.rstrip().endswith("(") and k + 1 < len(raw) else l
                 for k, l in enumerate(raw)]
        joined = "\n".join(lines)
        if not (rx_verb.search(joined) or rx_annot.search(joined)):
            continue
        class_prefix = ""
        for i, line in enumerate(lines):
            if len(line) > ctx.max_line:
                continue
            mp = rx_class_prefix.search(line)
            decl = next((l for l in lines[i + 1:i + 5] if rx_class_decl.match(l)), None) if mp else None
            if mp and decl is not None:
                cname_m = rx_class_name.search(decl)
                cname = cname_m.group(1) if cname_m else ""
                short = re.sub(re.escape(ctrl_token["strip_suffix"]) + "$", "", cname).lower()
                class_prefix = mp.group(2).replace(ctrl_token["token"], short)
                continue
            ma = rx_annot.search(line)
            if ma:  # method-level annotation (a class-level one was handled above)
                verb = ma.group(1).upper().replace("HTTP", "")
                if verb == "REQUEST":
                    mk = rx_methods_kw.search(" ".join(lines[i:i + 3]))
                    verb = mk.group(1).upper() if mk else None
                row = env.bind_decorated(f, i + 1, 8)
                target = env.candidate(*row) if row else None
                if target and (verb in verbs or verb is None):
                    target.triggers.append({"method": verb, "path": join_path(class_prefix, ma.group(3) or ""),
                                            "source": f"{f}:{i + 1}"})
                continue
            mv = rx_verb.search(line)
            if mv:
                word = mv.group(1).upper()
                method = word.replace("MAP", "") if word.replace("MAP", "") in verbs else None
                if method is None:
                    mk = rx_methods_kw.search(" ".join(lines[i:i + 3]))
                    method = mk.group(1).upper() if mk else None
                window, depth, k = line[mv.end():], line.count("(") - line.count(")"), i + 1
                while depth > 0 and k < len(lines) and k < i + 6:
                    window += " " + lines[k]
                    depth += lines[k].count("(") - lines[k].count(")")
                    k += 1
                receiver = re.search(r"([\w$]+)\s*(?:\.|->|::)\s*" + re.escape(mv.group(1)) + r"\s*\(", line)
                decorator_style = line.lstrip().startswith("@")
                bound = None
                if decorator_style:
                    row = env.bind_decorated(f, i + 1, 8)
                    bound = env.candidate(*row) if row else None
                else:
                    bound = resolve_handler_arg(env, f, i, raw, registration_args(window), method, mv.group(3),
                                                pick, by_name, rx_string_ref, skip_ids)
                if bound is not None:
                    encl = next((n for a, b, n in sorted(funcs_by_file.get(f, []), reverse=True) if a <= i + 1 <= b), None)
                    bound.triggers.append({"method": method, "path": mv.group(3), "source": f"{f}:{i + 1}",
                                           "_reg": (f, encl, receiver.group(1) if receiver else None)})
                continue


def resolve_prefixes(ctx: RepoContext, cands: dict) -> None:
    """Apply router prefixes: same-file router prefix, then mount lines in other
    files that name the registering function or import the registering module."""
    rules = ctx.rules
    rx_same = rules.rx("routing.same_file_prefix_regex", re.I)
    rx_mount = rules.rx("routing.mount_literal_regex")
    rx_import = rules.rx("routing.import_binding_regex")
    rx_verb = rules.rx("routing.verb_call_regex", re.I)
    rx_def = rules.rx("routing.definition_line_regex")
    max_depth = int(rules.get("routing.mount_max_depth"))
    ident = re.compile(r"[A-Za-z_$][\w$]*")
    texts = {f: ctx.lines(f) for f in ctx.tracked if ctx.is_production_code(f)}

    same_prefix: dict = {}
    prefixes_by_file: dict = defaultdict(set)
    for f, lines in texts.items():
        for line in lines:
            for m in rx_same.finditer(line):
                same_prefix[(f, m.group(1))] = m.group(3)
                prefixes_by_file[f].add(m.group(3))

    aliases_cache: dict = {}

    def aliases_in(g: str, f: str) -> set:
        key = (g, f)
        if key not in aliases_cache:
            names = set()
            for line in texts.get(g, []):
                for m in rx_import.finditer(line):
                    name, spec = (m.group(1), m.group(2)) if m.group(1) else (m.group(3), m.group(4))
                    if name and spec and resolve_import(ctx, g, spec) == f:
                        names.add(name)
                    if m.group(5):
                        for n in (x.strip() for x in m.group(6).split(",")):
                            if n and f.endswith(f"{m.group(5).replace('.', '/')}/{n}.py"):
                                names.add(n)
            aliases_cache[key] = names
        return aliases_cache[key]

    def mounts_of(f: str, encl: Optional[str]) -> list[tuple[str, str]]:
        found = []
        for g, lines in texts.items():
            if g == f:
                continue
            aliases = aliases_in(g, f)
            if not encl and not aliases:
                continue
            for line in lines:
                # keyword-argument names (tags=..., prefix=...) are not references
                ids = set(ident.findall(re.sub(r"\b[\w$]+\s*=(?!=)", " ", line)))
                if not ((encl and encl in ids) or (aliases & ids)):
                    continue
                if rx_verb.search(line) or rx_def.match(line) or rx_import.search(line):
                    continue
                lit = rx_mount.search(line)
                if lit and lit.group(2) != "/":
                    found.append((lit.group(2), g))
        return found

    for c in cands.values():
        new = []
        for t in c.triggers:
            reg = t.pop("_reg", None)
            if not reg:
                if t.get("source") == "cbm_route" and len(prefixes_by_file.get(c.file, ())) == 1:
                    pre = next(iter(prefixes_by_file[c.file]))
                    if not norm_path(t["path"]).startswith(norm_path(pre)):
                        t = {**t, "path": join_path(pre, t["path"]), "source": "cbm_route+file_prefix"}
                new.append(t)
                continue
            f, encl, var = reg
            local = same_prefix.get((f, var), "") if var else ""
            chains, results = [(join_path(local, t["path"]), f, encl, 0)], []
            while chains:
                path, file_, e, depth = chains.pop()
                ms = mounts_of(file_, e) if depth < max_depth else []
                if not ms:
                    results.append(path)
                for prefix, g in ms:
                    chains.append((join_path(prefix, path), g, None, depth + 1))
            for pth in sorted(set(results)):
                new.append({**t, "path": pth})
        c.triggers = new


def _plural(word: str) -> str:
    if word.endswith("s"):
        return word
    return word[:-1] + "ies" if word.endswith("y") else word + "s"


def _rails(ctx: RepoContext, cfg: dict, plural: dict, singular: dict, attach: Callable) -> None:
    for f in ctx.tracked:
        if not f.endswith(cfg["routes_file_suffix"]):
            continue
        stack: list[tuple] = []
        for i, raw in enumerate(ctx.lines(f)):
            line = raw.split("#", 1)[0].rstrip()
            if not line.strip():
                continue
            opens = bool(re.search(r"\bdo\b(\s*\|[^|]*\|)?\s*$", line))
            if re.match(r"^\s*end\b", line):
                if stack:
                    stack.pop()
                continue
            prefix = "".join(e[1] for e in stack)
            m = re.match(r"^\s*(?:scope|namespace)\s+[:'\"]?(\w+)", line)
            if m:
                if opens:
                    stack.append(("scope", "/" + m.group(1)))
                continue
            m = re.match(r"^\s*(resources|resource)\s+:(\w+)(.*)$", line)
            if m:
                kind, name, rest = m.groups()
                is_singular = kind == "resource"
                pm = re.search(r"param:\s*:(\w+)", rest)
                param = "{" + (pm.group(1) if pm else "id") + "}"
                table = singular if is_singular else plural
                acts = [a for a in table if a != "store"]
                only = re.search(r"only:\s*\[([^\]]*)\]", rest)
                exc = re.search(r"except:\s*\[([^\]]*)\]", rest)
                if only:
                    acts = [a.strip(" :") for a in only.group(1).split(",")]
                if exc:
                    excluded = {a.strip(" :") for a in exc.group(1).split(",")}
                    acts = [a for a in acts if a not in excluded]
                ctrl = _plural(name) + cfg["controller_suffix"]
                cfile = next((t for t in ctx.tracked if t.endswith("/" + ctrl) and cfg["controllers_dir"] in t), None)
                if cfile:
                    for a in acts:
                        for verb, suf in table.get(a, []):
                            attach(cfile, a, verb, f"{prefix}/{name}" + suf.replace("{id}", param), f"{f}:{i + 1}")
                if opens:
                    stack.append(("res", f"/{name}" if is_singular else f"/{name}/{param}", name))
                continue
            m = re.match(r"^\s*(get|post|put|patch|delete)\s+[:'\"]([\w/]+)['\"]?(.*)$", line)
            if m:
                verb, pth, rest = m.group(1).upper(), m.group(2), m.group(3)
                to = re.search(r"to:\s*['\"](\w+)#(\w+)", rest)
                res = next((e for e in reversed(stack) if e[0] == "res"), None)
                if to:
                    ctrl, action = to.group(1), to.group(2)
                elif res:
                    ctrl, action = _plural(res[2]), pth.split("/")[-1]
                else:
                    continue
                cfile = next((t for t in ctx.tracked if t.endswith(f"/{ctrl}{cfg['controller_suffix']}")), None)
                base = prefix
                if res and "on: :collection" in rest:
                    base = "".join(e[1] for e in stack[:-1]) + f"/{res[2]}"
                if cfile:
                    attach(cfile, action, verb, f"{base}/{pth}", f"{f}:{i + 1}")
                continue
            if opens:
                stack.append(("block", ""))


def _laravel(ctx: RepoContext, cfg: dict, plural: dict, attach: Callable) -> None:
    table = dict(plural, create=[tuple(x) for x in cfg["resource_create_extra"]])
    for f in ctx.tracked:
        if not (f.endswith(".php") and cfg["routes_dir"] in f) or ctx.is_test(f):
            continue
        joined = "\n".join(ctx.lines(f))

        def controller_file(ctrl: str) -> Optional[str]:
            short = ctrl.split("\\")[-1]
            return next((t for t in ctx.tracked if t.endswith(f"/{short}.php") and cfg["controllers_dir_token"] in t), None)

        for m in re.finditer(r"Route::(resource|apiResource)\(\s*'([^']+)'\s*,\s*'([\w\\\\]+)'(.*?)\);", joined, re.S):
            kind, path, ctrl, rest = m.groups()
            acts = [a for a in plural if a not in ("store", "create", "edit")] + ["store"]
            if kind == "resource":
                acts += ["create", "edit"]
            only = re.search(r"'only'\s*=>\s*\[([^\]]*)\]", rest)
            exc = re.search(r"'except'\s*=>\s*\[([^\]]*)\]", rest)
            if only:
                acts = [a.strip(" '\"") for a in only.group(1).split(",")]
            if exc:
                excluded = {a.strip(" '\"") for a in exc.group(1).split(",")}
                acts = [a for a in acts if a not in excluded]
            cfile = controller_file(ctrl)
            line_no = joined[:m.start()].count("\n") + 1
            if cfile:
                for a in acts:
                    for verb, suf in table.get(a, []):
                        attach(cfile, a, verb, join_path(path) + suf, f"{f}:{line_no}")
        for m in re.finditer(r"Route::match\(\s*\[([^\]]*)\]\s*,\s*'([^']*)'\s*,\s*'([\w\\\\]+)@(\w+)'", joined):
            verbs, path, ctrl, action = m.groups()
            cfile = controller_file(ctrl)
            if cfile:
                for v in re.findall(r"\w+", verbs):
                    attach(cfile, action, v.upper(), join_path(path), f"{f}:{joined[:m.start()].count(chr(10)) + 1}")


def _inherited(ctx: RepoContext, cfg: dict, file: str, cls: str, start: int) -> set:
    """Actions a Django/DRF class gets from its base classes (when it does not define them)."""
    line = " ".join(ctx.lines(file)[max(0, start - 1):start + 15])
    m = re.search(r"class\s+" + re.escape(cls) + r"\s*\(([^)]*)\)", line)
    acts = set()
    for base in re.findall(r"[\w.]+", m.group(1)) if m else []:
        acts.update(cfg.get("viewset_actions", {}).get(base.split(".")[-1], []))
    return acts


def _django(ctx: RepoContext, cfg: dict, classes: dict, methods_by_file: dict, attach: Callable) -> None:
    rx_urls = re.compile(cfg["urls_file_regex"])
    rx_dj_import = re.compile(r"^\s*(?:from\s+django\.(?:urls|conf\.urls)\s+import|import\s+django\.urls)", re.M)
    url_files = [f for f in ctx.tracked if not ctx.is_test(f) and f.endswith(".py")
                 and (rx_urls.search(f) or (rx_dj_import.search("\n".join(ctx.lines(f)[:80]))
                                           and _DJ_CALL.search("\n".join(ctx.lines(f)))))]
    include_prefix: dict = defaultdict(list)
    for f in url_files:
        for line in ctx.lines(f):
            m = re.search(r"""(?:path|re_path|url)\(\s*r?['"]([^'"]*)['"]\s*,\s*include\(\s*['"]([\w.]+)['"]""", line)
            if m:
                target = "/" + m.group(2).replace(".", "/") + ".py"
                tf = next((t for t in ctx.tracked if ("/" + t).endswith(target)), None)
                if tf:
                    include_prefix[tf].append(m.group(1))

    def dj(p: str) -> str:
        p = re.sub(r"\(\?P<(\w+)>[^)]*\)", r"{\1}", p)
        p = re.sub(r"<(?:\w+:)?(\w+)>", r"{\1}", p)
        return p.replace("^", "").replace("$", "").replace("/?", "").replace("\\", "")

    def full(f: str, p: str) -> list[str]:
        pres = include_prefix.get(f) or [""]
        return [join_path(dj(pre), dj(p)) for pre in pres]

    actions = cfg["drf_router_actions"]
    view_methods = cfg["class_view_methods"]
    for f in url_files:
        joined = "\n".join(ctx.lines(f))
        for m in re.finditer(r"""\.register\(\s*r?['"]([^'"]+)['"]\s*,\s*(\w+)([^)]*)\)""", joined):
            prefix, cls, rest = m.groups()
            loc = next(iter(classes.get(cls, [])), None)
            if not loc:
                continue
            mb = re.search(r"""basename\s*=\s*['"]([\w.\-]+)['"]""", rest)
            base = mb.group(1) if mb else re.sub(r"viewset$|view$", "", cls.lower())
            src = f"{f}:{joined[:m.start()].count(chr(10)) + 1}"
            inherited = _inherited(ctx, cfg, loc[0], cls, loc[1])
            for action, (verb, suf) in actions.items():
                rn = f"{base}-{'list' if action in ('list', 'create') else 'detail'}"
                for pth in full(f, prefix):
                    if not attach(loc[0], action, verb, pth + suf, src, cls, rn) and action in inherited:
                        attach.attach_class(loc[0], cls, loc[1], loc[2], verb, pth + suf, src, rn)
            # @action(detail=..., methods=[...], url_path=..., url_name=...) extra routes
            clines = ctx.lines(loc[0])
            for k in range(loc[1] - 1, min(loc[2], len(clines))):
                ma = re.match(r"""\s*@action\((.*)""", clines[k])
                if not ma:
                    continue
                args = " ".join(clines[k:k + 4])
                md = re.search(r"\bdef\s+(\w+)", " ".join(clines[k:k + 6]))
                if not md:
                    continue
                meth = md.group(1)
                detail = re.search(r"detail\s*=\s*True", args) is not None
                verbs = re.findall(r"""['"](get|post|put|patch|delete)['"]""", args.lower()) or ["get"]
                up = re.search(r"""url_path\s*=\s*['"]([^'"]+)['"]""", args)
                un = re.search(r"""url_name\s*=\s*['"]([^'"]+)['"]""", args)
                seg = up.group(1) if up else meth
                for pth in full(f, prefix):
                    for v in verbs:
                        attach(loc[0], meth, v.upper(), join_path(pth, "{pk}" if detail else "", seg), src, cls,
                               f"{base}-{un.group(1) if un else meth.replace('_', '-')}")
        for pth, name, is_cbv, line_no in _django_url_calls(joined, ctx.lines(f)):
            for full_p in full(f, pth):
                if is_cbv:
                    loc = next(iter(classes.get(name, [])), None)
                    if loc:
                        hit = False
                        for meth, verb in view_methods.items():
                            hit = attach(loc[0], meth, verb, full_p, f"{f}:{line_no}", name) or hit
                        if not hit:
                            for meth in sorted(_inherited(ctx, cfg, loc[0], name, loc[1])):
                                if meth in view_methods:
                                    attach.attach_class(loc[0], name, loc[1], loc[2], view_methods[meth], full_p,
                                                        f"{f}:{line_no}", None)
                else:
                    for fp, ms in methods_by_file.items():
                        if fp.endswith(cfg["views_file"]) and any(n == name for n, *_ in ms):
                            attach(fp, name, None, full_p, f"{f}:{line_no}")


_DJ_CALL = re.compile(r"""(?<![\w.])(?:path|re_path|url)\(\s*r?['"]([^'"]*)['"]\s*,""")
_CLASS_ATTR_STR = re.compile(r"""['"]([A-Za-z_]\w*)['"]\s*\)?\s*$""")


def _balanced_arg(text: str, start: int) -> str:
    """Text from `start` up to the comma/paren that closes the current argument."""
    depth, i = 0, start
    while i < len(text):
        ch = text[i]
        if ch in "([{":
            depth += 1
        elif ch in ")]}":
            if depth == 0:
                break
            depth -= 1
        elif ch == "," and depth == 0:
            break
        i += 1
    return text[start:i]


def _class_attr_class(lines: list[str], attr: str) -> Optional[str]:
    """`summary_view = get_class('basket.views', 'BasketView')` / `view_class = BasketView` /
    `@property def summary_view(self): return get_class(...)` -> the class name."""
    text = "\n".join(lines)
    m = re.search(r"^\s*(?:self\.|cls\.)?" + re.escape(attr) + r"\s*=\s*(.+)$", text, re.M)
    if not m:
        m = re.search(r"def\s+" + re.escape(attr) + r"\s*\(self\)[^:]*:\s*(?:\n\s*)*(?:\"\"\"[\s\S]*?\"\"\"\s*)?return\s+(.+)$", text, re.M)
    if not m:
        return None
    rhs = m.group(1).strip()
    ms = _CLASS_ATTR_STR.search(rhs)
    if ms:
        return ms.group(1)
    mi = re.match(r"^([A-Za-z_]\w*)\s*$", rhs)
    return mi.group(1) if mi else None


def _django_url_calls(joined: str, lines: list[str]) -> list[tuple]:
    """(route, handler name, is_class_based, line) for each path()/re_path()/url() call whose
    handler is a view function, `View.as_view()`, a wrapped view (login_required(View.as_view())),
    or an attribute of the enclosing class (`self.summary_view.as_view()`)."""
    out = []
    for m in _DJ_CALL.finditer(joined):
        arg = _balanced_arg(joined, m.end()).strip()
        if arg.startswith("include("):
            continue
        line_no = joined[:m.start()].count("\n") + 1
        mv = re.search(r"([\w.]+?)\.as_view\(", arg)
        if mv:
            ref = mv.group(1)
            name = ref.split(".")[-1]
            if ref.startswith(("self.", "cls.")):     # attribute of the enclosing class holding the view class
                name = _class_attr_class(lines, name) or name
            out.append((m.group(1), name, True, line_no))
            continue
        mf = re.match(r"^([\w.]+)\s*$", arg)
        if mf:
            ref = mf.group(1)
            out.append((m.group(1), ref.split(".")[-1], False, line_no))
            continue
        for inner in reversed(re.findall(r"([A-Za-z_][\w.]*)\s*[,)]", arg)):
            out.append((m.group(1), inner.split(".")[-1], False, line_no))
            break
    return out


def _razor(ctx: RepoContext, cfg: dict, methods_by_file: dict, attach: Callable) -> None:
    rx_handler = re.compile(cfg["handler_regex"])
    rx_area = re.compile(cfg["areas_regex"])
    rx_directive = re.compile(cfg["page_directive_regex"])
    token, suffix = cfg["pages_dir_token"], cfg["page_suffix"]
    for f in ctx.tracked:
        if not f.endswith(suffix) or token not in f or ctx.is_test(f):
            continue
        rel = f.split(token, 1)[1][: -len(suffix)]
        area = rx_area.search(f)
        route = join_path(*(([area.group(1)] if area else []) + rel.split("/")))
        route = re.sub(r"(^|/)Index$", "", route) or "/"
        page = f[: -len(".cs")]
        directive = rx_directive.search("\n".join(ctx.lines(page))) if page in ctx.tracked_set else None
        if directive:
            d = directive.group(1)
            route = d if d.startswith("/") else join_path(route, d)
        for n, _qn, _label, _a, _b in methods_by_file.get(f, []):
            m = rx_handler.match(n)
            if m:
                attach(f, n, m.group(1).upper(), route, f"razor page {f}")


def _file_routes(env: "Env", cfg: dict) -> None:
    ctx, cands = env.ctx, env.cands
    rx_dir = re.compile(cfg["dir_regex"])
    files = [f for f in ctx.tracked if rx_dir.search(f) and not ctx.is_test(f)
             and f.rsplit(".", 1)[-1] in cfg["extensions"] and not f.endswith(".d.ts") and not ctx.is_generated(f)]
    if len(files) < int(cfg["min_files"]):
        return
    by_file: dict = defaultdict(list)
    for c in cands.values():
        by_file[c.file].append(c)
    for f in files:
        rel = rx_dir.split(f, maxsplit=1)[1]
        segs = [s for s in rel.rsplit(".", 1)[0].split("/")
                if not s.startswith(tuple(cfg["ignored_segment_prefixes"])) and s not in cfg["ignored_segments"]]
        segs = ["{" + s.strip("[]$").lstrip(".") + "}" if s.startswith(tuple(cfg["param_prefixes"])) else s for s in segs]
        target = (next((c for c in by_file.get(f, []) if c.label in ("Module", "File")), None)
                  or next(iter(sorted(by_file.get(f, []), key=lambda c: c.start)), None))
        if target is None:
            target = env.candidate(f"{f}#ui", Path(f).stem, "Module", f, 1, 0)
        target.signals.add("S14_convention_route")
        env.register(target, "file_routes", "ui_route", f"file-based route {f}",
                     {"method": "UI", "path": join_path(*segs), "source": f"file-based route {f}", "kind": "ui"})


def dedupe_triggers(cands: dict[str, Candidate]) -> None:
    """Drop a route only when another route of the same handler and method is the same
    path with extra leading segments (CBM Route nodes can lose class/router prefixes).
    Distinct paths served by one handler are all kept."""
    for c in cands.values():
        if len(c.triggers) < 2:
            continue
        uniq: dict = {}
        for t in c.triggers:
            key = (t.get("kind", "http"), t["method"], norm_path(t["path"]))
            if key not in uniq or (uniq[key].get("source", "").startswith("cbm_route") and not t.get("source", "").startswith("cbm_route")):
                uniq[key] = t
        kept = list(uniq.values())

        def covered_by(t: dict, other: dict) -> bool:
            a, b = norm_path(t["path"]), norm_path(other["path"])
            same_kind = t.get("kind", "http") == other.get("kind", "http")
            return same_kind and a != b and b.endswith(a if a != "/" else "/") and (t["method"] in (None, other["method"])) \
                and len([x for x in b.split("/") if x]) > len([x for x in a.split("/") if x])

        out = [t for t in kept if not any(covered_by(t, o) for o in kept if o is not t)]
        specific = {norm_path(t["path"]) for t in out if t["method"]}
        has_method = bool(specific)
        # A method-less CBM route next to a method-specific registration of the
        # same handler is CBM failing to read the method, not a second route.
        out = [t for t in out if t["method"] or not (
            norm_path(t["path"]) in specific or (has_method and t.get("source", "").startswith("cbm_route")))]
        c.triggers = sorted(out, key=lambda t: (t["method"] is None, t["method"] or "", t["path"]))


def apply_context_paths(env: "Env") -> None:
    """Servlet context path / path base configured per module (server.servlet.context-path,
    server.context-path, UsePathBase) prefixes every route of that module."""
    rx_ctx = env.rules.rx("routing.context_path_regex", re.M)
    rx_name = env.rules.rx("routing.app_name_regex", re.M)
    modules: dict = {}
    names: dict = {}
    for f in env.ctx.tracked:
        if env.ctx.is_test(f) or not f.endswith((".yml", ".yaml", ".properties", ".cs")):
            continue
        text = "\n".join(env.ctx.lines(f))
        root = f.split("/src/")[0] if "/src/" in f else str(Path(f).parent).replace("\\", "/")
        mn = rx_name.search(text) if not f.endswith(".cs") else None
        if mn and "/src/main/" in f:
            names[mn.group(1).strip()] = root
        m = rx_ctx.search(text)
        if m:
            modules.setdefault(f, (root, (m.group(1) or m.group(2) or m.group(3) or "").strip().strip("'\"")))
    if not modules:
        return
    prefix_of: dict = {}
    for f, (root, path) in modules.items():
        stem = Path(f).stem.replace("application-", "").replace("bootstrap-", "")
        target = names.get(stem) or (root if "/src/main/" in f or f.endswith(".cs") else None)
        if target is not None and path and path != "/":
            prefix_of[target] = path
    for c in env.cands.values():
        root = next((r for r in sorted(prefix_of, key=len, reverse=True) if c.file.startswith(r + "/") or r in ("", ".")), None)
        if root is None:
            continue
        pre = prefix_of[root]
        for t in c.triggers:
            if t.get("kind", "http") == "http" and t.get("plugin") in (None, "http_registrations", "cbm_routes") \
                    and not norm_path(t["path"]).startswith(norm_path(pre)):
                t.setdefault("aliases", []).append(t["path"])  # in-process tests omit the context path
                t["path"] = join_path(pre, t["path"])
                t["source"] = f"{t.get('source', '')} + context path {pre}"


def _convention_attach(env: "Env", plugin_name: str) -> Callable:
    """attach(file, method_name, verb, path, source, class_name=None) for convention plugins."""
    graph = env.graph
    methods_by_file: dict = defaultdict(list)
    for r in graph.prod.values():
        methods_by_file[norm(r[3])].append((r[1], r[0], r[2], to_int(r[4]), to_int(r[5])))
    classes: dict = defaultdict(list)
    for name, fp, a, b in graph.classes:
        classes[name].append((fp, a, b))

    def attach(file: str, name: str, method: Optional[str], path: str, src: str, cls: Optional[str] = None,
               route_name: Optional[str] = None) -> bool:
        rng = next(((a, b) for f_, a, b in classes.get(cls, []) if f_ == file), None) if cls else None
        for n, qn, label, a, b in methods_by_file.get(file, []):
            if n != name or (rng and not rng[0] <= a <= rng[1]):
                continue
            c = env.candidate(qn, n, label, file, a, b)
            c.signals.add("S14_convention_route")
            env.register(c, plugin_name, "http", f"convention route {method or 'ANY'} {path} ({src})",
                         {"method": method, "path": path, "source": src, "kind": "http", "name": route_name})
            return True
        return False

    def attach_class(file: str, cls: str, a: int, b: int, method: Optional[str], path: str, src: str,
                     route_name: Optional[str]) -> None:
        c = env.candidate(f"{file}#{cls}", cls, "Class", file, a, b)
        c.signals.add("S14_convention_route")
        env.register(c, plugin_name, "http", f"convention route {method or 'ANY'} {path} ({src}; inherited handler)",
                     {"method": method, "path": path, "source": src, "kind": "http", "name": route_name})

    attach.classes = classes
    attach.methods_by_file = methods_by_file
    attach.attach_class = attach_class
    return attach



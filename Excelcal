"""Harness certification for xl_engine.py against test_wb.xlsx (9 checks)."""
import json, sys
sys.path.insert(0, "scripts")
from xl_engine import inventory, build_graph, blast_radius, snapshot, diff

WB = "test_wb.xlsx"
results = []
def check(name, cond, detail=""):
    results.append((name, bool(cond), detail))

rep, m = inventory(WB)
report, model, precedents, dependents = build_graph(WB)

# 1. Sheet enumeration
check("sheet enumeration", [s["name"] for s in rep["sheets"]] == ["Assumptions", "Calc"])

# 2. Defined name resolution
check("defined name TaxRate", rep["defined_names"].get("TaxRate") == "Assumptions!$B$1")

# 3. Shared formula expansion with relative-ref translation
a3 = model["cells"]["Calc"]["A3"]["formula"]
a4 = model["cells"]["Calc"]["A4"]["formula"]
check("shared formula expansion", a3 == "A2*TaxRate" and a4 == "A3*TaxRate",
      f"A3={a3!r} A4={a4!r}")

# 4. Cross-sheet edge: Calc!A1 <- Assumptions!B2
check("cross-sheet edge", "Assumptions!B2" in precedents.get("Calc!A1", set()),
      str(precedents.get("Calc!A1")))

# 5. Named-range edge resolves through to Assumptions!B1
check("named range edge", "Assumptions!B1" in precedents.get("Calc!A2", set()),
      str(precedents.get("Calc!A2")))

# 6. Volatile detection
check("volatile detection", rep["nondeterministic_cells"] == ["Calc!C1"],
      str(rep["nondeterministic_cells"]))

# 7. String-literal trap: no edge to Sheet3!Z9 from Calc!D1
d1 = precedents.get("Calc!D1", set())
check("string-literal trap", not any("Sheet3" in p for p in d1), str(d1))

# 8. Blast radius: change Assumptions!B2 -> A1, A2, A3, A4, B1 on Calc (5 cells)
hit = blast_radius(dependents, ["Assumptions!B2"])
expect = {"Calc!A1", "Calc!A2", "Calc!A3", "Calc!A4", "Calc!B1", "Calc!D1"}
check("blast radius transitive", hit == expect, str(sorted(hit)))

# 9. Diff gate: perturb one value beyond tolerance, exclude volatile
base = snapshot(WB)
mod = json.loads(json.dumps(base))
mod["Calc!A1"]["v"] = "200.001"          # real change
mod["Calc!C1"]["v"] = "45999.9"          # volatile churn -> must be excluded
changes = diff(base, mod, exclude=("Calc!C1",))
check("diff gate + volatile exclusion",
      len(changes) == 1 and changes[0]["cell"] == "Calc!A1"
      and changes[0]["kind"] == "value", str(changes))

passed = sum(1 for _, ok, _ in results if ok)
for name, ok, detail in results:
    print(f"{'PASS' if ok else 'FAIL'}  {name}" + (f"   [{detail}]" if not ok else ""))
print(f"\n{passed}/{len(results)} certification checks passed")
sys.exit(0 if passed == len(results) else 1)

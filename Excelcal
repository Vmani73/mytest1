## Appendix A — `scripts/xl_engine.py` (live-verified, 9/9)

```python
#!/usr/bin/env python3
"""xl_engine.py — stdlib-only Excel calculation-engine analyzer.

Subcommands:
  inventory <wb>                       Workbook census (sheets, names, VBA, externals, volatiles, calc settings)
  graph     <wb> [--out graph.json]    Build full cell-level dependency graph
  blast     <wb> <Sheet!Cell> [...]    Transitive dependents (blast radius) of one or more cells
  snapshot  <wb> [--out snap.json]     Dump cached values+formulas (STALE-RISK: baseline must come from COM recalc)
  diff      <a.json> <b.json>          Compare two snapshots with tolerance + volatile exclusion

Zero dependencies. Python 3.8+. Reads .xlsx and .xlsm (ignores vbaProject.bin content; reports its presence).
"""
import sys, json, re, zipfile, argparse, math
import xml.etree.ElementTree as ET

NS = "{http://schemas.openxmlformats.org/spreadsheetml/2006/main}"
R_NS = "{http://schemas.openxmlformats.org/officeDocument/2006/relationships}"
PKG_REL_NS = "{http://schemas.openxmlformats.org/package/2006/relationships}"

NONDETERMINISTIC = {"NOW", "TODAY", "RAND", "RANDBETWEEN", "RANDARRAY"}
OPAQUE_REF_FUNCS = {"INDIRECT", "OFFSET"}  # references not statically resolvable
RANGE_EXPANSION_CAP = 10000  # cells; beyond this a single range-node is used

# ---------------------------------------------------------------- utilities
def col_to_idx(col):
    n = 0
    for ch in col:
        n = n * 26 + (ord(ch) - 64)
    return n

def idx_to_col(n):
    s = ""
    while n:
        n, r = divmod(n - 1, 26)
        s = chr(65 + r) + s
    return s

def split_ref(ref):
    """'$B$12' -> (colAbs, 'B', rowAbs, 12)"""
    m = re.fullmatch(r"(\$?)([A-Z]{1,3})(\$?)(\d{1,7})", ref)
    return (m.group(1) == "$", m.group(2), m.group(3) == "$", int(m.group(4)))

STRING_LIT = re.compile(r'"(?:[^"]|"")*"')
# sheet-qualified or bare cell/range ref; suffix guards reject function names like LOG10(
CELL_REF = re.compile(
    r"(?:((?:'(?:[^']|'')+')|[A-Za-z_\u00A1-\uFFFF][\w.\u00A1-\uFFFF]*)!)?"
    r"(\$?[A-Z]{1,3}\$?\d{1,7}(?::\$?[A-Z]{1,3}\$?\d{1,7})?)"
    r"(?![\w(:])"
)
IDENT = re.compile(r"(?<![\w.!'])([A-Za-z_\\][\w.\\]*)(?!\s*\()(?![\w.!])")
FUNC = re.compile(r"([A-Za-z_][\w.]*)\s*\(")

def strip_strings(formula):
    return STRING_LIT.sub('""', formula)

def norm_sheet(s):
    if s and s.startswith("'"):
        return s[1:-1].replace("''", "'")
    return s

# ---------------------------------------------------------------- load
def load_workbook(path):
    z = zipfile.ZipFile(path)
    names = set(z.namelist())
    wb_xml = ET.fromstring(z.read("xl/workbook.xml"))
    rels = ET.fromstring(z.read("xl/_rels/workbook.xml.rels"))
    rel_map = {r.get("Id"): r.get("Target") for r in rels.iter(f"{PKG_REL_NS}Relationship")}
    sheets = []
    for sh in wb_xml.iter(f"{NS}sheet"):
        target = rel_map.get(sh.get(f"{R_NS}id"), "")
        if not target.startswith("/"):
            target = "xl/" + target
        else:
            target = target.lstrip("/")
        sheets.append({"name": sh.get("name"), "path": target,
                       "state": sh.get("state", "visible")})
    defined = {}
    for dn in wb_xml.iter(f"{NS}definedName"):
        if dn.text:
            defined[dn.get("name")] = dn.text.strip()
    calc = wb_xml.find(f"{NS}calcPr")
    calc_pr = dict(calc.attrib) if calc is not None else {}
    return z, names, sheets, defined, calc_pr

def iter_cells(z, sheet_path):
    """Yield (ref, formula_elem_attrs, formula_text, cached_value, cell_type)."""
    root = ET.fromstring(z.read(sheet_path))
    for c in root.iter(f"{NS}c"):
        f = c.find(f"{NS}f")
        v = c.find(f"{NS}v")
        yield (c.get("r"),
               dict(f.attrib) if f is not None else None,
               (f.text or "") if f is not None else None,
               v.text if v is not None else None,
               c.get("t", "n"))

# ------------------------------------------------- shared formula expansion
def translate_formula(formula, drow, dcol):
    """Shift relative refs in a shared-formula master by (drow, dcol)."""
    stripped_positions = []
    def _shift(m):
        sheet, ref = m.group(1), m.group(2)
        parts = ref.split(":")
        out = []
        for p in parts:
            ca, col, ra, row = split_ref(p)
            ncol = col if ca else idx_to_col(col_to_idx(col) + dcol)
            nrow = row if ra else row + drow
            out.append(f"{'$' if ca else ''}{ncol}{'$' if ra else ''}{nrow}")
        pref = (m.group(1) + "!") if m.group(1) else ""
        return pref + ":".join(out)
    # protect string literals, shift, restore
    lits = []
    def _stash(m):
        lits.append(m.group(0))
        return f"\x00{len(lits)-1}\x00"
    tmp = STRING_LIT.sub(_stash, formula)
    tmp = CELL_REF.sub(_shift, tmp)
    return re.sub(r"\x00(\d+)\x00", lambda m: lits[int(m.group(1))], tmp)

def expand_shared(cells_by_sheet):
    """cells_by_sheet: {sheet: {ref: cell_dict}} — fill in slave shared formulas."""
    for sheet, cells in cells_by_sheet.items():
        masters = {}
        for ref, c in cells.items():
            fa = c.get("f_attrs")
            if fa and fa.get("t") == "shared" and c.get("formula"):
                masters[fa.get("si")] = (ref, c["formula"])
        for ref, c in cells.items():
            fa = c.get("f_attrs")
            if fa and fa.get("t") == "shared" and not c.get("formula"):
                si = fa.get("si")
                if si in masters:
                    mref, mformula = masters[si]
                    _, mc, _, mr = split_ref(mref)
                    _, cc, _, cr = split_ref(ref)
                    c["formula"] = translate_formula(
                        mformula, cr - mr, col_to_idx(cc) - col_to_idx(mc))
                    c["shared_expanded"] = True

# ---------------------------------------------------------------- inventory
def build_model(path):
    z, names, sheets, defined, calc_pr = load_workbook(path)
    cells_by_sheet = {}
    for sh in sheets:
        cells = {}
        for ref, f_attrs, formula, value, ctype in iter_cells(z, sh["path"]):
            cells[ref] = {"f_attrs": f_attrs, "formula": formula,
                          "value": value, "type": ctype}
        cells_by_sheet[sh["name"]] = cells
    expand_shared(cells_by_sheet)
    return {"zip_names": names, "sheets": sheets, "defined": defined,
            "calc_pr": calc_pr, "cells": cells_by_sheet}

def inventory(path):
    m = build_model(path)
    vol, opaque, ext = [], [], []
    n_formulas = n_shared = n_array = 0
    for sheet, cells in m["cells"].items():
        for ref, c in cells.items():
            f = c.get("formula")
            if not f:
                continue
            n_formulas += 1
            fa = c.get("f_attrs") or {}
            if fa.get("t") == "shared":
                n_shared += 1
            if fa.get("t") == "array":
                n_array += 1
            funcs = set(x.upper() for x in FUNC.findall(strip_strings(f)))
            if funcs & NONDETERMINISTIC:
                vol.append(f"{sheet}!{ref}")
            if funcs & OPAQUE_REF_FUNCS:
                opaque.append(f"{sheet}!{ref}")
            if "[" in strip_strings(f) and re.search(r"\[\d+\]", f):
                ext.append(f"{sheet}!{ref}")
    report = {
        "sheets": [{"name": s["name"], "state": s["state"]} for s in m["sheets"]],
        "defined_names": m["defined"],
        "vba_present": "xl/vbaProject.bin" in m["zip_names"],
        "external_links": sorted(n for n in m["zip_names"]
                                 if n.startswith("xl/externalLinks/")),
        "external_ref_cells": ext,
        "calc_settings": m["calc_pr"],
        "iterative_calc": m["calc_pr"].get("iterate") == "1",
        "formula_cells": n_formulas,
        "shared_formula_cells": n_shared,
        "array_formula_cells": n_array,
        "nondeterministic_cells": vol,
        "opaque_ref_cells (INDIRECT/OFFSET — graph blind spots)": opaque,
    }
    return report, m

# ---------------------------------------------------------------- graph
def refs_in_formula(formula, defined, sheets, current_sheet):
    """Return set of precedent node ids ('Sheet!A1' or 'Sheet!A1:B9' or 'NAME')."""
    sheet_names = {s["name"] for s in sheets}
    clean = strip_strings(formula)
    out = set()
    spans = []
    for mm in CELL_REF.finditer(clean):
        spans.append(mm.span())
        sheet = norm_sheet(mm.group(1)) or current_sheet
        if mm.group(1) and norm_sheet(mm.group(1)) not in sheet_names:
            out.add(f"EXTERNAL::{norm_sheet(mm.group(1))}!{mm.group(2)}")
            continue
        out.add(f"{sheet}!{mm.group(2).replace('$', '')}")
    for mm in IDENT.finditer(clean):
        if any(a <= mm.start(1) < b for a, b in spans):
            continue
        name = mm.group(1)
        if name.upper() in ("TRUE", "FALSE"):
            continue
        if name in defined:
            out.add(f"NAME::{name}")
    return out

def expand_node(node, defined, sheets, depth=0):
    """Expand range-nodes/named-range-nodes to individual cell ids (capped)."""
    if node.startswith("NAME::") and depth < 4:
        target = defined.get(node[6:], "")
        cells = set()
        clean = strip_strings(target)
        for mm in CELL_REF.finditer(clean):
            sheet = norm_sheet(mm.group(1)) or ""
            cells |= expand_node(f"{sheet}!{mm.group(2).replace('$','')}",
                                 defined, sheets, depth + 1)
        return cells or {node}
    if "!" in node and ":" in node:
        sheet, rng = node.split("!", 1)
        a, b = rng.split(":")
        _, c1, _, r1 = split_ref(a)
        _, c2, _, r2 = split_ref(b)
        ci1, ci2 = sorted((col_to_idx(c1), col_to_idx(c2)))
        r1, r2 = sorted((r1, r2))
        if (ci2 - ci1 + 1) * (r2 - r1 + 1) > RANGE_EXPANSION_CAP:
            return {node}  # keep as a range-node
        return {f"{sheet}!{idx_to_col(c)}{r}"
                for c in range(ci1, ci2 + 1) for r in range(r1, r2 + 1)}
    return {node}

def build_graph(path):
    report, m = inventory(path)
    precedents = {}   # node -> set of precedent nodes (expanded to cells)
    for sheet, cells in m["cells"].items():
        for ref, c in cells.items():
            if not c.get("formula"):
                continue
            node = f"{sheet}!{ref}"
            precs = set()
            for p in refs_in_formula(c["formula"], m["defined"], m["sheets"], sheet):
                precs |= expand_node(p, m["defined"], m["sheets"])
            precedents[node] = precs
    dependents = {}
    for node, precs in precedents.items():
        for p in precs:
            dependents.setdefault(p, set()).add(node)
    return report, m, precedents, dependents

def blast_radius(dependents, seeds):
    seen, frontier = set(), list(seeds)
    while frontier:
        n = frontier.pop()
        for d in dependents.get(n, ()):
            if d not in seen:
                seen.add(d)
                frontier.append(d)
    return seen

# ---------------------------------------------------------------- snapshot/diff
def snapshot(path):
    _, m = inventory(path)
    snap = {}
    for sheet, cells in m["cells"].items():
        for ref, c in cells.items():
            if c.get("formula") is None and c.get("value") is None:
                continue
            snap[f"{sheet}!{ref}"] = {"f": c.get("formula"),
                                      "v": c.get("value"), "t": c.get("type")}
    return snap

def _num(x):
    try:
        return float(x)
    except (TypeError, ValueError):
        return None

def diff(a, b, rel_tol=1e-9, abs_tol=1e-12, exclude=()):
    changes = []
    keys = set(a) | set(b)
    for k in sorted(keys):
        if any(k == e or k.startswith(e) for e in exclude):
            continue
        ca, cb = a.get(k), b.get(k)
        if ca is None or cb is None:
            changes.append({"cell": k, "kind": "added" if ca is None else "removed"})
            continue
        if (ca.get("f") or "") != (cb.get("f") or ""):
            changes.append({"cell": k, "kind": "formula",
                            "before": ca.get("f"), "after": cb.get("f")})
        na, nb = _num(ca.get("v")), _num(cb.get("v"))
        if na is not None and nb is not None:
            if not math.isclose(na, nb, rel_tol=rel_tol, abs_tol=abs_tol):
                changes.append({"cell": k, "kind": "value",
                                "before": ca.get("v"), "after": cb.get("v")})
        elif (ca.get("v") or "") != (cb.get("v") or ""):
            changes.append({"cell": k, "kind": "value",
                            "before": ca.get("v"), "after": cb.get("v")})
    return changes

# ---------------------------------------------------------------- mermaid
def sheet_mermaid(precedents):
    agg = {}
    for node, precs in precedents.items():
        dst = node.split("!")[0]
        for p in precs:
            if p.startswith("EXTERNAL::"):
                src = "EXTERNAL"
            elif "!" in p:
                src = p.split("!")[0]
            else:
                continue
            if src != dst:
                agg[(src, dst)] = agg.get((src, dst), 0) + 1
    lines = ["flowchart LR"]
    for (src, dst), n in sorted(agg.items()):
        lines.append(f'    {re.sub(r"[^A-Za-z0-9_]", "_", src)}'
                     f'["{src}"] -->|{n} refs| '
                     f'{re.sub(r"[^A-Za-z0-9_]", "_", dst)}["{dst}"]')
    return "\n".join(lines)

# ---------------------------------------------------------------- CLI
def main():
    ap = argparse.ArgumentParser()
    sub = ap.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("inventory"); p.add_argument("wb")
    p = sub.add_parser("graph"); p.add_argument("wb"); p.add_argument("--out")
    p = sub.add_parser("blast"); p.add_argument("wb"); p.add_argument("cells", nargs="+")
    p = sub.add_parser("snapshot"); p.add_argument("wb"); p.add_argument("--out")
    p = sub.add_parser("mermaid"); p.add_argument("wb")
    p = sub.add_parser("diff"); p.add_argument("a"); p.add_argument("b")
    p.add_argument("--exclude", nargs="*", default=[])
    args = ap.parse_args()

    if args.cmd == "inventory":
        print(json.dumps(inventory(args.wb)[0], indent=2))
    elif args.cmd == "graph":
        _, _, precedents, dependents = build_graph(args.wb)
        out = {"precedents": {k: sorted(v) for k, v in precedents.items()},
               "dependents": {k: sorted(v) for k, v in dependents.items()}}
        if args.out:
            json.dump(out, open(args.out, "w"), indent=1)
            print(f"graph written: {args.out} "
                  f"({len(precedents)} formula nodes)")
        else:
            print(json.dumps(out, indent=2))
    elif args.cmd == "mermaid":
        _, _, precedents, _ = build_graph(args.wb)
        print(sheet_mermaid(precedents))
    elif args.cmd == "blast":
        _, _, _, dependents = build_graph(args.wb)
        hit = blast_radius(dependents, args.cells)
        print(json.dumps({"seeds": args.cells, "affected": sorted(hit),
                          "count": len(hit)}, indent=2))
    elif args.cmd == "snapshot":
        s = snapshot(args.wb)
        if args.out:
            json.dump(s, open(args.out, "w"), indent=1)
            print(f"snapshot written: {args.out} ({len(s)} cells)")
        else:
            print(json.dumps(s, indent=2))
    elif args.cmd == "diff":
        a = json.load(open(args.a)); b = json.load(open(args.b))
        changes = diff(a, b, exclude=tuple(args.exclude))
        print(json.dumps(changes, indent=2))
        sys.exit(1 if changes else 0)

if __name__ == "__main__":
    main()

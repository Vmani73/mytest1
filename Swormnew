## Implementation: Swarm Coordinator Script

Create `.github/skills/monolith-decomposer/swarm-coordinator.py`:

```python
#!/usr/bin/env python3
"""
Agentic Swarm Coordinator
Watches STATE.md, spawns agents, manages concurrency
"""

import json
import time
import subprocess
from pathlib import Path
from typing import Dict, List
from datetime import datetime

class SwarmCoordinator:
    def __init__(self, repo_root: str, config_file: str = None):
        self.repo_root = Path(repo_root)
        self.state_file = self.repo_root / "migration" / "STATE.md"
        self.config = {
            "max_parallel_extractors": 4,
            "max_parallel_verifiers": 6,
            "max_parallel_hardeners": 6,
            "timeout_extraction": 600,
            "timeout_verification": 900,
            "timeout_hardening": 900,
        }
        if config_file:
            self.load_config(config_file)
        
        self.active_agents = {}  # {agent_id: process}
    
    def run_swarm(self):
        """Main loop: watch STATE.md and spawn agents"""
        while True:
            state = self.read_state()
            
            # Phase 0-2 (sequential)
            self.spawn_analyzer(state)
            self.spawn_inventory(state)
            self.spawn_domain(state)
            self.spawn_boundaries(state)
            
            # Phase 3-5 (parallel swarm)
            if state.get("PHASE_3_GATE", {}).get("STATUS") == "ratified":
                self.spawn_extractors_swarm(state)
                self.spawn_verifiers_swarm(state)
                self.spawn_hardeners_swarm(state)
            
            # Check for migration complete
            if self.is_migration_complete(state):
                print("🎉 SWARM MIGRATION COMPLETE")
                break
            
            time.sleep(2)  # Check every 2 seconds
    
    def spawn_extractors_swarm(self, state: Dict):
        """Spawn up to MAX_PARALLEL_EXTRACTORS"""
        active_count = len([a for a in self.active_agents 
                           if "extractor" in a])
        
        if active_count < self.config["max_parallel_extractors"]:
            # Find next service in pending state
            for service, data in state.get("SERVICES", {}).items():
                if (data.get("PHASE_3_STATUS") == "pending" and 
                    service not in self.active_agents):
                    
                    # Spawn extractor for this service
                    agent_id = f"extractor-{service}"
                    self.active_agents[agent_id] = {
                        "service": service,
                        "started": datetime.now(),
                        "process": self.spawn_agent(
                            "migration-extractor",
                            service=service
                        )
                    }
    
    def spawn_verifiers_swarm(self, state: Dict):
        """Spawn up to MAX_PARALLEL_VERIFIERS"""
        active_count = len([a for a in self.active_agents 
                           if "verifier" in a])
        
        if active_count < self.config["max_parallel_verifiers"]:
            for service, data in state.get("SERVICES", {}).items():
                if (data.get("PHASE_3_STATUS") == "complete" and 
                    data.get("PHASE_4_STATUS") != "complete" and
                    f"verifier-{service}" not in self.active_agents):
                    
                    agent_id = f"verifier-{service}"
                    self.active_agents[agent_id] = {
                        "service": service,
                        "started": datetime.now(),
                        "process": self.spawn_agent(
                            "migration-verifier",
                            service=service
                        )
                    }
    
    def spawn_hardeners_swarm(self, state: Dict):
        """Spawn up to MAX_PARALLEL_HARDENERS"""
        active_count = len([a for a in self.active_agents 
                           if "hardener" in a])
        
        if active_count < self.config["max_parallel_hardeners"]:
            for service, data in state.get("SERVICES", {}).items():
                if (data.get("PHASE_4_STATUS") == "complete" and 
                    data.get("PHASE_5_STATUS") != "complete" and
                    f"hardener-{service}" not in self.active_agents):
                    
                    agent_id = f"hardener-{service}"
                    self.active_agents[agent_id] = {
                        "service": service,
                        "started": datetime.now(),
                        "process": self.spawn_agent(
                            "migration-hardener",
                            service=service
                        )
                    }
    

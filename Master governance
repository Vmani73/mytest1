  db: AsyncIOMotorDatabase
) -> None
  - Upsert to agent_graph_nodes keyed by agent_id
  - Update in-memory DiGraph node
  - Persist to MongoDB

async upsert_edge(
  edge: AgentEdge,
  db: AsyncIOMotorDatabase
) -> None
  - Upsert to agent_graph_edges keyed by
    (source_agent_id, target_agent_id, interface_ref)
  - Update in-memory DiGraph edge
  - Persist to MongoDB

get_downstream_agents(
  agent_id: str

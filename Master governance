  old has tool "validate_order"
  new has no tools
  changes = detector.detect(old_def, new_def)
  assert any(c.change_type ==
    ChangeType.TOOL_REMOVED for c in changes)
  assert detector.is_blocking(changes) == True

test_output_field_removed_is_critical:
  old output_schema: {order_id: str, status: str}
  new output_schema: {order_id: str}
  changes = detector.detect(old_def, new_def)
  assert any(c.change_type ==
    ChangeType.OUTPUT_FIELD_REMOVED
    for c in changes)

test_optional_param_added_is_not_blocking:
  old tool: process(amount: float)
  new tool: process(amount: float, note: str)
  changes = detector.detect(old_def, new_def)
  assert detector.is_blocking(changes) == False
  assert any(c.severity == Severity.INFO
    for c in changes)

test_prompt_change_is_warning_not_blocking:
  old: system_prompt_hash = "abc123"
  new: system_prompt_hash = "def456"
  changes = detector.detect(old_def, new_def)
  assert any(c.change_type ==
    ChangeType.PROMPT_HASH_CHANGED
    for c in changes)
  assert detector.is_blocking(changes) == False

test_no_change_returns_empty:
  old_def == new_def (same content)
  changes = detector.detect(old_def, new_def)
  assert changes == []


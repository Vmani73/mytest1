FILE 4: codemind/agentguard/detector.py

Class: BreakingChangeDetector

Compares old AgentDefinition vs new AgentDefinition.
Purely deterministic. Zero LLM calls.

Methods:

detect(
  old: AgentDefinition,
  new: AgentDefinition
) -> list[DetectedChange]
  - Run all sub-detectors
  - Return combined list, empty if no changes
  - CRITICAL severity → breaking
  - WARNING severity → prompt change
  - INFO severity → additive/safe

_detect_tool_changes(
  old_tools: list[ToolDefinition],
  new_tools: list[ToolDefinition]
) -> list[DetectedChange]
  Build old_map = {tool.name: tool}
  Build new_map = {tool.name: tool}

  For each tool in old_map:
    If tool.name not in new_map:
      → TOOL_REMOVED, CRITICAL
    Else:
      For each param in old input_schema:
        If param not in new input_schema:
          → TOOL_PARAM_REMOVED, CRITICAL
        Elif old type != new type:
          → TOOL_PARAM_TYPE_CHANGED, CRITICAL
        Elif param in new but key differs:
          → handled by removed+added pair
      For each param in new input_schema:
        If param not in old input_schema:
          → PARAM_ADDED_OPTIONAL, INFO

  For each tool in new_map not in old_map:
    → TOOL_ADDED, INFO

_detect_output_changes(
  old_schema: dict,
  new_schema: dict
) -> list[DetectedChange]
  For each field in old_schema:
    If field not in new_schema:
      → OUTPUT_FIELD_REMOVED, CRITICAL
    Elif old type != new type:
      → OUTPUT_FIELD_TYPE_CHANGED, CRITICAL
  For each field in new_schema not in old_schema:
    → INFO (additive)

_detect_prompt_change(
  old_hash: str | None,
  new_hash: str | None
) -> DetectedChange | None
  If both None: return None
  If old_hash != new_hash:
    → PROMPT_HASH_CHANGED, WARNING
    description: "System prompt modified.
    Semantic impact cannot be verified
    automatically. Manual review required."

_detect_route_change(
  old: AgentDefinition,
  new: AgentDefinition
) -> DetectedChange | None
  Only for fastapi type.
  If old.agent_id != new.agent_id:
    (agent_id is route path for fastapi)
    → ROUTE_CHANGED, CRITICAL

is_blocking(changes: list[DetectedChange]) -> bool
  Returns True if any change has
  severity == CRITICAL
  Returns False if only WARNING or INFO


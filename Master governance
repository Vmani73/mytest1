  - Load from MongoDB (the pre-PR version)
  - Used by BreakingChangeDetector to compare
    against new version extracted from PR diff

async remove_agent(
  agent_id: str,
  db: AsyncIOMotorDatabase
) -> None
  - Remove node and all its edges from graph
    and MongoDB
  - Called when agent file is deleted in PR


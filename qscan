    "S1_route_handler", "S2_passed_as_value", "S3_called_from_top_level",
    "S4_imported_not_called", "S7_top_level_program", "S8_bootstrap_file",
    "S10_public_api", "S11_named_in_string", "S14_convention_route"})
SIGNAL_MEANING = {
    "S1": "route node linked to this handler",
    "S2": "passed as a value (callback / handler registration)",
    "S3": "called from top-level code (script main)",
    "S4": "function imported but never called (e.g. tools=[...] lists)",
    "S4c": "class imported but never called (UI component or type-only use)",
    "S5": "carries a non-language decorator/annotation",
    "S6": "no production code calls it",
    "S7": "top-level program code calling in-repo functions",
    "S8": "bootstrap-only file (imports code, defines nothing)",
    "S9": "class nothing in production references",
    "S10": "library public API (exported by the package root)",
    "S11": "named in a string (route file, config, console-script entry)",
    "S12": "function value bound to a name (JS handlers, lambdas)",
    "S13": "module nothing imports (lazy/runtime loaded, script)",
    "S14": "route by framework convention (see rules: conventions)",
}


class QScanError(Exception):
    """Fatal, user-facing error with an exit code."""

    def __init__(self, message: str, code: int = EXIT_INTERNAL):
        super().__init__(message)
        self.code = code


